<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="kaliteConfig.GpuOverclock.Views.OverclockSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:kaliteConfig.GpuOverclock.ViewModels"
    xmlns:models="using:kaliteConfig.GpuOverclock.Models"
    xmlns:local="using:kaliteConfig.GpuOverclock.Views"
    mc:Ignorable="d"
    d:DesignHeight="1400" d:DesignWidth="1200">

    <UserControl.Resources>
        <Style x:Key="OcCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="8">

        <!-- ============ Safety countdown banner (safety-critical: impossible to miss) ============ -->
        <Border Style="{StaticResource OcCardStyle}"
                BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                BorderThickness="2"
                Padding="20"
                Visibility="{x:Bind local:OverclockSection.BoolToVis(Vm.ShowCountdown), Mode=OneWay}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7BA;" FontSize="28" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Keep these settings?" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="{x:Bind Vm.SafetyBannerText, Mode=OneWay}" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Keep" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind Vm.ConfirmChangesCommand}" />
                    <Button Content="Revert now" Command="{x:Bind Vm.RevertNowCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Unsupported card ============ -->
        <Border Style="{StaticResource OcCardStyle}" Padding="20"
                Visibility="{x:Bind local:OverclockSection.NotSupportedVis(Vm.IsSupported), Mode=OneWay}">
            <StackPanel Spacing="4">
                <TextBlock Text="Overclocking unavailable" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Vm.UnsupportedMessage, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- The overclock card sits under a full-cover risk gate until the user
             explicitly accepts the risk. Both live in one Grid cell so the gate
             overlays the card completely when visible. -->
        <Grid Visibility="{x:Bind local:OverclockSection.SupportedVis(Vm.IsSupported), Mode=OneWay}">

            <Border Style="{StaticResource OcCardStyle}">
            <StackPanel Spacing="20">

                <!-- Header -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Overclocking" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Vm.GpuTitle, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{x:Bind Vm.OpenChangeLogFileCommand}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="See exactly what this app changed on your GPU">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE81C;" FontSize="14" />
                            <TextBlock Text="Change log" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Telemetry tiles: responsive grid (same UniformGridLayout pattern
                     as InstallerPage/AffinityPage) - 6 per row on wide layouts,
                     fewer on narrow ones. Rows rebuilt every tick; conditional
                     tiles (hotspot, memory temp, PCIe TX/RX) only exist when
                     the GPU actually reports them. -->
                <ItemsRepeater ItemsSource="{x:Bind Vm.TelemetryTiles, Mode=OneWay}"
                               Visibility="{x:Bind local:OverclockSection.BoolToVis(Vm.TelemetryAvailable), Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="140" MinColumnSpacing="12" MinRowSpacing="12" Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:TelemetryTileRow">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Value, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Telemetry unavailable: distinct state, never stale values -->
                <TextBlock Text="{x:Bind Vm.TelemetryErrorText, Mode=OneWay}"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind local:OverclockSection.TextToVis(Vm.TelemetryErrorText), Mode=OneWay}" />

                <!-- Live monitor: 1-second history graphs (last ~3 minutes), hotspot included -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="Monitor" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="GPU" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Vm.MonGpuTemp, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorCautionBrush}" Margin="8,0,0,0" />
                            <TextBlock Text="Hotspot" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Vm.MonHotspotTemp, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorSuccessBrush}" Margin="8,0,0,0" />
                            <TextBlock Text="Memory" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Vm.MonMemTemp, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border CornerRadius="8" Padding="4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Canvas x:Name="MonitorTempCanvas" Height="100" SizeChanged="MonitorCanvas_SizeChanged" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Core" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Vm.MonCoreClock, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorSuccessBrush}" Margin="8,0,0,0" />
                            <TextBlock Text="Memory" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Vm.MonMemClock, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border CornerRadius="8" Padding="4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Canvas x:Name="MonitorClockCanvas" Height="100" SizeChanged="MonitorCanvas_SizeChanged" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Power" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Vm.MonPower, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border CornerRadius="8" Padding="4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Canvas x:Name="MonitorPowerCanvas" Height="100" SizeChanged="MonitorCanvas_SizeChanged" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="Fan" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Vm.MonFan, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border CornerRadius="8" Padding="4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Canvas x:Name="MonitorFanCanvas" Height="100" SizeChanged="MonitorCanvas_SizeChanged" />
                        </Border>
                    </StackPanel>
                </Expander>

                <!-- Two-column body: numeric controls left, graphical editors right.
                     Wide (≥1000px): side by side. Narrow: the right column stacks
                     below the left (same AdaptiveTrigger pattern as BiosManagerPage). -->
                <Grid x:Name="BodyGrid" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="BodyCol0" Width="*" />
                        <ColumnDefinition x:Name="BodyCol1" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="Adaptive">
                            <VisualState x:Name="Wide">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="1000" />
                                </VisualState.StateTriggers>
                            </VisualState>
                            <VisualState x:Name="Narrow">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="RightControls.(Grid.Row)" Value="1" />
                                    <Setter Target="RightControls.(Grid.Column)" Value="0" />
                                    <Setter Target="BodyCol1.Width" Value="0" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <StackPanel x:Name="LeftControls" Grid.Row="0" Grid.Column="0" Spacing="16">
                <!-- Clock/limit sliders (rendered only when the driver exposes the control) -->
                <StackPanel Spacing="16">

                    <StackPanel Spacing="4" Visibility="{x:Bind local:OverclockSection.BoolToVis(Vm.HasCoreOffset), Mode=OneWay}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Core clock offset (MHz)" VerticalAlignment="Center" />
                            <NumberBox Grid.Column="1" Width="104"
                                       Minimum="{x:Bind Vm.CoreOffsetMin, Mode=OneWay}"
                                       Maximum="{x:Bind Vm.CoreOffsetMax, Mode=OneWay}"
                                       Value="{x:Bind Vm.CoreOffsetValue, Mode=OneWay}"
                                       ValueChanged="CoreOffsetBox_ValueChanged"
                                       SpinButtonPlacementMode="Compact" SmallChange="1"
                                       ToolTipService.ToolTip="Type an exact offset - commits through the same confirmation countdown as dragging." />
                        </Grid>
                        <Slider x:Name="CoreOffsetSlider"
                                Minimum="{x:Bind Vm.CoreOffsetMin, Mode=OneWay}"
                                Maximum="{x:Bind Vm.CoreOffsetMax, Mode=OneWay}"
                                Value="{x:Bind Vm.CoreOffsetValue, Mode=OneWay}"
                                ValueChanged="CoreOffsetSlider_ValueChanged"
                                StepFrequency="1" SnapsTo="StepValues" />
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind local:OverclockSection.BoolToVis(Vm.HasMemOffset), Mode=OneWay}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Memory clock offset (MHz)" VerticalAlignment="Center" />
                            <NumberBox Grid.Column="1" Width="104"
                                       Minimum="{x:Bind Vm.MemOffsetMin, Mode=OneWay}"
                                       Maximum="{x:Bind Vm.MemOffsetMax, Mode=OneWay}"
                                       Value="{x:Bind Vm.MemOffsetValue, Mode=OneWay}"
                                       ValueChanged="MemOffsetBox_ValueChanged"
                                       SpinButtonPlacementMode="Compact" SmallChange="1"
                                       ToolTipService.ToolTip="Type an exact offset - commits through the same confirmation countdown as dragging." />
                        </Grid>
                        <Slider x:Name="MemOffsetSlider"
                                Minimum="{x:Bind Vm.MemOffsetMin, Mode=OneWay}"
                                Maximum="{x:Bind Vm.MemOffsetMax, Mode=OneWay}"
                                Value="{x:Bind Vm.MemOffsetValue, Mode=OneWay}"
                                ValueChanged="MemOffsetSlider_ValueChanged"
                                StepFrequency="1" SnapsTo="StepValues" />
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind local:OverclockSection.BoolToVis(Vm.HasPowerLimit), Mode=OneWay}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Power limit (%)" VerticalAlignment="Center" />
                            <NumberBox Grid.Column="1" Width="104"
                                       Minimum="{x:Bind Vm.PowerLimitMin, Mode=OneWay}"
                                       Maximum="{x:Bind Vm.PowerLimitMax, Mode=OneWay}"
                                       Value="{x:Bind Vm.PowerLimitValue, Mode=OneWay}"
                                       ValueChanged="PowerLimitBox_ValueChanged"
                                       SpinButtonPlacementMode="Compact" SmallChange="1"
                                       ToolTipService.ToolTip="Type an exact value - commits through the same confirmation countdown as dragging." />
                        </Grid>
                        <Slider x:Name="PowerLimitSlider"
                                Minimum="{x:Bind Vm.PowerLimitMin, Mode=OneWay}"
                                Maximum="{x:Bind Vm.PowerLimitMax, Mode=OneWay}"
                                Value="{x:Bind Vm.PowerLimitValue, Mode=OneWay}"
                                ValueChanged="PowerLimitSlider_ValueChanged"
                                StepFrequency="1" SnapsTo="StepValues" />
                    </StackPanel>

                    <!-- Only rendered when TempLimitRangeC is non-null for this GPU -->
                    <StackPanel Spacing="4" Visibility="{x:Bind local:OverclockSection.BoolToVis(Vm.HasTempLimit), Mode=OneWay}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Temperature limit (°C)" VerticalAlignment="Center" />
                            <NumberBox Grid.Column="1" Width="104"
                                       Minimum="{x:Bind Vm.TempLimitMin, Mode=OneWay}"
                                       Maximum="{x:Bind Vm.TempLimitMax, Mode=OneWay}"
                                       Value="{x:Bind Vm.TempLimitValue, Mode=OneWay}"
                                       ValueChanged="TempLimitBox_ValueChanged"
                                       SpinButtonPlacementMode="Compact" SmallChange="1"
                                       ToolTipService.ToolTip="Type an exact value - commits through the same confirmation countdown as dragging." />
                        </Grid>
                        <Slider x:Name="TempLimitSlider"
                                Minimum="{x:Bind Vm.TempLimitMin, Mode=OneWay}"
                                Maximum="{x:Bind Vm.TempLimitMax, Mode=OneWay}"
                                Value="{x:Bind Vm.TempLimitValue, Mode=OneWay}"
                                ValueChanged="TempLimitSlider_ValueChanged"
                                StepFrequency="1" SnapsTo="StepValues" />
                    </StackPanel>
                </StackPanel>
                    <!-- Voltage boost (V/F simple mode, left column) -->
                    <StackPanel Spacing="4" Visibility="{x:Bind local:OverclockSection.BoolToVis(Vm.HasVfCurve), Mode=OneWay}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Voltage boost (MHz)" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE946;" FontSize="13"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          ToolTipService.ToolTip="Adjusts clock behavior across voltage points within the GPU's existing envelope - does not set voltage directly on this GPU generation." />
                            </StackPanel>
                            <NumberBox Grid.Column="1" Width="104"
                                       Minimum="{x:Bind Vm.VfFlatMin, Mode=OneWay}"
                                       Maximum="{x:Bind Vm.VfFlatMax, Mode=OneWay}"
                                       Value="{x:Bind Vm.VfFlatValue, Mode=OneWay}"
                                       ValueChanged="VfFlatBox_ValueChanged"
                                       SpinButtonPlacementMode="Compact" SmallChange="1"
                                       ToolTipService.ToolTip="Type an exact flat offset - commits through the same confirmation countdown as dragging." />
                        </Grid>
                        <Slider x:Name="VfFlatSlider"
                                Minimum="{x:Bind Vm.VfFlatMin, Mode=OneWay}"
                                Maximum="{x:Bind Vm.VfFlatMax, Mode=OneWay}"
                                Value="{x:Bind Vm.VfFlatValue, Mode=OneWay}"
                                ValueChanged="VfFlatSlider_ValueChanged"
                                StepFrequency="1" SnapsTo="StepValues"
                                ToolTipService.ToolTip="One flat clock offset applied uniformly across all voltage points. For per-point control, open the advanced curve editor on the right." />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Points currently differ per voltage - the curve editor shows them. Moving this slider makes them uniform again."
                                   Visibility="{x:Bind local:OverclockSection.BoolToVis(Vm.VfOffsetsMixed), Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
                    <StackPanel x:Name="RightControls" Grid.Row="0" Grid.Column="1" Spacing="12">
                <!-- Fan control -->
                <StackPanel Spacing="10" Visibility="{x:Bind local:OverclockSection.BoolToVis(Vm.FanControlAvailable), Mode=OneWay}">
                    <TextBlock Text="Fan" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <RadioButton Content="Auto" GroupName="fanMode"
                                     IsChecked="{x:Bind Vm.FanAutoChecked, Mode=TwoWay}" />
                        <RadioButton Content="Fixed %" GroupName="fanMode"
                                     IsChecked="{x:Bind Vm.FanStaticChecked, Mode=TwoWay}" />
                        <RadioButton Content="Curve" GroupName="fanMode"
                                     IsChecked="{x:Bind Vm.FanCurveChecked, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Spacing="4" Visibility="{x:Bind local:OverclockSection.FanStaticVis(Vm.FanMode), Mode=OneWay}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Fixed fan speed (%)" VerticalAlignment="Center" />
                            <NumberBox Grid.Column="1" x:Name="FanStaticBox" Width="104"
                                       Minimum="0" Maximum="100"
                                       Value="{x:Bind Vm.FanStaticPercent, Mode=OneWay}"
                                       ValueChanged="FanStaticBox_ValueChanged"
                                       SpinButtonPlacementMode="Compact" SmallChange="1" />
                        </Grid>
                        <Slider Minimum="0" Maximum="100"
                                Value="{x:Bind Vm.FanStaticPercent, Mode=OneWay}"
                                ValueChanged="FanStaticSlider_ValueChanged"
                                StepFrequency="1" SnapsTo="StepValues" />
                    </StackPanel>
                    <StackPanel Spacing="6" Visibility="{x:Bind local:OverclockSection.FanCurveVis(Vm.FanMode), Mode=OneWay}">
                        <TextBlock Text="Temperature → fan speed (%)" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Border CornerRadius="8" Padding="4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Canvas x:Name="FanCurveCanvas" Height="150"
                                    PointerPressed="FanCurveCanvas_PointerPressed"
                                    PointerMoved="FanCurveCanvas_PointerMoved"
                                    PointerReleased="FanCurveCanvas_PointerReleased"
                                    PointerCanceled="FanCurveCanvas_PointerCanceled"
                                    SizeChanged="FanCurveCanvas_SizeChanged" />
                        </Border>
                        <TextBlock Text="Drag points up or down for an exact speed (temperature via the table below). The table and graph stay in sync; press Apply curve to commit."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <ItemsRepeater ItemsSource="{x:Bind Vm.CurvePoints, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:FanCurvePointRow">
                                    <StackPanel Spacing="2">
                                        <NumberBox Value="{x:Bind TempC, Mode=TwoWay}" SpinButtonPlacementMode="Compact"
                                                   Minimum="20" Maximum="100" SmallChange="1" Width="96" />
                                        <NumberBox Value="{x:Bind FanPercent, Mode=TwoWay}" SpinButtonPlacementMode="Compact"
                                                   Minimum="0" Maximum="100" SmallChange="1" Width="96" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Update interval (ms)" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <NumberBox Width="96" Minimum="100" Maximum="10000"
                                       Value="{x:Bind Vm.FanIntervalMs, Mode=OneWay}"
                                       ValueChanged="FanIntervalBox_ValueChanged" SmallChange="100" />
                            <TextBlock Text="Ramp (%/tick)" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       ToolTipService.ToolTip="0 = off. Otherwise the applied speed moves toward the curve target by at most this much per tick, damping audible hunting." />
                            <NumberBox Width="80" Minimum="0" Maximum="100"
                                       Value="{x:Bind Vm.FanRampStep, Mode=OneWay}"
                                       ValueChanged="FanRampBox_ValueChanged" SmallChange="1" />
                        </StackPanel>
                        <Button Content="Apply curve" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind Vm.StartFanCurveCommand}" />
                        <TextBlock Text="The loop re-applies the curve every few seconds. Closing the app or switching to Auto always hands control back to the driver."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                    <TextBlock FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                               Text="{x:Bind Vm.VfCurveError, Mode=OneWay}"
                               Visibility="{x:Bind local:OverclockSection.TextToVis(Vm.VfCurveError), Mode=OneWay}" />
                    <!-- Advanced V/F curve editor (right column; panel copy unchanged) -->
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Visibility="{x:Bind local:OverclockSection.BoolToVis(Vm.HasVfCurve), Mode=OneWay}">
                        <Expander.Header>
                            <TextBlock Text="Advanced curve editor" />
                        </Expander.Header>
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="Drag points to set per-point clock offsets. Frequency must not decrease as voltage rises - invalid curves are blocked before anything is written. Every commit runs through the same confirmation countdown as the other controls (slightly longer for curve edits)." />
                            <Border CornerRadius="8" Padding="4"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Canvas x:Name="VfCurveCanvas" Height="240"
                                        PointerPressed="VfCurveCanvas_PointerPressed"
                                        PointerMoved="VfCurveCanvas_PointerMoved"
                                        PointerReleased="VfCurveCanvas_PointerReleased"
                                        PointerCanceled="VfCurveCanvas_PointerCanceled"
                                        SizeChanged="VfCurveCanvas_SizeChanged" />
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="VfAxisLeft" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="VfAxisCenter" Grid.Column="1" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="VfAxisRight" Grid.Column="2" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Reset to stock curve" Click="ResetVfCurve_Click" />
                                <Button Content="Apply point edits" Style="{StaticResource AccentButtonStyle}" Click="ApplyVfCurve_Click" />
                            </StackPanel>
                            <StackPanel Spacing="4" Visibility="{x:Bind local:OverclockSection.BoolToVis(Vm.HasVoltageBoost), Mode=OneWay}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Driver voltage boost" />
                                        <FontIcon Glyph="&#xE946;" FontSize="13"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  ToolTipService.ToolTip="Exposed by the driver on this GPU. On most RTX 30/40 cards this control is locked by the vBIOS and stays hidden - the curve above is the effective control there." />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                                               Text="{x:Bind Vm.VoltageBoostPercentDisplay, Mode=OneWay}" />
                                </Grid>
                                <Slider x:Name="VoltageBoostSlider" Minimum="0" Maximum="100"
                                        Value="{x:Bind Vm.VoltageBoostPercentValue, Mode=OneWay}"
                                        ValueChanged="VoltageBoostSlider_ValueChanged"
                                        StepFrequency="1" SnapsTo="StepValues" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    </StackPanel>
                </Grid>

                <!-- Status line -->
                <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind local:OverclockSection.TextToVis(Vm.StatusText), Mode=OneWay}" />

                <!-- Profiles -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="Profiles" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="10" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox PlaceholderText="Profile name" Width="220"
                                     Text="{x:Bind Vm.NewProfileName, Mode=TwoWay}" />
                            <Button Content="Save current as profile" Command="{x:Bind Vm.SaveProfileCommand}" />
                            <ToggleSwitch OnContent="Reapply at startup" OffContent="Reapply at startup"
                                          Margin="8,0,0,0"
                                          IsOn="{x:Bind Vm.StartupReapplyEnabled, Mode=OneWay}"
                                          Toggled="StartupReapply_Toggled" />
                        </StackPanel>
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Profiles, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:OverclockProfile">
                                    <Grid ColumnSpacing="8" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                <Border CornerRadius="6" Padding="5,1"
                                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                         Visibility="{x:Bind local:OverclockSection.BoolToVis(HasConfirmedAt), Mode=OneTime}">
                                                    <TextBlock Text="validated" FontSize="10"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                </Border>
                                                <Border CornerRadius="6" Padding="5,1"
                                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                         Visibility="{x:Bind local:OverclockSection.BoolToVis(HasBeenManuallyValidated), Mode=OneTime}"
                                                        ToolTipService.ToolTip="Manually applied and confirmed at least once - eligible for per-game auto-switch.">
                                                    <TextBlock Text="auto-switch ready ✓" FontSize="10"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{x:Bind Summary}" />
                                            <TextBlock FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                       Text="Not yet validated - apply manually once to enable auto-switch."
                                                        Visibility="{x:Bind local:OverclockSection.InverseBoolToVis(HasBeenManuallyValidated), Mode=OneTime}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <ToggleSwitch OnContent="At startup" OffContent="At startup"
                                                          HorizontalAlignment="Left"
                                                           IsOn="{x:Bind IsStartupDefault, Mode=OneTime}"
                                                          Toggled="StartupDefault_Toggled" Tag="{x:Bind}" />
                                            <Button Content="Apply" Style="{StaticResource AccentButtonStyle}"
                                                    Click="ApplyProfile_Click" Tag="{x:Bind}" />
                                            <Button Content="Bind to game…"
                                                    Click="BindProfile_Click" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Auto-apply this profile when a game executable launches." />
                                            <Button Content="Delete"
                                                    Click="DeleteProfile_Click" Tag="{x:Bind}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Expander>

                <!-- Per-game auto-switch (v2 Part B) -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="Per-game auto-switch" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind Vm.ActiveGameProfileText, Mode=OneWay}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind Vm.LastAutoSwitchText, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="{x:Bind local:OverclockSection.TextToVis(Vm.LastAutoSwitchText), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Vm.GameWatcherStatusText, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="{x:Bind local:OverclockSection.TextToVis(Vm.GameWatcherStatusText), Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Bind a validated profile to a game below: it auto-applies on launch (no blocking countdown while you're in-game, but the driver watchdog stays armed) and the default profile returns on exit. The active profile is also shown in the system tray tooltip. Only manually-validated profiles are eligible." />
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Bindings, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameBindingRow">
                                    <Grid ColumnSpacing="8" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind ExeDisplay}" FontWeight="SemiBold" />
                                                <TextBlock Text="→" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ProfileName}" />
                                                <Border CornerRadius="6" Padding="5,1"
                                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                        Visibility="{x:Bind local:OverclockSection.BoolToVis(IsPathLocked), Mode=OneWay}"
                                                        ToolTipService.ToolTip="Only matches this exact executable path.">
                                                    <TextBlock Text="exact path" FontSize="10"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{x:Bind PathDisplay}" TextWrapping="Wrap" />
                                            <TextBlock FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                       Text="{x:Bind ValidationDisplay}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <ToggleSwitch OnContent="Enabled" OffContent="Enabled"
                                                          IsOn="{x:Bind Enabled, Mode=OneWay}"
                                                          Toggled="BindingEnabled_Toggled" Tag="{x:Bind}" />
                                            <Button Content="Exact path…" Click="LockBindingPath_Click" Tag="{x:Bind}"
                                                    Visibility="{x:Bind local:OverclockSection.InverseBoolToVis(IsPathLocked), Mode=OneWay}"
                                                    ToolTipService.ToolTip="Restrict this binding to one exact executable path (for generically-named executables)." />
                                            <Button Content="Name only" Click="ClearBindingPath_Click" Tag="{x:Bind}"
                                                    Visibility="{x:Bind local:OverclockSection.BoolToVis(IsPathLocked), Mode=OneWay}"
                                                    ToolTipService.ToolTip="Match by executable name anywhere (portable across install locations)." />
                                            <Button Content="Remove" Click="RemoveBinding_Click" Tag="{x:Bind}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Expander>

                <!-- Change log viewer -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="Recent changes" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox MinWidth="130" Header="Result" PlaceholderText="All results"
                                      SelectedIndex="{x:Bind Vm.LogResultFilterIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="All results" />
                                <ComboBoxItem Content="OK" />
                                <ComboBoxItem Content="Reverted" />
                                <ComboBoxItem Content="Failed" />
                            </ComboBox>
                            <ComboBox Grid.Column="1" MinWidth="150" Header="Source" PlaceholderText="All sources"
                                      SelectedIndex="{x:Bind Vm.LogSourceFilterIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="All sources" />
                                <ComboBoxItem Content="Manual (UI)" />
                                <ComboBoxItem Content="Profile apply" />
                                <ComboBoxItem Content="Startup apply" />
                                <ComboBoxItem Content="Auto revert" />
                                <ComboBoxItem Content="Game auto-switch" />
                            </ComboBox>
                            <TextBlock Grid.Column="2" VerticalAlignment="Bottom" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind local:OverclockSection.BoolToVis(Vm.LogIsEmpty), Mode=OneWay}"
                                       Text="No matching entries." />
                            <Button Grid.Column="5" VerticalAlignment="Bottom"
                                    Command="{x:Bind Vm.ExportVerificationRecordCommand}"
                                    ToolTipService.ToolTip="Write the change log as a Markdown verification record (same shape as Docs/OverclockVerification.md)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                                    <TextBlock Text="Export verification record" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ListView ItemsSource="{x:Bind Vm.LogEntries, Mode=OneWay}" MaxHeight="220" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:AppliedChangeLogEntry">
                                    <TextBlock FontSize="12" IsTextSelectionEnabled="True" TextWrapping="NoWrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{x:Bind TimestampDisplay}" /><Run Text="  " />
                                        <Run Text="{x:Bind ResultDisplay}" FontWeight="SemiBold" /><Run Text="  " />
                                        <Run Text="{x:Bind LineDisplay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Expander>
            </StackPanel>
            </Border>

            <!-- ============ Extreme-caution risk gate: covers the card until accepted ============ -->
            <Border Style="{StaticResource OcCardStyle}"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                    BorderThickness="2"
                    Padding="28"
                    Visibility="{x:Bind local:OverclockSection.NotRiskAcceptedVis(Vm.RiskAccepted), Mode=OneWay}">
                <StackPanel Spacing="16" VerticalAlignment="Center" MaxWidth="720" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE7BA;" FontSize="40"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="Extreme caution - advanced feature"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock FontSize="14"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"
                               Text="Overclocking is for advanced users only. Every value you apply here runs your hardware outside its factory specification and can cause system instability, crashes, data loss, or permanent hardware damage. You assume full responsibility for anything you apply: the kaliteConfig developers accept no liability whatsoever for any damage, however caused, resulting from the use of this module. Use entirely at your own risk." />
                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="Safety net: every change is applied through a confirmation window and is reverted automatically to your previous working settings if you don't confirm it, or if the driver crashes. Changes beyond the driver's limits may still freeze the display before a revert can run - save your work before experimenting." />
                    <Button Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"
                            Command="{x:Bind Vm.AcceptRiskCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                            <TextBlock Text="I understand - continue at my own risk" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
