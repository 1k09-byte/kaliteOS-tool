<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.PackageManager.Views.PackageManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:kaliteConfig.PackageManager.Views"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="32,8,32,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Apps"
                       Style="{StaticResource TitleLargeTextBlockStyle}"
                       VerticalAlignment="Center" />

            <InfoBadge Grid.Column="1"
                       Value="{x:Bind Module.UpdateCount, Mode=OneWay}"
                       VerticalAlignment="Center"
                       Visibility="{x:Bind local:PackageManagerPage.BadgeVis(Module.UpdateCount), Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <NavigationView x:Name="InnerNav"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            OpenPaneLength="200"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            IsPaneToggleButtonVisible="False"
                            PaneDisplayMode="LeftCompact"
                            SelectionChanged="InnerNav_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Discover Packages" Tag="Discover">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE738;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Software Updates" Tag="Updates">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE72C;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem Content="Package Managers" Tag="Managers">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>
            </NavigationView>

            <Frame x:Name="ContentFrame"
                   Grid.Column="1"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" />
        </Grid>
    </Grid>
</Page>
