<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.PackageManager.Views.DiscoverPackagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:kaliteConfig.PackageManager.ViewModels"
    xmlns:local="using:kaliteConfig.PackageManager.Views"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Disabled">

    <Grid RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="22,18" CornerRadius="{ThemeResource OverlayCornerRadius}"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Get Software" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Vm.StatusLine, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                </StackPanel>
                <AutoSuggestBox Grid.Column="1" PlaceholderText="What are you looking for?" QueryIcon="Find"
                                MaxWidth="560" HorizontalAlignment="Right" Width="560"
                                CornerRadius="{ThemeResource ControlCornerRadius}" VerticalAlignment="Center"
                                Text="{x:Bind Vm.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                QuerySubmitted="SearchBox_QuerySubmitted" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsRepeater ItemsSource="{x:Bind Vm.SourceChoices, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SourceChoice">
                            <ToggleButton Content="{x:Bind Label}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                          CornerRadius="16" Padding="14,4" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="All" Command="{x:Bind Vm.CheckAllSourcesCommand}" CornerRadius="16" />
                <Button Content="None" Command="{x:Bind Vm.UncheckAllSourcesCommand}" CornerRadius="16" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" SelectedIndex="{x:Bind Vm.SearchModeIndex, Mode=TwoWay}" Header="Match by"
                      CornerRadius="{ThemeResource ControlCornerRadius}">
                <ComboBoxItem Content="Package name" />
                <ComboBoxItem Content="Package ID" />
                <ComboBoxItem Content="Both" />
                <ComboBoxItem Content="Exact match" />
                <ComboBoxItem Content="Similar" />
            </ComboBox>
            <ComboBox Grid.Column="1" Header="Scope" SelectionChanged="ScopeBox_SelectionChanged"
                      CornerRadius="{ThemeResource ControlCornerRadius}">
                <ComboBoxItem Content="Default" IsSelected="True" />
                <ComboBoxItem Content="Machine" />
                <ComboBoxItem Content="User" />
            </ComboBox>
            <ComboBox Grid.Column="2" SelectedIndex="{x:Bind Vm.SortKeyIndex, Mode=TwoWay}" Header="Order by"
                      CornerRadius="{ThemeResource ControlCornerRadius}">
                <ComboBoxItem Content="Name" />
                <ComboBoxItem Content="Source" />
                <ComboBoxItem Content="Version" />
            </ComboBox>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                <ToggleButton Content="List" Tag="0" Click="ViewMode_Click"
                              IsChecked="{x:Bind Vm.ViewMode.Equals(vm:PackageViewMode.List), Mode=OneWay}" />
                <ToggleButton Content="Compact" Tag="1" Click="ViewMode_Click"
                              IsChecked="{x:Bind Vm.ViewMode.Equals(vm:PackageViewMode.Compact), Mode=OneWay}" />
                <ToggleButton Content="Grid" Tag="2" Click="ViewMode_Click"
                              IsChecked="{x:Bind Vm.ViewMode.Equals(vm:PackageViewMode.Grid), Mode=OneWay}" />
            </StackPanel>
            <Button Grid.Column="4" Content="Search" Command="{x:Bind Vm.SearchCommand}" VerticalAlignment="Bottom" />
            <Button Grid.Column="5" Content="Install selected" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind Vm.InstallSelectedCommand}" VerticalAlignment="Bottom" />
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <local:PackageListView x:Name="ResultsList"
                                       Items="{x:Bind Vm.Filtered, Mode=OneWay}"
                                       ViewMode="{x:Bind Vm.ViewMode, Mode=OneWay}"
                                       ShowAction="False"
                                       ShowInfo="False"
                                       CancelCommand="{x:Bind Vm.CancelActiveOperationCommand}"
                                       SelectionToggled="ResultsList_SelectionToggled" />
                <TextBlock Text="Search above to discover packages."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind local:DiscoverPackagesPage.EmptyVis(Vm.Filtered.Count, Vm.IsBusy), Mode=OneWay}" />
            </Grid>

            <Border Grid.Column="1" x:Name="DropBox" AllowDrop="True" Padding="18"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                    DragOver="DropBox_DragOver" Drop="DropBox_Drop" Tapped="DropBox_Tapped"
                    ToolTipService.ToolTip="Click to choose files, or drag them here">
                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE896;" FontSize="36" HorizontalAlignment="Center"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Browser extensions" FontWeight="SemiBold" FontSize="16"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Drop .crx, .xpi, .exe or .msi files here, or click to browse."
                               TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Padding="12,6" CornerRadius="{ThemeResource ControlCornerRadius}"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Vm.CountsLine, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Select all" Command="{x:Bind Vm.SelectAllCommand}" />
                <Button Grid.Column="2" Content="Clear selection" Command="{x:Bind Vm.ClearSelectionCommand}" />
            </Grid>
        </Border>
    </Grid>
</Page>
