                <NavigationViewItem Style="{StaticResource RailNavItemStyle}" Content="WS" Tag="WindowsSettingsPage" AutomationProperties.Name="Windows Tuning" Margin="0" Padding="0">
                    <ToolTipService.ToolTip>
                        <ToolTip Visibility="Collapsed" />
                    </ToolTipService.ToolTip>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
