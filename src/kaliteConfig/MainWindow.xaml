            <!--
                PAGES SIT IN ONE BIG ROUNDED CARD.

                ContentFrame used to be a bare Frame filling the content area, so
                every page bled to the window edges - there was no visual
                container at all and pages read as one full-screen surface.

                This Border is the page card: a rounded surface with a hairline
                stroke and a small margin on all sides so the matte-black window
                shows around it. The backdrop stays behind it and is visible in
                that margin, which is the layering the app is meant to have.
            -->
            <!--
                Margin must equal the caption mask's 16px overhang (TopBarMask's
                Margin="0,0,0,-16"). With a smaller margin the mask darkened only
                the TOP of the side margins, so the backdrop strip beside the card
                started a few px BELOW the card's top edge - the strip read as a
                background that was "shorter than the card", with a ragged notch at
                the top-left/top-right corners. At 16 the mask ends exactly at the
                card's top edge and the strip runs the card's full height.
            -->
            <Border
                Margin="16"
                CornerRadius="6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <!--
                    PAGE TRANSITION LIVES HERE, ONCE, FOR EVERY PAGE.

                    Entrance used to be declared per page (only three pages had
                    it), so most nav clicks hard-cut. Setting it on the Frame is
                    the single source of truth: any page navigated here fades and
                    slides up, and a page can still override it with its own
                    Page.Transitions if it ever needs something else.
                -->
                <Frame x:Name="ContentFrame" UseLayoutRounding="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" FontFamily="{StaticResource KaliteFontFamily}">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition>
                                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                    <EntranceNavigationTransitionInfo />
                                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                            </NavigationThemeTransition>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </Border>
        </NavigationView>

            <!-- Shared selection indicator: a thin accent pill riding the left edge
                 of the selected item's plate. 4x18 with CornerRadius 2 is a full
                 pill. It is one element rather than one-per-item so a selection
                 change MOVES it: the RepositionThemeTransition below makes it glide
                 between rows instead of snapping. Positioned from code-behind
                 (UpdateNavPill), which runs on every layout pass. -->
            <Border
                x:Name="NavPill"
                Width="3"
                Height="18"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="1.5"
                Opacity="0">
                <Border.Transitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </Border.Transitions>
            </Border>
        </Grid>

        <!-- KaliteOS first-launch auto-provisioning overlay.
             Visible only when HKLM\SOFTWARE\KaliteOS IsInstalled == 0,
             shows live Windhawk install progress with determinate + indeterminate bars.
             Background is solid/opaque (E6 ~90% black) so underlying UI is fully hidden;
             no see-through ghost behind the progress card. -->
        <Border x:Name="KaliteOSStartupOverlay"
                Grid.RowSpan="2"
                Visibility="Collapsed"
                Background="#E6000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Canvas.ZIndex="100">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE713;" FontSize="20" VerticalAlignment="Center" />
                                <TextBlock Text="Setting up KaliteOS" Style="{StaticResource KaliteSectionTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="First launch detected - installing Windhawk and importing mods. This may take a few minutes…"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <ProgressBar x:Name="KaliteOSProgressBar"
                                         Minimum="0" Maximum="100" Value="0"
                                         IsIndeterminate="True" />
                            <TextBlock x:Name="KaliteOSProgressText"
                                       Text="Preparing…"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="KaliteOSPercentText"
                                       Text=""
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="Collapsed" />
                        </StackPanel>

                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                                   Text="Do not close the app. Progress is shown above; Windhawk installs silently and the bundled KaliteOS mods are imported automatically." />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- VERIFICATION LOCK. Visible by default so the very first frame is already
             covered (no 1s flash of content): code-behind collapses it when the
             stamp is present, otherwise it stays and nothing inside is reachable.
             Fully opaque, above everything (ZIndex 200). Generic copy only. -->
        <Border x:Name="VerificationOverlay"
                Grid.RowSpan="2"
                Visibility="Visible"
                Background="#FF080B08"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Canvas.ZIndex="200">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="28">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE72E;" FontSize="32" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Verification required" Style="{StaticResource KaliteSectionTitle}" TextAlignment="Center" HorizontalAlignment="Center" />
                        <TextBlock Text="This toolkit only runs on KaliteOS."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" FontSize="13" TextAlignment="Center" HorizontalAlignment="Center" />
                        <Button Content="Exit" Click="VerificationExit_Click" HorizontalAlignment="Center" MinWidth="140" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
