<Window
    x:Class="kaliteConfig.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:controls="using:kaliteConfig.Controls"
    Title="kaliteConfig"
    mc:Ignorable="d">

    <!-- Root background is intentionally left transparent (see ApplyRootBackground
         in code-behind). With Material = None the raw black window surface shows
         through, which is what gives the app its solid black look; with a
         Mica/Acrylic backdrop active the backdrop renders behind the XAML and an
         opaque root would cover it. -->
    <!-- FontFamily inherits to everything under it: one body face for every
         page instead of whatever each control's default happens to be.
         KaliteFontFamily (Jim Nightshade, defined in KaliteTheme) is the app's
         typeface, so page content picks it up here; controls that set an
         explicit family (monospace readouts, symbol icons) keep theirs.
         Panel/Grid cannot carry it (not a Control), hence the Frame below. -->
    <Grid x:Name="RootGrid" UseLayoutRounding="True" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
             LAYOUT IS LOAD-BEARING HERE. Row 0 is Height="Auto". A backdrop that
             sits in row 0 without spanning contributes its desired height to
             that row - and its inner canvases are deliberately oversized
             (1600x900) so the drift can never expose an edge. That made the
             TitleBar row 900px tall and squeezed NavShell off the window,
             which looked like the entire UI had vanished. RowSpan="2" stops
             it contributing to any row's sizing (a spanning child never does),
             and Stretch on both axes makes it fill rather than use its
             desired size. It stays the first child so it paints behind
             everything, and IsHitTestVisible=False on the control means it can
             never intercept a click meant for the nav rail or a page.
        -->
        <controls:KaliteBackdrop
            x:Name="Backdrop"
            Grid.Row="0"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <!--
             BACKGROUND IMAGE (Settings > Appearance > Background image).

             A user-chosen image painted between the animated meteor field and the
             backdrop tint, so the tint can wash over it and the chrome masks stay
             opaque on top. It is RowSpan=2 + Stretch and IsHitTestVisible=False,
             and it is removed when the user has not picked an image (the meteor
             field shows through).

             Stretch is user-controlled: None (native size, top-left), Fill (cover
             the window, ignores aspect), Uniform (fit inside, centred), Uniform to
             fill (cover, keep aspect, crop).
        -->
        <Border
            x:Name="BgImageLayer"
            Grid.Row="0"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Image
                x:Name="BgImage"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
        </Border>

        <!--
             BACKDROP TINT (Settings > Appearance > Backdrop tint).

             A translucent wash over the window surface, painted between the
             backdrop and everything else so the material still renders through
             it - which is the whole point of a tint. Brushed in from
             code-behind (a SolidColorBrush this window owns) because the alpha
             is user-controlled and a shared resource would have to be swapped
             in every theme dictionary.

             It is RowSpan=2 + Stretch, and IsHitTestVisible=False so it can
             never take a click. It sits AFTER the backdrop but BEFORE the
             opaque rail/caption masks, so those keep their matte black and the
             tint only reaches the page area - never the chrome, and never a
             full-screen flat colour.
        -->
        <Border
            x:Name="TintLayer"
            Grid.Row="0"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            IsHitTestVisible="False" />

        <!--
            OPAQUE NAV RAIL MASK.

            The meteor backdrop is a window-level element, so it drifts behind
            the whole window including the rail - which read as streaks smearing
            through the nav icons and labels.

            Setting NavigationViewDefaultPaneBackground / ExpandedPaneBackground
            to black is NOT sufficient: WinUI does not honour those keys for the
            compact rail layout, and the pane still rendered at RGB(28,29,28)
            rather than true black. So the rail is masked explicitly instead,
            with an opaque panel the same width as the pane
            (CompactPaneLength, 68px). It stays fully opaque, because
            translucency is what let the streaks through in the first place,
            but it is tinted to the app's own surface (#10150F, the same
            matte colour as the caption band) rather than pure black, so the rail reads as
            part of the tool instead of a black bar bolted to the side.
            Being a sibling placed after the backdrop
            but before the nav shell, it covers the backdrop in the rail column
            and nothing else, and it needs no cooperation from WinUI theming.

            Transparent remains correct everywhere else: page content keeps the
            live backdrop, and a material backdrop still shows when selected.
        -->
        <Border
            x:Name="NavRailMask"
            Grid.Row="0"
            Grid.RowSpan="2"
            Width="76"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Background="{ThemeResource KaliteChromeSurfaceBrush}"
            IsHitTestVisible="False" />

        <TitleBar x:Name="titleBar" FontFamily="{StaticResource KaliteFontFamily}" />

        <!--
            OPAQUE CAPTION MASK. The TitleBar control paints its default
            translucent chrome, and the window's backdrop material shows
            through the caption area as a washed band lighter than the page.
            Both read as an off-coloured top strip. This mask paints the whole
            caption band with the same matte surface as the nav rail
            (#10150F), so rail + title bar form one coherent L of chrome.
            The band the window material paints runs 12-16px DEEPER than the
            TitleBar row, so the mask overhangs the row with a negative bottom
            margin (an explicit Height instead would grow the Auto row and drag
            the band down with it - verified). The overflow sits UNDER NavShell
            (earlier sibling), so page content renders on top of it.
            It sits AFTER the TitleBar so it wins the z-order, and the TitleBar
            is currently content-less (drag region + caption buttons are
            native), so nothing visible is covered. Keep it that way: if the
            TitleBar ever grows content (search box, back button), paint that
            content ABOVE this mask.
        -->
        <Border
            x:Name="TopBarMask"
            Grid.Row="0"
            Margin="0,0,0,-16"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{ThemeResource KaliteChromeSurfaceBrush}"
            IsHitTestVisible="False" />

        <!-- Store-style shell: 76px rail + shared animated selection pill. -->
        <Grid x:Name="NavShell" Grid.Row="1">
            <Grid.Transitions>
                <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="-40" />
                </TransitionCollection>
            </Grid.Transitions>

        <NavigationView
            x:Name="NavView"
            UseLayoutRounding="True"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="76"
            CompactPaneLength="76"
            IsPaneOpen="True"
            SelectionChanged="NavView_SelectionChanged">
            
            <NavigationView.Resources>
                <!-- Keep the rail on WinUI's Segoe face even when the app font
                     preference is a decorative serif. NavigationViewItem's theme
                     style reads ContentControlThemeFontFamily; the empty scoped
                     TextBlock style prevents App.xaml's global serif setter from
                     overriding inherited rail text fonts. -->
                <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable</FontFamily>
                <!-- Explicit keyed label style prevents App.xaml's implicit TextBlock
                     style from stamping the decorative app font onto this caption. -->
                <Style x:Key="RailLabelTextBlockStyle" TargetType="TextBlock" />

                <!--
                    The side rail is deliberately OPAQUE. The meteor backdrop is a
                    window-level element that paints behind everything, so a
                    transparent pane let the streaks drift down the nav list and
                    through the icon labels, which read as smearing. Pure black
                    keeps the rail clean and makes the rail/content edge crisp.

                    The rest of the NavigationView stays transparent so the
                    backdrop is still visible behind page content.
                -->
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource KaliteChromeSurfaceColor}" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource KaliteChromeSurfaceColor}" />

                <!--
                    Beyond NavigationViewBackground/ContentBackground, we also need to
                    give the compact rail's item chrome its own surface fill, because
                    NavigationViewItem icons live inside the pane region and a pane-
                    level background inversion does not always reach per-item hover/
                    selection brushes on every theme. This is a separate, local override
                    for that item chrome only.
                -->
                <SolidColorBrush x:Key="NavigationViewBackground" Color="{ThemeResource KaliteChromeSurfaceColor}" />
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
                <!--
                    ITEM STATE CHROME LIVES IN RailNavItemStyle NOW.

                    The control template above paints hover/pressed/selected itself
                    from theme brushes, so none of the NavigationViewItem*Background
                    overrides are read any more. They used to be declared here - and
                    three of them assigned a *Brush* (AccentFillColorDefaultBrush) to
                    SolidColorBrush.Color, which is a type mismatch the XAML loader
                    rejects at parse time. They are gone rather than "fixed": the
                    template is the single source of truth for item colour.

                    ItemBackground stays only so a generated container can never
                    paint over the template's own rounded plate.
                -->
                <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />

                <!-- Rail highlight plates: explicit white-alpha fills, lighter than WinUI's
                     ControlFill brushes. Selected ~30%, hover ~22%, pressed ~18% - all Opacity 1. -->
                <SolidColorBrush x:Key="RailHighlightSelectedBrush" Color="#4DFFFFFF" />
                <SolidColorBrush x:Key="RailHighlightHoverBrush" Color="#38FFFFFF" />
                <SolidColorBrush x:Key="RailHighlightPressedBrush" Color="#2EFFFFFF" />

                <Style x:Key="RailNavItemStyle" TargetType="NavigationViewItem">
                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                    <Setter Property="Width" Value="60" />
                    <Setter Property="Height" Value="56" />
                    <Setter Property="Margin" Value="0,4" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="NavigationViewItem">
                                <Grid x:Name="LayoutRoot" Background="Transparent" Width="60" Height="56">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                                <!-- Smooth cross-fade between idle/hover/pressed/selected
                                                     instead of an instant snap. -->
                                                <VisualTransition GeneratedDuration="0:0:0.12">
                                                    <VisualTransition.GeneratedEasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </VisualTransition.GeneratedEasingFunction>
                                                </VisualTransition>
                                            </VisualStateGroup.Transitions>
                                            <!-- Idle: unselected items carry no background at all. -->
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Target="ItemBody.Background" Value="Transparent"/>
                                                    <Setter Target="ItemBody.Opacity" Value="0"/>
                                                    <Setter Target="IconPresenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <Setter Target="ItemLabel.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <!-- Hover: lighter control fill, dialled back. -->
                                                    <Setter Target="ItemBody.Background" Value="{StaticResource RailHighlightHoverBrush}"/>
                                                    <Setter Target="ItemBody.Opacity" Value="1"/>
                                                    <Setter Target="IconPresenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <Setter Target="ItemLabel.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="ItemBody.Background" Value="{StaticResource RailHighlightPressedBrush}"/>
                                                    <Setter Target="ItemBody.Opacity" Value="1"/>
                                                    <Setter Target="IconPresenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <Setter Target="ItemLabel.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <!-- Selected icon pop runs from code-behind
                                                 the moment the pointer hovers (state leaves
                                                 Selected for PointerOverSelected). -->
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Target="ItemBody.Background" Value="{StaticResource RailHighlightSelectedBrush}"/>
                                                    <Setter Target="ItemBody.Opacity" Value="1"/>
                                                    <Setter Target="IconPresenter.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                    <Setter Target="ItemLabel.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PointerOverSelected">
                                                <VisualState.Setters>
                                                    <Setter Target="ItemBody.Background" Value="{StaticResource RailHighlightSelectedBrush}"/>
                                                    <Setter Target="ItemBody.Opacity" Value="1"/>
                                                    <Setter Target="IconPresenter.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                    <Setter Target="ItemLabel.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <!-- Selection must stay legible while pressed, so this
                                                 keeps the selection plate instead of dropping to the
                                                 unselected pressed colour. -->
                                            <VisualState x:Name="PressedSelected">
                                                <VisualState.Setters>
                                                    <Setter Target="ItemBody.Background" Value="{StaticResource RailHighlightSelectedBrush}"/>
                                                    <Setter Target="ItemBody.Opacity" Value="1"/>
                                                    <Setter Target="IconPresenter.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                    <Setter Target="ItemLabel.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                    <!-- Neutral selected/hover plate fills the fixed cell. Squarish 4px radius: still rounded, matches KaliteControlRadius. -->
                                    <Border x:Name="ItemBody"
                                            Margin="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            CornerRadius="4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Opacity="0" />

                                    <!--
                                        ICON OVER CAPTION, both centred in a fixed 60×56 cell;
                                        the 21px icon and 12px one-line label never resize it.

                                    -->
                                    <StackPanel x:Name="ItemStack"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <ContentPresenter x:Name="IconPresenter"
                                                          Content="{TemplateBinding Icon}"
                                                          Width="21"
                                                          Height="21"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <!-- Caption, not a ContentPresenter: Content is a plain
                                             string on every rail item, so it binds straight to
                                             Text. MaxLines + ellipsis keep a long label from
                                             widening or wrapping the fixed row. -->
                                        <TextBlock x:Name="ItemLabel"
                                                   Style="{StaticResource RailLabelTextBlockStyle}"
                                                   Text="{TemplateBinding Content}"
                                                   Width="56"
                                                   FontSize="12"
                                                   TextAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </NavigationView.Resources>
            
            <NavigationView.MenuItems>
                <NavigationViewItem Style="{StaticResource RailNavItemStyle}" Content="Apps" Tag="AppsPage" AutomationProperties.Name="App Manager" Margin="0" Padding="0">
                    <ToolTipService.ToolTip>
                        <ToolTip Visibility="Collapsed" />
                    </ToolTipService.ToolTip>
                    <NavigationViewItem.Icon>
