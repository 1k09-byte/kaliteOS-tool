                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                
                <NavigationViewItem Style="{StaticResource RailNavItemStyle}" Content="Graphics" Tag="GraphicsPage" AutomationProperties.Name="Graphics Control" Margin="0" Padding="0">
                    <ToolTipService.ToolTip>
                        <ToolTip Visibility="Collapsed" />
                    </ToolTipService.ToolTip>
                    <NavigationViewItem.Icon>
                        <!-- Fluent System Icons, Desktop 20 Filled (monitor = display/GPU drivers). -->
                        <PathIcon Data="M3.5 2C2.67157 2 2 2.67157 2 3.5V13.5C2 14.3284 2.67157 15 3.5 15H7V17H5.5C5.22386 17 5 17.2239 5 17.5C5 17.7761 5.22386 18 5.5 18H14.5C14.7761 18 15 17.7761 15 17.5C15 17.2239 14.7761 17 14.5 17H13V15H16.5C17.3284 15 18 14.3284 18 13.5V3.5C18 2.67157 17.3284 2 16.5 2H3.5ZM12 15V17H8V15H12Z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Style="{StaticResource RailNavItemStyle}" Content="Affinity" Tag="GamingPage" AutomationProperties.Name="Process Affinity" Margin="0" Padding="0">
                    <ToolTipService.ToolTip>
                        <ToolTip Visibility="Collapsed" />
                    </ToolTipService.ToolTip>
                    <NavigationViewItem.Icon>
                        <!-- Fluent System Icons, Pulse 20 Filled (tuning/monitoring). -->
                        <PathIcon Data="M7.00956 3.00006C7.34232 3.0043 7.63249 3.22731 7.72222 3.54778L10.5432 13.6226L12.7848 6.52415C12.8792 6.22514 13.1497 6.01644 13.4629 6.00092C13.7761 5.9854 14.0658 6.16635 14.1894 6.45456L15.4945 9.5H17.25C17.6642 9.5 18 9.83579 18 10.25C18 10.6642 17.6642 11 17.25 11H15C14.7 11 14.4288 10.8212 14.3106 10.5454L13.6067 8.90283L11.2152 16.4758C11.1153 16.7922 10.8194 17.0054 10.4877 16.9999C10.156 16.9944 9.86723 16.7717 9.77778 16.4522L6.96609 6.41048L5.71683 10.4706C5.62001 10.7853 5.32925 11 5 11H2.75C2.33579 11 2 10.6642 2 10.25C2 9.83579 2.33579 9.5 2.75 9.5H4.44607L6.28317 3.52944C6.38103 3.21136 6.6768 2.99582 7.00956 3.00006Z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Style="{StaticResource RailNavItemStyle}" Content="PRC" Tag="ThreadTunerPage" AutomationProperties.Name="Process Control" Margin="0" Padding="0">
                    <ToolTipService.ToolTip>
                        <ToolTip Visibility="Collapsed" />
                    </ToolTipService.ToolTip>
                    <NavigationViewItem.Icon>
                        <!-- Fluent System Icons, Branch 20 Filled. -->
                        <PathIcon Data="M5.5 2C6.88071 2 8 3.11929 8 4.5V6H13.5C14.3644 6 15.1118 6.49525 15.5413 7.21041L15.65 7.4243L17.8184 12.0125C17.9352 12.2596 18.0002 12.5293 18.0002 12.8055C18.0028 13.9213 17.1517 14.8569 16.0353 14.9926L15.8053 15C14.7061 15 13.8052 14.1083 13.8052 13.003L13.8043 12.84L12.0002 9V15.5C12.0002 16.8285 10.963 17.9157 9.65487 17.9947L9.50025 18C8.16335 18 7.06877 16.9535 7.00551 15.6322L7.00025 15.5V8H5.5C4.16335 8 3.06877 6.95353 3.00551 5.63222L3 5.5C3 4.16335 4.04647 3.06877 5.36778 3.00551L5.5 3H5.50025V4.5H7.00025V6H5.5C5.4673 6 5.4349 6.00122 5.40284 6.00363L5.35086 6.00977C5.16104 6.03756 5.09351 6.05929 5.03554 6.08272C4.54589 6.28183 4.15615 6.64303 3.93175 7.10304C3.89679 7.17466 3.86438 7.26629 3.84443 7.33088C3.82092 7.40698 3.80216 7.47895 3.79133 7.55013H4C4 7.55013 4 7.50536 4.00412 7.4586C4.019 7.28976 4.08486 7.02692 4.25056 6.78443L4.31688 6.69537C4.59473 6.34568 5.00696 6.09675 5.51865 6.00025H7C7.51169 6.09675 7.92392 6.34568 8.20177 6.69537L8.26809 6.78443C8.42398 6.99839 8.5 7.22941 8.5 7.5H4C4 7.77614 4.22386 8 4.5 8H8.5C8.77614 8 9 7.77614 9 7.5C9 7.22941 8.92398 6.99839 8.76809 6.78443L8.70177 6.69537C8.42392 6.34568 8.01169 6.09675 7.50025 6H8C9.32854 6 10.4157 7.03703 10.4947 8.34513L10.5 8.5V11H12.5C12.7761 11 13 11.2239 13 11.5C13 11.7294 12.8368 11.9213 12.6176 11.9806L12.55 12H10.5V14.5C10.5 14.7761 10.2239 15 9.95 15C9.72064 15 9.52874 14.8368 9.46939 14.6176L9.45 14.55V8C9.45 6.67157 10.487 5.5843 11.7951 5.5053L11.95 5.5H13.5C14.0006 5.5 14.4552 5.68819 14.8 5.99222L14.8872 6.08253C14.949 6.15545 15.006 6.23358 15.0577 6.31681L15.1106 6.40698L17.279 10.9951C17.3496 11.1444 17.3912 11.3093 17.4243 11.4883L17.4398 11.5834L17.4492 11.6997C17.4497 12.28 16.9956 12.7607 16.4253 12.8258L16.3353 12.833L16.1453 12.8355C15.5458 12.8355 15.0506 12.3734 15.0258 11.7828L15.0243 11.6669V8.50025H13.5002C13.2241 8.50025 13.0002 8.72411 13.0002 9.00025V13.003L13.0016 13.11C13.0416 13.5519 13.4111 13.8824 13.8