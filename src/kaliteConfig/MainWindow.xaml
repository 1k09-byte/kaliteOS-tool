                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Style="{StaticResource RailNavItemStyle}" Content="BIOS" Tag="BiosManagerPage" AutomationProperties.Name="BIOS Control" Margin="0" Padding="0">
                    <ToolTipService.ToolTip>
