<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="kaliteConfig.Controls.ThreadListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:kaliteConfig.Controls"
    Title="Threads"
    CloseButtonText="Close"
    DefaultButton="Close"
    CornerRadius="12">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1020</x:Double>
    </ContentDialog.Resources>

    <Grid Width="920" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Thread list -->
        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="HeaderText" Grid.Row="0" Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <ListView x:Name="ThreadList" Grid.Row="1" MaxHeight="480" SelectionMode="Single"
                      SelectionChanged="ThreadList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="controls:ThreadRow">
                        <Grid ColumnSpacing="8" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE718;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      VerticalAlignment="Center" Visibility="{x:Bind IsNamed, Mode=OneWay}"
                                      ToolTipService.ToolTip="Named thread - pinned to top" />
                            <CheckBox Grid.Column="1" IsChecked="{x:Bind BoostAllowed, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Priority boost" VerticalAlignment="Center" MinWidth="32" Checked="BoostBox_Checked" Unchecked="BoostBox_Unchecked" />
                            <StackPanel Grid.Column="2" Spacing="1">
                            <TextBlock FontSize="13" FontWeight="SemiBold">
                                <Run Text="TID " /><Run Text="{x:Bind Tid}" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind CurrentText, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Description}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button Grid.Row="2" Content="Refresh list" Click="RefreshButton_Click" HorizontalAlignment="Left" />
        </Grid>

        <!-- Per-thread editor -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="540">
            <StackPanel Spacing="10">
                <TextBlock Text="Select a thread to inspect and tune it." FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           x:Name="NoSelectionText" />
                <StackPanel Spacing="10" x:Name="EditorPanel" Visibility="Collapsed">
                    <TextBlock x:Name="EditorTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="EditorSub" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    <TextBlock Text="Thread priority" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="PriorityCurrent" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="PriorityCombo" Width="220" HorizontalAlignment="Left" PlaceholderText="Select priority…" SelectionChanged="PriorityCombo_SelectionChanged">
                        <ComboBoxItem Content="Idle (-15)" Tag="-15" />
                        <ComboBoxItem Content="Lowest (-2)" Tag="-2" />
                        <ComboBoxItem Content="Below normal (-1)" Tag="-1" />
                        <ComboBoxItem Content="Normal (0)" Tag="0" />
                        <ComboBoxItem Content="Above normal (+1)" Tag="1" />
                        <ComboBoxItem Content="Highest (+2)" Tag="2" />
                        <ComboBoxItem Content="Time critical (+15)" Tag="15" />
                    </ComboBox>

                    <ToggleSwitch x:Name="BoostToggle" Header="Priority boost" Toggled="BoostToggle_Toggled" ToolTipService.ToolTip="Priority boost - ON = allowed, OFF = off (persists across restarts)" />
                    <ToggleSwitch x:Name="EcoToggle" Header="Efficiency mode (EcoQoS)" Toggled="EcoToggle_Toggled" />

                    <TextBlock Text="CPU affinity - tick the CPUs this thread may run on" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="AffinityCurrent" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid x:Name="AffinityCpuGrid" ColumnSpacing="6" RowSpacing="6" />
                    <Button Content="Apply affinity" Click="AffinityApply_Click" HorizontalAlignment="Left" />

                    <TextBlock Text="Ideal processor - pick one preferred CPU the thread's affinity mask allows" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="IdealCurrent" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid x:Name="IdealCpuGrid" ColumnSpacing="6" RowSpacing="6" />
                    <Button Content="Apply ideal processor" Click="IdealApply_Click" HorizontalAlignment="Left" />

                    <Button Content="Make permanent (save as rule)" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="PermanentButton_Click"
                            ToolTipService.ToolTip="Saves priority, Eco, the ticked affinity CPUs and the picked ideal CPU as an auto-apply rule - no need to press Apply first; the rule also takes effect immediately" />

                    <TextBlock Text="Danger zone" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SuspendButton" Content="Suspend" Click="SuspendButton_Click" />
                        <Button x:Name="EndButton" Content="End thread" Click="EndButton_Click" />
                    </StackPanel>

                    <TextBlock x:Name="EditorStatusBox" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                    <TextBlock Text="Every control above maps to a documented Win32 thread API (SetThreadPriority, SetThreadPriorityBoost, SetThreadGroupAffinity, SetThreadIdealProcessorEx, SuspendThread, TerminateThread)." FontSize="11" Foreground="{ThemeResource TextFillColorDisabledBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
