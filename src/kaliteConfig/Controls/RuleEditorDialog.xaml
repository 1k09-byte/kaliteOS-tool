<ContentDialog
    x:Class="kaliteConfig.Controls.RuleEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:kaliteConfig.Models"
    Title="New rule"
    PrimaryButtonText="Apply"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="12"
    PrimaryButtonClick="Dialog_PrimaryClick">

    <ContentDialog.PrimaryButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </ContentDialog.PrimaryButtonStyle>
    <ContentDialog.CloseButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </ContentDialog.CloseButtonStyle>

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <Grid x:Name="Root" Width="1060" RowSpacing="8" KeyDown="Root_KeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Target + applies to -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Target process" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <AutoSuggestBox x:Name="TargetBox" PlaceholderText=""
                                    Text="{x:Bind Draft.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextChanged="TargetBox_TextChanged"
                                    SuggestionChosen="TargetBox_SuggestionChosen" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Applies to" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="AppliesBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="Always" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" Text="Tab accepts the highlighted suggestion" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Tabs -->
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="TabSettings" Grid.Column="0" Content="Process rules" HorizontalAlignment="Stretch" Click="Tab_Click" Tag="Settings" />
                <Button x:Name="TabThreads" Grid.Column="1" Content="Thread rules" HorizontalAlignment="Stretch" Click="Tab_Click" Tag="Threads" />
            </Grid>

            <!-- Process settings panel -->
            <StackPanel x:Name="SettingsPanel" Grid.Row="3" Spacing="8">
                <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Process priority" VerticalAlignment="Center"
                                  IsChecked="{x:Bind PriorityEnabled, Mode=TwoWay}" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ProcessPriorityNames, Mode=OneWay}"
                                  SelectedItem="{x:Bind PriorityName, Mode=TwoWay}"
                                  IsEnabled="{x:Bind PriorityEnabled, Mode=OneWay}" />
                    </Grid>
                </Border>
                <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Priority boost" VerticalAlignment="Center"
                                  IsChecked="{x:Bind BoostEnabled, Mode=TwoWay}" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ToggleNames, Mode=OneWay}"
                                  SelectedItem="{x:Bind BoostName, Mode=TwoWay}"
                                  IsEnabled="{x:Bind BoostEnabled, Mode=OneWay}" />
                    </Grid>
                </Border>
                <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Efficiency mode" VerticalAlignment="Center"
                                  IsChecked="{x:Bind EfficiencyEnabled, Mode=TwoWay}" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ToggleNames, Mode=OneWay}"
                                  SelectedItem="{x:Bind EfficiencyName, Mode=TwoWay}"
                                  IsEnabled="{x:Bind EfficiencyEnabled, Mode=OneWay}" />
                    </Grid>
                </Border>
                <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Automatic Gaming mode" VerticalAlignment="Center"
                                  IsChecked="{x:Bind GamingAutoChecked, Mode=TwoWay}"
                                  ToolTipService.ToolTip="{x:Bind AutomaticGamingModeTooltip, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind AutomaticGamingModeDescription, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
                <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Protect process threads" VerticalAlignment="Center"
                                  IsChecked="{x:Bind Draft.ProtectThreads, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Prevents Global Optimize from stripping priority boosts off this process's threads." />
                        <TextBlock Grid.Column="1" Text="Exclude this process from global priority boost stripping" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
                <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="CPU affinity" VerticalAlignment="Center"
                                  IsChecked="{x:Bind AffinityEnabled, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" x:Name="DraftAffinitySummaryText" Text="All logical processors" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                        <Button Grid.Column="2" x:Name="AffinityChooseButton" Content="Choose..." Click="AffinityChoose_Click" />
                    </Grid>
                </Border>
                <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="CPU Sets" VerticalAlignment="Center"
                                  IsChecked="{x:Bind CpuSetsEnabled, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" x:Name="CpuSetsSummaryText" Text="All logical processors" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                        <Button Grid.Column="2" x:Name="CpuSetsChooseButton" Content="Choose..." Click="CpuSetsChoose_Click" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Thread rules panel: same two-pane tuner as the Process tab's
                 Threads dialog (Image 2) - saved rules on the left, the same
                 per-thread editor on the right. A single saved rule (e.g. only
                 .NET Finalizer) shows just that one row on the left. -->
            <Grid x:Name="ThreadsPanel" Grid.Row="3" Visibility="Collapsed" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Thread rule list -->
                <Grid Grid.Column="0" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ThreadRulesHeaderText" Grid.Row="0" Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="No thread rules" />
                    <ListView x:Name="ThreadRulesList" Grid.Row="1" MaxHeight="420" SelectionMode="Single"
                              ItemsSource="{x:Bind Draft.ThreadRules, Mode=OneWay}"
                              SelectionChanged="ThreadRulesList_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="Margin" Value="0,2,8,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TunerThreadRule">
                                <Grid ColumnSpacing="8" Padding="0,6">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Delete rule" Click="ThreadRule_DeleteFlyout_Click" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE718;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" Visibility="{x:Bind NamedVis, Mode=OneWay}"
                                              ToolTipService.ToolTip="Named thread - pinned to top" />
                                    <CheckBox Grid.Column="1" IsChecked="{x:Bind BoostEnabled, Mode=TwoWay}"
                                              ToolTipService.ToolTip="Priority boost" VerticalAlignment="Center" MinWidth="32" Click="RuleBoostBox_Click" />
                                    <StackPanel Grid.Column="2" Spacing="1">
                                        <TextBlock Text="{x:Bind TargetText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind PriorityText, Mode=OneWay}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind RuleIdText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Grid.Row="2" Content="Delete rule" Click="ThreadRule_DeleteButton_Click" HorizontalAlignment="Left" />
                </Grid>

                <!-- Per-thread-rule editor -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="480">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Select a thread rule to inspect and tune it." FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   x:Name="RuleNoSelectionText" />
                        <StackPanel Spacing="10" x:Name="RuleEditorPanel" Visibility="Collapsed">
                            <TextBlock x:Name="RuleEditorTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="RuleEditorSub" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                            <TextBlock Text="Thread priority" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="RulePriorityCurrent" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="RulePriorityCombo" Width="220" HorizontalAlignment="Left" PlaceholderText="Select priority…" SelectionChanged="RulePriorityCombo_SelectionChanged">
                                <ComboBoxItem Content="Idle (-15)" Tag="-15" />
                                <ComboBoxItem Content="Lowest (-2)" Tag="-2" />
                                <ComboBoxItem Content="Below normal (-1)" Tag="-1" />
                                <ComboBoxItem Content="Normal (0)" Tag="0" />
                                <ComboBoxItem Content="Above normal (+1)" Tag="1" />
                                <ComboBoxItem Content="Highest (+2)" Tag="2" />
                                <ComboBoxItem Content="Time critical (+15)" Tag="15" />
                            </ComboBox>

                            <ToggleSwitch x:Name="RuleBoostToggle" Header="Priority boost" Toggled="RuleBoostToggle_Toggled" ToolTipService.ToolTip="Priority boost - ON = allowed, OFF = off" />
                            <ToggleSwitch x:Name="RuleEcoToggle" Header="Efficiency mode (EcoQoS)" Toggled="RuleEcoToggle_Toggled" />

                            <TextBlock Text="CPU affinity - tick the CPUs this thread may run on" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="RuleAffinityCurrent" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <Grid x:Name="RuleAffinityCpuGrid" ColumnSpacing="6" RowSpacing="6" />
                            <Button Content="Apply affinity" Click="RuleAffinityApply_Click" HorizontalAlignment="Left" />

                            <TextBlock Text="Ideal processor - pick one preferred CPU the thread's affinity mask allows" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="RuleIdealCurrent" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <Grid x:Name="RuleIdealCpuGrid" ColumnSpacing="6" RowSpacing="6" />
                            <Button Content="Apply ideal processor" Click="RuleIdealApply_Click" HorizontalAlignment="Left" />

                            <Button Content="Delete rule" HorizontalAlignment="Left" Click="ThreadRule_DeleteButton_Click"
                                    ToolTipService.ToolTip="Remove this thread rule from the profile" />

                            <TextBlock x:Name="RuleEditorStatusBox" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Summary -->
            <Border Grid.Row="4" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <TextBlock x:Name="SummaryText" Text="0 process settings Â· 0 thread rules" Style="{StaticResource BodyTextBlockStyle}" />
            </Border>

            <TextBlock x:Name="ErrorText" Grid.Row="5" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />

            <TextBlock Grid.Row="6" Text="Esc closes Â· Ctrl+Enter applies" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </ScrollViewer>
</ContentDialog>
