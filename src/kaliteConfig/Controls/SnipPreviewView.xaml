<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="kaliteConfig.Controls.SnipPreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <UserControl.Resources>
        <Style x:Key="PreviewChromeButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style x:Key="PreviewBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="8"/>
        </Style>
    </UserControl.Resources>

    <!-- Input is handled here rather than on the Win2D control: a swap-chain child is not
         guaranteed to be hit-testable, so a CanvasControl can silently swallow drags.
         (Same reason the snip overlay handles input on its root panel.) -->
    <Grid x:Name="Root"
          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
          SizeChanged="Root_SizeChanged"
          PointerWheelChanged="Root_PointerWheelChanged"
          PointerPressed="Root_PointerPressed"
          PointerMoved="Root_PointerMoved"
          PointerReleased="Root_PointerReleased"
          PointerCaptureLost="Root_PointerCaptureLost"
          PointerCanceled="Root_PointerCanceled"
          DoubleTapped="Root_DoubleTapped">

        <canvas:CanvasControl x:Name="PreviewCanvas"
                              ClearColor="Transparent"
                              Draw="PreviewCanvas_Draw"
                              CreateResources="PreviewCanvas_CreateResources"/>

        <!-- What is on screen right now: 512 px preview, full resolution, or the real error -->
        <Border x:Name="StatusBadge" Style="{StaticResource PreviewBadgeStyle}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ProgressRing x:Name="BusyRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusLabel" FontSize="11" MaxWidth="320" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Protected/DRM captures are legitimately flat: warn, never hide -->
        <Border x:Name="BlankBadge" Style="{StaticResource PreviewBadgeStyle}"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#CC3A3A00" BorderThickness="0"
                Visibility="Collapsed" IsHitTestVisible="False"
                ToolTipService.ToolTip="Every pixel is identical. Protected or DRM content can legitimately capture as a flat frame.">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7BA;" FontSize="11" Foreground="#FFFFD24D"/>
                <TextBlock Text="Image looks blank" FontSize="11" Foreground="#FFFFD24D"/>
            </StackPanel>
        </Border>

        <Border x:Name="ZoomChrome" Style="{StaticResource PreviewBadgeStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Style="{StaticResource PreviewChromeButtonStyle}" Content="&#x2212;" Click="ZoomOut_Click"
                        ToolTipService.ToolTip="Zoom out (Ctrl+-)" AutomationProperties.Name="Zoom out"/>
                <Button Style="{StaticResource PreviewChromeButtonStyle}" Content="Fit" Click="ZoomFit_Click"
                        ToolTipService.ToolTip="Fit the whole image (Ctrl+0)" AutomationProperties.Name="Fit to window"/>
                <Button Style="{StaticResource PreviewChromeButtonStyle}" Content="100%" Click="ZoomActual_Click"
                        ToolTipService.ToolTip="Actual size: one image pixel per screen pixel (Ctrl+1)" AutomationProperties.Name="Actual size"/>
                <Button Style="{StaticResource PreviewChromeButtonStyle}" Content="+" Click="ZoomIn_Click"
                        ToolTipService.ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in"/>
                <TextBlock x:Name="ZoomLabel" Text="100%" MinWidth="52" TextAlignment="Center" FontSize="12"
                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
