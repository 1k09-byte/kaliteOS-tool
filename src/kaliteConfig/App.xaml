<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="kaliteConfig.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:kaliteConfig">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///DevWinUI/Themes/Generic.xaml" />
                <!-- Kalite matte design system. Merged AFTER the WinUI/DevWinUI
                     defaults so its tokens win: every page references these
                     brush names by key, so redefining them here re-skins the
                     whole app without touching a single page. -->
                <ResourceDictionary Source="ms-appx:///Themes/KaliteTheme.xaml" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- The Kalite identity is dark-only and matte (see Themes/KaliteTheme.xaml,
                 which defines Light/Dark/Default identically so the app looks the
                 same under any theme setting). The app forces ElementTheme.Dark in
                 code; these dictionaries exist so a light-mode system setting can
                 never wash the UI out. -->

            <!-- Other app resources here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
