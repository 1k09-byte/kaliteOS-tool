<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="KaliteChromeSurfaceColor">#FFF2F2F2</Color>
            <SolidColorBrush x:Key="KaliteChromeSurfaceBrush" Color="#FFF2F2F2" />
            <SolidColorBrush x:Key="RailHighlightSelectedBrush" Color="#40000000" />
            <SolidColorBrush x:Key="RailHighlightHoverBrush" Color="#30000000" />
            <SolidColorBrush x:Key="RailHighlightPressedBrush" Color="#26000000" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="Transparent" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="KaliteChromeSurfaceColor">#FF0A0A0A</Color>
            <SolidColorBrush x:Key="KaliteChromeSurfaceBrush" Color="#FF0A0A0A" />
            <SolidColorBrush x:Key="RailHighlightSelectedBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="RailHighlightHoverBrush" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="RailHighlightPressedBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="Transparent" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <Color x:Key="KaliteChromeSurfaceColor">#FF0A0A0A</Color>
            <SolidColorBrush x:Key="KaliteChromeSurfaceBrush" Color="#FF0A0A0A" />
            <SolidColorBrush x:Key="RailHighlightSelectedBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="RailHighlightHoverBrush" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="RailHighlightPressedBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <CornerRadius x:Key="KaliteRailPlateRadius">3</CornerRadius>

    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/UncialAntiqua-Regular.ttf#Uncial Antiqua</FontFamily>

    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
    <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />

                <Style x:Key="RailNavItemStyle" TargetType="NavigationViewItem">
                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                    <Setter Property="Width" Value="68" />
                    <Setter Property="Height" Value="56" />
                    <Setter Property="Margin" Value="0,2" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="NavigationViewItem">
                                <Grid x:Name="LayoutRoot" Background="Transparent" Width="68" Height="56">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualStateGroup.Transitions>
                                                <VisualTransition GeneratedDuration="0:0:0.09">
                                                    <VisualTransition.GeneratedEasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </VisualTransition.GeneratedEasingFunction>
                                                </VisualTransition>
                                            </VisualStateGroup.Transitions>

                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Target="ItemBody.Opacity" Value="0"/>
                                                    <Setter Target="SelectionPlate.Opacity" Value="0"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="ItemBody.Opacity" Value="1"/>
                                                    <Setter Target="SelectionPlate.Opacity" Value="0"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="ItemBody.Opacity" Value="0.82"/>
                                                    <Setter Target="SelectionPlate.Opacity" Value="0"/>
                                                </VisualState.Setters>
                                            </VisualState>

                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Target="ItemBody.Opacity" Value="0"/>
                                                    <Setter Target="SelectionPlate.Opacity" Value="1"/>
                                                    <Setter Target="IconPresenter.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                    <Setter Target="ItemLabel.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PointerOverSelected">
                                                <VisualState.Setters>
                                                    <Setter Target="ItemBody.Opacity" Value="1"/>
                                                    <Setter Target="SelectionPlate.Opacity" Value="1"/>
                                                    <Setter Target="IconPresenter.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                    <Setter Target="ItemLabel.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PressedSelected">
                                                <VisualState.Setters>
                                                    <Setter Target="ItemBody.Opacity" Value="0.82"/>
                                                    <Setter Target="SelectionPlate.Opacity" Value="1"/>
                                                    <Setter Target="IconPresenter.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                    <Setter Target="ItemLabel.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                    <Border x:Name="ItemBody"
                                            Margin="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            CornerRadius="{StaticResource KaliteRailPlateRadius}"
                                            Background="{ThemeResource RailHighlightHoverBrush}"
                                            BorderThickness="0"
                                            Opacity="0" />

                                    <Border x:Name="SelectionPlate"
                                            Margin="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            CornerRadius="{StaticResource KaliteRailPlateRadius}"
                                            Background="{ThemeResource RailHighlightSelectedBrush}"
                                            BorderThickness="0"
                                            Opacity="0" />

                                    <StackPanel x:Name="ItemStack"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="ItemShift" X="0" Y="0" />
                                        </StackPanel.RenderTransform>
                                        <Viewbox Width="20" Height="20"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Stretch="Uniform">
                                        <ContentPresenter x:Name="IconPresenter"
                                                          Content="{TemplateBinding Icon}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <ContentPresenter.RenderTransform>
                                                <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1" />
                                            </ContentPresenter.RenderTransform>
                                        </ContentPresenter>
                                        </Viewbox>

                                        <TextBlock x:Name="ItemLabel"
                                                   Text="{TemplateBinding Content}"
                                                   Width="64"
                                                   FontSize="10"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
</ResourceDictionary>
