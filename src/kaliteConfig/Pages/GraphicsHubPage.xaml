<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.GraphicsHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Background="Transparent" NavigationCacheMode="Required">

    <!-- Tab strip: a SelectorBar, not a top NavigationView. The top NavView
         always drew a faint divider rule under its tabs and its items stayed
         small; the SelectorBar takes 18px semibold tabs with generous padding
         and no rule underneath. Same tab-host pattern as InstallerPage. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar x:Name="ViewSelector" Grid.Row="0" Margin="40,28,40,4"
                     SelectionChanged="ViewSelector_SelectionChanged">
            <SelectorBarItem Tag="Drivers" Text="Drivers" IsSelected="True"
                             FontSize="18" FontWeight="SemiBold" Padding="24,10" />
            <SelectorBarItem Tag="Overclock" Text="Overclock"
                             FontSize="18" FontWeight="SemiBold" Padding="24,10" />
        </SelectorBar>

        <Frame x:Name="ContentFrame" Grid.Row="1">
            <Frame.ContentTransitions>
                <TransitionCollection>
                    <NavigationThemeTransition>
                        <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                            <EntranceNavigationTransitionInfo />
                        </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    </NavigationThemeTransition>
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>
    </Grid>
</Page>
