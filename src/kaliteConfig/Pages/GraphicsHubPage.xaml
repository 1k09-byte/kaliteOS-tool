<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.GraphicsHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d" Background="Transparent" NavigationCacheMode="Required">

    <Grid>
        <NavigationView x:Name="ViewSelector" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="ViewSelector_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Drivers" Tag="Drivers" />
                <NavigationViewItem Content="Overclock" Tag="Overclock" />
                <!-- The two vendor tabs are named and shown per vendor: NVIDIA's only
                     on a machine with an NVIDIA GPU, the Radeon one only with an AMD
                     GPU, both on a machine that has both. Set in code-behind, which
                     is also where the fallback content lives. -->
                <NavigationViewItem x:Name="NvidiaTab" Content="NVIDIA" Tag="NVIDIA" />
                <NavigationViewItem x:Name="RadeonTab" Content="Radeon" Tag="Radeon" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Page>
