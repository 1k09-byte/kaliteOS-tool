<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.GpuDriversPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:kaliteConfig.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:kaliteConfig.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="ToolbarComboStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="MinWidth" Value="176" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        </Style>
        <Style x:Key="DriverLogoStyle" TargetType="Border">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FactLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="FactValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="DriverScroll" Padding="36,8,36,32" VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

            <Border Style="{StaticResource GalleryCard}">
                <Grid ColumnSpacing="24" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Detected hardware" Style="{StaticResource GallerySectionTitle}" />
                        <TextBlock Text="{x:Bind ViewModel.DetectStatusText, Mode=OneWay}"
                                   Style="{StaticResource GalleryPageCaption}" />
                        <TextBlock Style="{StaticResource GalleryPageCaption}"
                                   Text="Pick the adapter type and driver channel, then refresh to compare installed and current versions." />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ComboBox x:Name="NotebookToggle" Style="{StaticResource ToolbarComboStyle}"
                                  SelectedIndex="{x:Bind ViewModel.NotebookGpuIndex, Mode=TwoWay}">
                            <x:String>Desktop GPU</x:String>
                            <x:String>Notebook GPU</x:String>
                        </ComboBox>
                        <ComboBox x:Name="StudioChannelToggle" Style="{StaticResource ToolbarComboStyle}"
                                  SelectedIndex="{x:Bind ViewModel.StudioChannelIndex, Mode=TwoWay}">
                            <x:String>Game Ready channel</x:String>
                            <x:String>Studio channel</x:String>
                        </ComboBox>
                        <Button VerticalAlignment="Center" Command="{x:Bind ViewModel.DetectGpusCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Re-detect" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.VisibleDrivers, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:GpuDriverItem">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

                            <Border Style="{StaticResource GalleryCard}" Padding="0">
                                <StackPanel>

                                    <Grid Padding="24,20" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource DriverLogoStyle}">
                                            <Image Source="{x:Bind local:GpuDriversPage.VendorIcon(Vendor), Mode=OneWay}"
                                                   Stretch="Uniform" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Vendor}" Style="{StaticResource GalleryMetaLabel}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind HardwareName}" FontSize="20" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border Style="{StaticResource GalleryPill}" Padding="8,2"
                                                    Visibility="{x:Bind PrimaryVis, Mode=OneWay}">
                                                <TextBlock Text="Primary" Style="{StaticResource BadgeTextStyle}" />
                                            </Border>
                                            <Border Style="{StaticResource GalleryPill}" Padding="8,2"
                                                    Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                    Visibility="{x:Bind SecondaryVis, Mode=OneWay}">
                                                <TextBlock Text="Secondary" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <Grid Padding="24,20" ColumnSpacing="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.3*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="Installed driver" Style="{StaticResource FactLabelStyle}" />
                                            <TextBlock Text="{x:Bind InstalledVersion, Mode=OneWay, TargetNullValue='-'}"
                                                       FontSize="26" FontWeight="SemiBold" />
                                            <Border Style="{StaticResource GalleryPill}" Padding="8,2"
                                                    HorizontalAlignment="Left" Margin="0,4,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontSize="11"
                                                              Glyph="{x:Bind StateGlyph, Mode=OneWay}"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}"
                                                               Style="{StaticResource BadgeTextStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="Latest available" Style="{StaticResource FactLabelStyle}" />
                                            <TextBlock Text="{x:Bind LatestVersion, Mode=OneWay, TargetNullValue='-'}"
                                                       FontSize="20" FontWeight="SemiBold"
                                                       Visibility="{x:Bind LatestVersionVis, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource GalleryMetaLabel}"
                                                       Text="Matches the installed build"
                                                       Visibility="{x:Bind local:GpuDriversPage.UpToDateVis(Status), Mode=OneWay}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="VRAM" Style="{StaticResource FactLabelStyle}" MinWidth="86" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind VramText}"
                                                           Style="{StaticResource FactValueStyle}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="GPU type" Style="{StaticResource FactLabelStyle}" MinWidth="86" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind GpuTypeText}"
                                                           Style="{StaticResource FactValueStyle}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Device type" Style="{StaticResource FactLabelStyle}" MinWidth="86" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind DeviceTypeText}"
                                                           Style="{StaticResource FactValueStyle}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            Visibility="{x:Bind local:GpuDriversPage.ProgressVis(Status), Mode=OneWay}" />

                                    <StackPanel Spacing="6" Padding="24,16"
                                                Visibility="{x:Bind local:GpuDriversPage.ProgressVis(Status), Mode=OneWay}">
                                        <ProgressBar Value="{x:Bind DownloadProgress, Mode=OneWay}"
                                                     Maximum="100"
                                                     IsIndeterminate="{x:Bind local:GpuDriversPage.InstallPhaseVis(Status), Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                   Style="{StaticResource GalleryMetaLabel}" />
                                    </StackPanel>

                                    <TextBlock Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                               Margin="24,0,24,8"
                                               FontSize="12"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind local:GpuDriversPage.ErrorVis(ErrorMessage), Mode=OneWay}" />

                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <Grid Padding="24,16" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Style="{StaticResource GalleryMetaLabel}"
                                                   Text="{x:Bind StatusText, Mode=OneWay}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                    HorizontalAlignment="Right">
                                            <Button Tag="{x:Bind}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    MinWidth="200"
                                                    Content="{x:Bind PrimaryActionText, Mode=OneWay}"
                                                    Visibility="{x:Bind local:GpuDriversPage.InstallBtnVis(Status, Vendor), Mode=OneWay}"
                                                    Click="DownloadInstallBtn_Click" />
                                            <Button Tag="{x:Bind}"
                                                    MinWidth="200"
                                                    Content="{x:Bind CheckActionText, Mode=OneWay}"
                                                    IsEnabled="{x:Bind IsCheckEnabled, Mode=OneWay}"
                                                    Visibility="{x:Bind local:GpuDriversPage.CheckBtnVis(Status, Vendor), Mode=OneWay}"
                                                    Click="CheckForUpdatesBtn_Click" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Expander Style="{StaticResource GalleryCardExpander}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      Visibility="{x:Bind local:GpuDriversPage.ToolsVis(Vendor), Mode=OneWay}">
                                <Expander.Header>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Advanced tools" Style="{StaticResource GallerySectionTitle}" />
                                        <TextBlock Style="{StaticResource GalleryMetaLabel}"
                                                   Text="Vendor utilities that work alongside the driver." />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Spacing="16" Padding="0,8,0,0">

                                    <StackPanel Spacing="8"
                                                Visibility="{x:Bind local:GpuDriversPage.AmdToolsVis(Vendor), Mode=OneWay}">
                                        <TextBlock Text="Radeon Software Slimmer" Style="{StaticResource FactValueStyle}" />
                                        <Button Tag="{x:Bind}"
                                                HorizontalAlignment="Left" MinWidth="280"
                                                Content="{x:Bind local:GpuDriversPage.SlimmerButtonText(IsSlimmerInstalled), Mode=OneWay}"
                                                IsEnabled="{x:Bind local:GpuDriversPage.SlimmerEnabled(IsSlimmerBusy), Mode=OneWay}"
                                                Click="OpenRadeonSlimmer_Click" />
                                        <ProgressBar Value="{x:Bind SlimmerProgress, Mode=OneWay}"
                                                     Maximum="100"
                                                     Visibility="{x:Bind local:GpuDriversPage.SlimmerProgressVis(SlimmerProgress), Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource GalleryMetaLabel}"
                                                   Text="Third-party utility (GPL-3.0) that removes bloat from Radeon Software. Downloaded from its GitHub page on first use; needs administrator rights." />
                                    </StackPanel>

                                    <StackPanel Spacing="8"
                                                Visibility="{x:Bind local:GpuDriversPage.NvidiaToolsVis(Vendor), Mode=OneWay}">
                                        <TextBlock Text="NVIDIA Profile Inspector" Style="{StaticResource FactValueStyle}" />
                                        <TextBlock Style="{StaticResource GalleryMetaLabel}"
                                                   Text="Edits the hidden driver profile database — useful for low-latency and frame-pacing tweaks the control panel does not expose." />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Open NVIDIA Profile Inspector" MinWidth="280"
                                                    Click="OpenNvidiaInspector_Click" />
                                            <Button Content="Apply OS default profile"
                                                    ToolTipService.ToolTip="Import global_profile.nip manually"
                                                    Click="ApplyNvidiaDefaultProfile_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
