<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:kaliteConfig"
    xmlns:pages="using:kaliteConfig.Pages"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Page.Resources>
        <!-- Consistent settings layout, cloned from WinUI-Gallery Pages/SettingsPage.xaml
             (see docs/GALLERY-REFERENCE.md section 3). -->
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="PageHeader"
            HorizontalAlignment="Stretch"
            Margin="36,24,36,0"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource KalitePageTitle}"
            Text="Settings" />
        <ScrollViewer
            Grid.Row="1"
            Padding="36,0,36,0"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                HorizontalAlignment="Stretch"
                Spacing="{StaticResource SettingsCardSpacing}">

                <!-- Consumer update banner (hidden unless a newer GitHub release exists).
                     Wired in code-behind only for the CONSUMER flavor - the full
                     flavor leaves Vm null and never checks, so this stays closed. -->
                <InfoBar Title="{x:Bind Vm.BannerTitle, Mode=OneWay}"
                         Message="{x:Bind Vm.Notes, Mode=OneWay}"
                         IsOpen="{x:Bind Vm.IsAvailable, Mode=OneWay}"
                         Severity="Informational"
                         IsClosable="True"
                         Margin="0,0,0,12">
                    <InfoBar.Content>
                        <StackPanel Spacing="8">
                            <ProgressBar Value="{x:Bind pages:SettingsPageBindings.UpdateProgressValue(Vm.DownloadPercent), Mode=OneWay}"
                                         IsIndeterminate="{x:Bind Vm.IsBusy, Mode=OneWay}"
                                         Visibility="{x:Bind Vm.ProgressVisibility, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{x:Bind Vm.PrimaryUpdateActionText, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        IsEnabled="{x:Bind Vm.CanUpdateNow, Mode=OneWay}"
                                        Click="UpdateNow_Click" />
                                <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>

                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="General" />

                <toolkit:SettingsCard
                    Description="Starts minimized to the system tray so thread rules keep applying"
                    Header="Start with Windows">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="startupToggle"
                        OffContent="Off"
                        OnContent="On"
                        Toggled="StartupToggle_Toggled" />
                </toolkit:SettingsCard>

                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Appearance" />

                <toolkit:SettingsCard
                    Description="Select which app theme to display"
                    Header="App theme">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="themeMode"
                        dev:ThemeServiceAttach.ThemeService="{x:Bind local:App.Current.ThemeService}"
                        Width="250"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="themeModeComboBox">
                        <ComboBoxItem Content="Use system setting" Tag="Default" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </toolkit:SettingsCard>


                <toolkit:SettingsCard
                    Description="Change the appearance of the backdrop material behind your app"
                    Header="Material">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE2B1;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="backdropMode"
                        dev:ThemeServiceAttach.ThemeService="{x:Bind local:App.Current.ThemeService}"
                        Width="250"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="backdropModeComboBox">
                        <ComboBoxItem Content="None" Tag="None" />
                        <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                        <ComboBoxItem Content="Acrylic Thin" Tag="AcrylicThin" />
                        <ComboBoxItem Content="Mica" Tag="Mica" />
                        <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                    </ComboBox>
                </toolkit:SettingsCard>

                <!--
                    Backdrop tint: a soft colour wash over the material. The
                    strength is capped (BackdropTint.MaxAlpha, ~63%) precisely so
                    the wash can never cover the material - the point of a tint is
                    that the backdrop still shows through it. The rail and caption
                    masks are opaque, so the tint never reaches the chrome either.
                -->
                <toolkit:SettingsCard
                    Description="Soft colour wash over the material. The material still shows through it - pick a colour, then set how strong it is."
                    Header="Backdrop tint">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <!-- Swatch doubles as the colour button: what you see is what the window is painted with. -->
                        <Button x:Name="TintColorButton"
                                Width="52"
                                Height="34"
                                Padding="0"
                                ToolTipService.ToolTip="Pick a tint colour">
                            <Button.Flyout>
                                <Flyout Opened="TintFlyout_Opened" Closed="TintFlyout_Closed">
                                    <ColorPicker
                                        x:Name="TintPicker"
                                        ColorSpectrumShape="Ring"
                                        Width="300"
                                        IsAlphaEnabled="False"
                                        IsAlphaSliderVisible="False"
                                        IsAlphaTextInputVisible="False"
                                        IsColorSpectrumVisible="True"
                                        IsColorSliderVisible="True"
                                        IsColorChannelTextInputVisible="True"
                                        IsHexInputVisible="True"
                                        ColorChanged="TintPicker_ColorChanged" />
                                </Flyout>
                            </Button.Flyout>
                            <Border x:Name="TintSwatch"
                                    Width="34"
                                    Height="20"
                                    CornerRadius="3"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" />
                        </Button>

                        <Button Content="Clear" Click="TintClear_Click" ToolTipService.ToolTip="Remove the tint" />

                        <StackPanel Spacing="0" VerticalAlignment="Center">
                            <TextBlock Text="Strength" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Slider x:Name="TintStrength"
                                    Width="130"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="1"
                                    ValueChanged="TintStrength_ValueChanged"
                                    ToolTipService.ToolTip="0% is no tint. Higher makes the wash stronger without ever hiding the material." />
                        </StackPanel>

                        <TextBlock x:Name="TintStrengthText" Width="40" VerticalAlignment="Center" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard
                    Description="Choose the typeface used for text across the app (Default is the standard Windows font)"
                    Header="App font">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8D2;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="fontMode"
                        Width="250"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="fontModeComboBox"
                        SelectionChanged="FontMode_SelectionChanged">
                        <ComboBoxItem Content="Default" Tag="Default" FontFamily="Segoe UI" />
                        <ComboBoxItem Content="Jim Nightshade" Tag="JimNightshade" FontFamily="ms-appx:///Assets/Fonts/JimNightshade-Regular.ttf#Jim Nightshade" />
                        <ComboBoxItem Content="Uncial Antiqua" Tag="UncialAntiqua" FontFamily="ms-appx:///Assets/Fonts/UncialAntiqua-Regular.ttf#Uncial Antiqua" />
                        <ComboBoxItem Content="Cormorant Garamond" Tag="CormorantGaramond" FontFamily="ms-appx:///Assets/Fonts/CormorantGaramond-Regular.ttf#Cormorant Garamond" />
                    </ComboBox>
                </toolkit:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>