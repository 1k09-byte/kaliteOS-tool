<Page
    x:Class="kaliteConfig.Pages.WindowsSettingsHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d" Background="Transparent" NavigationCacheMode="Disabled">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="28,16,28,0" Spacing="2">
            <TextBlock Text="Windows Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="System switches and the appearance of Windows, in one place."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <SelectorBar x:Name="HubBar" Grid.Row="1" Margin="28,8,28,4" HorizontalAlignment="Left"
                     SelectionChanged="HubBar_SelectionChanged">
            <SelectorBarItem x:Name="SystemTab" Text="System" IsSelected="True" />
            <SelectorBarItem x:Name="PersonalizationTab" Text="Personalization" />
        </SelectorBar>
        <ScrollViewer x:Name="SystemPanel" Grid.Row="2" Padding="28,8,28,20" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SettingsPanel" Spacing="8">
                <Border Style="{StaticResource CardBorder}" Padding="12">
                    <StackPanel Spacing="8">

                        <toolkit:SettingsCard x:Name="TimerExpCard" Header="Serialized timer expiration" Margin="0,0,0,2"><ToggleSwitch x:Name="TimerExpToggle" OffContent="Off" OnContent="On" Toggled="KernelToggle_Toggled" RightTapped="KernelToggle_RightTapped" Tag="TimerExpiration"/></toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Name="MmcssCard" Header="Multimedia Class Scheduler (MMCSS)"><ToggleSwitch x:Name="MmcssToggle" OffContent="Off" OnContent="On" Toggled="KernelToggle_Toggled" RightTapped="KernelToggle_RightTapped" Tag="MmcssStatus"/></toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Name="HibernateCard" Header="Hibernation" Description="Turning it off clears the hibernate flags and keeps fast startup off. Needs administrator rights."><ToggleSwitch x:Name="HibernateToggle" OffContent="Off" OnContent="On" Toggled="Hibernate_Toggled"/></toolkit:SettingsCard>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Security and virtualization" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="14,4,0,0" />
                        <toolkit:SettingsCard x:Name="VbsCard" Header="Virtualization-Based Security (VBS)"><ToggleSwitch x:Name="VbsToggle" OffContent="Off" OnContent="On" Toggled="KernelToggle_Toggled" RightTapped="KernelToggle_RightTapped" Tag="Vbs"/></toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Name="HvciCard" Header="Memory integrity (HVCI)"><ToggleSwitch x:Name="HvciToggle" OffContent="Off" OnContent="On" Toggled="KernelToggle_Toggled" RightTapped="KernelToggle_RightTapped" Tag="Hvci"/></toolkit:SettingsCard>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="GPU scheduling" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="14,4,0,0" />
                        <toolkit:SettingsCard x:Name="HagsCard" Header="Hardware-accelerated GPU scheduling (HAGS)"><ToggleSwitch x:Name="HagsToggle" OffContent="Off" OnContent="On" Toggled="KernelToggle_Toggled" RightTapped="KernelToggle_RightTapped" Tag="HwSchMode"/></toolkit:SettingsCard>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="12">
                    <StackPanel Spacing="8">
                        <toolkit:SettingsCard x:Name="SvcSplitCard" Header="Service host splitting threshold" Description="Reading…"><StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="SvcSplitBox" PlaceholderText="Select RAM size" SelectionChanged="SvcSplitBox_SelectionChanged" MinWidth="220"/><Button Content="Reset" Click="SvcSplitReset_Click"/></StackPanel></toolkit:SettingsCard>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="12">
                    <StackPanel Spacing="8"><TextBlock Text="Reserved CPU sets and processor placement are managed in their dedicated control surface." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><Frame x:Name="ReservedCpuSetsFrame" CacheSize="0" UseLayoutRounding="True">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition>
                                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                    <EntranceNavigationTransitionInfo />
                                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                            </NavigationThemeTransition>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame></StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Frame x:Name="PersonalizationFrame" Grid.Row="2" CacheSize="0" Visibility="Collapsed" />
    </Grid>
</Page>
