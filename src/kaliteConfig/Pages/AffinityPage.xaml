<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.AffinityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:kaliteConfig.Pages"
    xmlns:models="using:kaliteConfig.Models"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <Style x:Key="GroupHeaderButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="8,2" />
        </Style>

        <Style x:Key="DeviceRowButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0" />
        </Style>

        <Style x:Key="TableCellLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="TableCellValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <DataTemplate x:Key="AffinityTableRowTemplate" x:DataType="models:AffinityDeviceItem">
            <Button Style="{StaticResource DeviceRowButtonStyle}" Click="DeviceRow_Click" Tag="{x:Bind}">
                <Grid>
                    <Grid Padding="20,11" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.4*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                                       Text="{x:Bind Name}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind DeviceInstanceId}" />
                            <TextBlock Style="{StaticResource GalleryMetaLabel}" Text="{x:Bind CategoryLabel}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Style="{StaticResource TableCellValueStyle}"
                                   Text="{x:Bind MsiEnabledText, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TableCellValueStyle}"
                                   Text="{x:Bind MsiLimitText, Mode=OneWay}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TableCellValueStyle}"
                                   Text="{x:Bind MaxMsiLimitText, Mode=OneWay}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource TableCellValueStyle}"
                                   Text="{x:Bind DevicePolicyShort, Mode=OneWay}" />
                        <TextBlock Grid.Column="5" Style="{StaticResource TableCellValueStyle}"
                                   Text="{x:Bind DevicePriorityShort, Mode=OneWay}" />
                        <TextBlock Grid.Column="6" Style="{StaticResource TableCellValueStyle}"
                                   Text="{x:Bind AffinityText, Mode=OneWay}" />
                        <FontIcon Grid.Column="7" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="12" Width="12" VerticalAlignment="Center"
                                  Glyph="&#xE76C;"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>

                    <Border Height="1" VerticalAlignment="Bottom" Margin="20,0"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid" UseLayoutRounding="True">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Toolbar.(Grid.Row)" Value="1" />
                        <Setter Target="Toolbar.(Grid.Column)" Value="0" />
                        <Setter Target="Toolbar.HorizontalAlignment" Value="Left" />
                        <Setter Target="SummaryStrip.Orientation" Value="Vertical" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentDialog x:Name="DeviceDetailsDialog"
                       Grid.RowSpan="3"
                       Style="{StaticResource DefaultContentDialogStyle}"
                       Title="{x:Null}"
                       PrimaryButtonText=""
                       CloseButtonText="">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">1180</x:Double>
                <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
            </ContentDialog.Resources>
            <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <StackPanel Spacing="12" MinWidth="720">

                    <Border Style="{StaticResource GalleryCard}" Padding="20,16">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="8"
                                    VerticalAlignment="Center">
                                <Image Stretch="Uniform"
                                       Source="{x:Bind local:AffinityPage.VendorIcon(ViewModel.SelectedDevice.Name), Mode=OneWay, FallbackValue={x:Null}}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource GallerySectionTitle}"
                                           Text="{x:Bind ViewModel.SelectedDevice.Name, Mode=OneWay, FallbackValue=''}"
                                           TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource GalleryMetaLabel}"
                                           Text="{x:Bind ViewModel.SelectedDevice.CategoryLabel, Mode=OneWay, FallbackValue=''}" />
                                <TextBlock FontFamily="Cascadia Mono" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Text="{x:Bind ViewModel.SelectedDevice.DeviceInstanceId, Mode=OneWay, FallbackValue=''}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource GalleryCard}">
                        <StackPanel Spacing="16">
                            <TextBlock Style="{StaticResource GallerySectionTitle}" Text="MSI settings" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="MSI mode" />
                                    <TextBlock Style="{StaticResource GalleryMetaLabel}"
                                               Text="Message-signaled interrupts cut CPU overhead compared with legacy line-based IRQs." />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              OnContent="Enabled" OffContent="Disabled"
                                              IsOn="{x:Bind ViewModel.SelectedDevice.MsiEnabled, Mode=TwoWay}" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="MSI limit" />
                                    <TextBlock Style="{StaticResource GalleryMetaLabel}"
                                               Text="Caps how many interrupts the device may raise. Lower values reduce DPC latency spikes; 0 means automatic." />
                                </StackPanel>
                                <NumberBox Grid.Column="1" Width="160" SpinButtonPlacementMode="Inline"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Value="{x:Bind ViewModel.SelectedDevice.MsiLimit, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="{x:Bind ViewModel.SelectedDevice.EffectiveMaxMsiLimit, Mode=OneWay}"
                                           IsEnabled="{x:Bind ViewModel.SelectedDevice.MsiEnabled, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GalleryCard}">
                        <StackPanel Spacing="16">
                            <TextBlock Style="{StaticResource GallerySectionTitle}" Text="Advanced policies" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Device priority" />
                                    <TextBlock Style="{StaticResource GalleryMetaLabel}"
                                               Text="How urgently this device's interrupts are serviced relative to other hardware." />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="260" VerticalAlignment="Center"
                                          ItemsSource="{x:Bind ViewModel.PriorityOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedDevice.SelectedPriority, Mode=TwoWay}" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Device policy" />
                                    <TextBlock Style="{StaticResource GalleryMetaLabel}"
                                               Text="Controls which processors are eligible to receive this device's interrupts." />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="260" VerticalAlignment="Center"
                                          ItemsSource="{x:Bind ViewModel.PolicyOptions, Mode=OneWay}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{x:Bind ViewModel.SelectedDevice.SelectedPolicy, Mode=TwoWay}"
                                          ToolTipService.ToolTip="{x:Bind ViewModel.SelectedDevice.SelectedPolicy, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Expander Style="{StaticResource GalleryCardExpander}"
                              IsExpanded="{x:Bind ViewModel.SelectedDevice.IsProcessorMaskExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Style="{StaticResource GallerySectionTitle}" Text="Processor mask" />
                                    <Border Style="{StaticResource GalleryPill}" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource GalleryMetaLabel}"
                                                   Text="{x:Bind ViewModel.SelectedDevice.SelectedThreadCountText, Mode=OneWay, FallbackValue=''}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource GalleryMetaLabel}"
                                           Text="Assign hardware interrupts to specific logical processors." />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Select all" Command="{x:Bind ViewModel.SelectAllThreadsCommand}" />
                                <Button Content="Clear" Command="{x:Bind ViewModel.ClearThreadsCommand}" />
                            </StackPanel>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedDevice.CoreGroups, Mode=OneWay}"
                                           HorizontalAlignment="Stretch">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MaximumRowsOrColumns="8" MinItemWidth="150"
                                                       MinColumnSpacing="8" MinRowSpacing="8"
                                                       Orientation="Horizontal" ItemsJustification="Start" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProcessorCoreGroup">
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8" Padding="10" BorderThickness="0">
                                            <StackPanel Spacing="6">
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           Text="{x:Bind Title}" />
                                                <ItemsRepeater ItemsSource="{x:Bind Threads}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="4" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ProcessorThreadItem">
                                                            <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Expander>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Cancel" Click="DialogCancel_Click" />
                        <Button Style="{ThemeResource AccentButtonStyle}" Content="Apply" Click="DialogApply_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <Grid Grid.Row="0" Padding="36,24,36,0" ColumnSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TitleBlock" Grid.Row="0" Grid.Column="0" Spacing="4">
                <TextBlock Text="Interrupts &amp; affinity" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <CommandBar x:Name="Toolbar" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                        DefaultLabelPosition="Right">
                <AppBarButton Icon="Refresh" Label="Rescan" Command="{x:Bind ViewModel.RefreshDevicesCommand}" />
                <AppBarButton Icon="Undo" Label="Undo" Command="{x:Bind ViewModel.UndoCommand}"
                              IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" />
                <AppBarButton Icon="Redo" Label="Redo" Command="{x:Bind ViewModel.RedoCommand}"
                              IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}" />
                <AppBarButton Icon="View" Label="{x:Bind ViewModel.ChangeCountText, Mode=OneWay}"
                              Click="ViewChanges_Click" />
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="Restore defaults" Icon="RepeatAll"
                                  Command="{x:Bind ViewModel.RestoreCommand}"
                                  IsEnabled="{x:Bind ViewModel.CanRestoreDefaults, Mode=OneWay}"
                                  ToolTipService.ToolTip="Set every device back to IrqPolicyMachineDefault with MSI Priority undefined, then restart them all." />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <StackPanel Grid.Row="1" Padding="36,12,36,0" Spacing="12">
            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind local:AffinityPage.BoolToVis(ViewModel.IsRefreshing), Mode=OneWay}" />
            <StackPanel x:Name="SummaryStrip" Orientation="Horizontal" Spacing="24">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.DeviceCountText, Mode=OneWay}"
                               Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Devices" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="tunable adapters found" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.MsiEnabledCountText, Mode=OneWay}"
                               Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="MSI enabled" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="devices using message-signaled interrupts" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.ChangeCountNumberText, Mode=OneWay}"
                               Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Changes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="edits you can undo this session" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
            <TextBlock Text="Every edit is written immediately and stays reversible until the app closes."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Padding="36,12,36,36"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">

                <Border Style="{StaticResource GalleryCard}" Padding="0">
                    <StackPanel>
                        <Grid Padding="28,16,28,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TableCellLabelStyle}" Text="Device" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TableCellLabelStyle}" Text="MSI" />
                            <TextBlock Grid.Column="2" Style="{StaticResource TableCellLabelStyle}" Text="Limit" />
                            <TextBlock Grid.Column="3" Style="{StaticResource TableCellLabelStyle}" Text="Max MSI" />
                            <TextBlock Grid.Column="4" Style="{StaticResource TableCellLabelStyle}" Text="Policy" />
                            <TextBlock Grid.Column="5" Style="{StaticResource TableCellLabelStyle}" Text="Priority" />
                            <TextBlock Grid.Column="6" Style="{StaticResource TableCellLabelStyle}" Text="Processors" />
                            <Border Grid.Column="7" Width="12" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="12,0" />

                        <Button Style="{StaticResource GroupHeaderButtonStyle}"
                                Command="{x:Bind ViewModel.ToggleGroupCommand}" CommandParameter="Graphics"
                                Visibility="{x:Bind local:AffinityPage.NonEmptyToVisibility(ViewModel.GraphicsDevices.Count), Mode=OneWay}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12"
                                          VerticalAlignment="Center"
                                          Glyph="{x:Bind local:AffinityPage.ExpanderGlyph(ViewModel.IsGraphicsExpanded), Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="Graphics cards" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Style="{StaticResource GalleryPill}" Padding="8,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource GalleryMetaLabel}"
                                               Text="{x:Bind local:AffinityPage.CountText(ViewModel.GraphicsDevices.Count), Mode=OneWay}" />
                                </Border>
                            </Grid>
                        </Button>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.GraphicsDevices, Mode=OneWay}"
                                       ItemTemplate="{StaticResource AffinityTableRowTemplate}"
                                       HorizontalAlignment="Stretch"
                                       Visibility="{x:Bind local:AffinityPage.BoolToVis(ViewModel.IsGraphicsExpanded), Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>

                        <Button Style="{StaticResource GroupHeaderButtonStyle}"
                                Command="{x:Bind ViewModel.ToggleGroupCommand}" CommandParameter="Network"
                                Visibility="{x:Bind local:AffinityPage.NonEmptyToVisibility(ViewModel.NetworkDevices.Count), Mode=OneWay}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12"
                                          VerticalAlignment="Center"
                                          Glyph="{x:Bind local:AffinityPage.ExpanderGlyph(ViewModel.IsNetworkExpanded), Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="Network controllers" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Style="{StaticResource GalleryPill}" Padding="8,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource GalleryMetaLabel}"
                                               Text="{x:Bind local:AffinityPage.CountText(ViewModel.NetworkDevices.Count), Mode=OneWay}" />
                                </Border>
                            </Grid>
                        </Button>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.NetworkDevices, Mode=OneWay}"
                                       ItemTemplate="{StaticResource AffinityTableRowTemplate}"
                                       HorizontalAlignment="Stretch"
                                       Visibility="{x:Bind local:AffinityPage.BoolToVis(ViewModel.IsNetworkExpanded), Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>

                        <Button Style="{StaticResource GroupHeaderButtonStyle}"
                                Command="{x:Bind ViewModel.ToggleGroupCommand}" CommandParameter="Usb"
                                Visibility="{x:Bind local:AffinityPage.NonEmptyToVisibility(ViewModel.UsbDevices.Count), Mode=OneWay}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12"
                                          VerticalAlignment="Center"
                                          Glyph="{x:Bind local:AffinityPage.ExpanderGlyph(ViewModel.IsUsbExpanded), Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="USB controllers" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Style="{StaticResource GalleryPill}" Padding="8,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource GalleryMetaLabel}"
                                               Text="{x:Bind local:AffinityPage.CountText(ViewModel.UsbDevices.Count), Mode=OneWay}" />
                                </Border>
                            </Grid>
                        </Button>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.UsbDevices, Mode=OneWay}"
                                       ItemTemplate="{StaticResource AffinityTableRowTemplate}"
                                       HorizontalAlignment="Stretch"
                                       Visibility="{x:Bind local:AffinityPage.BoolToVis(ViewModel.IsUsbExpanded), Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>

                        <Button Style="{StaticResource GroupHeaderButtonStyle}"
                                Command="{x:Bind ViewModel.ToggleGroupCommand}" CommandParameter="Audio"
                                Visibility="{x:Bind local:AffinityPage.NonEmptyToVisibility(ViewModel.AudioDevices.Count), Mode=OneWay}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12"
                                          VerticalAlignment="Center"
                                          Glyph="{x:Bind local:AffinityPage.ExpanderGlyph(ViewModel.IsAudioExpanded), Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="Audio controllers" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Style="{StaticResource GalleryPill}" Padding="8,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource GalleryMetaLabel}"
                                               Text="{x:Bind local:AffinityPage.CountText(ViewModel.AudioDevices.Count), Mode=OneWay}" />
                                </Border>
                            </Grid>
                        </Button>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.AudioDevices, Mode=OneWay}"
                                       ItemTemplate="{StaticResource AffinityTableRowTemplate}"
                                       HorizontalAlignment="Stretch"
                                       Visibility="{x:Bind local:AffinityPage.BoolToVis(ViewModel.IsAudioExpanded), Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GalleryCard}" Padding="20,16">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="18" VerticalAlignment="Top"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="What these settings do" Style="{StaticResource GallerySectionTitle}" />
                            <TextBlock Style="{StaticResource GalleryPageCaption}"
                                       Text="MSI replaces line-based interrupts with messages, which avoids shared IRQ contention. The limit caps in-flight messages; automatic lets Windows pick." />
