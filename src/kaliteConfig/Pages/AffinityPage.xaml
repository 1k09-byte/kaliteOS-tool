<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.AffinityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:kaliteConfig.Pages"
    xmlns:models="using:kaliteConfig.Models"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <Style x:Key="AffinityRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <GridLength x:Key="AffinityDeviceColumn">2.6*</GridLength>
        <GridLength x:Key="AffinityMsiColumn">0.85*</GridLength>
        <GridLength x:Key="AffinityLimitColumn">0.85*</GridLength>
        <GridLength x:Key="AffinityMaxMsiColumn">0.9*</GridLength>
        <GridLength x:Key="AffinityPolicyColumn">1.35*</GridLength>
        <GridLength x:Key="AffinityPriorityColumn">1.1*</GridLength>
        <GridLength x:Key="AffinityProcessorsColumn">1.4*</GridLength>
        <GridLength x:Key="AffinityChevronColumn">16</GridLength>

        <DataTemplate x:Key="AffinityDeviceRowTemplate" x:DataType="models:AffinityDeviceItem">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource AffinityDeviceColumn}" />
                    <ColumnDefinition Width="{StaticResource AffinityMsiColumn}" />
                    <ColumnDefinition Width="{StaticResource AffinityLimitColumn}" />
                    <ColumnDefinition Width="{StaticResource AffinityMaxMsiColumn}" />
                    <ColumnDefinition Width="{StaticResource AffinityPolicyColumn}" />
                    <ColumnDefinition Width="{StaticResource AffinityPriorityColumn}" />
                    <ColumnDefinition Width="{StaticResource AffinityProcessorsColumn}" />
                    <ColumnDefinition Width="{StaticResource AffinityChevronColumn}" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind DeviceInstanceId}" />
                    <TextBlock Text="{x:Bind CategoryLabel}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind MsiEnabledText, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{x:Bind MsiLimitText, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{x:Bind MaxMsiLimitText, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="{x:Bind DevicePolicyShort, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="5" Text="{x:Bind DevicePriorityShort, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="6" Text="{x:Bind AffinityText, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <FontIcon Grid.Column="7" Glyph="&#xE76C;"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AffinityDeviceRowNarrowTemplate" x:DataType="models:AffinityDeviceItem">
            <StackPanel Spacing="4">
                <StackPanel>
                    <TextBlock Text="{x:Bind Name}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="Wrap"
                               ToolTipService.ToolTip="{x:Bind DeviceInstanceId}" />
                    <TextBlock Text="{x:Bind CategoryLabel}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MSI"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind MsiEnabledText, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Limit"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind MsiLimitText, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Max MSI"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind MaxMsiLimitText, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Policy"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind DevicePolicyShort, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Priority"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind DevicePriorityShort, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Processors"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind AffinityText, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ChangeRowTemplate">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Device}"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{Binding Detail}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid" UseLayoutRounding="True">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Toolbar.(Grid.Row)" Value="1" />
                        <Setter Target="Toolbar.(Grid.Column)" Value="0" />
                        <Setter Target="Toolbar.HorizontalAlignment" Value="Left" />
                        <Setter Target="SummaryStrip.Orientation" Value="Vertical" />
                        <Setter Target="GraphicsList.ItemTemplate" Value="{StaticResource AffinityDeviceRowNarrowTemplate}" />
                        <Setter Target="NetworkList.ItemTemplate" Value="{StaticResource AffinityDeviceRowNarrowTemplate}" />
                        <Setter Target="UsbList.ItemTemplate" Value="{StaticResource AffinityDeviceRowNarrowTemplate}" />
                        <Setter Target="AudioList.ItemTemplate" Value="{StaticResource AffinityDeviceRowNarrowTemplate}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentDialog x:Name="DeviceDetailsDialog"
                       Grid.RowSpan="3"
                       Style="{StaticResource DefaultContentDialogStyle}"
                       Title="{x:Bind ViewModel.SelectedDevice.Name, Mode=OneWay, FallbackValue=''}"
                       PrimaryButtonText=""
                       CloseButtonText="">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">1180</x:Double>
                <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
            </ContentDialog.Resources>
            <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <StackPanel Spacing="24">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.SelectedDevice.CategoryLabel, Mode=OneWay, FallbackValue=''}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedDevice.DeviceInstanceId, Mode=OneWay, FallbackValue=''}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="16">
                        <TextBlock Text="MSI settings" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ToggleSwitch Header="MSI mode"
                                      OnContent="Enabled" OffContent="Disabled"
                                      IsOn="{x:Bind ViewModel.SelectedDevice.MsiEnabled, Mode=TwoWay}" />
                        <TextBlock Text="Message-signaled interrupts cut CPU overhead compared with legacy line-based IRQs."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <NumberBox Header="MSI limit"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{x:Bind ViewModel.SelectedDevice.MsiLimit, Mode=TwoWay}"
                                   Minimum="0"
                                   Maximum="{x:Bind ViewModel.SelectedDevice.EffectiveMaxMsiLimit, Mode=OneWay}"
                                   IsEnabled="{x:Bind ViewModel.SelectedDevice.MsiEnabled, Mode=OneWay}" />
                        <TextBlock Text="Caps how many interrupts the device may raise. Lower values reduce DPC latency spikes; 0 means automatic."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Max MSI"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedDevice.MaxMsiLimitText, Mode=OneWay, FallbackValue=''}"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="16">
                        <TextBlock Text="Advanced policies" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox Header="Device priority"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.PriorityOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDevice.SelectedPriority, Mode=TwoWay}" />
                        <TextBlock Text="How urgently this device's interrupts are serviced relative to other hardware."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <ComboBox Header="Device policy"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.PolicyOptions, Mode=OneWay}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{x:Bind ViewModel.SelectedDevice.SelectedPolicy, Mode=TwoWay}"
                                  ToolTipService.ToolTip="{x:Bind ViewModel.SelectedDevice.SelectedPolicy, Mode=OneWay}" />
                        <TextBlock Text="Controls which processors are eligible to receive this device's interrupts."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="16">
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  IsExpanded="{x:Bind ViewModel.SelectedDevice.IsProcessorMaskExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <StackPanel Spacing="0">
                                    <TextBlock Text="Processor mask" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedDevice.SelectedThreadCountText, Mode=OneWay, FallbackValue=''}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Select all" Command="{x:Bind ViewModel.SelectAllThreadsCommand}" />
                                    <Button Content="Clear" Command="{x:Bind ViewModel.ClearThreadsCommand}" />
                                </StackPanel>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedDevice.CoreGroups, Mode=OneWay}"
                                               HorizontalAlignment="Stretch">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MaximumRowsOrColumns="8" MinItemWidth="150"
                                                           MinColumnSpacing="8" MinRowSpacing="8"
                                                           Orientation="Horizontal" ItemsJustification="Start" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProcessorCoreGroup">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{x:Bind Title}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <ItemsRepeater ItemsSource="{x:Bind Threads}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="4" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ProcessorThreadItem">
                                                            <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="Assign hardware interrupts to specific logical processors."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Cancel" Click="DialogCancel_Click" />
                        <Button Style="{ThemeResource AccentButtonStyle}" Content="Apply" Click="DialogApply_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <Grid Grid.Row="0" Padding="36,24,36,0" ColumnSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TitleBlock" Grid.Row="0" Grid.Column="0" Spacing="4">
                <TextBlock Text="Interrupts &amp; affinity" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <CommandBar x:Name="Toolbar" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                        DefaultLabelPosition="Right">
                <AppBarButton Icon="Refresh" Label="Rescan" Command="{x:Bind ViewModel.RefreshDevicesCommand}" />
                <AppBarButton Icon="Undo" Label="Undo" Command="{x:Bind ViewModel.UndoCommand}"
                              IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" />
                <AppBarButton Icon="Redo" Label="Redo" Command="{x:Bind ViewModel.RedoCommand}"
                              IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}" />
                <AppBarButton Icon="View" Label="{x:Bind ViewModel.ChangeCountText, Mode=OneWay}"
                              Click="ViewChanges_Click" />
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="Restore defaults" Icon="RepeatAll"
                                  Command="{x:Bind ViewModel.RestoreCommand}"
                                  IsEnabled="{x:Bind ViewModel.CanRestoreDefaults, Mode=OneWay}"
                                  ToolTipService.ToolTip="Set every device back to IrqPolicyMachineDefault with MSI Priority undefined, then restart them all." />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <StackPanel Grid.Row="1" Padding="36,12,36,0" Spacing="12">
            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind local:AffinityPage.BoolToVis(ViewModel.IsRefreshing), Mode=OneWay}" />
            <StackPanel x:Name="SummaryStrip" Orientation="Horizontal" Spacing="24">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.DeviceCountText, Mode=OneWay}"
                               Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Devices" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="tunable adapters found" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.MsiEnabledCountText, Mode=OneWay}"
                               Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="MSI enabled" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="devices using message-signaled interrupts" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.ChangeCountNumberText, Mode=OneWay}"
                               Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Changes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="edits you can undo this session" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
            <TextBlock Text="Every edit is written immediately and stays reversible until the app closes."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Padding="36,12,36,36"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Stretch" Spacing="8">

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsExpanded="{x:Bind ViewModel.IsGraphicsExpanded, Mode=TwoWay}"
                          Visibility="{x:Bind local:AffinityPage.NonEmptyToVisibility(ViewModel.GraphicsDevices.Count), Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Graphics cards"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind local:AffinityPage.CountText(ViewModel.GraphicsDevices.Count), Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="4">
                        <Grid Padding="12,0,12,4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource AffinityDeviceColumn}" />
                                <ColumnDefinition Width="{StaticResource AffinityMsiColumn}" />
                                <ColumnDefinition Width="{StaticResource AffinityLimitColumn}" />
                                <ColumnDefinition Width="{StaticResource AffinityMaxMsiColumn}" />
                                <ColumnDefinition Width="{StaticResource AffinityPolicyColumn}" />
                                <ColumnDefinition Width="{StaticResource AffinityPriorityColumn}" />
                                <ColumnDefinition Width="{StaticResource AffinityProcessorsColumn}" />
                                <ColumnDefinition Width="{StaticResource AffinityChevronColumn}" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Device"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="MSI"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="Limit"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="Max MSI"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="4" Text="Policy"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="5" Text="Priority"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="6" Text="Processors"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ListView x:Name="GraphicsList"
                                  ItemsSource="{x:Bind ViewModel.GraphicsDevices, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="DeviceRow_ItemClick"
                                  ItemTemplate="{StaticResource AffinityDeviceRowTemplate}"
                                  ItemContainerStyle="{StaticResource AffinityRowContainerStyle}"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </StackPanel>
                </Expander>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsExpanded="{x:Bind ViewModel.IsNetworkExpanded, Mode=TwoWay}"
                          Visibility="{x:Bind local:AffinityPage.NonEmptyToVisibility(ViewModel.NetworkDevices.Count), Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Network controllers"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind local:AffinityPage.CountText(ViewModel.NetworkDevices.Count), Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="4">
                        <Grid Padding="12,0,12,4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource AffinityDeviceColumn}" />
                                <ColumnDefinition Width="{StaticResource AffinityMsiColumn}" />
                                <ColumnDefinition Width="{StaticResource AffinityLimitColumn}" />
                                <ColumnDefinition Width="{StaticResource AffinityMaxMsiColumn}" />
                                <ColumnDefinition Width="{StaticResource AffinityPolicyColumn}" />
                                <ColumnDefinition Width="{StaticResource AffinityPriorityColumn}" />
                                <ColumnDefinition Width="{StaticResource AffinityProcessorsColumn}" />
                                <ColumnDefinition Width="{StaticResource AffinityChevronColumn}" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Device"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="MSI"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="Limit"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="Max MSI"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="4" Text="Policy"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="5" Text="Priority"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="6" Text="Processors"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ListView x:Name="NetworkList"
                                  ItemsSource="{x:Bind ViewModel.NetworkDevices, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="DeviceRow_ItemClick"
                                  ItemTemplate="{StaticResource AffinityDeviceRowTemplate}"
                                  ItemContainerStyle="{StaticResource AffinityRowContainerStyle}"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </StackPanel>
                </Expander>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsExpanded="{x:Bind ViewModel.IsUsbExpanded, Mode=TwoWay}"
                          Visibility="{x:Bind local:AffinityPage.NonEmptyToVisibility(ViewModel.UsbDevices.Count), Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="USB controllers"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind local:AffinityPage.CountText(ViewModel.UsbDevices.Count), Mode=OneWay}"
