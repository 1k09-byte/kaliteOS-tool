<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.AffinityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:kaliteConfig.Pages"
    xmlns:models="using:kaliteConfig.Models"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <Style x:Key="AffinityRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <SolidColorBrush x:Key="AffinityRowHoverBrush" Color="#1EFFFFFF" />
        <SolidColorBrush x:Key="AffinityRowPressedBrush" Color="#19FFFFFF" />
        <Style x:Key="AffinityCardRowContainerStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource AffinityRowContainerStyle}">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Card"
                                Control.IsTemplateFocusTarget="True"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Card.Background" Value="{StaticResource AffinityRowHoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Card.Background" Value="{StaticResource AffinityRowPressedBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <GridLength x:Key="AffinityDeviceColumn">2.6*</GridLength>
        <GridLength x:Key="AffinityMsiColumn">1.0*</GridLength>
        <GridLength x:Key="AffinityLimitColumn">1.0*</GridLength>
        <GridLength x:Key="AffinityMaxMsiColumn">0.9*</GridLength>
        <GridLength x:Key="AffinityPolicyColumn">1.15*</GridLength>
        <GridLength x:Key="AffinityPriorityColumn">1.1*</GridLength>
        <GridLength x:Key="AffinityProcessorsColumn">1.15*</GridLength>
        <GridLength x:Key="AffinityChevronColumn">16</GridLength>

        <!-- Wide row: identity on the left, labelled value columns on the right. -->
        <DataTemplate x:Key="AffinityDeviceRowTemplate" x:DataType="models:AffinityDeviceItem">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource AffinityDeviceColumn}" />
                    <ColumnDefinition Width="{StaticResource AffinityMsiColumn}" />
                    <ColumnDefinition Width="{StaticResource AffinityLimitColumn}" />
                    <ColumnDefinition Width="{StaticResource AffinityPolicyColumn}" />
                    <ColumnDefinition Width="{StaticResource AffinityPriorityColumn}" />
                    <ColumnDefinition Width="{StaticResource AffinityProcessorsColumn}" />
                    <ColumnDefinition Width="{StaticResource AffinityChevronColumn}" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Name}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="WrapWholeWords"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind DeviceInstanceId}" />
                    <TextBlock Text="{x:Bind CategoryLabel}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="MSI" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind MsiEnabledText, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="Limit" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind MsiLimitText, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="max" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind MaxMsiLimitText, Mode=OneWay}" FontSize="10.5"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="Policy" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind DevicePolicyShort, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="Priority" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind DevicePriorityShort, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="Processors" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind AffinityText, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <FontIcon Grid.Column="6" Glyph="&#xE76C;"
                          FontSize="12"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AffinityDeviceRowNarrowTemplate" x:DataType="models:AffinityDeviceItem">
            <StackPanel Spacing="6">
                <StackPanel>
                    <TextBlock Text="{x:Bind Name}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="Wrap"
                               ToolTipService.ToolTip="{x:Bind DeviceInstanceId}" />
                    <TextBlock Text="{x:Bind CategoryLabel}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MSI" FontSize="11" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind MsiEnabledText, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Limit" FontSize="11" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind MsiLimitText, Mode=OneWay}"
                                   Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="max" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind MaxMsiLimitText, Mode=OneWay}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Policy" FontSize="11" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind DevicePolicyShort, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Priority" FontSize="11" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind DevicePriorityShort, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Processors" FontSize="11" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind AffinityText, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ChangeRowTemplate">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Device}"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{Binding Detail}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid" UseLayoutRounding="True">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Toolbar.(Grid.Row)" Value="1" />
                        <Setter Target="Toolbar.(Grid.Column)" Value="0" />
                        <Setter Target="Toolbar.HorizontalAlignment" Value="Left" />
                        <Setter Target="SummaryStrip.Orientation" Value="Vertical" />
                        <Setter Target="GraphicsList.ItemTemplate" Value="{StaticResource AffinityDeviceRowNarrowTemplate}" />
                        <Setter Target="NetworkList.ItemTemplate" Value="{StaticResource AffinityDeviceRowNarrowTemplate}" />
                        <Setter Target="UsbList.ItemTemplate" Value="{StaticResource AffinityDeviceRowNarrowTemplate}" />
                        <Setter Target="AudioList.ItemTemplate" Value="{StaticResource AffinityDeviceRowNarrowTemplate}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentDialog x:Name="DeviceDetailsDialog"
                       Grid.RowSpan="3"
                       Style="{StaticResource DefaultContentDialogStyle}"
                       Title="{x:Bind ViewModel.SelectedDevice.Name, Mode=OneWay, FallbackValue=''}"
                       PrimaryButtonText=""
                       CloseButtonText="">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">1180</x:Double>
                <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
            </ContentDialog.Resources>
            <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,12,0">
                <StackPanel Spacing="24" Padding="0,0,4,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.SelectedDevice.CategoryLabel, Mode=OneWay, FallbackValue=''}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedDevice.DeviceInstanceId, Mode=OneWay, FallbackValue=''}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="16">
                        <TextBlock Text="MSI settings" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ToggleSwitch Header="MSI mode"
                                      OnContent="Enabled" OffContent="Disabled"
                                      IsOn="{x:Bind ViewModel.SelectedDevice.MsiEnabled, Mode=TwoWay}" />
                        <TextBlock Text="Message-signaled interrupts cut CPU overhead compared with legacy line-based IRQs."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <NumberBox Header="MSI limit"
                                   HorizontalAlignment="Stretch"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{x:Bind ViewModel.SelectedDevice.MsiLimit, Mode=TwoWay}"
                                   Minimum="0"
                                   Maximum="{x:Bind ViewModel.SelectedDevice.EffectiveMaxMsiLimit, Mode=OneWay}"
                                   IsEnabled="{x:Bind ViewModel.SelectedDevice.MsiEnabled, Mode=OneWay}" />
                        <TextBlock Text="Caps how many interrupts the device may raise. Lower values reduce DPC latency spikes; 0 means automatic."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Max MSI"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedDevice.MaxMsiLimitText, Mode=OneWay, FallbackValue=''}"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="16">
                        <TextBlock Text="Advanced policies" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox Header="Device priority"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.PriorityOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDevice.SelectedPriority, Mode=TwoWay}" />
                        <TextBlock Text="How urgently this device's interrupts are serviced relative to other hardware."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <ComboBox Header="Device policy"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.PolicyOptions, Mode=OneWay}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{x:Bind ViewModel.SelectedDevice.SelectedPolicy, Mode=TwoWay}"
                                  ToolTipService.ToolTip="{x:Bind ViewModel.SelectedDevice.SelectedPolicy, Mode=OneWay}" />
                        <TextBlock Text="Controls which processors are eligible to receive this device's interrupts."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="8"
                                Visibility="{x:Bind local:AffinityPage.BoolToVis(ViewModel.SelectedDevice.IsNetwork), Mode=OneWay}">
                        <TextBlock Text="Receive Side Scaling (NDIS)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedDevice.RssText, Mode=OneWay, FallbackValue=''}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Network packet processing is steered by RSS, not by the IRQ mask alone. Applying a processor mask sets the RSS base processor and queue count, then restarts the adapter."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="16">
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  IsExpanded="{x:Bind ViewModel.SelectedDevice.IsProcessorMaskExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <StackPanel Spacing="0">
                                    <TextBlock Text="Processor mask" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedDevice.SelectedThreadCountText, Mode=OneWay, FallbackValue=''}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Select all" Command="{x:Bind ViewModel.SelectAllThreadsCommand}" />
                                    <Button Content="Clear" Command="{x:Bind ViewModel.ClearThreadsCommand}" />
                                </StackPanel>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedDevice.CoreGroups, Mode=OneWay}"
                                               HorizontalAlignment="Stretch">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MaximumRowsOrColumns="8" MinItemWidth="150"
                                                           MinColumnSpacing="8" MinRowSpacing="8"
                                                           Orientation="Horizontal" ItemsJustification="Start" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProcessorCoreGroup">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{x:Bind Title}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <ItemsRepeater ItemsSource="{x:Bind Threads}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="4" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ProcessorThreadItem">
                                                            <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="Assign hardware interrupts to specific logical processors."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Cancel" Click="DialogCancel_Click" />
                        <Button Style="{ThemeResource AccentButtonStyle}" Content="Apply" Click="DialogApply_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <!-- ── Header band ─────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Padding="28,20,28,0" ColumnSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TitleBlock" Grid.Row="0" Grid.Column="0" Spacing="2" VerticalAlignment="Bottom">
                <TextBlock Text="Interrupts &amp; affinity" Style="{StaticResource GalleryPageTitle}" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Style="{StaticResource GalleryPageCaption}" />
            </StackPanel>

            <CommandBar x:Name="Toolbar" Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom"
                        DefaultLabelPosition="Right" Background="Transparent">
                <AppBarButton Icon="Refresh" Label="Rescan" Command="{x:Bind ViewModel.RefreshDevicesCommand}" />
                <AppBarButton Icon="Undo" Label="Undo" Command="{x:Bind ViewModel.UndoCommand}"
                              IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" />
                <AppBarButton Icon="Redo" Label="Redo" Command="{x:Bind ViewModel.RedoCommand}"
                              IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}" />
                <AppBarButton Icon="View" Label="{x:Bind ViewModel.ChangeCountText, Mode=OneWay}"
                              Click="ViewChanges_Click" />
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="Restore defaults" Icon="RepeatAll"
                                  Command="{x:Bind ViewModel.RestoreCommand}"
                                  IsEnabled="{x:Bind ViewModel.CanRestoreDefaults, Mode=OneWay}"
                                  ToolTipService.ToolTip="Set every device back to IrqPolicyMachineDefault with MSI Priority undefined, then restart them all." />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <!-- ── Summary strip ───────────────────────────────────────────── -->
        <StackPanel Grid.Row="1" Padding="28,12,28,0" Spacing="8">
            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind local:AffinityPage.BoolToVis(ViewModel.IsRefreshing), Mode=OneWay}" />
            <StackPanel x:Name="SummaryStrip" Orientation="Horizontal" Spacing="10">
                <Border Style="{StaticResource GalleryCard}" Padding="16,10" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.DeviceCountText, Mode=OneWay}"
                                   Style="{StaticResource GalleryPageTitle}" FontSize="22" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="Devices" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="tunable adapters found" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GalleryCard}" Padding="16,10" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.MsiEnabledCountText, Mode=OneWay}"
                                   Style="{StaticResource GalleryPageTitle}" FontSize="22" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="MSI enabled" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="message-signaled interrupts" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GalleryCard}" Padding="16,10" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.ChangeCountNumberText, Mode=OneWay}"
                                   Style="{StaticResource GalleryPageTitle}" FontSize="22" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="Changes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="edits you can undo this session" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Text="Every edit is written immediately and stays reversible until the app closes."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- ── Device categories ───────────────────────────────────────── -->
        <ScrollViewer Grid.Row="2" Padding="28,12,28,20"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Stretch" Spacing="10">

                <Expander Style="{StaticResource GalleryCardExpander}"
                          IsExpanded="{x:Bind ViewModel.IsGraphicsExpanded, Mode=TwoWay}"
                          Visibility="{x:Bind local:AffinityPage.NonEmptyToVisibility(ViewModel.GraphicsDevices.Count), Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Graphics cards" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind local:AffinityPage.CountText(ViewModel.GraphicsDevices.Count), Mode=OneWay}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="4">
                        <ListView x:Name="GraphicsList"
                                  ItemsSource="{x:Bind ViewModel.GraphicsDevices, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="DeviceRow_ItemClick"
                                  ItemTemplate="{StaticResource AffinityDeviceRowTemplate}"
                                  ItemContainerStyle="{StaticResource AffinityCardRowContainerStyle}"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource GalleryCardExpander}"
                          IsExpanded="{x:Bind ViewModel.IsNetworkExpanded, Mode=TwoWay}"
                          Visibility="{x:Bind local:AffinityPage.NonEmptyToVisibility(ViewModel.NetworkDevices.Count), Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Network controllers" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind local:AffinityPage.CountText(ViewModel.NetworkDevices.Count), Mode=OneWay}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="4">
                        <ListView x:Name="NetworkList"
                                  ItemsSource="{x:Bind ViewModel.NetworkDevices, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="DeviceRow_ItemClick"
                                  ItemTemplate="{StaticResource AffinityDeviceRowTemplate}"
                                  ItemContainerStyle="{StaticResource AffinityCardRowContainerStyle}"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource GalleryCardExpander}"
                          IsExpanded="{x:Bind ViewModel.IsUsbExpanded, Mode=TwoWay}"
                          Visibility="{x:Bind local:AffinityPage.NonEmptyToVisibility(ViewModel.UsbDevices.Count), Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="USB controllers" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind local:AffinityPage.CountText(ViewModel.UsbDevices.Count), Mode=OneWay}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="4">
                        <ListView x:Name="UsbList"
                                  ItemsSource="{x:Bind ViewModel.UsbDevices, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="DeviceRow_ItemClick"
                                  ItemTemplate="{StaticResource AffinityDeviceRowTemplate}"
                                  ItemContainerStyle="{StaticResource AffinityCardRowContainerStyle}"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource GalleryCardExpander}"
                          IsExpanded="{x:Bind ViewModel.IsAudioExpanded, Mode=TwoWay}"
                          Visibility="{x:Bind local:AffinityPage.NonEmptyToVisibility(ViewModel.AudioDevices.Count), Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Audio controllers" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind local:AffinityPage.CountText(ViewModel.AudioDevices.Count), Mode=OneWay}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="4">
                        <ListView x:Name="AudioList"
                                  ItemsSource="{x:Bind ViewModel.AudioDevices, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="DeviceRow_ItemClick"
                                  ItemTemplate="{StaticResource AffinityDeviceRowTemplate}"
                                  ItemContainerStyle="{StaticResource AffinityCardRowContainerStyle}"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
