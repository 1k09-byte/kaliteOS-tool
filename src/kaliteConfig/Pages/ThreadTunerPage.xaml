<Page
    x:Class="kaliteConfig.Pages.ThreadTunerPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:kaliteConfig.Pages"
    xmlns:models="using:kaliteConfig.Models"
    xmlns:converters="using:kaliteConfig.Converters"
    xmlns:gamemode="using:kaliteConfig.Gaming.GameMode"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter" />

        <DataTemplate x:Key="RuleRowTemplate" x:DataType="models:TunerProfile">
            <Border Margin="2,1" Padding="16,11" CornerRadius="6"
                    Background="Transparent"
                    ToolTipService.ToolTip="{x:Bind Pattern}" DoubleTapped="RuleRow_DoubleTapped">
                <Border.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Edit" Click="RuleEdit_Click" />
                        <MenuFlyoutItem Text="Enable / disable" Click="RuleToggle_Click" />
                        <MenuFlyoutItem Text="Apply now" Click="RuleApplyNow_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Delete" Click="RuleDelete_Click" />
                    </MenuFlyout>
                </Border.ContextFlyout>
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Pattern, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ProcessActionsSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ThreadRulesSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <Border CornerRadius="10" Padding="9,2" HorizontalAlignment="Left"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Visibility="{x:Bind EnabledPillVis, Mode=OneWay}">
                            <TextBlock Text="Enabled" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </Border>
                        <Border CornerRadius="10" Padding="9,2" HorizontalAlignment="Left"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Visibility="{x:Bind DisabledPillVis, Mode=OneWay}">
                            <TextBlock Text="Disabled" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock FontSize="12" Text="{x:Bind LastResult, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Visibility="{x:Bind AppliedResultVis, Mode=OneWay}" />
                        <TextBlock FontSize="12" Text="{x:Bind LastResult, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Visibility="{x:Bind WaitingResultVis, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </Page.Resources>

    <Grid x:Name="RootGrid" UseLayoutRounding="True" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,20,28,6" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Bottom">
                <TextBlock Text="Process Control" Style="{StaticResource GalleryPageTitle}" />
                <TextBlock Text="Permanent settings are re-applied automatically" Style="{StaticResource GalleryPageCaption}" />
            </StackPanel>
            <SelectorBar CornerRadius="8" x:Name="MainSelectorBar" SelectionChanged="MainSelectorBar_SelectionChanged"
                          Grid.Column="1" VerticalAlignment="Bottom" Background="Transparent">
                <SelectorBarItem CornerRadius="8" x:Name="TabProcesses" Text="Processes" Background="Transparent" IsSelected="True" />
                <SelectorBarItem CornerRadius="8" x:Name="TabRules" Text="Rules" Background="Transparent" />
            </SelectorBar>
        </Grid>

        <Grid x:Name="ProcessesPanel" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Expander x:Name="GameModeCard" Grid.Row="0" Style="{StaticResource GalleryCardExpander}" Margin="28,6,28,0"
                      IsExpanded="False">
                <Expander.Header>
                    <Grid ColumnSpacing="14" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Game Mode" Style="{StaticResource GallerySectionTitle}" />
                            <TextBlock Text="{x:Bind GameMode.StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="140" VerticalAlignment="Center" AutomationProperties.Name="Game Mode preset"
                                  SelectedIndex="{x:Bind GameMode.PresetIndex, Mode=TwoWay}"                                  ToolTipService.ToolTip="Default preset for newly added games">
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Balanced" />
                            <ComboBoxItem Content="Aggressive" />
                            <ComboBoxItem Content="Custom" />
                        </ComboBox>
                    </Grid>
                </Expander.Header>

                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <StackPanel Spacing="12">
                    <InfoBar IsOpen="True" IsClosable="False" Severity="{x:Bind GameMode.StatusSeverity, Mode=OneWay}"
                             Message="{x:Bind GameMode.StatusText, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Preview" Click="GameModePreview_Click" AutomationProperties.Name="Preview planned actions" />
                        <Button Content="Resume everything now" Click="GameModeResume_Click" AutomationProperties.Name="Resume everything now" />
                        <NumberBox Value="{x:Bind GameMode.DebounceMs, Mode=TwoWay}" Minimum="250" Maximum="5000" SmallChange="50"
                                   SpinButtonPlacementMode="Inline" Header="Activation delay (ms)" Width="200" />
                        <ComboBox Header="Optimize scope" SelectedIndex="{x:Bind OptimizeLevelIndex, Mode=TwoWay}" Width="150"
                                  ToolTipService.ToolTip="Standard lowers only processes actively using CPU. Aggressive also lowers idle background processes.">
                            <ComboBoxItem Content="Standard" />
                            <ComboBoxItem Content="Aggressive" />
                        </ComboBox>
                        <TextBlock Text="{x:Bind GameMode.JournalText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind GameMode.PreviewSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind GameMode.CpuPlanSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="2.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Process" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Category" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Action" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Grid.Column="3" Text="State" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Grid.Column="4" Text="Detail" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                    <ListView ItemsSource="{x:Bind GameMode.Affected, Mode=OneWay}" SelectionMode="None" MaxHeight="180"
                              Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="gamemode:GameModeAffectedRow">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="2.4*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Category}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Action}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind State}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Message}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Game list and Never touch">
                        <StackPanel Spacing="8">
                            <InfoBar IsOpen="{x:Bind GameMode.HasListFeedback, Mode=OneWay}" Severity="{x:Bind GameMode.ListFeedbackSeverity, Mode=OneWay}"
                                     Message="{x:Bind GameMode.ListFeedback, Mode=OneWay}" CloseButtonClick="GameModeListFeedback_Close" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Add focused app" Click="GameModeAddFocused_Click" ToolTipService.ToolTip="Adds the app you used just before kaliteConfig" />
                                <TextBox Text="{x:Bind GameMode.GamePathInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="360"
                                         PlaceholderText="Full path, or an image name such as notepad.exe" AutomationProperties.Name="Game executable path"
                                         KeyDown="GameModePathBox_KeyDown" />
                                <Button Content="Add by path" Click="GameModeAddPath_Click" ToolTipService.ToolTip="Accepts a full path or an image name; Enter works too" />
                            </StackPanel>
                            <ListView ItemsSource="{x:Bind GameMode.Games, Mode=OneWay}" SelectionMode="None" MaxHeight="140"
                                      Background="Transparent" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="gamemode:GameModeGameEntry">
                                        <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" />
                                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" MinWidth="120" VerticalAlignment="Center" AutomationProperties.Name="Game preset"
                                                  SelectedIndex="{x:Bind PresetIndex, Mode=TwoWay}" SelectionChanged="GameModeGamePreset_Changed">
                                            <ComboBoxItem Content="Light" />
                                            <ComboBoxItem Content="Balanced" />
                                            <ComboBoxItem Content="Aggressive" />
                                            <ComboBoxItem Content="Custom" />
                                        </ComboBox>
                                        <Button Grid.Column="2" Content="Remove" Click="GameModeRemoveGame_Click" Tag="{x:Bind}" AutomationProperties.Name="Remove game" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Text="{x:Bind GameMode.NeverTouchInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="280"
                                         PlaceholderText="Image name or pattern" AutomationProperties.Name="Never touch entry"
                                         KeyDown="GameModeNeverTouchBox_KeyDown" />
                                <Button Content="Add to Never touch" Click="GameModeAddNeverTouch_Click" />
                            </StackPanel>
                            <ListView ItemsSource="{x:Bind GameMode.NeverTouch, Mode=OneWay}" SelectionMode="None" MaxHeight="120"
                                      Background="Transparent" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Remove" Click="GameModeRemoveNeverTouch_Click" Tag="{x:Bind}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>

                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Activity log">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox MinWidth="180" ItemsSource="{x:Bind GameMode.LogFilters}" SelectedIndex="{x:Bind GameMode.LogFilterIndex, Mode=TwoWay}" AutomationProperties.Name="Log filter" />
                                <Button Content="Copy" Click="GameModeCopyLog_Click" />
                                <Button Content="Export" Click="GameModeExportLog_Click" />
                                <Button Content="Clear" Click="GameModeClearLog_Click" />
                            </StackPanel>
                            <ListView ItemsSource="{x:Bind GameMode.LogRows, Mode=OneWay}" SelectionMode="None" MaxHeight="200"
                                      Background="Transparent" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="gamemode:GameModeLogRow">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="2.6*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Time}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Process}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Action}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Result}" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind Message}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>
            </Expander>

            <Border Grid.Row="1" Style="{StaticResource GalleryCard}" Margin="28,10,28,0" Padding="14,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">                        <Button x:Name="PageGamingModeButton" Content="Enable Gaming mode" Style="{StaticResource AccentButtonStyle}" Click="Page_ToggleGamingMode"
                                 ToolTipService.ToolTip="Turns the Game Mode session engine on or off. No process needs to be selected." />
                        <Button x:Name="PageRestoreButton" Content="Restore changes" Click="Page_RestorePriorities" IsEnabled="False"
                                ToolTipService.ToolTip="Revert every priority kaliteConfig changed." />
                    </StackPanel>

                    <TextBox CornerRadius="6" x:Name="ProcessesSearchBox" Grid.Column="1" MaxWidth="260" MinWidth="190" HorizontalAlignment="Left"
                             PlaceholderText="Search processes or PID" VerticalAlignment="Center"
                             Text="{x:Bind ViewModel.RulesFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Counters" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <ToggleSwitch CornerRadius="6" x:Name="CountersToggle" VerticalAlignment="Center"
                                      OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.ShowCounterDeltas, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Show Context switches and Cycles delta. Off also stops collecting them." />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="PageGamingStatusText" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="440" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock x:Name="PageSuspendStatusText" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Keep running" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <ToggleSwitch CornerRadius="6" x:Name="StartupToggle" VerticalAlignment="Center" Toggled="StartupToggle_Toggled"
                                      ToolTipService.ToolTip="Keep the app running so rules apply automatically" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource GalleryCard}" Margin="28,10,28,0" Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,4,26,8">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.6*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="{x:Bind ViewModel.ShowCounterDeltas, Mode=OneWay, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=120}" />
                                <ColumnDefinition Width="{x:Bind ViewModel.ShowCounterDeltas, Mode=OneWay, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=120}" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Process" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="1" Text="CPU %" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="2" Text="Memory" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="3" Text="Threads" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="4" Text="Priority" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="5" Text="State" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="6" Text="Affinity" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       ToolTipService.ToolTip="Live CPU affinity per process (All = every core). Hover a value for the exact mask." />
                            <TextBlock Grid.Column="7" Text="Context switches delta" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind ViewModel.ShowCounterDeltasVis, Mode=OneWay}" />
                            <TextBlock Grid.Column="8" Text="Cycles delta" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind ViewModel.ShowCounterDeltasVis, Mode=OneWay}" />
                            <TextBlock Grid.Column="9" Text="Boost" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       ToolTipService.ToolTip="Priority boost for the whole process. Untick to disable it - the choice is saved and re-applied to this process every time it starts." />
                        </Grid>
                    </Border>

                    <ListView x:Name="ProcessesGrid" Grid.Row="1" ItemsSource="{x:Bind ViewModel.DisplayedProcesses, Mode=OneWay}" SelectionMode="Single" SelectionChanged="ProcessesGrid_SelectionChanged" ShowsScrollingPlaceholders="False"
                              Padding="0,2,0,0"
                              Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TunerProcessRow">
                                <Border CornerRadius="6">
                                <Grid Padding="16,7" ColumnSpacing="14" Background="Transparent"
                                        ToolTipService.ToolTip="{x:Bind Name}"
                                        DoubleTapped="Row_DoubleTapped">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout Opening="ProcessMenu_Opening">
                                            <MenuFlyoutItem Text="Terminate" Click="Action_Terminate" />
                                            <MenuFlyoutItem Text="Suspend" Click="Action_Suspend" />
                                            <MenuFlyoutItem Text="Resume" Click="Action_Resume" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutSubItem Text="Priority   >">
                                                <MenuFlyoutItem Text="Real time" Click="Action_Priority" Tag="Realtime" />
                                                <MenuFlyoutItem Text="High" Click="Action_Priority" Tag="High" />
                                                <MenuFlyoutItem Text="Above normal" Click="Action_Priority" Tag="AboveNormal" />
                                                <MenuFlyoutItem Text="Normal" Click="Action_Priority" Tag="Normal" />
                                                <MenuFlyoutItem Text="Below normal" Click="Action_Priority" Tag="BelowNormal" />
                                                <MenuFlyoutItem Text="Idle" Click="Action_Priority" Tag="Idle" />
                                            </MenuFlyoutSubItem>
                                            <MenuFlyoutItem Text="CPU affinity..." Click="Action_Affinity" />
                                                    <MenuFlyoutSubItem Text="Priority boost   >">
                                                <MenuFlyoutItem Text="Enabled" Click="Action_Boost" Tag="Enabled" />
                                                <MenuFlyoutItem Text="Disabled" Click="Action_Boost" Tag="Disabled" />
                                            </MenuFlyoutSubItem>
                                            <MenuFlyoutSubItem Text="Efficiency mode   >">
                                                <MenuFlyoutItem Text="Enabled" Click="Action_Eco" Tag="Enabled" />
                                                <MenuFlyoutItem Text="Disabled" Click="Action_Eco" Tag="Disabled" />
                                            </MenuFlyoutSubItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Create rule..." Click="Action_CreateRule" />
                                            <MenuFlyoutItem Text="Show threads..." Click="Action_Threads" />
                                            <MenuFlyoutItem Text="Show details" Click="Action_Details" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.6*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="{x:Bind ShowCounters, Mode=OneWay, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=120}" />
                                        <ColumnDefinition Width="{x:Bind ShowCounters, Mode=OneWay, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=120}" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                                Margin="{x:Bind IndentMargin, Mode=OneWay}">
                                        <Grid Width="12" Height="16" VerticalAlignment="Center">
                                            <Button
                                                MinWidth="0"
                                                MinHeight="0"
                                                Padding="0"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{x:Bind HasChildrenVis, Mode=OneWay}"
                                                Click="RowChevron_Click"
                                                ToolTipService.ToolTip="Expand or collapse child processes">
                                                <FontIcon Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" FontSize="10" />
                                            </Button>
                                        </Grid>
                                        <Grid Width="16" Height="16">
                                            <Image Source="{x:Bind AppIcon, Mode=OneWay}" Width="16" Height="16"
                                                   Visibility="{x:Bind AppIconVis, Mode=OneWay}" />
                                            <FontIcon Glyph="&#xE8A5;" FontSize="14"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{x:Bind GenericIconVis, Mode=OneWay}"
                                                      ToolTipService.ToolTip="No icon available for this process" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center" Spacing="0">
                                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" FontSize="12.5" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{x:Bind local:ThreadTunerPage.RowNameBrush(IsProtected), Mode=OneWay}" />
                                            <TextBlock FontSize="10.5" Text="{x:Bind Pid}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind CpuPercent, Mode=OneWay}" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind Memory, Mode=OneWay}" />
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind Threads, Mode=OneWay}" />
                                    <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind PriorityText, Mode=OneWay}" />
                                    <TextBlock Grid.Column="5" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind State, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12"
                                               Text="{x:Bind AffinitySummary, Mode=OneWay}"
                                               ToolTipService.ToolTip="{x:Bind AffinityDetail, Mode=OneWay}" />
                                    <TextBlock Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12"
                                               Text="{x:Bind ContextSwitchesDelta, Mode=OneWay}"
                                               Visibility="{x:Bind ShowCountersVis, Mode=OneWay}" />
                                    <TextBlock Grid.Column="8" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12"
                                               Text="{x:Bind CyclesDelta, Mode=OneWay}"
                                               Visibility="{x:Bind ShowCountersVis, Mode=OneWay}" />

                                    <CheckBox Grid.Column="9"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              MinWidth="0"
                                              IsThreeState="False"
                                              Click="RowBoost_Click"
                                              Tag="{x:Bind}"
                                              IsEnabled="{x:Bind local:ThreadTunerPage.Not(IsProtected), Mode=OneWay}"
                                              IsChecked="{x:Bind BoostAllowed, Mode=OneWay}"
                                              ToolTipService.ToolTip="Priority boost (ticked = Windows default). Untick to disable it permanently for this process." />
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid x:Name="ProcessesLoadingOverlay" Grid.Row="1" MinHeight="220" Background="Transparent"
                          Visibility="{x:Bind ViewModel.IsProcessListLoadingVis, Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressRing x:Name="ProcessesLoadingRing" Width="42" Height="42"
                                          IsActive="{x:Bind ViewModel.IsProcessListLoading, Mode=OneWay}" />
                            <TextBlock x:Name="ProcessesLoadingText" Text="Loading processes…" FontSize="12"
                                       HorizontalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.IsProcessListLoadingVis, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="30,6,30,10">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="Updated 2 s" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <Border Padding="8,3" CornerRadius="6"
                            Visibility="{Binding Optimizer.IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="{Binding Optimizer.ActiveGameName}" FontSize="11" />
                            <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding Optimizer.ProcessesManaged}" FontSize="11" />
                            <TextBlock Text="managed" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="RulesPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource GalleryCard}" Margin="28,6,28,0" Padding="14,10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Rules" Style="{StaticResource GallerySectionTitle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox CornerRadius="6" Grid.Column="1" MaxWidth="320" MinWidth="200" HorizontalAlignment="Left" PlaceholderText="Search rules" VerticalAlignment="Center"
                             Text="{x:Bind ViewModel.RulesFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Edit" VerticalAlignment="Center" Click="RuleEdit_Click" />
                        <Button Content="Enable / disable" VerticalAlignment="Center" Click="RuleToggle_Click" />
                        <Button Content="Delete" VerticalAlignment="Center" Click="RuleDelete_Click" />
                    </StackPanel>
                    <Button Grid.Column="4" Content="Add rule" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Click="RuleAdd_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource GalleryCard}" Margin="28,10,28,0" Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,4,26,8">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Process" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="1" Text="Process actions" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="2" Text="Thread rules" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="4" Text="Last result" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Border>

                    <ListView x:Name="RulesList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.DisplayedProcessProfiles, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                              ItemTemplate="{StaticResource RuleRowTemplate}"
                              SelectionMode="Single" ShowsScrollingPlaceholders="False"
                              Padding="0,2,0,0"
                              Background="Transparent" BorderThickness="0" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="30,6,30,10">
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <TextBlock x:Name="RulesCountText" Text="0 rules" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Each action is applied and verified independently" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <CheckBox Content="Rules can enable Game Mode automatically" IsChecked="{x:Bind AllowRuleAutoGameMode, Mode=TwoWay}" VerticalAlignment="Center"
                              ToolTipService.ToolTip="When off, rules with 'Automatic Gaming mode' are skipped and logged instead of changing priorities." />
                </StackPanel>
                <TextBlock Text="Double-click to edit" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>

