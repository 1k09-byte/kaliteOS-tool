<Page
    x:Class="kaliteConfig.Pages.ThreadTunerPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:kaliteConfig.Pages"
    xmlns:models="using:kaliteConfig.Models"
    xmlns:converters="using:kaliteConfig.Converters"
    xmlns:animations="using:Microsoft.UI.Xaml.Media.Animation"
    NavigationCacheMode="Enabled">
    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <EntranceNavigationTransitionInfo />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
        </TransitionCollection>
    </Page.Transitions>

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter" />
        
        <!-- Flat table rows: no rounded card per row, no margin gaps. Hover
             and selection are a subtle full-width fill on the row itself. -->
        <Style x:Key="ProcessCardItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="FocusVisualPrimaryThickness" Value="0" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowSurface" Background="Transparent">
                            <ContentPresenter Background="Transparent"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowSurface" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowSurface" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Rule Row Template -->
        <DataTemplate x:Key="RuleRowTemplate" x:DataType="models:TunerProfile">
            <Border Margin="12,4" Padding="14,10" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    ToolTipService.ToolTip="{x:Bind Pattern}" DoubleTapped="RuleRow_DoubleTapped">
                <Border.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Edit" Click="RuleEdit_Click" />
                        <MenuFlyoutItem Text="Enable / disable" Click="RuleToggle_Click" />
                        <MenuFlyoutItem Text="Apply now" Click="RuleApplyNow_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Delete" Click="RuleDelete_Click" />
                    </MenuFlyout>
                </Border.ContextFlyout>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Pattern, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ProcessActionsSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ThreadRulesSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Visibility="{x:Bind EnabledPillVis, Mode=OneWay}">
                            <TextBlock Text="Enabled" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </Border>
                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Visibility="{x:Bind DisabledPillVis, Mode=OneWay}">
                            <TextBlock Text="Disabled" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock FontSize="12" Text="{x:Bind LastResult, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Visibility="{x:Bind AppliedResultVis, Mode=OneWay}" />
                        <TextBlock FontSize="12" Text="{x:Bind LastResult, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Visibility="{x:Bind WaitingResultVis, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        </Page.Resources>

    <Grid x:Name="RootGrid" UseLayoutRounding="True" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Action Bar -->
            <RowDefinition Height="Auto" /> <!-- SelectorBar -->
            <RowDefinition Height="*" />    <!-- Main Content Panel -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,20,28,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Process Control" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Permanent settings are re-applied automatically" FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Margin="28,12,28,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SelectorBar CornerRadius="8" x:Name="MainSelectorBar" SelectionChanged="MainSelectorBar_SelectionChanged"
                        Grid.Column="0" VerticalAlignment="Center" Background="Transparent">
                <!-- SelectedItem set in code-behind (Loaded): a SelectorBar with no
                     selection draws no active indicator, so the Processes tab
                     looked unselected on the first visit. -->
                <SelectorBarItem CornerRadius="8" x:Name="TabProcesses" Text="Processes" Background="Transparent" IsSelected="True" />
                <SelectorBarItem CornerRadius="8" x:Name="TabRules" Text="Rules" Background="Transparent" />
            </SelectorBar>
        </Grid>

        <!-- Processes Panel -->
        <Grid x:Name="ProcessesPanel" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Toolbar: one plain row, no card. Column 3 is the elastic spacer
                 that pushes the status cluster to the right edge. -->
            <Grid Grid.Row="0" Margin="28,0,28,10" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button CornerRadius="6" x:Name="PageGamingModeButton" Grid.Column="0" Content="Enable Gaming mode" Style="{StaticResource AccentButtonStyle}" Click="Page_ToggleGamingMode" MinWidth="160" Padding="12,6"
                        ToolTipService.ToolTip="Raises the selected process to Above Normal and applies the safe Gaming Mode profile." />
                <Button CornerRadius="6" x:Name="PageRestoreButton" Grid.Column="1" Content="Restore changes" Click="Page_RestorePriorities" IsEnabled="False" Padding="12,6"
                        ToolTipService.ToolTip="Revert every priority kaliteConfig changed." />
                <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" Margin="4,0,0,0" CornerRadius="4"
                        Visibility="{Binding Optimizer.IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="{Binding Optimizer.ActiveGameName}" FontSize="11" />
                        <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding Optimizer.ProcessesManaged}" FontSize="11" />
                        <TextBlock Text="managed" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <TextBox CornerRadius="6" x:Name="ProcessesSearchBox" Grid.Column="3" MaxWidth="260" MinWidth="200" HorizontalAlignment="Left"
                         Margin="8,0,0,0" PlaceholderText="Search processes or PID" VerticalAlignment="Center"
                         Text="{x:Bind ViewModel.RulesFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <!-- Own column: sharing column 3 with the search box stacked this
                     on top of the Gaming mode button. -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,8,0">
                    <TextBlock Text="Counters" FontSize="11" VerticalAlignment="Center" />
                    <ToggleSwitch CornerRadius="6" x:Name="CountersToggle" VerticalAlignment="Center"
                                  OnContent="On" OffContent="Off"
                                  IsOn="{x:Bind ViewModel.ShowCounterDeltas, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Show Context switches and Cycles delta. Off also stops collecting them." />
                </StackPanel>
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock x:Name="PageGamingStatusText" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="440" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock x:Name="PageSuspendStatusText" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <ToggleSwitch CornerRadius="6" x:Name="StartupToggle" VerticalAlignment="Center" Toggled="StartupToggle_Toggled"
                                  ToolTipService.ToolTip="Keep the app running so rules apply automatically" />
                </StackPanel>
            </Grid>

            <!-- Column Headers: plain caption row above a hairline rule, no card. -->
            <Grid Grid.Row="1" Margin="28,0,28,0" ColumnSpacing="12" Padding="14,0,14,6"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <!-- Counter columns collapse to 0 via the same fixed width in
                         header and rows. Auto widths would size the header's long
                         caption differently from the row's number and the columns
                         would drift out of alignment. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="{x:Bind ViewModel.ShowCounterDeltas, Mode=OneWay, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=120}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.ShowCounterDeltas, Mode=OneWay, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=120}" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Process" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Column="1" Text="CPU" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Column="2" Text="PID" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Column="3" Text="Memory" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Column="4" Text="Threads" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Column="5" Text="Priority" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Column="6" Text="State" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Column="7" Text="Context switches delta" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Visibility="{x:Bind ViewModel.ShowCounterDeltasVis, Mode=OneWay}" />
                    <TextBlock Grid.Column="8" Text="Cycles delta" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Visibility="{x:Bind ViewModel.ShowCounterDeltasVis, Mode=OneWay}" />
                    <TextBlock Grid.Column="9" Text="Boost" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               ToolTipService.ToolTip="Priority boost for the whole process. Untick to disable it - the choice is saved and re-applied to this process every time it starts." />
            </Grid>

            <!-- Process table: no card, no border around the list. Rows are flat
                     lines separated by hairlines, the way a process table reads. -->
            <ListView x:Name="ProcessesGrid" Grid.Row="2" Margin="28,0,28,0" ItemsSource="{x:Bind ViewModel.DisplayedProcesses, Mode=OneWay}" SelectionMode="Single" SelectionChanged="ProcessesGrid_SelectionChanged" ShowsScrollingPlaceholders="False"
                      Background="Transparent" BorderThickness="0" Padding="0"
                      ItemContainerStyle="{StaticResource ProcessCardItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TunerProcessRow">
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid Padding="14,6" ColumnSpacing="12" Background="Transparent"
                                ToolTipService.ToolTip="{x:Bind Name}"
                                DoubleTapped="Row_DoubleTapped">
                            <Grid.ContextFlyout>
                                <MenuFlyout Opening="ProcessMenu_Opening">
                                    <MenuFlyoutItem Text="Terminate" Click="Action_Terminate" />
                                    <MenuFlyoutItem Text="Suspend" Click="Action_Suspend" />
                                    <MenuFlyoutItem Text="Resume" Click="Action_Resume" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutSubItem Text="Priority   >">
                                        <MenuFlyoutItem Text="Real time" Click="Action_Priority" Tag="Realtime" />
                                        <MenuFlyoutItem Text="High" Click="Action_Priority" Tag="High" />
                                        <MenuFlyoutItem Text="Above normal" Click="Action_Priority" Tag="AboveNormal" />
                                        <MenuFlyoutItem Text="Normal" Click="Action_Priority" Tag="Normal" />
                                        <MenuFlyoutItem Text="Below normal" Click="Action_Priority" Tag="BelowNormal" />
                                        <MenuFlyoutItem Text="Idle" Click="Action_Priority" Tag="Idle" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutItem Text="CPU affinity..." Click="Action_Affinity" />
                                            <MenuFlyoutSubItem Text="Priority boost   >">
                                        <MenuFlyoutItem Text="Enabled" Click="Action_Boost" Tag="Enabled" />
                                        <MenuFlyoutItem Text="Disabled" Click="Action_Boost" Tag="Disabled" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSubItem Text="Efficiency mode   >">
                                        <MenuFlyoutItem Text="Enabled" Click="Action_Eco" Tag="Enabled" />
                                        <MenuFlyoutItem Text="Disabled" Click="Action_Eco" Tag="Disabled" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Create rule..." Click="Action_CreateRule" />
                                    <MenuFlyoutItem Text="Show threads..." Click="Action_Threads" />
                                    <MenuFlyoutItem Text="Show details" Click="Action_Details" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="100" />
                                <!-- Same widths as the header row, so every
                                     column lines up with its caption. -->
                                <ColumnDefinition Width="{x:Bind ShowCounters, Mode=OneWay, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=120}" />
                                <ColumnDefinition Width="{x:Bind ShowCounters, Mode=OneWay, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=120}" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <!-- Tree indent: children sit 14 px further right per
                                 level, under the process that spawned them. -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        Margin="{x:Bind IndentMargin, Mode=OneWay}">
                                <!-- Chevron slot is a fixed-width box so every row's icon lands on
                                     the same x. Collapsing the whole slot on leaf
                                     rows would pull their icons left, out of line
                                     with the parents' icons. -->
                                <Grid Width="12" Height="16" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" FontSize="10"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{x:Bind HasChildrenVis, Mode=OneWay}"
                                              Tapped="RowChevron_Tapped"
                                              ToolTipService.ToolTip="Expand or collapse child processes" />
                                </Grid>
                                <!-- Icon slot is a fixed-size box either way, so
                                     names align down the column. With no extracted
                                     icon a generic document glyph stands in. -->
                                <Grid Width="16" Height="16">
                                    <Image Source="{x:Bind AppIcon, Mode=OneWay}" Width="16" Height="16"
                                           Visibility="{x:Bind AppIconVis, Mode=OneWay}" />
                                    <!-- Last resort only (the wininit.exe bitmap above covers
                                     every icon-less row in practice): the previous
                                     generic glyph. -->
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{x:Bind GenericIconVis, Mode=OneWay}"
                                              ToolTipService.ToolTip="No icon available for this process" />
                                </Grid>
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{x:Bind local:ThreadTunerPage.RowNameBrush(IsProtected), Mode=OneWay}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind CpuPercent, Mode=OneWay}" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind Pid}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind Memory, Mode=OneWay}" />
                            <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind Threads, Mode=OneWay}" />
                            <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind PriorityText, Mode=OneWay}" />
                            <TextBlock Grid.Column="6" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind State, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <!-- Counter columns: hidden unless the user turns them on, and not
                                 computed at all while hidden. -->
                            <TextBlock Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12"
                                       Text="{x:Bind ContextSwitchesDelta, Mode=OneWay}"
                                       Visibility="{x:Bind ShowCountersVis, Mode=OneWay}" />
                            <TextBlock Grid.Column="8" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12"
                                       Text="{x:Bind CyclesDelta, Mode=OneWay}"
                                       Visibility="{x:Bind ShowCountersVis, Mode=OneWay}" />

                            <!-- Per-process Priority boost. Unticking applies to the
                                 live process immediately and is remembered for good. -->
                            <CheckBox Grid.Column="9"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      MinWidth="0"
                                      IsThreeState="False"
                                      Click="RowBoost_Click"
                                      Tag="{x:Bind}"
                                      IsEnabled="{x:Bind local:ThreadTunerPage.Not(IsProtected), Mode=OneWay}"
                                      IsChecked="{x:Bind BoostAllowed, Mode=OneWay}"
                                      ToolTipService.ToolTip="Priority boost (ticked = Windows default). Untick to disable it permanently for this process." />
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="3" Margin="28,12,28,12">
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <TextBlock Text="Updated 2 s" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- RulesPanel -->
        <Grid x:Name="RulesPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Rules toolbar -->
            <Border Grid.Row="0" Margin="28,4,28,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Rules" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox CornerRadius="8" Grid.Column="1" MaxWidth="320" HorizontalAlignment="Left" PlaceholderText="Search rules" VerticalAlignment="Center"
                         Text="{x:Bind ViewModel.RulesFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button CornerRadius="8" Content="Edit" VerticalAlignment="Center" Click="RuleEdit_Click" />
                    <Button CornerRadius="8" Content="Enable / disable" VerticalAlignment="Center" Click="RuleToggle_Click" />
                    <Button CornerRadius="8" Content="Delete" VerticalAlignment="Center" Click="RuleDelete_Click" />
                </StackPanel>
                <Button CornerRadius="8" Grid.Column="3" Content="Add rule" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Click="RuleAdd_Click" />
            </Grid>
            </Border>

            <!-- Rules column headers -->
            <Border Grid.Row="1" Margin="28,0,28,0" Padding="14,8" CornerRadius="8"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Process" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="Process actions" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="Thread rules" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="Last result" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- Rules list -->
            <ListView CornerRadius="12" x:Name="RulesList" Grid.Row="2" Margin="16,0,16,0" ItemsSource="{x:Bind ViewModel.DisplayedProcessProfiles, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                      ItemTemplate="{StaticResource RuleRowTemplate}"
                      SelectionMode="Single" ShowsScrollingPlaceholders="False" />

            <!-- Rules footer -->
            <Grid Grid.Row="3" Margin="12,8,12,12">
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <TextBlock x:Name="RulesCountText" Text="0 rules" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Each action is applied and verified independently" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Double-click to edit" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>
