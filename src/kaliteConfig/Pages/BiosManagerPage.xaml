<Page
    x:Class="kaliteConfig.Pages.BiosManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:kaliteConfig.Models"
    xmlns:vm="using:kaliteConfig.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Enabled"
    Background="Transparent">

    <Page.Resources>
        <!-- Row for the pre-export review dialog: Name → Old → New -->
        <DataTemplate x:Key="ChangeSummaryTemplate" x:DataType="vm:ChangeSummary">
            <Grid Padding="4,6" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" MinWidth="120">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind PathText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind OldValue}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind NewValue}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="12,4,12,4" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE950;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="BIOS Manager" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,1"
                    Visibility="{x:Bind ViewModel.HasChanges, Mode=OneWay}" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.ModifiedCountText, Mode=OneWay}" FontSize="11" Foreground="White" />
            </Border>
        </StackPanel>

        <!-- Sticky action bar: load/export/revert always visible -->
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" Background="Transparent" Margin="0,0,0,4">
            <CommandBar.PrimaryCommands>
                <AppBarButton Icon="Save" Label="Apply to BIOS" Click="ApplyToBios_Click" IsEnabled="{x:Bind ViewModel.HasChanges, Mode=OneWay}" />
                <AppBarSeparator />
                <AppBarButton Icon="OpenFile" Label="Load profile…" Click="LoadDump_Click" />
                <AppBarButton Icon="SaveLocal" Label="Save profile…" Click="Export_Click" IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}" />
                <AppBarSeparator />
                <AppBarButton Icon="Undo" Label="Revert all" Command="{x:Bind ViewModel.ResetAllCommand}" IsEnabled="{x:Bind ViewModel.HasChanges, Mode=OneWay}" />
            </CommandBar.PrimaryCommands>
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.ModifiedCountText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>

        <StackPanel Grid.Row="2" Spacing="4" Margin="12,0,12,4">
            <InfoBar
                IsOpen="True"
                Severity="Warning"
                Title="Proceed With Caution"
                Message="Any modifications made to your BIOS settings are strictly at your own risk. We are not responsible for any damage, instability, or bricked motherboards resulting from these changes. You are fully responsible for any actions taken here. If you need guidance, ask our community in Discord for help before hitting apply."
                IsClosable="False" />

            <InfoBar
                x:Name="ErrorBar"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="Error"
                Title="Couldn't load dump"
                Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                IsClosable="True" />
        </StackPanel>

        <!-- Search pinned above the list, always visible without scrolling -->
        <AutoSuggestBox
            Grid.Row="3"
            x:Name="SearchBox"
            QueryIcon="Find"
            PlaceholderText="Search setting name, token, help text, or value…"
            TextChanged="SearchBox_TextChanged"
            IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
            Margin="12,0,12,8" />

        <!-- Three panes: menu tree | settings list | detail/editor -->
        <Grid Grid.Row="4" x:Name="PaneRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DetailColumn" Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Category nav: WinUI Settings-style list (rounded selection,
                 name + count), fed by keyword buckets (CPU, PCIe, Security…).
                 Replaces the old ListBox+TreeView hybrid. -->
            <Border
                Grid.Column="0"
                BorderThickness="0,0,1,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Text="Categories"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Margin="16,8,12,8" />
                    <ListView
                        Grid.Row="1"
                        SelectionMode="Single"
                        Padding="4,0"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Enabled"
                        ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedCategoryItem, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BiosCategory">
                                <Grid Height="36" Padding="12,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind DisplayName}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind CountText}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <ListView
                Grid.Column="1"
                x:Name="SettingsList"
                ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                SelectionMode="Single"
                SelectionChanged="SettingsList_SelectionChanged"
                Padding="4,0,14,0"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled"
                ScrollViewer.IsVerticalScrollChainingEnabled="True"
                ScrollViewer.IsVerticalRailEnabled="True">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:BiosSettingRow">
                        <Grid Height="46" ColumnSpacing="8" Padding="14,4,18,4" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Left accent stripe on modified rows only -->
                            <Border
                                Grid.Column="0"
                                Width="3"
                                CornerRadius="1.5"
                                Margin="0,4,8,4"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind ModifiedVisibility, Mode=OneWay}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind TokenLineText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <!-- Current value pill; tap opens a quick editor when the detail pane is collapsed -->
                            <Border
                                Grid.Column="2"
                                CornerRadius="12"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Padding="12,4"
                                VerticalAlignment="Center"
                                Tapped="ValuePill_Tapped">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind ModifiedVisibility, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ValueDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Detail / edit pane -->
            <Border
                Grid.Column="2"
                x:Name="DetailPane"
                BorderThickness="1,0,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Padding="16,10,16,12">
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Hidden">
                    <Grid>
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.SelectedRow.Name, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedRow.SectionText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                            <TextBlock
                                Text="{x:Bind ViewModel.SelectedRow.HelpText, Mode=OneWay}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />

                            <!-- Metadata: muted, small - must not compete with the editor -->
                            <Grid ColumnSpacing="10" RowSpacing="3" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Token" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.SelectedRow.TokenValueText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Offset" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedRow.OffsetValueText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Width" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedRow.WidthValueText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="BIOS default" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedRow.BiosDefaultText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                            </Grid>

                            <!-- The editor gets the most visual weight -->
                            <TextBlock Text="Value" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                            <!-- Selection is written back from code-behind: a TwoWay
                                 SelectedValue binding can fire before ItemsSource is
                                 ready and write an empty value over the real one. -->
                            <ComboBox
                                x:Name="ValueCombo"
                                ItemsSource="{x:Bind ViewModel.SelectedRow.Options, Mode=OneWay}"
                                SelectedValuePath="RawToken"
                                DisplayMemberPath="Display"
                                SelectionChanged="ValueCombo_SelectionChanged"
                                Visibility="{x:Bind ViewModel.EditingEnumeratedVisibility, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                MinHeight="34" />
                            <TextBox
                                Text="{x:Bind ViewModel.EditingValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="0x-prefixed hex or decimal"
                                Visibility="{x:Bind ViewModel.EditingFreeformVisibility, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.EditingValidationMessage, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.EditingErrorVisibility, Mode=OneWay}" />
                            <Button
                                Content="Reset to BIOS default"
                                Command="{x:Bind ViewModel.ResetSettingCommand}"
                                CommandParameter="{x:Bind ViewModel.SelectedRow, Mode=OneWay}"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock
                            Text="Select a setting to view and edit it."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind ViewModel.NoDetailVisibility, Mode=OneWay}" />
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- 0-results empty state (search with no matches) -->
            <Border
                Grid.Column="1"
                Background="Transparent"
                Visibility="{x:Bind ViewModel.NoResultsVisibility, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="34" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No settings match your search" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Try a shorter or different term." HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Loading overlay -->
            <Grid
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing IsActive="True" Width="44" Height="44" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.LoadingText, Mode=OneWay}" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Empty state overlay -->
            <Grid
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE9D9;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Load a SCEWIN dump to begin" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="Open a text file produced by SCEWIN_64.exe /o /s to browse and edit BIOS settings."
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        MaxWidth="420"
                        TextAlignment="Center" />
                    <Button Content="Import dump" HorizontalAlignment="Center" Margin="0,6,0,0" Click="LoadDump_Click" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="Adaptive">
                    <!-- Below 1000px the detail pane collapses; the value pill's
                         tap action opens a quick-edit dialog instead. A state
                         with no trigger is NEVER applied by WinUI, so Narrow
                         gets an always-true MinWindowWidth=0 trigger and sits
                         AFTER Wide (later active states win). -->
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1000" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="DetailColumn.Width" Value="0" />
                            <Setter Target="DetailPane.Visibility" Value="Collapsed" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>

        <!-- Status footer -->
        <Border
            Grid.Row="5"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            Padding="12,6,12,6">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.FileNameText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Page>
