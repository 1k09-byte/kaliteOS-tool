<Page
    x:Class="kaliteConfig.Pages.BiosManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:kaliteConfig.ViewModels"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    NavigationCacheMode="Disabled"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="ChangeSummaryTemplate" x:DataType="vm:ChangeSummary">
            <Grid Padding="4,6" ColumnSpacing="10"
                  automation:AutomationProperties.Name="{x:Bind Name}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" MinWidth="140">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind PathText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind OldValue}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind NewValue}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <Style x:Key="FilterChipStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="SettingRowStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="BiosActionButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>

        <Style x:Key="MetaCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <VisualStateManager.VisualStateGroups>

            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ActionRow.Margin" Value="16,8,16,0" />
                        <Setter Target="NoticeStack.Margin" Value="16,8,16,0" />
                        <Setter Target="WorkGrid.Margin" Value="16,8,16,0" />
                        <Setter Target="WorkGrid.ColumnSpacing" Value="0" />
                        <Setter Target="InspectorColumn.Width" Value="0" />
                        <Setter Target="InspectorCard.Visibility" Value="Collapsed" />
                        <Setter Target="FilterCard.Padding" Value="8,6" />
                        <Setter Target="FilterSearchColumn.Width" Value="*" />
                        <Setter Target="FilterCategoryColumn.Width" Value="0" />
                        <Setter Target="FilterBottomRow.Height" Value="Auto" />
                        <Setter Target="FilterGrid.RowSpacing" Value="8" />
                        <Setter Target="FilterSearchWrap.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="CategoryStrip.(Grid.Row)" Value="1" />
                        <Setter Target="CategoryStrip.(Grid.Column)" Value="0" />
                        <Setter Target="CategoryStrip.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="TrayStatus.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="TrayToggle.(Grid.Row)" Value="1" />
                        <Setter Target="TrayToggle.(Grid.Column)" Value="0" />
                        <Setter Target="TrayToggle.HorizontalAlignment" Value="Left" />
                        <Setter Target="TrayActions.(Grid.Row)" Value="1" />
                        <Setter Target="TrayActions.(Grid.Column)" Value="2" />
                        <Setter Target="TrayActions.HorizontalAlignment" Value="Right" />
                        <Setter Target="TrayGrid.RowSpacing" Value="8" />
                        <Setter Target="TrayStatusText.MaxWidth" Value="1000" />
                        <Setter Target="StagedTray.Margin" Value="16,8,16,12" />
                        <Setter Target="StagedTray.Padding" Value="12,10" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1150" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ActionRow.Margin" Value="20,12,20,0" />
                        <Setter Target="NoticeStack.Margin" Value="20,10,20,0" />
                        <Setter Target="WorkGrid.Margin" Value="20,12,20,0" />
                        <Setter Target="WorkGrid.ColumnSpacing" Value="0" />
                        <Setter Target="InspectorColumn.Width" Value="0" />
                        <Setter Target="InspectorCard.Visibility" Value="Collapsed" />
                        <Setter Target="FilterSearchColumn.Width" Value="230" />
                        <Setter Target="TrayStatusText.MaxWidth" Value="320" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1360" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="ActionRow" Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="28,14,28,0">
                    <Button Style="{StaticResource BiosActionButton}" Click="LoadDump_Click"
                            ToolTipService.ToolTip="Open a SCEWIN dump file by hand">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                            <TextBlock Text="Import dump…" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BiosActionButton}" Click="Refresh_Click"
                            IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                            ToolTipService.ToolTip="Run SCEWIN again and reload the live firmware settings">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Re-export live" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BiosActionButton}" Click="Export_Click"
                            IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                            ToolTipService.ToolTip="Write the current document (with your edits) to a text file">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="Save profile…" />
                        </StackPanel>
                    </Button>
        </StackPanel>

        <StackPanel x:Name="NoticeStack" Grid.Row="1" Spacing="8" Margin="28,12,28,0">

            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,11">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BA;" FontSize="17" VerticalAlignment="Top"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="Flashing values is entirely at your own risk"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="Any modifications made to your BIOS settings are strictly at your own risk. We are not responsible for any damage, instability, or bricked motherboards resulting from these changes. You are fully responsible for any actions taken here. If you need guidance, ask our community in Discord for help before hitting apply."
                            Style="{StaticResource GalleryPageCaption}"
                            MaxLines="3" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,11"
                    Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE730;" FontSize="17" VerticalAlignment="Top"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="The last operation did not finish"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                                   Style="{StaticResource GalleryPageCaption}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="ErrorDismiss_Click"
                            ToolTipService.ToolTip="Dismiss"
                            VerticalAlignment="Top" Padding="7,5">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" x:Name="WorkGrid" ColumnSpacing="16" Margin="28,14,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="420" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="FilterCard" Grid.Row="0" Style="{StaticResource GalleryCard}" Padding="10,8">
                    <Grid x:Name="FilterGrid" ColumnSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="FilterTopRow" Height="Auto" />
                            <RowDefinition x:Name="FilterBottomRow" Height="0" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FilterSearchColumn" Width="270" />
                            <ColumnDefinition x:Name="FilterCategoryColumn" Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="FilterSearchWrap" Grid.Row="0" Grid.Column="0">
                            <TextBox x:Name="SearchField"
                                     TextChanged="SearchField_TextChanged"
                                PlaceholderText="Search name, token, help text or value…"
                                MinHeight="30"
                                Padding="30,4,10,4"
                                     IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}" />
                            <FontIcon Glyph="&#xE721;" FontSize="14"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Margin="11,0,0,0" IsHitTestVisible="False"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>

                        <ListView Grid.Row="0" Grid.Column="1"
                                  x:Name="CategoryStrip"
                                  SelectionMode="Single"
                                  Padding="0" Margin="0"
                                  ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedCategoryItem, Mode=TwoWay}"
                                  ItemContainerStyle="{StaticResource FilterChipStyle}"
                                  IsItemClickEnabled="False"
                                  ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.IsHorizontalRailEnabled="True">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:BiosCategory">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind DisplayName}" FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind CountText}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="17,0,1,6"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Visibility="{x:Bind ViewModel.HasDocument, Mode=OneWay}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource GalleryPageCaption}" />
                            <TextBlock Grid.Column="1" Text="BIOS default" Style="{StaticResource GalleryPageCaption}" />
                            <TextBlock Grid.Column="2" Text="Current" Style="{StaticResource GalleryPageCaption}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                    <ListView x:Name="SettingsGrid"
                              SelectionMode="Single"
                              ItemClick="SettingsGrid_ItemClick"
                              ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                              ItemContainerStyle="{StaticResource SettingRowStyle}"
                              Padding="0"
                              Margin="0"
                              IsItemClickEnabled="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollMode="Enabled"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.IsVerticalScrollChainingEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BiosSettingRow">
                                <Grid automation:AutomationProperties.Name="{x:Bind Name}" Padding="9,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="6" Height="6"
                                                 VerticalAlignment="Center"
                                                 Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                 Visibility="{x:Bind ModifiedVisibility, Mode=OneWay}" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind TileMetaText}"
                                                       Style="{StaticResource GalleryPageCaption}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Column="1" Text="{x:Bind BiosDefaultText}"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"
                                                VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE730;" FontSize="11"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                  Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" />
                                        <Border CornerRadius="8" Padding="8,2"
                                                Width="112"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{x:Bind ValueDisplay, Mode=OneWay}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="{x:Bind ViewModel.NoResultsVisibility, Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="340">
                            <FontIcon Glyph="&#xE721;" FontSize="32"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="Nothing matches that filter"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Shorten the search term, or switch back to the All settings chip."
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Style="{StaticResource GalleryPageCaption}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="340">
                            <ProgressRing IsActive="True" Width="46" Height="46" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.LoadingText, Mode=OneWay}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Style="{StaticResource GalleryPageCaption}" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Column="1" x:Name="InspectorCard"
                    Style="{StaticResource GalleryCard}" Padding="18,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="DetailScroll">
                    <Grid>

                        <StackPanel Spacing="8" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.NoDetailVisibility, Mode=OneWay}">
                            <FontIcon Glyph="&#xE945;" FontSize="34"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Pick a tile to inspect it"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Its help text, current value and firmware metadata open here, and you can edit the value without leaving the grid."
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Style="{StaticResource GalleryPageCaption}" />
                        </StackPanel>

                        <StackPanel Spacing="12"
                                    Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}">
                            <StackPanel Spacing="6">
                                <Border Style="{StaticResource GalleryPill}" HorizontalAlignment="Left"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedRow.SectionText, Mode=OneWay}"
                                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="340" />
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.SelectedRow.Name, Mode=OneWay}"
                                           Style="{StaticResource GallerySectionTitle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.SelectedRow.HelpText, Mode=OneWay}"
                                       Style="{StaticResource GalleryPageCaption}"
                                       TextWrapping="Wrap" />

                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14,12">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Value" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                    <RadioButtons x:Name="ValueOptions"
                                                SelectionChanged="ValueOptions_SelectionChanged"
                                                Visibility="{x:Bind ViewModel.EditingEnumeratedVisibility, Mode=OneWay}" />

                                    <TextBox x:Name="ValueInput"
                                             Text="{x:Bind ViewModel.EditingValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="0x-prefixed hex or decimal"
                                             Visibility="{x:Bind ViewModel.EditingFreeformVisibility, Mode=OneWay}" />

                                    <StackPanel Orientation="Horizontal" Spacing="7"
                                                Visibility="{x:Bind ViewModel.EditingErrorVisibility, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE730;" FontSize="13" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.EditingValidationMessage, Mode=OneWay}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </StackPanel>

                                    <Button Command="{x:Bind ViewModel.ResetSettingCommand}"
                                            CommandParameter="{x:Bind ViewModel.SelectedRow, Mode=OneWay}"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource BiosActionButton}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE72A;" FontSize="13" />
                                            <TextBlock Text="Reset to firmware default" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14,12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Firmware metadata" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Grid ColumnSpacing="12" RowSpacing="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Token" Style="{StaticResource MetaCaption}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.SelectedRow.TokenValueText, Mode=OneWay}"
                                                   Style="{StaticResource GalleryMetaValue}" IsTextSelectionEnabled="True" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Offset" Style="{StaticResource MetaCaption}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedRow.OffsetValueText, Mode=OneWay}"
                                                   Style="{StaticResource GalleryMetaValue}" IsTextSelectionEnabled="True" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Width" Style="{StaticResource MetaCaption}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedRow.WidthValueText, Mode=OneWay}"
                                                   Style="{StaticResource GalleryMetaValue}" IsTextSelectionEnabled="True" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Firmware default" Style="{StaticResource MetaCaption}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedRow.BiosDefaultText, Mode=OneWay}"
                                                   Style="{StaticResource GalleryMetaValue}" IsTextSelectionEnabled="True" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="430">
                    <Border Width="72" Height="72" CornerRadius="20"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE9D9;" FontSize="30"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Border>
                    <TextBlock Text="No firmware document yet"
                               HorizontalAlignment="Center"
                               Style="{StaticResource GallerySectionTitle}" />
                    <TextBlock Text="Open a text file produced by SCEWIN_64.exe /o /s — or let the app export one from this machine — and every setup question becomes an editable tile."
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Style="{StaticResource GalleryPageCaption}" />
                    <Button Content="Import a dump" HorizontalAlignment="Center" Margin="0,6,0,0"
                            Click="LoadDump_Click" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="StagedTray" Grid.Row="3" Style="{StaticResource GalleryCard}" Margin="28,14,28,16" Padding="16,11">
            <StackPanel Spacing="10">
                <Grid x:Name="TrayGrid" ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="TrayRowTop" Height="Auto" />
                        <RowDefinition x:Name="TrayRowBottom" Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="TrayStatus" Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="9"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE74E;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <TextBlock Text="Staged changes" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Border Style="{StaticResource GalleryPill}"
                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ModifiedCountText, Mode=OneWay}"
                                       FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock x:Name="TrayStatusText" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                   Style="{StaticResource GalleryPageCaption}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="460" />
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="TrayToggle" Click="TrayToggle_Click"
                            ToolTipService.ToolTip="Show what is staged"
                            Padding="7,5"
                            IsEnabled="{x:Bind ViewModel.HasChanges, Mode=OneWay}">
                        <FontIcon x:Name="TrayChevron" Glyph="&#xE70E;" FontSize="12" />
                    </Button>

                    <StackPanel x:Name="TrayActions" Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Style="{StaticResource BiosActionButton}"
                                Command="{x:Bind ViewModel.ResetAllCommand}"
                                IsEnabled="{x:Bind ViewModel.HasChanges, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE72A;" FontSize="13" />
                                <TextBlock Text="Revert all" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Click="ApplyToBios_Click"
                                IsEnabled="{x:Bind ViewModel.HasChanges, Mode=OneWay}"
                                ToolTipService.ToolTip="Review the staged values, then write them with SCEWIN"
                                Padding="14,6">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE74E;" FontSize="13" />
                                <TextBlock Text="Apply" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>                        <ListView x:Name="StagedList"
                          automation:AutomationProperties.Name="Staged change list"
                          SelectionMode="None"
                          Visibility="Collapsed"
                          MaxHeight="200"
                          Padding="4,0"
                          ItemTemplate="{StaticResource ChangeSummaryTemplate}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </Border>
    </Grid>
</Page>

