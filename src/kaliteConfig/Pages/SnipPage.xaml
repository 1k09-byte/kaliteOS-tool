<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.SnipPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:kaliteConfig.ViewModels"
    xmlns:services="using:kaliteConfig.Services"
    xmlns:controls="using:kaliteConfig.Controls"
    xmlns:models="using:kaliteConfig.Models"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <Style x:Key="HubTabStyle" TargetType="NavigationViewItem">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CaptureTileStyle" TargetType="Grid">
            <Setter Property="Width" Value="212"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style x:Key="RecentActionStyle" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#99202020"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="SnipSurface" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="SnipActionButton" TargetType="Button">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- Shared ItemContainerStyle to disable default selection/focus visuals -->
        <Style x:Key="SnipCardContainerStyle" TargetType="GridViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <ContentPresenter x:Name="ContentPresenter"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        ContentTransitions="{TemplateBinding ContentTransitions}"
                                        Content="{TemplateBinding Content}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        Padding="{TemplateBinding Padding}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SnipCardContainerStyleListView" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter x:Name="ContentPresenter"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        ContentTransitions="{TemplateBinding ContentTransitions}"
                                        Content="{TemplateBinding Content}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        Padding="{TemplateBinding Padding}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slide-in toast (3 s): bottom-right card for capture/save/import/copy notes -->
        <Storyboard x:Name="ToastIn">
            <DoubleAnimation Storyboard.TargetName="ToastShift" Storyboard.TargetProperty="Y"
                             From="24" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ToastCard" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25"/>
        </Storyboard>
        <Storyboard x:Name="ToastOut">
            <DoubleAnimation Storyboard.TargetName="ToastShift" Storyboard.TargetProperty="Y"
                             From="0" To="24" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ToastCard" Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.25"/>
        </Storyboard>

    </Page.Resources>

    <Page.DataContext>
        <vm:SnipViewModel />
    </Page.DataContext>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <NavigationView x:Name="HubNav" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed" SelectionChanged="HubNav_SelectionChanged" IsSettingsVisible="False" Background="Transparent">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Capture" Content="Capture" Style="{StaticResource HubTabStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7A8;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Gallery" Content="Gallery" Icon="Library" Style="{StaticResource HubTabStyle}"/>
                <NavigationViewItem Tag="Bin" Content="Bin" Style="{StaticResource HubTabStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Stickers" Content="Stickers" Style="{StaticResource HubTabStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE899;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Tools" Content="Tools" Icon="Edit" Style="{StaticResource HubTabStyle}"/>
                <NavigationViewItem Tag="Settings" Content="Settings" Icon="Setting" Style="{StaticResource HubTabStyle}"/>
            </NavigationView.MenuItems>
            
            <Border Margin="20,8,20,16" Style="{StaticResource SnipSurface}">
            <Grid Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <Grid>
                        <!-- Capture Home -->
                        <Grid x:Name="ViewCapture" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="0" Style="{StaticResource SnipSurface}" Padding="18,14" Margin="0,0,0,16">
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE7A8;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="Capture Studio" FontSize="24" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="Create, organize, and share clean screenshots without leaving your workflow." FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            


                            <TextBlock Grid.Row="2" Text="Capture Profile" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,24">
                                <ComboBox x:Name="ProfilePicker" Width="260" SelectedIndex="0" AutomationProperties.Name="Capture profile" SelectionChanged="ProfilePicker_SelectionChanged">
                                    <ComboBoxItem Content="Default (High Quality PNG)"/>
                                    <ComboBoxItem Content="Bug Report (Redact &amp; Copy)"/>
                                    <ComboBoxItem Content="Discord Safe (WebP Compressed)"/>
                                </ComboBox>
                                <Button Content="Edit Profiles" Click="EditProfiles_Click"/>
                            </StackPanel>

                            <Grid Grid.Row="4" Margin="0,0,0,8">
                                <TextBlock Text="Recent Snips" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                                <HyperlinkButton Content="View all" HorizontalAlignment="Right" Click="ViewAllSnips_Click"/>
                            </Grid>
                            <ListView Grid.Row="5" MaxHeight="172" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Auto" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.ZoomMode="Disabled" ItemsSource="{x:Bind ViewModel.RecentSnips}" ContainerContentChanging="RecentList_ContainerContentChanging" SelectionMode="None" ItemContainerStyle="{StaticResource SnipCardContainerStyleListView}">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SnipThumbnailItem">
                                         <Border Width="260" Height="160" Margin="0,0,12,0"
                                                 Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                 BorderThickness="2"
                                                 BorderBrush="Transparent"
                                                 CornerRadius="8"
                                                 ToolTipService.ToolTip="{x:Bind Card.FullErrorText, Mode=OneWay}">
                                              <Grid Margin="2">
                                                  <Grid.RowDefinitions>
                                                      <RowDefinition Height="*"/>
                                                      <RowDefinition Height="Auto"/>
                                                  </Grid.RowDefinitions>
                                                  <Grid>
                                                      <!-- Skeleton: exact final size, so nothing shifts when pixels arrive -->
                                                      <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Visibility="{x:Bind Card.SkeletonVisibility, Mode=OneWay}">
                                                          <Border x:Name="RecentSkeletonHighlight" Opacity="0.35">
                                                              <Border.Background>
                                                                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                      <GradientStop Color="Transparent" Offset="0"/>
                                                                      <GradientStop Color="#33FFFFFF" Offset="0.5"/>
                                                                      <GradientStop Color="Transparent" Offset="1"/>
                                                                  </LinearGradientBrush>
                                                              </Border.Background>
                                                          </Border>
                                                      </Border>
                                                      <Image x:Name="CardImage" Source="{x:Bind Card.Image, Mode=OneWay}" Stretch="{x:Bind Card.ImageStretch, Mode=OneWay}"
                                                             Width="{x:Bind Card.ImageWidth, Mode=OneWay}" Height="{x:Bind Card.ImageHeight, Mode=OneWay}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Visibility="{x:Bind Card.ImageVisibility, Mode=OneWay}"/>
                                                      <!-- Failure / missing file: icon, short reason, action -->
                                                      <StackPanel Spacing="6" Padding="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Visibility="{x:Bind Card.ErrorVisibility, Mode=OneWay}">
                                                          <FontIcon Glyph="&#xE783;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                          <TextBlock Text="{x:Bind Card.ShortErrorText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                     TextWrapping="Wrap" TextAlignment="Center" FontSize="12" MaxLines="3"
                                                                     ToolTipService.ToolTip="{x:Bind Card.FullErrorText, Mode=OneWay}"/>
                                                          <Button Content="Retry" Click="CardRetry_Click" Visibility="{x:Bind Card.RetryVisibility, Mode=OneWay}"/>
                                                          <Button Content="Remove from gallery" Click="CardRemoveMissing_Click" Visibility="{x:Bind Card.RemoveMissingVisibility, Mode=OneWay}"/>
                                                      </StackPanel>
                                                      <!-- Protected/DRM captures are legitimately flat: warn, never hide -->
                                                      <Border Visibility="{x:Bind Card.BlankBadgeVisibility, Mode=OneWay}" Background="#CC3A3A00" CornerRadius="10"
                                                              Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6"
                                                              ToolTipService.ToolTip="Every pixel is identical. Protected or DRM content can legitimately capture as a flat frame.">
                                                          <StackPanel Orientation="Horizontal" Spacing="4">
                                                              <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="#FFFFD24D"/>
                                                              <TextBlock Text="Image looks blank" FontSize="11" Foreground="#FFFFD24D"/>
                                                          </StackPanel>
                                                      </Border>
                                                  </Grid>
                                                  <StackPanel Grid.Row="1" Margin="8,6" Spacing="2">
                                                      <TextBlock Text="{x:Bind Filename}" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" ToolTipService.ToolTip="{x:Bind Filename}"/>
                                                      <StackPanel Orientation="Horizontal" Spacing="8">
                                                          <TextBlock Text="{x:Bind RelativeTimeText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7"/>
                                                          <TextBlock Text="{x:Bind ResolutionText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7"/>
                                                      </StackPanel>
                                                  </StackPanel>
                                                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Spacing="4">
                                                      <Button Style="{StaticResource RecentActionStyle}" Content="&#xE8C8;" FontFamily="{ThemeResource SymbolThemeFontFamily}" Click="RecentCopy_Click" ToolTipService.ToolTip="Copy image" AutomationProperties.Name="Copy image"/>
                                                      <Button Style="{StaticResource RecentActionStyle}" Content="&#xE70F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" Click="RecentEdit_Click" ToolTipService.ToolTip="Edit in Snip" AutomationProperties.Name="Edit snip"/>
                                                      <Button Style="{StaticResource RecentActionStyle}" Content="&#xE8BB;" FontFamily="{ThemeResource SymbolThemeFontFamily}" Click="RecentFolder_Click" ToolTipService.ToolTip="Show in folder" AutomationProperties.Name="Show in folder"/>
                                                      <Button Style="{StaticResource RecentActionStyle}" Content="&#xE74D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" Click="RecentDelete_Click" ToolTipService.ToolTip="Delete" AutomationProperties.Name="Delete snip"/>
                                                  </StackPanel>
                                              </Grid>
                                         </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Quick tools + drop zone + stats -->
                            <TextBlock Grid.Row="6" Text="Quick tools" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,12"/>
                            <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                <Button Content="Open image" Click="QuickOpenImage_Click"/>
                                <Button Content="Copy text from screen" Click="QuickCopyText_Click"/>
                                <Button Content="Color picker" Click="QuickColorPicker_Click"/>
                                <Button Content="Ruler" Click="QuickRuler_Click"/>
                                <Button Content="QR scan" Click="QuickQrScan_Click"/>
                            </StackPanel>
                            <Border Grid.Row="8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24" MinHeight="72" AllowDrop="True" Drop="SnipDropZone_Drop" DragOver="SnipDropZone_DragOver">
                                <TextBlock Text="Drop or paste an image to edit" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Border>
                            <TextBlock Grid.Row="9" Text="{x:Bind ViewModel.StorageText, Mode=OneWay}" Margin="0,12,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </Grid>
                        
                        <!-- Gallery View -->
                        <Grid x:Name="ViewGallery" Visibility="Collapsed">
                             <Grid.RowDefinitions>
                                 <RowDefinition Height="Auto"/>
                                 <RowDefinition Height="Auto"/>
                                 <RowDefinition Height="*"/>
                             </Grid.RowDefinitions>

                             <Grid Margin="0,0,0,8">
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*"/>
                                     <ColumnDefinition Width="Auto"/>
                                 </Grid.ColumnDefinitions>
                                 <TextBlock Text="Gallery" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                                 <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                     <Button Content="Import Images..." Click="ImportImages_Click"/>
                                     <Button Content="Find blanks..." Click="FindBlanks_Click"
                                             ToolTipService.ToolTip="Find flat blank captures taking up space"/>
                                     <Button Content="Refresh" Click="RefreshGallery_Click">
                                         <Button.KeyboardAccelerators>
                                             <KeyboardAccelerator Key="F5"/>
                                         </Button.KeyboardAccelerators>
                                     </Button>
                                 </StackPanel>
                             </Grid>

                             <InfoBar x:Name="GalleryInfoBar" Grid.Row="1" Margin="0,0,0,8" IsOpen="False" IsClosable="True" Severity="Success">
                                 <InfoBar.ActionButton>
                                     <Button Style="{StaticResource SnipActionButton}" Content="Undo" Click="UndoInfoBar_Click" x:Name="UndoInfoButton"/>
                                 </InfoBar.ActionButton>
                             </InfoBar>

                             <Grid Grid.Row="2">
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="Auto"/>
                                     <RowDefinition Height="Auto"/>
                                     <RowDefinition Height="Auto"/>
                                     <RowDefinition Height="*"/>
                                 </Grid.RowDefinitions>
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*"/>
                                     <ColumnDefinition Width="300"/>
                                 </Grid.ColumnDefinitions>

                                 <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="*"/>
                                         <ColumnDefinition Width="Auto"/>
                                     </Grid.ColumnDefinitions>
                                     <StackPanel Orientation="Horizontal" Spacing="8">
                                         <AutoSuggestBox Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}" VerticalAlignment="Bottom" PlaceholderText="Search name, app, tags, OCR..." Width="240" QueryIcon="Find"/>
                                         <ComboBox Header="Type" MinWidth="110" VerticalAlignment="Bottom" ItemsSource="{x:Bind ViewModel.TypeOptions}" SelectedIndex="{x:Bind ViewModel.TypeIndex, Mode=TwoWay}"/>
                                         <ComboBox Header="Format" MinWidth="110" VerticalAlignment="Bottom" ItemsSource="{x:Bind ViewModel.FormatOptions}" SelectedIndex="{x:Bind ViewModel.FormatIndex, Mode=TwoWay}"/>
                                         <ComboBox Header="Date" MinWidth="120" VerticalAlignment="Bottom" ItemsSource="{x:Bind ViewModel.DateOptions}" SelectedIndex="{x:Bind ViewModel.DateIndex, Mode=TwoWay}"/>
                                         <ComboBox Header="App" MinWidth="140" VerticalAlignment="Bottom" ItemsSource="{x:Bind ViewModel.AvailableAppOptions}" SelectedIndex="{x:Bind ViewModel.SelectedAppIndex, Mode=TwoWay}"/>
                                         <ToggleButton IsChecked="{x:Bind ViewModel.FavoritesOnly, Mode=TwoWay}" VerticalAlignment="Bottom" ToolTipService.ToolTip="Show only favorited snips" AutomationProperties.Name="Favorites only">
                                             <StackPanel Orientation="Horizontal" Spacing="8">
                                                 <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE735;" FontSize="14"/>
                                                 <TextBlock Text="Favorites only"/>
                                             </StackPanel>
                                         </ToggleButton>
                                     </StackPanel>
                                 </Grid>

                                 <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="Auto"/>
                                         <ColumnDefinition Width="Auto"/>
                                         <ColumnDefinition Width="Auto"/>
                                         <ColumnDefinition Width="Auto"/>
                                         <ColumnDefinition Width="*"/>
                                         <ColumnDefinition Width="Auto"/>
                                     </Grid.ColumnDefinitions>
                                     <ComboBox Header="Sort" MinWidth="140" VerticalAlignment="Bottom" ItemsSource="{x:Bind ViewModel.SortOptions}" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"/>
                                     <Slider Header="Thumbnail size" Grid.Column="1" Width="140" VerticalAlignment="Bottom" Margin="12,0" Minimum="120" Maximum="380" Value="{x:Bind ViewModel.GalleryThumbSize, Mode=TwoWay}" ToolTipService.ToolTip="Gallery thumbnail size in pixels"/>
                                     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                         <RadioButton Content="&#xE80A;" FontFamily="{ThemeResource SymbolThemeFontFamily}" IsChecked="{x:Bind ViewModel.IsGridView, Mode=TwoWay}" GroupName="ViewMode" MinWidth="40" Padding="8,4" ToolTipService.ToolTip="Grid view" AutomationProperties.Name="Grid view"/>
                                         <RadioButton Content="&#xE8FD;" FontFamily="{ThemeResource SymbolThemeFontFamily}" IsChecked="{x:Bind ViewModel.IsListView, Mode=TwoWay}" GroupName="ViewMode" MinWidth="40" Padding="8,4" ToolTipService.ToolTip="List view" AutomationProperties.Name="List view"/>
                                     </StackPanel>
                                     <HyperlinkButton Grid.Column="3" Content="Clear filters" Margin="12,0,0,0" VerticalAlignment="Bottom" Click="ClearFilters_Click" Visibility="{x:Bind ViewModel.HasActiveFiltersVisibility, Mode=OneWay}"/>
                                     <TextBlock Grid.Column="5" Text="{x:Bind ViewModel.StorageText, Mode=OneWay}" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                 </Grid>

                                 <ScrollViewer Grid.Row="2" Grid.Column="0" Margin="0,0,0,8"
                                              HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                                              VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                                  <Grid Visibility="{x:Bind ViewModel.SelectionBarVisibility, Mode=OneWay}">
                                     <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="Auto"/>
                                      <ColumnDefinition Width="Auto"/>
                                      <ColumnDefinition Width="Auto"/>
                                      <ColumnDefinition Width="Auto"/>
                                      <ColumnDefinition Width="Auto"/>
                                      <ColumnDefinition Width="Auto"/>
                                  </Grid.ColumnDefinitions>
                                      <TextBlock Text="{x:Bind ViewModel.SelectedCountText, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                      <Button Grid.Column="1" Content="Copy" Click="CopySelected_Click"/>
                                      <Button Grid.Column="2" Content="Delete" Click="DeleteSelected_Click" Margin="8,0,0,0"/>
                                      <Button Grid.Column="3" Content="Export ZIP" Click="ExportZipSelected_Click" Margin="8,0,0,0"/>
                                      <Button Grid.Column="4" Content="Convert..." Click="ConvertSelected_Click" Margin="8,0,0,0"/>
                                      <Button Grid.Column="5" Content="Move..." Click="MoveSelected_Click" Margin="8,0,0,0"/>
                                  </Grid>
                                  </ScrollViewer>

                                 <Grid Grid.Row="3" Grid.Column="0">
                                     <GridView x:Name="GalleryGridView"
                                               ItemsSource="{x:Bind ViewModel.GallerySnips}"
                                               SelectedItem="{x:Bind ViewModel.SelectedGalleryItem, Mode=TwoWay}"
                                               SelectionMode="Extended"
                                               IsMultiSelectCheckBoxEnabled="True"
                                               SelectionChanged="GalleryGrid_SelectionChanged"
                                               ContainerContentChanging="GalleryGrid_ContainerContentChanging"
                                               CanDragItems="True" AllowDrop="True"
                                               DragItemsStarting="GalleryGrid_DragItemsStarting"
                                               DragOver="GalleryGrid_DragOver"
                                               Drop="GalleryGrid_Drop"
                                               ItemContainerStyle="{StaticResource SnipCardContainerStyle}"
                                               Visibility="{x:Bind ViewModel.GridViewVisibility, Mode=OneWay}">
                                         <GridView.ItemsPanel>
                                             <ItemsPanelTemplate>
                                                 <ItemsWrapGrid Orientation="Horizontal"/>
                                             </ItemsPanelTemplate>
                                         </GridView.ItemsPanel>
                                         <GridView.ItemTemplate>
                                             <DataTemplate x:DataType="vm:GalleryItem">
                                                  <Border Width="{x:Bind ThumbSize, Mode=OneWay}" Height="{x:Bind ThumbSize, Mode=OneWay}" Margin="4"
                                                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                          BorderBrush="{x:Bind TileBorder, Mode=OneWay}"
                                                          BorderThickness="2"
                                                          CornerRadius="8"
                                                          PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited"
                                                          ToolTipService.ToolTip="{x:Bind Card.FullErrorText, Mode=OneWay}">
                                                     <Border.ContextFlyout>
                                                         <MenuFlyout>
                                                             <MenuFlyoutItem Text="Open in Viewer" Command="{x:Bind OpenInViewerCommand}"/>
                                                             <MenuFlyoutItem Text="Open" Command="{x:Bind OpenCommand}"/>
                                                             <MenuFlyoutItem Text="Copy Image" Command="{x:Bind CopyImageCommand}"/>
                                                             <MenuFlyoutItem Text="Copy Path" Command="{x:Bind CopyPathCommand}"/>
                                                             <MenuFlyoutItem Text="Copy Text (OCR)" Command="{x:Bind CopyTextCommand}"/>
                                                             <MenuFlyoutSeparator/>
                                                             <MenuFlyoutItem Text="Toggle Favorite" Command="{x:Bind ToggleFavoriteCommand}"/>
                                                             <MenuFlyoutItem Text="Resize ..." Click="ResizeSingle_Click"/>
                                                             <MenuFlyoutItem Text="Rename ..." Command="{x:Bind RenameCommand}"/>
                                                             <MenuFlyoutItem Text="Open Containing Folder" Command="{x:Bind OpenContainingFolderCommand}"/>
                                                             <MenuFlyoutSeparator/>
                                                             <MenuFlyoutItem Text="Delete" Command="{x:Bind DeleteCommand}"/>
                                                         </MenuFlyout>
                                                     </Border.ContextFlyout>
                                                     <Grid Margin="2">
                                                         <!-- SINGLE ITEM VIEW -->
                                                         <Grid>
                                                             <!-- Skeleton at the exact final size: no layout shift on load -->
                                                             <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Visibility="{x:Bind Card.SkeletonVisibility, Mode=OneWay}">
                                                                 <Border x:Name="GallerySkeletonHighlight" Opacity="0.35">
                                                                     <Border.Background>
                                                                         <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                             <GradientStop Color="Transparent" Offset="0"/>
                                                                             <GradientStop Color="#33FFFFFF" Offset="0.5"/>
                                                                             <GradientStop Color="Transparent" Offset="1"/>
                                                                         </LinearGradientBrush>
                                                                     </Border.Background>
                                                                 </Border>
                                                             </Border>
                                                             <Image x:Name="CardImage" Source="{x:Bind Card.Image, Mode=OneWay}" Stretch="{x:Bind Card.ImageStretch, Mode=OneWay}"
                                                                    Width="{x:Bind Card.ImageWidth, Mode=OneWay}" Height="{x:Bind Card.ImageHeight, Mode=OneWay}"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    Visibility="{x:Bind Card.ImageVisibility, Mode=OneWay}"/>
                                                             <!-- Failed / missing file state -->
                                                             <StackPanel Spacing="6" Padding="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                         Visibility="{x:Bind Card.ErrorVisibility, Mode=OneWay}">
                                                                 <FontIcon Glyph="&#xE783;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                 <TextBlock Text="{x:Bind Card.ShortErrorText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                             TextWrapping="Wrap" TextAlignment="Center" FontSize="11" MaxLines="3"
                                                                             ToolTipService.ToolTip="{x:Bind Card.FullErrorText, Mode=OneWay}"/>
                                                                 <Button Content="Retry" FontSize="11" Click="CardRetry_Click" Visibility="{x:Bind Card.RetryVisibility, Mode=OneWay}"/>
                                                                 <Button Content="Remove from gallery" FontSize="11" Click="CardRemoveMissing_Click" Visibility="{x:Bind Card.RemoveMissingVisibility, Mode=OneWay}"/>
                                                             </StackPanel>
                                                             <!-- Blank-frame warning badge -->
                                                             <Border Visibility="{x:Bind Card.BlankBadgeVisibility, Mode=OneWay}" Background="#CC3A3A00" CornerRadius="10"
                                                                     Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                                     ToolTipService.ToolTip="Every pixel is identical. Protected or DRM content can legitimately capture as a flat frame.">
                                                                 <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="#FFFFD24D"/>
                                                             </Border>
                                                         </Grid>


                                                         <!-- Common Footer Overlay (gradients, name, selection badge) -->
                                                         <Border VerticalAlignment="Bottom" Height="36">
                                                             <Border.Background>
                                                                 <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                     <GradientStop Color="#00000000" Offset="0"/>
                                                                     <GradientStop Color="#99000000" Offset="1"/>
                                                                 </LinearGradientBrush>
                                                             </Border.Background>
                                                         </Border>
                                                         <TextBlock Text="{x:Bind Name}" Foreground="White" VerticalAlignment="Bottom" Margin="8,4" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="11"/>
                                                         <Button BorderThickness="0" Background="#66000000" CornerRadius="16" Width="30" Height="30" Margin="4" Padding="0" VerticalAlignment="Top" HorizontalAlignment="Left" Command="{x:Bind ToggleFavoriteCommand}" Visibility="{x:Bind StarVisibility, Mode=OneWay}" Opacity="{x:Bind StarOpacity, Mode=OneWay}">
                                                             <FontIcon Glyph="{x:Bind FavoriteGlyph}" FontSize="14" Foreground="{x:Bind StarBrush, Mode=OneWay}"/>
                                                         </Button>
                                                         <Border CornerRadius="12" Width="22" Height="22" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4" Background="#CC2F2F2F" Visibility="{x:Bind IsSelected, Mode=OneWay}">
                                                             <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White"/>
                                                         </Border>
                                                     </Grid>
                                                 </Border>
                                             </DataTemplate>
                                         </GridView.ItemTemplate>
                                     </GridView>

                                     <ListView x:Name="GalleryListView"
                                               ItemsSource="{x:Bind ViewModel.GallerySnips}"
                                               SelectedItem="{x:Bind ViewModel.SelectedGalleryItem, Mode=TwoWay}"
                                               SelectionMode="Extended"
                                               IsMultiSelectCheckBoxEnabled="True"
                                               SelectionChanged="GalleryGrid_SelectionChanged"
                                               ContainerContentChanging="GalleryGrid_ContainerContentChanging"
                                               DragItemsStarting="GalleryGrid_DragItemsStarting"
                                               ItemContainerStyle="{StaticResource SnipCardContainerStyleListView}"
                                               Visibility="{x:Bind ViewModel.ListViewVisibility, Mode=OneWay}">
                                         <ListView.ItemTemplate>
                                             <DataTemplate x:DataType="vm:GalleryItem">
                                                 <Border Margin="4"
                                                         Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                         BorderBrush="{x:Bind TileBorder, Mode=OneWay}"
                                                         BorderThickness="2"
                                                         CornerRadius="8"
                                                         PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
                                                     <Border.ContextFlyout>
                                                         <MenuFlyout>
                                                             <MenuFlyoutItem Text="Open in Viewer" Command="{x:Bind OpenInViewerCommand}"/>
                                                             <MenuFlyoutItem Text="Open" Command="{x:Bind OpenCommand}"/>
                                                             <MenuFlyoutItem Text="Copy Image" Command="{x:Bind CopyImageCommand}"/>
                                                             <MenuFlyoutItem Text="Copy Path" Command="{x:Bind CopyPathCommand}"/>
                                                             <MenuFlyoutItem Text="Copy Text (OCR)" Command="{x:Bind CopyTextCommand}"/>
                                                             <MenuFlyoutSeparator/>
                                                             <MenuFlyoutItem Text="Toggle Favorite" Command="{x:Bind ToggleFavoriteCommand}"/>
                                                             <MenuFlyoutItem Text="Resize ..." Click="ResizeSingle_Click"/>
                                                             <MenuFlyoutItem Text="Rename ..." Command="{x:Bind RenameCommand}"/>
                                                             <MenuFlyoutItem Text="Open Containing Folder" Command="{x:Bind OpenContainingFolderCommand}"/>
                                                             <MenuFlyoutSeparator/>
                                                             <MenuFlyoutItem Text="Delete" Command="{x:Bind DeleteCommand}"/>
                                                         </MenuFlyout>
                                                     </Border.ContextFlyout>
                                                     <Grid Margin="2" Height="96">
                                                         <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="128"/>
                                                             <ColumnDefinition Width="*"/>
                                                         </Grid.ColumnDefinitions>
                                                         <Grid Width="128" Height="96">
                                                             <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Visibility="{x:Bind Card.SkeletonVisibility, Mode=OneWay}"/>
                                                             <Image x:Name="CardImage" Source="{x:Bind Card.Image, Mode=OneWay}" Stretch="Uniform" Width="128" Height="96"
                                                                    Visibility="{x:Bind Card.ImageVisibility, Mode=OneWay}"/>
                                                             <StackPanel Spacing="4" Padding="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                         Visibility="{x:Bind Card.ErrorVisibility, Mode=OneWay}">
                                                                 <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                 <TextBlock Text="{x:Bind Card.ShortErrorText, Mode=OneWay}" FontSize="10" TextWrapping="Wrap" TextAlignment="Center"
                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                            ToolTipService.ToolTip="{x:Bind Card.FullErrorText, Mode=OneWay}"/>
                                                             </StackPanel>
                                                         </Grid>
                                                         <StackPanel Grid.Column="1" Margin="12,8" VerticalAlignment="Center" Spacing="2">
                                                             <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                                             <TextBlock Text="{x:Bind CreatedText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                                             <StackPanel Orientation="Horizontal" Spacing="8">
                                                                 <TextBlock Text="{x:Bind SizeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                                                 <TextBlock Text="{x:Bind ResolutionText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                                             </StackPanel>
                                                             <Button Content="Retry" FontSize="11" HorizontalAlignment="Left" Click="CardRetry_Click" Visibility="{x:Bind Card.RetryVisibility, Mode=OneWay}"/>
                                                             <Button Content="Remove from gallery" FontSize="11" HorizontalAlignment="Left" Click="CardRemoveMissing_Click" Visibility="{x:Bind Card.RemoveMissingVisibility, Mode=OneWay}"/>
                                                         </StackPanel>
                                                     </Grid>
                                                 </Border>
                                             </DataTemplate>
                                         </ListView.ItemTemplate>
                                     </ListView>
                                 </Grid>

                                 <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Margin="16,0,0,0" Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                                     <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="0,0,8,0">
                                         <StackPanel Spacing="12">
                                             <TextBlock Text="Item Details" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                             <TextBlock Text="Select a snip to see its details." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                                        Visibility="{x:Bind ViewModel.DetailsEmptyVisibility, Mode=OneWay}"/>
                                             <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.DetailsContentVisibility, Mode=OneWay}">
                                                 <!-- The large preview: same Win2D pipeline as the full viewer, so the
                                                      panel and the viewer can never disagree about a snip. Double-tap to
                                                      detach it into the viewer window. -->
                                                 <Border Height="220" CornerRadius="8" BorderThickness="1"
                                                         BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                         Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                     <controls:SnipPreviewView x:Name="DetailsPreview"
                                                                               SourcePath="{x:Bind ViewModel.SelectedGalleryItem.FilePath, Mode=OneWay}"
                                                                               PreviewActivated="DetailsPreview_Activated"/>
                                                 </Border>
                                                 <StackPanel Orientation="Horizontal" Spacing="8"
                                                             Visibility="{x:Bind ViewModel.SelectedGalleryItem.Card.ErrorVisibility, Mode=OneWay}">
                                                     <Button Content="Retry" Click="DetailsRetry_Click"
                                                             Visibility="{x:Bind ViewModel.SelectedGalleryItem.Card.RetryVisibility, Mode=OneWay}"/>
                                                     <Button Content="Remove from gallery" Click="DetailsRemoveMissing_Click"
                                                             Visibility="{x:Bind ViewModel.SelectedGalleryItem.Card.RemoveMissingVisibility, Mode=OneWay}"/>
                                                 </StackPanel>
                                                 <TextBlock Text="{x:Bind ViewModel.SelectedGalleryItem.Name, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind ViewModel.SelectedGalleryItem.FilePath, Mode=OneWay}"/>
                                                 <TextBlock Text="{x:Bind ViewModel.SelectedGalleryItem.FilePath, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="11" ToolTipService.ToolTip="{x:Bind ViewModel.SelectedGalleryItem.FilePath, Mode=OneWay}"/>
                                                 <Grid>
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="Auto"/>
                                                         <ColumnDefinition Width="*"/>
                                                     </Grid.ColumnDefinitions>
                                                     <Grid.RowDefinitions>
                                                         <RowDefinition Height="Auto"/>
                                                         <RowDefinition Height="Auto"/>
                                                         <RowDefinition Height="Auto"/>
                                                         <RowDefinition Height="Auto"/>
                                                         <RowDefinition Height="Auto"/>
                                                         <RowDefinition Height="Auto"/>
                                                     </Grid.RowDefinitions>
                                                     <TextBlock Grid.Row="0" Text="Type" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                                                     <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.SelectedGalleryItem.TypeText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.SelectedGalleryItem.TypeText, Mode=OneWay}"/>
                                                     <TextBlock Grid.Row="1" Text="Created" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                     <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedGalleryItem.CreatedText, Mode=OneWay}" TextWrapping="Wrap"/>
                                                     <TextBlock Grid.Row="2" Text="Size" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                     <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedGalleryItem.SizeText, Mode=OneWay}" TextWrapping="Wrap"/>
                                                     <TextBlock Grid.Row="3" Text="Resolution" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                     <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedGalleryItem.ResolutionText, Mode=OneWay}" TextWrapping="Wrap"/>
                                                     <TextBlock Grid.Row="4" Text="Source" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                     <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.SelectedGalleryItem.SourceAppText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.SelectedGalleryItem.SourceAppText, Mode=OneWay}"/>
                                                     <TextBlock Grid.Row="5" Text="Tags" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                     <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.SelectedGalleryItem.TagsText, Mode=OneWay}" TextWrapping="Wrap"/>
                                                 </Grid>
                                                <!-- Icon + label: the glyph lives in a FontIcon, never in Button.Content
                                                     with the icon font applied to the whole string (that turned the
                                                     labels into tofu boxes). -->
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Command="{x:Bind ViewModel.SelectedGalleryItem.CopyImageCommand, Mode=OneWay}"
                                                            ToolTipService.ToolTip="Copy image">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" FontSize="14"/>
                                                            <TextBlock Text="Copy"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="DetailsEdit_Click" ToolTipService.ToolTip="Edit in Snip">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE70F;" FontSize="14"/>
                                                            <TextBlock Text="Edit"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="DetailsView_Click" ToolTipService.ToolTip="Open the full viewer">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8A7;" FontSize="14"/>
                                                            <TextBlock Text="View"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="DetailsResize_Click" ToolTipService.ToolTip="Resize this snip">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE799;" FontSize="14"/>
                                                            <TextBlock Text="Resize"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel>
                                                     <StackPanel.ContextFlyout>
                                                         <MenuFlyout>
                                                             <MenuFlyoutItem Text="Open" Command="{x:Bind ViewModel.SelectedGalleryItem.OpenCommand, Mode=OneWay}"/>
                                                         </MenuFlyout>
                                                     </StackPanel.ContextFlyout>
                                                     <Button Content="Open" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,2" Command="{x:Bind ViewModel.SelectedGalleryItem.OpenCommand, Mode=OneWay}"/>
                                                     <Button Content="Copy path" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,2" Command="{x:Bind ViewModel.SelectedGalleryItem.CopyPathCommand, Mode=OneWay}"/>
                                                     <Button Content="Copy text (OCR)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,2" Command="{x:Bind ViewModel.SelectedGalleryItem.CopyTextCommand, Mode=OneWay}"/>
                                                     <Button Content="Rename" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,2" Command="{x:Bind ViewModel.SelectedGalleryItem.RenameCommand, Mode=OneWay}"/>
                                                     <Button Content="Favorite" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,2" Command="{x:Bind ViewModel.SelectedGalleryItem.ToggleFavoriteCommand, Mode=OneWay}"/>
                                                     <Button Content="Show in folder" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,2" Command="{x:Bind ViewModel.SelectedGalleryItem.OpenContainingFolderCommand, Mode=OneWay}"/>
                                                     <Button Content="Pin to screen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,2" Click="DetailsPin_Click"/>
                                                     <Button Content="Delete" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,2" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Command="{x:Bind ViewModel.SelectedGalleryItem.DeleteCommand, Mode=OneWay}"/>
                                                 </StackPanel>
                                             </StackPanel>
                                         </StackPanel>
                                     </ScrollViewer>
                                 </Border>
                             </Grid>
                        </Grid>
                        
                        <!-- Stickers View -->
                        <Grid x:Name="ViewStickers" Visibility="Collapsed">
                             <StackPanel Spacing="16">
                                 <TextBlock Text="Stickers" Style="{ThemeResource TitleTextBlockStyle}" />
                                 <TextBlock Text="Import your own stickers, then stamp them onto captures with the sticker tool (K) in the capture overlay." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                 <StackPanel Orientation="Horizontal" Spacing="8">
                                     <Button Content="Import Stickers..." Click="ImportStickers_Click"/>
                                     <Button Content="Delete Selected" Click="DeleteStickers_Click"/>
                                 </StackPanel>
                                 <TextBlock x:Name="StickersEmptyText" Text="No stickers yet. Import some PNGs to get started."
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                                 <GridView x:Name="StickerGalleryView" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="True"
                                           SelectionChanged="StickerGallery_SelectionChanged">
                                     <GridView.ItemsPanel>
                                         <ItemsPanelTemplate>
                                             <ItemsWrapGrid Orientation="Horizontal"/>
                                         </ItemsPanelTemplate>
                                     </GridView.ItemsPanel>
                                     <GridView.ItemTemplate>
                                         <DataTemplate x:DataType="services:StickerEntry">
                                             <Grid Width="140" Margin="4">
                                                 <Grid.RowDefinitions>
                                                     <RowDefinition Height="110"/>
                                                     <RowDefinition Height="Auto"/>
                                                 </Grid.RowDefinitions>
                                                 <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                     <Image Source="{x:Bind FilePath, Mode=OneTime}" Stretch="Uniform" Margin="8"/>
                                                 </Border>
                                                 <TextBlock Grid.Row="1" Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                            HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12"/>
                                             </Grid>
                                         </DataTemplate>
                                     </GridView.ItemTemplate>
                                 </GridView>
                             </StackPanel>
                        </Grid>

                        <!-- Bin View -->
                        <Grid x:Name="ViewBin" Visibility="Collapsed">
                             <StackPanel Spacing="16">
                                 <TextBlock Text="Bin" Style="{ThemeResource TitleTextBlockStyle}" />
                                 <TextBlock Text="Deleted snips wait here until you restore them or empty the bin. Nothing is purged automatically." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                 <StackPanel Orientation="Horizontal" Spacing="8">
                                     <Button Content="Restore Selected" Click="RestoreTrash_Click"/>
                                     <Button Content="Delete Forever" Click="DeleteTrashForever_Click"/>
                                     <Button Content="Empty Bin" Click="EmptyBin_Click"/>
                                 </StackPanel>
                                 <TextBlock x:Name="BinEmptyText" Text="Bin is empty."
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                                 <GridView x:Name="BinGridView" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="True"
                                           ItemsSource="{x:Bind ViewModel.TrashItems, Mode=OneWay}"
                                           ContainerContentChanging="RecentList_ContainerContentChanging">
                                     <GridView.ItemsPanel>
                                         <ItemsPanelTemplate>
                                             <ItemsWrapGrid Orientation="Horizontal"/>
                                         </ItemsPanelTemplate>
                                     </GridView.ItemsPanel>
                                     <GridView.ItemTemplate>
                                         <DataTemplate x:DataType="vm:SnipThumbnailItem">
                                             <Grid Width="180" Margin="4">
                                                 <Grid.RowDefinitions>
                                                     <RowDefinition Height="110"/>
                                                     <RowDefinition Height="Auto"/>
                                                 </Grid.RowDefinitions>
                                                 <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                     <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" Margin="6"/>
                                                 </Border>
                                                 <TextBlock Grid.Row="1" Text="{x:Bind Filename, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                            HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12"/>
                                             </Grid>
                                         </DataTemplate>
                                     </GridView.ItemTemplate>
                                 </GridView>
                             </StackPanel>
                        </Grid>

                        <!-- Tools View -->
                        <Grid x:Name="ViewTools" Visibility="Collapsed">
                             <StackPanel Spacing="16">
                                 <TextBlock Text="Tools" Style="{ThemeResource TitleTextBlockStyle}" />
                                 <TextBlock Text="Analysis and Pixel Operations go here." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                 <StackPanel x:Name="IconTestPanel" Spacing="4" />
                             </StackPanel>
                        </Grid>

                        <!-- Settings View -->
                        <Grid x:Name="ViewSettings" Visibility="Collapsed">
                            <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Left">
                                <TextBlock Text="Snip Configuration" Style="{ThemeResource TitleTextBlockStyle}" />
                                
                                <Grid Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Instant Auto-Copy" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Copy to clipboard on release and close immediately. Turn off to keep the editor toolbar instead." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.IsInstantModeEnabled, Mode=TwoWay}" />
                                </Grid>

                                <Grid Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Capture notifications" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Slide-in confirmation after capture, save, import and copy. Lasts 3 seconds, bottom-right. Undo and errors always use the banner instead." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.SnipToastEnabled, Mode=TwoWay}" />
                                </Grid>

                                <Grid Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Fill card thumbnails" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Off (default): every thumbnail fits inside its card, never cropped. On: thumbnails cover the card, so very wide or tall snips are cropped to fill it." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.ThumbnailFillMode, Mode=TwoWay}"/>
                                </Grid>

                                <Grid Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Capture Hotkey" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Select the global hardware interrupt shortcut to instantly freeze the screen." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" VerticalAlignment="Center" Width="150" 
                                              ItemsSource="{x:Bind ViewModel.HotkeyPresets}" 
                                              SelectedIndex="{x:Bind ViewModel.SelectedHotkeyIndex, Mode=TwoWay}" />
                                </Grid>

                                <Grid Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Custom combination" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Capture any Ctrl/Shift/Alt + key. Taken keys warn and keep the old hotkey. The Win key cannot be captured." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock x:Name="CustomHotkeyLabel" Text="{x:Bind ViewModel.CustomHotkeyText, Mode=OneWay}" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                        <Button x:Name="CaptureHotkeyButton" Content="Press keys…" Click="CaptureHotkeyButton_Click" KeyDown="CaptureHotkeyButton_KeyDown"
                                                ToolTipService.ToolTip="Focus, then press the wanted combination. Esc cancels."/>
                                    </StackPanel>
                                </Grid>

                                <Grid Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Auto-delete old snips" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Automatically remove snips older than the chosen age (favorites are kept)." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" VerticalAlignment="Center" Width="160"
                                              SelectedIndex="{x:Bind ViewModel.AutoDeleteIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Disabled"/>
                                        <ComboBoxItem Content="After 7 days"/>
                                        <ComboBoxItem Content="After 30 days"/>
                                        <ComboBoxItem Content="After 90 days"/>
                                        <ComboBoxItem Content="After 1 year"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Override Windows Snipping Tool" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Modifies the Registry so Windows stops stealing the PrtScn key (takes effect after sign out/in), then re-registers the kalite hotkey." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Disable Key Hijacking" Command="{x:Bind ViewModel.DisableWindowsSnippingCommand}" />
                                        <Button Content="Remove Built-in App" Command="{x:Bind ViewModel.ForceRemoveSnippingToolCommand}" ToolTipService.ToolTip="Completely rips out SnippingTool.exe and its UWP package." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
            </Border>
        </NavigationView>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Margin="20,0,20,8" Padding="12,6">
             <StackPanel Orientation="Horizontal" Spacing="16">
                 <TextBlock Text="{x:Bind ViewModel.StatusBarRegistrationText, Mode=OneWay}" Foreground="{x:Bind ViewModel.StatusBarHotkeyBrush, Mode=OneWay}" VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind ViewModel.StatusBarHotkeyTooltip, Mode=OneWay}"/>
                 <TextBlock Text="{x:Bind ViewModel.StatusBarHijackText, Mode=OneWay}" Foreground="{x:Bind ViewModel.StatusBarPrtScnBrush, Mode=OneWay}" VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind ViewModel.StatusBarPrtScnTooltip, Mode=OneWay}" Tapped="StatusBarPrtScn_Tapped"/>
                 <Border Background="#33C4A483" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.ElevationBadgeVisibility, Mode=OneWay}"
                         ToolTipService.ToolTip="The app runs elevated: drag-and-drop to non-elevated apps (Explorer, Discord) is blocked by Windows. Use Copy Image / Copy File instead.">
                     <TextBlock Text="{x:Bind ViewModel.ElevationBadgeText, Mode=OneWay}" FontSize="11" Foreground="#FFC4A483"/>
                 </Border>
                 <TextBlock Text="{x:Bind ViewModel.StatusBarSnipCountText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
             </StackPanel>
        </Border>

        <!-- Slide-in toast card: bottom-right, 3 s, optional (see Settings) -->
        <Border x:Name="ToastCard" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,84" MaxWidth="360" Visibility="Collapsed" Canvas.ZIndex="10"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Tapped="ToastCard_Tapped">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" Y="24"/>
            </Border.RenderTransform>
            <StackPanel Spacing="2">
                <TextBlock x:Name="ToastTitle" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <TextBlock x:Name="ToastMessage" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
