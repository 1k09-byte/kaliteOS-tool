<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.UninstallerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:kaliteConfig.ViewModels"
    xmlns:models="using:kaliteConfig.Models"
    xmlns:converters="using:kaliteConfig.Converters"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <SolidColorBrush x:Key="StartupRowHoverBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
        <SolidColorBrush x:Key="StartupRowPressedBrush" Color="{ThemeResource SubtleFillColorTertiary}" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <Style x:Key="CardListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Card" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Card.Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Card.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="Card.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                            <Setter Target="Card.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="Card.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                            <Setter Target="Card.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="Card.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                            <Setter Target="Card.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Card.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SourcesCardListViewItemStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource CardListViewItemStyle}">
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="TableRowListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1,12,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Page.DataContext>
        <vm:UninstallerViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1008" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AppDetailsPane.DisplayMode" Value="Overlay" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="SectionHeader" Grid.Row="0" Margin="28,16,28,8" Spacing="2">
            <TextBlock x:Name="SectionTitle" Text="Uninstaller" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="SectionSubtitle" Text="Remove installed applications and leftover folders."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid x:Name="UninstallerPanel" Grid.Row="1" Padding="28,0,28,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox Grid.Column="0" PlaceholderText="Search name or publisher..." QueryIcon="Find"
                                Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="1" Text="{Binding SummaryText}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SelectionText" Grid.Column="2" Text=""
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <CommandBar Grid.Column="3" DefaultLabelPosition="Right" HorizontalAlignment="Right">
                    <AppBarButton Icon="Refresh" Label="Refresh" Command="{Binding LoadAppsCommand}" />
                    <AppBarButton Label="Export list..." Command="{Binding ExportListCommand}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74E;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <RadioButtons x:Name="FilterRadios" Grid.Column="0" MaxColumns="4"
                              SelectedIndex="{Binding FilterIndex, Mode=TwoWay}">
                    <x:String>All</x:String>
                    <x:String>Desktop</x:String>
                    <x:String>Store</x:String>
                    <x:String>No uninstaller</x:String>
                </RadioButtons>
                <CheckBox Grid.Column="1" Content="Show system components" VerticalAlignment="Center"
                          IsChecked="{Binding ShowSystem, Mode=TwoWay}"
                          ToolTipService.ToolTip="Include Windows system components in the list" />
                <TextBlock Grid.Column="3" Text="Sort" Style="{StaticResource BodyTextBlockStyle}"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="4" VerticalAlignment="Center"
                          SelectedIndex="{Binding SortIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Name" />
                    <ComboBoxItem Content="Publisher" />
                    <ComboBoxItem Content="Size" />
                    <ComboBoxItem Content="Installed" />
                </ComboBox>
            </Grid>

            <SplitView x:Name="AppDetailsPane" Grid.Row="2" DisplayMode="Inline" PanePlacement="Right"
                       OpenPaneLength="320" IsPaneOpen="False" PaneBackground="Transparent">
                <SplitView.Pane>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16" Margin="8,0,0,0">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="32" Height="32" VerticalAlignment="Center">
                                    <Image Source="{Binding SelectedApp.Icon}" Stretch="Uniform"
                                           Visibility="{Binding SelectedApp.HasRealIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <FontIcon Glyph="{Binding SelectedApp.Glyph}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Visibility="{Binding SelectedApp.HasRealIcon, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedApp.Name}"
                                               Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedApp.Publisher}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Click="DetailsClose_Click" Width="32" Height="32"
                                        Padding="0" Background="Transparent" BorderThickness="0"
                                        VerticalAlignment="Top"
                                        AutomationProperties.Name="Close details"
                                        ToolTipService.ToolTip="Close">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Version" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedApp.Version}"
                                               Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="4"
                                            Visibility="{Binding SelectedApp.FormattedSize, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Size" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedApp.FormattedSize}"
                                               Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="4"
                                            Visibility="{Binding SelectedApp.FormattedInstallDate, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Installed" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedApp.FormattedInstallDate}"
                                               Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Source" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedApp.SourceLabel}"
                                               Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="4"
                                            Visibility="{Binding SelectedApp.InstallLocation, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Location" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedApp.InstallLocation}"
                                               Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Spacing="4"
                                            Visibility="{Binding SelectedApp.UninstallString, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Uninstall command"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedApp.UninstallString}"
                                               Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Spacing="8">
                                <Button Content="Uninstall" HorizontalAlignment="Stretch"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="DetailsUninstall_Click" />
                                <Button HorizontalAlignment="Stretch" Click="DetailsForceRemove_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" />
                                        <TextBlock Text="Force Remove..." />
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" Command="{Binding OpenInstallFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B7;" />
                                        <TextBlock Text="Open install folder" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding ActionStatus}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding ActionStatus, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert, FallbackValue=Collapsed}" />
                            </StackPanel>
                    </Grid>
                    </Border>
                </SplitView.Pane>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Version" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Installed" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="Source" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ListView x:Name="AppList" Grid.Row="1" ItemsSource="{Binding FilteredApps}"
                              SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                              SelectionMode="Single" SelectionChanged="AppList_SelectionChanged"
                              ItemContainerStyle="{StaticResource CardListViewItemStyle}"
                              Visibility="{Binding IsLoading, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:UninstallerItem">
                                <Grid ColumnSpacing="12"
                                      PointerPressed="AppRow_PointerPressed"
                                      PointerReleased="AppRow_PointerReleased">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="32" Height="32" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Stretch="Uniform"
                                                   Visibility="{Binding HasRealIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <FontIcon Glyph="{Binding Glyph}" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding HasRealIcon, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Publisher}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Version}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding FormattedSize}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding FormattedInstallDate}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding SourceLabel}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ProgressRing IsActive="{Binding IsLoading}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding LoadingStatus}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="No applications match your filters."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </SplitView>
        </Grid>
    </Grid>
</Page>
