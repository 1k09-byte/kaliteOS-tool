<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.UninstallerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:kaliteConfig.ViewModels"
    xmlns:models="using:kaliteConfig.Models"
    xmlns:converters="using:kaliteConfig.Converters"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <Style x:Key="RemoverCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="12" />
        </Style>
    </Page.Resources>

    <Page.DataContext>
        <vm:UninstallerViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="36,8,36,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Uninstall" Style="{StaticResource TitleLargeTextBlockStyle}" Margin="0,2,0,0"
                           ToolTipService.ToolTip="Uninstaller &amp; remover - applications, driver packages, startup entries" />
                <TextBlock Text="{Binding SummaryText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding LoadAppsCommand}" VerticalAlignment="Bottom" />
        </Grid>

        <Border Grid.Row="1" Margin="28,14,28,0" Style="{StaticResource RemoverCard}" Padding="12,10"
                Visibility="{Binding IsUninstallerTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox CornerRadius="{ThemeResource ControlCornerRadius}" Grid.Column="0" PlaceholderText="Search name or publisher..." QueryIcon="Find"
                            Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
            <ComboBox CornerRadius="{ThemeResource ControlCornerRadius}" Grid.Column="1" SelectedIndex="{Binding SortIndex, Mode=TwoWay}" Width="130" VerticalAlignment="Center"
                      Header="Sort" FontSize="12">
                <ComboBoxItem Content="Name" />
                <ComboBoxItem Content="Publisher" />
                <ComboBoxItem Content="Size" />
                <ComboBoxItem Content="Installed" />
            </ComboBox>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                <ToggleButton x:Name="ChipAll" Content="All" Tag="0" IsChecked="True" Click="FilterChip_Click" />
                <ToggleButton x:Name="ChipDesktop" Content="Desktop" Tag="1" Click="FilterChip_Click" />
                <ToggleButton x:Name="ChipStore" Content="Store" Tag="2" Click="FilterChip_Click" />
                <ToggleButton x:Name="ChipNoUn" Content="No uninstaller" Tag="3" Click="FilterChip_Click" />
            </StackPanel>
        </Grid>
        </Border>

        <Border Grid.Row="2" Margin="28,12,28,12" Style="{StaticResource RemoverCard}" Padding="12,8"
                Visibility="{Binding IsUninstallerTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Export list..." Command="{Binding ExportListCommand}" />
            <CheckBox Content="Show system components" Margin="8,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ShowSystem, Mode=TwoWay}"
                      ToolTipService.ToolTip="Include Windows system components in the list" />
            <TextBlock x:Name="SelectionText" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="28,0,28,24" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <SelectorBar x:Name="MainPivot" Grid.Row="0" HorizontalAlignment="Left"
                         SelectionChanged="MainPivot_SelectionChanged">
                <SelectorBarItem x:Name="TabUninstaller" Text="Uninstaller" IsSelected="True" />
                <SelectorBarItem x:Name="TabRemover" Text="Remover" />
                <SelectorBarItem x:Name="TabStartup" Text="Startup" />
            </SelectorBar>

            <Grid Grid.Row="1">
        <Grid x:Name="UninstallerPanel" Margin="0,12,0,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>                        <Border Grid.Row="0" Margin="0,0,0,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12,8">
                        <Grid>
                            <Grid.Margin>0</Grid.Margin>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="Version" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="Size" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="Installed" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="Source" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                </Border>

                <ListView x:Name="AppList" Grid.Row="1" ItemsSource="{Binding FilteredApps}" SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                          SelectionMode="Extended" ShowsScrollingPlaceholders="True" SelectionChanged="AppList_SelectionChanged"
                          HorizontalContentAlignment="Stretch"
                          Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:UninstallerItem">
                            <Grid Padding="8,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform"
                                               Visibility="{Binding HasRealIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Grid Visibility="{Binding HasRealIcon, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                            <Border CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.2" />
                                            <TextBlock Text="{Binding Initial}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border Width="16" Height="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4">
                                                <FontIcon Glyph="{Binding Glyph}" FontSize="9" />
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Publisher}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Version}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0"
                                                ToolTipService.ToolTip="{Binding ExactSizeBytes}">
                                        <TextBlock Text="{Binding FormattedSize}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Value="{Binding SizeBarValue}" Maximum="1" Height="4" Margin="0,4,0,0"
                                                     Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                     Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                     Visibility="{Binding HasSize, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="Unknown size" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                                   Visibility="{Binding HasSize, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="4" Text="{Binding FormattedInstallDate}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,2"
                                                Visibility="{Binding IsStoreApp, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="STORE" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,2"
                                                Visibility="{Binding IsStoreApp, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <Border Background="{ThemeResource SystemFillColorCautionBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,2"
                                                Visibility="{Binding HasUninstaller, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                            <TextBlock Text="!" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                       ToolTipService.ToolTip="No registered uninstaller - use Force Remove" />
                                        </Border>
                                    </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="1" Text="No applications match your filters." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Border Grid.Row="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.9" CornerRadius="{ThemeResource ControlCornerRadius}"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="380">
                        <ProgressRing IsActive="{Binding IsLoading}" Width="44" Height="44" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding LoadingStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="20">
                <Grid>
                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding SelectedApp, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
                        <FontIcon Glyph="&#xE8F9;" FontSize="32" Foreground="{ThemeResource TextFillColorDisabledBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Select an application to see details and actions."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedApp, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Spacing="12">
                            <Grid Width="56" Height="56" HorizontalAlignment="Left">
                                <Image Source="{Binding SelectedApp.Icon}" Width="56" Height="56" Stretch="Uniform"
                                       Visibility="{Binding SelectedApp.HasRealIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Border CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.2"
                                        Visibility="{Binding SelectedApp.HasRealIcon, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                <TextBlock Text="{Binding SelectedApp.Initial}" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding SelectedApp.HasRealIcon, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                            </Grid>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding SelectedApp.Name}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedApp.Publisher}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,3">
                                    <TextBlock Text="{Binding SelectedApp.Version}" FontSize="11" />
                                </Border>
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,3">
                                    <TextBlock Text="{Binding SelectedApp.FormattedSize}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,3"
                                        Visibility="{Binding SelectedApp.IsStoreApp, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="STORE" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Installed" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding SelectedApp.FormattedInstallDate}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Location" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding SelectedApp.InstallLocation}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Uninstall command" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding SelectedApp.UninstallString}" FontSize="11" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Content="Uninstall" HorizontalAlignment="Stretch"
                                    Click="DetailsUninstall_Click" />
                            <Button Content="Force Remove..." HorizontalAlignment="Stretch" Click="DetailsForceRemove_Click" />
                            <Button Content="Open install folder" HorizontalAlignment="Stretch" Command="{Binding OpenInstallFolderCommand}" />
                            <TextBlock Text="{Binding ActionStatus}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding ActionStatus, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert, FallbackValue=Collapsed}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
                <Grid x:Name="RemoverPanel" Margin="0,12,0,0" ColumnSpacing="16" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12,8" Margin="0,0,0,8">
                        <Grid ColumnSpacing="12">
                            <Grid.Margin>0</Grid.Margin>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="420" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox CornerRadius="{ThemeResource ControlCornerRadius}" Grid.Column="0" PlaceholderText="Search provider, name, class, INF..." QueryIcon="Find"
                                            Text="{Binding DriverSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Refresh" Command="{Binding LoadDriversCommand}" VerticalAlignment="Center" />
                        </Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="12,0,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Driver" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="Version" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="Date" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="Class" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="4" Text="INF" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ListView x:Name="DriverList" Grid.Row="2" ItemsSource="{Binding FilteredDrivers}" SelectedItem="{Binding SelectedDriver, Mode=TwoWay}"
                                  SelectionMode="Extended" ShowsScrollingPlaceholders="True" SelectionChanged="DriverList_SelectionChanged"
                                  HorizontalContentAlignment="Stretch"
                                  Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="4">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DriverPackageItem">
                                    <Grid Padding="8,6" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding FriendlyKind}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding DriverVersion}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding DriverDate}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding FriendlyClass}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                            <Border Grid.Column="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PublishedName}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Grid.Row="2" Text="No driver packages match." HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding ShowDriversEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Border Grid.Row="2" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.9" CornerRadius="{ThemeResource ControlCornerRadius}"
                                Visibility="{Binding IsLoadingDrivers, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="380">
                                <ProgressRing IsActive="{Binding IsLoadingDrivers}" Width="44" Height="44" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DriverSummaryText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="20">
                        <Grid>
                            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding SelectedDriver, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
                                <FontIcon Glyph="&#xE8F9;" FontSize="32" Foreground="{ThemeResource TextFillColorDisabledBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Select a driver package to see details and actions."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding SelectedDriver, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding SelectedDriver.FriendlyKind}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedDriver.Provider}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,3">
                                            <TextBlock Text="{Binding SelectedDriver.DriverVersion}" FontSize="11" />
                                        </Border>
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,3">
                                            <TextBlock Text="{Binding SelectedDriver.FriendlyClass}" FontSize="11" />
                                        </Border>
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,3">
                                            <TextBlock Text="{Binding SelectedDriver.PublishedName}" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Driver date" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedDriver.DriverDate}" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Signer" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedDriver.SignerName}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Driver store size" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedDriver.FormattedSize}" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Published INF" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedDriver.PublishedName}" FontSize="11" TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Content="Remove package" HorizontalAlignment="Stretch"
                                            Click="DetailsRemoveDriver_Click" />
                                    <TextBlock Text="{Binding DriverActionStatus}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding DriverActionStatus, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert, FallbackValue=Collapsed}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="StartupPanel" Margin="0,12,0,0" ColumnSpacing="16" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="248" MinWidth="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Margin="8,0,0,0" Text="Sources" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ListView CornerRadius="{ThemeResource ControlCornerRadius}" Grid.Row="1" ItemsSource="{Binding StartupSections}"
                                      SelectedIndex="{Binding StartupSectionIndex, Mode=TwoWay}"
                                      SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                      HorizontalAlignment="Stretch">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StartupSectionVm">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Padding="6,1" VerticalAlignment="Center"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="{ThemeResource ControlCornerRadius}">
                                                <TextBlock Text="{x:Bind CountText, Mode=OneWay}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock Grid.Row="2" Margin="8,4,8,0" FontSize="11" TextWrapping="Wrap"
                                       Text="A checkbox switches an entry on or off straight away; the trash button deletes it."
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Spacing="2">
                            <TextBlock Text="{Binding CurrentStartupSection.Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding CurrentStartupSection.Hint}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="420" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox CornerRadius="{ThemeResource ControlCornerRadius}" Grid.Column="0" PlaceholderText="Search name or command..." QueryIcon="Find"
                                        Text="{Binding StartupSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                        <CheckBox Grid.Column="1" Content="Hide Microsoft services" IsChecked="{Binding HideMicrosoftServices, Mode=TwoWay}"
                                  VerticalAlignment="Center" Visibility="{Binding MicrosoftFilterVis}"
                                  ToolTipService.ToolTip="Hide services whose binary reports a Microsoft company name" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding StartupSummaryText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Content="Refresh" Command="{Binding LoadStartupCommand}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="20">
                            <StackPanel Spacing="6" Visibility="{Binding HkcuVis}">
                                <Grid Margin="28,0,52,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Start" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="Name" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="Type" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="Command / Value" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding FilteredHkcu}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:StartupEntry">
                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12,8" Margin="0,0,0,4">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="4*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"
                                                               TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center"
                                                               ToolTipService.ToolTip="{x:Bind Id}" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind EntryType}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind Command}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                               IsTextSelectionEnabled="True" VerticalAlignment="Center"
                                                               ToolTipService.ToolTip="{x:Bind Command}" />
                                                    <Button Grid.Column="4" Click="DeleteStartupEntry_Click" Tag="{x:Bind}" VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="Delete this entry">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Spacing="6" Visibility="{Binding HklmVis}">
                                <Grid Margin="28,0,52,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Start" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="Name" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="Type" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="Command / Value" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding FilteredHklm}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:StartupEntry">
                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12,8" Margin="0,0,0,4">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="4*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"
                                                               TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center"
                                                               ToolTipService.ToolTip="{x:Bind Id}" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind EntryType}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind Command}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                               IsTextSelectionEnabled="True" VerticalAlignment="Center"
                                                               ToolTipService.ToolTip="{x:Bind Command}" />
                                                    <Button Grid.Column="4" Click="DeleteStartupEntry_Click" Tag="{x:Bind}" VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="Delete this entry">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Spacing="6" Visibility="{Binding ServicesVis}">
                                <Grid Margin="28,0,52,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Start" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="Name" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="Type" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="Command / Value" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding FilteredServices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:StartupEntry">
                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12,8" Margin="0,0,0,4">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="4*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                                              ToolTipService.ToolTip="Checked = automatic start; unchecked = disabled" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"
                                                               TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center"
                                                               ToolTipService.ToolTip="{x:Bind Id}" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind EntryType}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind Command}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                               IsTextSelectionEnabled="True" VerticalAlignment="Center"
                                                               ToolTipService.ToolTip="{x:Bind Command}" />
                                                    <Button Grid.Column="4" Click="DeleteStartupEntry_Click" Tag="{x:Bind}" VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="Delete this service (cannot be undone here)">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Spacing="6" Visibility="{Binding TasksVis}">
                                <Grid Margin="28,0,52,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Start" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="Name" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="Type" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="Command / Value" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding FilteredTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:StartupEntry">
                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12,8" Margin="0,0,0,4">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="4*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"
                                                               TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center"
                                                               ToolTipService.ToolTip="{x:Bind Id}" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind EntryType}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind Command}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                               IsTextSelectionEnabled="True" VerticalAlignment="Center"
                                                               ToolTipService.ToolTip="{x:Bind Command}" />
                                                    <Button Grid.Column="4" Click="DeleteStartupEntry_Click" Tag="{x:Bind}" VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="Delete this task">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="Nothing to show - this source has no entries, or the search hides them all." FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding EmptyVis}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding StartupStatusText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding StartupStatusText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert, FallbackValue=Collapsed}" />
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
