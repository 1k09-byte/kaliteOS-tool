<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.UninstallerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:kaliteConfig.ViewModels"
    xmlns:models="using:kaliteConfig.Models"
    xmlns:converters="using:kaliteConfig.Converters"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <Style x:Key="StretchListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Page.DataContext>
        <vm:UninstallerViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1008" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AppDetailsPane.DisplayMode" Value="Overlay" />
                        <Setter Target="DriverDetailsPane.DisplayMode" Value="Overlay" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar x:Name="MainPivot" Grid.Row="0" Margin="40,0,40,4"
                     HorizontalAlignment="Left"
                     SelectionChanged="MainPivot_SelectionChanged">
            <SelectorBarItem x:Name="TabUninstaller" Text="Uninstaller" IsSelected="True" />
            <SelectorBarItem x:Name="TabRemover" Text="Remover" />
            <SelectorBarItem x:Name="TabStartup" Text="Startup" />
        </SelectorBar>

        <Grid x:Name="UninstallerPanel" Grid.Row="1" Padding="40,0,40,24" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox Grid.Column="0" PlaceholderText="Search name or publisher..." QueryIcon="Find"
                                Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="1" Text="{Binding SummaryText}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SelectionText" Grid.Column="2" Text=""
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <CommandBar Grid.Column="3" DefaultLabelPosition="Right" HorizontalAlignment="Right">
                    <AppBarButton Icon="Refresh" Label="Refresh" Command="{Binding LoadAppsCommand}" />
                    <AppBarButton Label="Export list..." Command="{Binding ExportListCommand}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74E;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <RadioButtons x:Name="FilterRadios" Grid.Column="0" MaxColumns="4"
                              SelectedIndex="{Binding FilterIndex, Mode=TwoWay}">
                    <x:String>All</x:String>
                    <x:String>Desktop</x:String>
                    <x:String>Store</x:String>
                    <x:String>No uninstaller</x:String>
                </RadioButtons>
                <CheckBox Grid.Column="1" Content="Show system components" VerticalAlignment="Center"
                          IsChecked="{Binding ShowSystem, Mode=TwoWay}"
                          ToolTipService.ToolTip="Include Windows system components in the list" />
                <TextBlock Grid.Column="3" Text="Sort" Style="{StaticResource BodyTextBlockStyle}"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="4" VerticalAlignment="Center"
                          SelectedIndex="{Binding SortIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Name" />
                    <ComboBoxItem Content="Publisher" />
                    <ComboBoxItem Content="Size" />
                    <ComboBoxItem Content="Installed" />
                </ComboBox>
            </Grid>

            <SplitView x:Name="AppDetailsPane" Grid.Row="2" DisplayMode="Inline" PanePlacement="Right"
                       OpenPaneLength="320" IsPaneOpen="False">
                <SplitView.Pane>
                    <Grid Padding="24,0,16,0" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="32" Height="32" VerticalAlignment="Center">
                                    <Image Source="{Binding SelectedApp.Icon}" Stretch="Uniform"
                                           Visibility="{Binding SelectedApp.HasRealIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <FontIcon Glyph="{Binding SelectedApp.Glyph}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Visibility="{Binding SelectedApp.HasRealIcon, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedApp.Name}"
                                               Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedApp.Publisher}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Version" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedApp.Version}"
                                               Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="4"
                                            Visibility="{Binding SelectedApp.FormattedSize, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Size" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedApp.FormattedSize}"
                                               Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="4"
                                            Visibility="{Binding SelectedApp.FormattedInstallDate, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Installed" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedApp.FormattedInstallDate}"
                                               Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Source" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedApp.SourceLabel}"
                                               Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="4"
                                            Visibility="{Binding SelectedApp.InstallLocation, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Location" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedApp.InstallLocation}"
                                               Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Spacing="4"
                                            Visibility="{Binding SelectedApp.UninstallString, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Uninstall command"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedApp.UninstallString}"
                                               Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Spacing="8">
                                <Button Content="Uninstall" HorizontalAlignment="Stretch"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="DetailsUninstall_Click" />
                                <Button HorizontalAlignment="Stretch" Click="DetailsForceRemove_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" />
                                        <TextBlock Text="Force Remove..." />
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" Command="{Binding OpenInstallFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B7;" />
                                        <TextBlock Text="Open install folder" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding ActionStatus}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding ActionStatus, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert, FallbackValue=Collapsed}" />
                            </StackPanel>
                    </Grid>
                </SplitView.Pane>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Version" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Installed" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="Source" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ListView x:Name="AppList" Grid.Row="1" ItemsSource="{Binding FilteredApps}"
                              SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                              SelectionMode="Single" SelectionChanged="AppList_SelectionChanged"
                              ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                              Visibility="{Binding IsLoading, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:UninstallerItem">
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="32" Height="32" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Stretch="Uniform"
                                                   Visibility="{Binding HasRealIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <FontIcon Glyph="{Binding Glyph}" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding HasRealIcon, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Publisher}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Version}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding FormattedSize}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding FormattedInstallDate}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding SourceLabel}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ProgressRing IsActive="{Binding IsLoading}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding LoadingStatus}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="No applications match your filters."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </SplitView>
        </Grid>

        <Grid x:Name="RemoverPanel" Grid.Row="1" Padding="40,0,40,24" RowSpacing="12"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox Grid.Column="0" PlaceholderText="Search provider, name, class, INF..." QueryIcon="Find"
                                Text="{Binding DriverSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="1" Text="{Binding DriverSummaryText}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <CommandBar Grid.Column="3" DefaultLabelPosition="Right" HorizontalAlignment="Right">
                    <AppBarButton Icon="Refresh" Label="Refresh" Command="{Binding LoadDriversCommand}" />
                </CommandBar>
            </Grid>

            <SplitView x:Name="DriverDetailsPane" Grid.Row="1" DisplayMode="Inline" PanePlacement="Right"
                       OpenPaneLength="320" IsPaneOpen="False">
                <SplitView.Pane>
                    <Grid Padding="24,0,16,0" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding SelectedDriver.FriendlyKind}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedDriver.Provider}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4"
                                            Visibility="{Binding SelectedDriver.DriverVersion, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Version" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedDriver.DriverVersion}"
                                               Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="4"
                                            Visibility="{Binding SelectedDriver.FriendlyClass, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Class" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedDriver.FriendlyClass}"
                                               Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="4"
                                            Visibility="{Binding SelectedDriver.DriverDate, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Driver date" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedDriver.DriverDate}"
                                               Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="4"
                                            Visibility="{Binding SelectedDriver.SignerName, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Signer" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedDriver.SignerName}"
                                               Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="4"
                                            Visibility="{Binding SelectedDriver.FormattedSize, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Driver store size"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedDriver.FormattedSize}"
                                               Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="4"
                                            Visibility="{Binding SelectedDriver.PublishedName, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Published INF"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedDriver.PublishedName}"
                                               Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Spacing="8">
                                <Button HorizontalAlignment="Stretch" Click="DetailsRemoveDriver_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" />
                                        <TextBlock Text="Remove package" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding DriverActionStatus}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding DriverActionStatus, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert, FallbackValue=Collapsed}" />
                            </StackPanel>
                    </Grid>
                </SplitView.Pane>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="88" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Driver" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Version" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Date" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="Class" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="INF" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ListView x:Name="DriverList" Grid.Row="1" ItemsSource="{Binding FilteredDrivers}"
                              SelectedItem="{Binding SelectedDriver, Mode=TwoWay}"
                              SelectionMode="Single" SelectionChanged="DriverList_SelectionChanged"
                              ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                              Visibility="{Binding IsLoadingDrivers, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DriverPackageItem">
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="88" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FriendlyKind}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DriverVersion}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding DriverDate}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding FriendlyClass}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{Binding PublishedName}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLoadingDrivers, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ProgressRing IsActive="{Binding IsLoadingDrivers}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DriverSummaryText}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="No driver packages match."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowDriversEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </SplitView>
        </Grid>

        <Grid x:Name="StartupPanel" Grid.Row="1" Padding="40,0,40,24" ColumnSpacing="24"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Sources" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ListView ItemsSource="{Binding StartupSections}"
                          SelectedIndex="{Binding StartupSectionIndex, Mode=TwoWay}"
                          SelectionMode="Single"
                          ItemContainerStyle="{StaticResource StretchListViewItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:StartupSectionVm">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyTextBlockStyle}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind CountText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock Text="{Binding CurrentStartupSection.Title}"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{Binding CurrentStartupSection.Hint}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="A checkbox switches an entry on or off straight away; the trash button deletes it."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="360" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox Grid.Column="0" PlaceholderText="Search name or command..." QueryIcon="Find"
                                    Text="{Binding StartupSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Grid.Column="1" Content="Hide Microsoft services" VerticalAlignment="Center"
                              IsChecked="{Binding HideMicrosoftServices, Mode=TwoWay}"
                              Visibility="{Binding MicrosoftFilterVis}"
                              ToolTipService.ToolTip="Hide services whose binary reports a Microsoft company name" />
                    <TextBlock Grid.Column="2" Text="{Binding StartupSummaryText}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <CommandBar Grid.Column="3" DefaultLabelPosition="Right" HorizontalAlignment="Right">
                        <AppBarButton Icon="Refresh" Label="Refresh" Command="{Binding LoadStartupCommand}" />
                    </CommandBar>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Start" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding TypeHeaderText}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="Command / Value"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{Binding CurrentStartupEntries}"
                              SelectionMode="None"
                              ItemContainerStyle="{StaticResource StretchListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:StartupEntry">
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}" OnContent="" OffContent=""
                                                  VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="Checked = automatic start; unchecked = disabled" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               ToolTipService.ToolTip="{x:Bind Id}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind EntryType}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Command}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               IsTextSelectionEnabled="True" VerticalAlignment="Center"
                                               ToolTipService.ToolTip="{x:Bind Command}" />
                                    <Button Grid.Column="4" Click="DeleteStartupEntry_Click" Tag="{x:Bind}"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Delete entry"
                                            ToolTipService.ToolTip="Delete this entry">
                                        <FontIcon Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="1"
                               Text="Nothing to show - this source has no entries, or the search hides them all."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding EmptyVis}" />

                    <TextBlock Grid.Row="1" Text="{Binding StartupStatusText}"
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Bottom" Margin="0,0,0,8"
                               Visibility="{Binding StartupStatusText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert, FallbackValue=Collapsed}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
