<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="kaliteConfig.Pages.SimpleDriverSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:kaliteConfig.ViewModels"
      xmlns:models="using:kaliteConfig.Models"
      xmlns:converters="using:kaliteConfig.Converters"
      xmlns:local="using:kaliteConfig.Pages"
      Background="Transparent"
      NavigationCacheMode="Required">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        <converters:InvertedBoolConverter x:Key="InvertBoolConverter" />
        <converters:MutedBackgroundConverter x:Key="MutedBackgroundConverter" />

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="MutedCard" TargetType="Border" BasedOn="{StaticResource SectionCard}">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="SettingNameText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingDescriptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SectionTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DiffLineText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Profile picker rows: an icon, the profile name, and what it points at. -->
        <DataTemplate x:Key="ProfileOptionTemplate" x:DataType="vm:NvidiaProfileOption">
            <Grid ColumnSpacing="12" MinHeight="48" Padding="4,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind DisplayName}" />
                    <TextBlock Text="{x:Bind Subtitle}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Preset confirmation rows: the change, and a checkbox to leave it out. -->
        <DataTemplate x:Key="PresetStepTemplate" x:DataType="local:NvidiaPresetStepViewModel">
            <Grid ColumnSpacing="10" MinHeight="40" Padding="4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{x:Bind IsIncluded, Mode=TwoWay}"
                          IsEnabled="{x:Bind CanInclude, Mode=OneWay}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind SettingId}" />
                    <TextBlock Text="{x:Bind Detail}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid RowSpacing="10" Padding="28,16,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Persistent profile header: you always know which profile you are editing. -->
        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Padding="16,12" CornerRadius="10">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Image x:Name="ProfileIcon" Width="24" Height="24"
                           Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Vm.ProfileHeaderText, Mode=OneWay}"
                               Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{x:Bind Vm.ProfileSubtitle, Mode=OneWay}"
                               Style="{StaticResource SettingDescriptionText}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Change profile" VerticalAlignment="Center"
                        Click="ChangeProfile_Click" />
            </Grid>
        </Border>

        <!-- The Global banner is up for as long as the Global profile is selected, not
             just until the user dismisses a dialog. -->
        <InfoBar Grid.Row="1" x:Name="GlobalBanner" IsOpen="True" IsClosable="False"
                 Severity="Warning" Margin="0,2,0,0"
                 Visibility="{x:Bind Vm.IsGlobalProfile, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                 Title="Editing Global"
                 Message="These settings affect every application that does not have its own profile." />

        <StackPanel Grid.Row="2" Spacing="8">
                <AutoSuggestBox x:Name="SearchBox" MinWidth="320" HorizontalAlignment="Left" PlaceholderText="Search settings"
                                QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,12">
            <StackPanel Spacing="14" MaxWidth="1100" HorizontalAlignment="Stretch">

                <Grid Visibility="{x:Bind Vm.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.7" />
                    <ProgressRing IsActive="True" Width="40" Height="40"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Nothing above this line may fail silently: a driver that refuses
                     the read, a profile with nothing curated on it, and a failed
                     apply all say so here rather than leaving a blank page. -->
                <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational"
                         Title="Settings"
                         Message="{x:Bind Vm.Status, Mode=OneWay}"
                         Visibility="{x:Bind Vm.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <InfoBar IsOpen="True" IsClosable="False" Severity="Success"
                         Title="Applied"
                         Message="{x:Bind Vm.ApplyReport, Mode=OneWay}"
                         Visibility="{x:Bind Vm.HasApplyReport, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Text="This profile has no settings this driver offers."
                           Style="{StaticResource SettingDescriptionText}" TextWrapping="Wrap"
                           Visibility="{x:Bind Vm.HasNoCuratedSettings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- ===== every setting this driver offers, grouped by the user's own map ===== -->
                <StackPanel Spacing="6"
                            Visibility="{x:Bind Vm.HasRecents, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Recently changed" Style="{StaticResource SectionTitleText}" />
                    <Border Style="{StaticResource SectionCard}">
                        <ItemsControl ItemsSource="{x:Bind Vm.Recents, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NvidiaRecentChangeViewModel">
                                    <Grid ColumnSpacing="10" Padding="16,6" MinHeight="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Text}" TextWrapping="Wrap"
                                                   Style="{StaticResource DiffLineText}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ProfileName}" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind When}" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <ItemsControl ItemsSource="{x:Bind Vm.Sections, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NvidiaSettingSectionViewModel">
                            <StackPanel Spacing="6" Margin="0,0,0,8">
                                <Expander x:Name="SectionHeader"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          IsExpanded="{x:Bind IsMuted, Mode=OneTime, Converter={StaticResource InvertBoolConverter}}">
                                    <Expander.Header>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource SectionTitleText}" />
                                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SettingDescriptionText}"
                                                       Visibility="{x:Bind HasSubtitle, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <Border Style="{StaticResource SectionCard}"
                                            Margin="0,6,0,0"
                                            Background="{x:Bind IsMuted, Mode=OneTime, Converter={StaticResource MutedBackgroundConverter}}">
                                    <ItemsControl ItemsSource="{x:Bind Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:NvidiaSettingRowViewModel">
                                                <Grid Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      MinHeight="56" Padding="16,8" ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="260" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <ToggleSwitch Grid.Column="0" VerticalAlignment="Center"
                                                                  IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                                                                  IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                                                  Visibility="{x:Bind IsToggleControl, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource SettingNameText}" />
                                                        <TextBlock Text="{x:Bind HexId}" FontFamily="Consolas" FontSize="11"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>

                                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                                        <ComboBox HorizontalAlignment="Stretch"
                                                                  IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                                                                  ItemsSource="{x:Bind Options}"
                                                                  SelectedItem="{x:Bind SelectedOption, Mode=TwoWay}"
                                                                  Visibility="{x:Bind IsChoiceControl, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:Nvidia3DOption">
                                                                    <TextBlock Text="{x:Bind Label}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <TextBlock Text="{x:Bind ValueText, Mode=OneWay}"
                                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{x:Bind IsReadOnlyControl, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </Grid>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                Spacing="4" VerticalAlignment="Center">
                                                        <ToggleButton IsChecked="{x:Bind IsFavorite, Mode=TwoWay}"
                                                                      ToolTipService.ToolTip="Pin to My Settings">
                                                            <Grid>
                                                                <FontIcon Glyph="&#xE735;" FontSize="14"
                                                                          Visibility="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <FontIcon Glyph="&#xE734;" FontSize="14"
                                                                          Visibility="{x:Bind IsNotFavorite, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </Grid>
                                                        </ToggleButton>
                                                        <HyperlinkButton Content="Show in full editor"
                                                                         Tag="{x:Bind}"
                                                                         Click="ShowInFullEditor_Click"
                                                                         ToolTipService.ToolTip="Opens the bundled full profile editor. It shows every raw driver setting for this profile; it cannot jump to one setting." />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                    </Expander>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No setting matches your search."
                           Style="{StaticResource SettingDescriptionText}"
                           Visibility="{x:Bind Vm.HasNoMatches, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Staged changes, in plain English, before anything is written. -->
        <Border Grid.Row="4" Style="{StaticResource SectionCard}" Padding="16,12" Margin="0,8,0,16"
                Visibility="{x:Bind Vm.HasStagedDiff, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Not applied yet" FontWeight="SemiBold" />
                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Vm.DiffLines, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" Style="{StaticResource DiffLineText}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Discard" Click="Discard_Click" />
                    <Button Content="Apply changes" Style="{StaticResource AccentButtonStyle}"
                            Click="Apply_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
