<Page
    x:Class="kaliteConfig.Pages.InputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:kaliteConfig.ViewModels"
    xmlns:input="using:kaliteConfig.Input"
    xmlns:converters="using:kaliteConfig.Converters"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Disabled">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="BoolToVisibilityInverseConverter" />
    </Page.Resources>
    <Grid Margin="36,24,36,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Input" Style="{StaticResource TitleLargeTextBlockStyle}" />
        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.ShowVendorBanner, Mode=OneWay}" Severity="Warning" Message="{x:Bind ViewModel.VendorBanner, Mode=OneWay}" />
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="No supported mouse found." Visibility="{x:Bind ViewModel.HasSupportedDevices, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverseConverter}}" Style="{StaticResource SubtitleTextBlockStyle}" />
            <GridView Grid.Row="0" ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}" SelectionMode="Single" SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}" IsItemClickEnabled="True" ItemClick="DeviceGrid_ItemClick" Visibility="{x:Bind ViewModel.HasSupportedDevices, Mode=OneWay}">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:MouseDeviceRow">
                        <Border Width="280" Padding="16,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Device.BrandText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ConnectionText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Battery: unknown" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="DPI: can't read" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind MeasuredLine, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <Expander Grid.Row="1" Header="Ignored devices" IsExpanded="False" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                <ListView ItemsSource="{x:Bind ViewModel.IgnoredDevices, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:MouseDeviceRow">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind DisplayName, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Device.ClassReason, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Button Grid.Column="2" Content="Show anyway" Click="ShowIgnored_Click" Tag="{x:Bind}" VerticalAlignment="Center" ToolTipService.ToolTip="Show this device anyway (Windows settings only)" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Expander>
        </Grid>
        <SelectorBar Grid.Row="3" x:Name="SectionBar" SelectionChanged="SectionBar_SelectionChanged" />
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Padding="0,0,0,32">
            <StackPanel Spacing="8">
                <StackPanel x:Name="InfoPanel" Spacing="8">
                    <toolkit:SettingsCard Header="Brand" Description="{x:Bind ViewModel.InfoBrand, Mode=OneWay}" />
                    <toolkit:SettingsCard Header="Model" Description="{x:Bind ViewModel.InfoModel, Mode=OneWay}" />
                    <toolkit:SettingsCard Header="VID and PID" Description="{x:Bind ViewModel.InfoVidPid, Mode=OneWay}" />
                    <toolkit:SettingsCard Header="Serial" Description="{x:Bind ViewModel.InfoSerial, Mode=OneWay}" />
                    <toolkit:SettingsCard Header="Connection" Description="{x:Bind ViewModel.InfoConnection, Mode=OneWay}" />
                    <toolkit:SettingsCard Header="Receiver" Description="{x:Bind ViewModel.InfoReceiver, Mode=OneWay}" />
                    <toolkit:SettingsCard Header="Vendor software" Description="{x:Bind ViewModel.InfoVendor, Mode=OneWay}" />
                    <toolkit:SettingsCard Header="Why shown" Description="{x:Bind ViewModel.InfoReason, Mode=OneWay}" />
                    <toolkit:SettingsCard Header="Nickname">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{x:Bind ViewModel.Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="200" PlaceholderText="Nickname" />
                            <Button Content="Save" Click="NicknameSave_Click" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Re-apply on connect" Description="Re-applies the saved Windows settings when the mouse arrives. Off by default.">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ReapplyOnConnect, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </toolkit:SettingsCard>
                </StackPanel>
                <StackPanel x:Name="WindowsPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="Applies to all mice. These are system-wide Windows settings, not per-device settings." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.WindowsOriginalText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <toolkit:SettingsCard Header="Pointer speed">
                        <Slider Value="{x:Bind ViewModel.Speed, Mode=TwoWay}" Minimum="1" Maximum="20" StepFrequency="1" MinWidth="200" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Enhanced pointer precision">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Precision, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Pointer trails">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Trails, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Scroll lines per notch">
                        <NumberBox Value="{x:Bind ViewModel.WheelLines, Mode=TwoWay}" Minimum="-1" Maximum="100" SpinButtonPlacementMode="Inline" MinWidth="160" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Horizontal scroll characters">
                        <Slider Value="{x:Bind ViewModel.WheelChars, Mode=TwoWay}" Minimum="1" Maximum="20" StepFrequency="1" MinWidth="200" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Primary button is left">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.PrimaryLeft, Mode=TwoWay}" OnContent="Left" OffContent="Right" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Double-click speed (ms)">
                        <NumberBox Value="{x:Bind ViewModel.DoubleClickMs, Mode=TwoWay}" Minimum="100" Maximum="2000" SpinButtonPlacementMode="Inline" MinWidth="160" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Snap pointer to default button">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.SnapDefault, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="ClickLock">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ClickLock, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="ClickLock time (ms)">
                        <NumberBox Value="{x:Bind ViewModel.ClickLockMs, Mode=TwoWay}" Minimum="200" Maximum="2200" SpinButtonPlacementMode="Inline" MinWidth="160" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Scroll inactive windows" Description="Not implemented in this app.">
                        <ToggleSwitch IsEnabled="False" IsOn="False" OnContent="On" OffContent="Off" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Hide pointer while typing" Description="Not implemented in this app.">
                        <ToggleSwitch IsEnabled="False" IsOn="False" OnContent="On" OffContent="Off" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Show pointer location on Ctrl" Description="Not implemented in this app.">
                        <ToggleSwitch IsEnabled="False" IsOn="False" OnContent="On" OffContent="Off" />
                    </toolkit:SettingsCard>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Apply Windows settings" Style="{StaticResource AccentButtonStyle}" Click="WindowsApply_Click" />
                        <Button Content="Reset section" Click="WindowsReset_Click" />
                        <Button Content="Revert everything this app changed" Click="WindowsRevert_Click" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.WindowsResultText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="VendorPanel" Spacing="8" Visibility="Collapsed">
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.VendorBanner, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowVendorBanner, Mode=OneWay}" />
                    <toolkit:SettingsCard x:Name="VendorStateCard" Header="Vendor settings" Description="Detected, vendor settings not implemented yet." />
                </StackPanel>
                <StackPanel x:Name="ReportRatePanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="Report rate is a device setting, not a Windows setting." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <toolkit:SettingsCard Header="Setting (read back)" Description="Can't read from this mouse" />
                    <toolkit:SettingsCard Header="Measured" Description="{x:Bind ViewModel.ReportMeasuredLine, Mode=OneWay}" />
                    <toolkit:SettingsCard Header="Supported rates">
                        <ComboBox IsEnabled="False" PlaceholderText="No rates reported" MinWidth="200" />
                    </toolkit:SettingsCard>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Apply report rate" IsEnabled="False" Click="ReportApply_Click" ToolTipService.ToolTip="Not implemented in this app: no verified module can set the report rate on this mouse." />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.MismatchText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="TestPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="Move the mouse continuously in circles." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Start" Click="TestStart_Click" />
                        <Button Content="Stop" Click="TestStop_Click" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.TestStatusText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.TestResultText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <toolkit:SettingsCard Header="Buttons now" Description="{x:Bind ViewModel.LiveButtonsText, Mode=OneWay}" />
                    <toolkit:SettingsCard Header="Wheel" Description="{x:Bind ViewModel.LiveWheelText, Mode=OneWay}" />
                    <toolkit:SettingsCard Header="Speed road" Description="The dashes move while the mouse sends movement. Faster movement makes the marker run faster.">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE962;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <StackPanel Spacing="8" MinWidth="320">
                            <TextBlock Text="{x:Bind ViewModel.LiveSpeedText, Mode=OneWay}" />
                            <Canvas x:Name="SpeedRoadCanvas" Height="96" SizeChanged="SpeedRoad_SizeChanged" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Counts per inch">
                        <StackPanel Spacing="8">
                            <NumberBox Value="{x:Bind ViewModel.DpiInches, Mode=TwoWay}" Minimum="0.1" Maximum="100" SpinButtonPlacementMode="Inline" Header="Distance moved (inches)" MinWidth="200" />
                            <Button Content="Analyze" Click="DpiAnalyze_Click" />
                            <TextBlock Text="{x:Bind ViewModel.DpiResultText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Double-click test">
                        <StackPanel Spacing="8">
                            <Border x:Name="ClickTestArea" MinHeight="80" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" PointerPressed="ClickTestArea_PointerPressed">
                                <TextBlock Text="Double-click here" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.ClickTestText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                </StackPanel>
                <StackPanel x:Name="LogPanel" Spacing="8" Visibility="Collapsed">
                    <ListView ItemsSource="{x:Bind ViewModel.Log.Rows, Mode=OneWay}" SelectionMode="None" MaxHeight="480">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="input:MouseLogRow">
                                <StackPanel Spacing="2" Padding="0,4">
                                    <TextBlock Text="{x:Bind Action}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                        <Run Text="{x:Bind Time}" /><Run Text=" " /><Run Text="{x:Bind Device}" /><Run Text=" " /><Run Text="{x:Bind Result}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind Message}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
