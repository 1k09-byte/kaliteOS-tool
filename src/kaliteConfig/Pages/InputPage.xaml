<Page
    x:Class="kaliteConfig.Pages.InputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:kaliteConfig.ViewModels"
    xmlns:input="using:kaliteConfig.Input"
    xmlns:converters="using:kaliteConfig.Converters"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Disabled">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="BoolToVisibilityInverseConverter" />
        <SolidColorBrush x:Key="MouseShellBrush" Color="{ThemeResource SystemAccentColorDark2}" />
        <SolidColorBrush x:Key="MouseShellDeepBrush" Color="{ThemeResource SystemAccentColorDark3}" />
        <SolidColorBrush x:Key="MouseShellLightBrush" Color="{ThemeResource SystemAccentColorLight1}" />
        <SolidColorBrush x:Key="MouseEdgeBrush" Color="{ThemeResource SystemAccentColorLight3}" />
        <LinearGradientBrush x:Key="MouseShellGradient" StartPoint="0,0" EndPoint="0.35,1">
            <GradientStop Color="{ThemeResource SystemAccentColorDark1}" Offset="0" />
            <GradientStop Color="{ThemeResource SystemAccentColorDark2}" Offset="0.5" />
            <GradientStop Color="{ThemeResource SystemAccentColorDark3}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MouseWheelGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{ThemeResource SystemAccentColorDark2}" Offset="0" />
            <GradientStop Color="{ThemeResource SystemAccentColorDark3}" Offset="0.5" />
            <GradientStop Color="{ThemeResource SystemAccentColorDark2}" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <Grid Margin="28,16,28,14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Input" Style="{StaticResource TitleLargeTextBlockStyle}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" MinWidth="260" VerticalAlignment="Center"
                      ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      PlaceholderText="No supported mouse" />
            <Button Grid.Column="2" Content="Rescan" Click="Rescan_Click" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="6">
            <InfoBar IsOpen="{x:Bind ViewModel.ShowVendorBanner, Mode=OneWay}" Severity="Warning"
                     Message="{x:Bind ViewModel.VendorBanner, Mode=OneWay}" />
            <InfoBar IsOpen="True" Severity="Informational" IsClosable="False" Message="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.HasSupportedDevices, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverseConverter}}" />
        </StackPanel>

        <SelectorBar Grid.Row="2" x:Name="SectionBar" SelectionChanged="SectionBar_SelectionChanged">
            <SelectorBarItem Text="Mouse" IsSelected="True" />
            <SelectorBarItem Text="Buttons" />
            <SelectorBarItem Text="Windows" />
            <SelectorBarItem Text="Tests" />
            <SelectorBarItem Text="Ignored" />
            <SelectorBarItem Text="Log" />
        </SelectorBar>

        <Grid Grid.Row="3">

            <Grid x:Name="MouseSection" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="348" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="8,2" CornerRadius="10" VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind ViewModel.InfoConnection, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PortText, Mode=OneWay}" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.UsbTreeText, Mode=OneWay}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ModelClickText, Mode=OneWay}" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <Grid x:Name="StageHost" Grid.Row="1" Background="Transparent"
                              PointerPressed="Stage_PointerPressed" PointerReleased="Stage_PointerReleased"
                              PointerMoved="Stage_PointerMoved" PointerEntered="Stage_PointerEntered"
                              PointerExited="Stage_PointerExited"
                              PointerCanceled="Stage_PointerCanceled" PointerWheelChanged="Stage_PointerWheelChanged">
                            <Viewbox Stretch="Uniform" Margin="0,2,0,0">
                                <Grid x:Name="MouseRig" Width="210" Height="286" RenderTransformOrigin="0.5,0.52" IsHitTestVisible="False">
                                    <Grid.RenderTransform>
                                        <CompositeTransform x:Name="RigTransform" />
                                    </Grid.RenderTransform>
                                    <Grid.Projection>
                                        <PlaneProjection x:Name="RigProjection" />
                                    </Grid.Projection>

                                    <Ellipse Width="156" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                             Margin="18,0,0,6" Opacity="0.4" Fill="{ThemeResource SubtleFillColorTertiaryBrush}" />

                                    <Border Width="172" Height="248" Margin="0,12,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                                            CornerRadius="86,86,74,74" Background="{StaticResource MouseShellDeepBrush}" Opacity="0.9">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="20" Y="32" />
                                        </Border.RenderTransform>
                                    </Border>

                                    <Border Width="172" Height="248" Margin="0,12,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                                            CornerRadius="86,86,74,74" Background="{StaticResource MouseShellBrush}" Opacity="0.95">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="10" Y="16" />
                                        </Border.RenderTransform>
                                    </Border>

                                    <Border Width="174" Height="252" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                                            CornerRadius="87,87,75,75" Background="{StaticResource MouseShellGradient}"
                                            BorderBrush="{StaticResource MouseEdgeBrush}" BorderThickness="1" />

                                    <Ellipse Width="88" Height="140" Margin="0,30,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                                             Opacity="0.07" Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />

                                    <Grid Width="174" Height="252" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                                        <Rectangle Width="1" Height="90" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                                                   Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Opacity="0.25" />
                                        <Rectangle Width="140" Height="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,98,0,0"
                                                   Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Opacity="0.18" />
                                        <Border Width="24" Height="52" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Margin="0,36,0,0" Background="{StaticResource MouseWheelGradient}"
                                                BorderBrush="{ThemeResource TextOnAccentFillColorPrimaryBrush}" BorderThickness="1">
                                            <StackPanel Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Rectangle Width="13" Height="1" Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Opacity="0.5" />
                                                <Rectangle Width="13" Height="1" Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Opacity="0.5" />
                                                <Rectangle Width="13" Height="1" Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Opacity="0.5" />
                                            </StackPanel>
                                        </Border>
                                        <Ellipse Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,50"
                                                 Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.3" />
                                        <TextBlock Text="K" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,60"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Opacity="0.85" />
                                        <Border Width="18" Height="38" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="-9,112,0,0" Background="{StaticResource MouseShellLightBrush}" Opacity="0.95" />
                                        <Border Width="18" Height="28" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="-9,162,0,0" Background="{StaticResource MouseShellLightBrush}" Opacity="0.7" />

                                        <Border x:Name="LeftPress" Width="84" Height="96" CornerRadius="74,10,6,6"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,11,0,0"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0" />
                                        <Border x:Name="RightPress" Width="84" Height="96" CornerRadius="10,74,6,6"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,11,1,0"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0" />
                                        <Border x:Name="WheelPress" Width="32" Height="60" CornerRadius="16"
                                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,32,0,0"
                                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" Opacity="0" />
                                        <Border x:Name="ForwardPress" Width="18" Height="38" CornerRadius="6"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-9,112,0,0"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0" />
                                        <Border x:Name="BackPress" Width="18" Height="28" CornerRadius="6"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-9,162,0,0"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0" />
                                    </Grid>
                                </Grid>
                            </Viewbox>
                        </Grid>

                        <Canvas Grid.Row="2" x:Name="RoadCanvas" Height="32" SizeChanged="Road_SizeChanged" />

                        <Grid Grid.Row="3" ColumnSpacing="10" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Received" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.LiveHzText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Speed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.LiveCountsText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CPU" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CpuShortText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}">
                        <Grid RowSpacing="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SelectedDevice.DisplayName, Mode=OneWay, FallbackValue='No mouse selected'}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Details" Padding="8,2" VerticalAlignment="Center">
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                                            <StackPanel Spacing="3" MinWidth="320" MaxWidth="440">
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                                    <Run Text="Brand: " /><Run Text="{x:Bind ViewModel.InfoBrand, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                                    <Run Text="Model: " /><Run Text="{x:Bind ViewModel.InfoModel, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                                    <Run Text="IDs: " /><Run Text="{x:Bind ViewModel.InfoVidPid, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                                    <Run Text="Serial: " /><Run Text="{x:Bind ViewModel.InfoSerial, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                                    <Run Text="USB tree: " /><Run Text="{x:Bind ViewModel.UsbTreeText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                                    <Run Text="Receiver: " /><Run Text="{x:Bind ViewModel.InfoReceiver, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                                    <Run Text="Vendor software: " /><Run Text="{x:Bind ViewModel.InfoVendor, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                                    <Run Text="Rule: " /><Run Text="{x:Bind ViewModel.InfoReason, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{x:Bind ViewModel.InfoMemory, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                    <TextBox Text="{x:Bind ViewModel.Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="150" PlaceholderText="Nickname" />
                                                    <Button Content="Save" Click="NicknameSave_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                <Run Text="{x:Bind ViewModel.InfoBrand, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{x:Bind ViewModel.InfoVidPid, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{x:Bind ViewModel.InfoConnection, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.DeviceQuickText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Poll rate advisor" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="{x:Bind ViewModel.RecommendationButtonText, Mode=OneWay}" Click="UseRecommendation_Click"
                                        MinHeight="0" Padding="12,3" VerticalAlignment="Center"
                                        IsEnabled="{x:Bind ViewModel.CanUseRecommendation, Mode=OneWay}" />
                            </Grid>

                            <Grid ColumnSpacing="12" RowSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Display" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.AdvisorDisplayText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Refresh" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.AdvisorRefreshText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Needed poll rate" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.AdvisorBudgetText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="CPU" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.AdvisorCpuText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Supported" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.AdvisorSupportedText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Measured" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.AdvisorMeasuredText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Target" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.AdvisorTargetText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2" />

                            <TextBlock Text="{x:Bind ViewModel.RecommendationText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" MaxLines="1" />

                            <Expander Header="Why this rate?" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.RecommendationNote, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="260" />
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Link quality" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.QualityVerdict, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.QualityDetail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <Canvas Grid.Row="2" x:Name="SparkCanvas" Height="36" SizeChanged="Spark_SizeChanged" Margin="0,2,0,0" />
                            <StackPanel Grid.Row="3" Spacing="1">
                                <TextBlock Text="{x:Bind ViewModel.CpuUsageText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.TestStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.MismatchText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                    <Grid RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Mouse settings" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,2" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{x:Bind ViewModel.DeviceCanSet, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="0">
                            <Grid MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Poll rate" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.ReportSettingText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox MinWidth="104" ItemsSource="{x:Bind ViewModel.RateOptions, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedRate, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <Grid MinHeight="46">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DPI" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Slider Grid.Column="1" Value="{x:Bind ViewModel.RequestedDpi, Mode=TwoWay}" Minimum="50" Maximum="26000"
                                        StepFrequency="50" VerticalAlignment="Center" />
                                <NumberBox Grid.Column="2" Value="{x:Bind ViewModel.RequestedDpi, Mode=TwoWay}" Minimum="50" Maximum="26000"
                                           SmallChange="50" SpinButtonPlacementMode="Compact" Width="102" Margin="6,0,0,0"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.DeviceDpiText, Mode=OneWay}" />
                            </Grid>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.Settings, Mode=OneWay}" Margin="0,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:MouseSettingRow">
                                        <Grid MinHeight="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{x:Bind Label}" />
                                                <TextBlock Text="{x:Bind Hint}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{x:Bind HasHint, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsOn, Mode=TwoWay}" OnContent="On" OffContent="Off"
                                                          Visibility="{x:Bind IsToggle, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <ComboBox Grid.Column="1" MinWidth="124" ItemsSource="{x:Bind Options, Mode=OneWay}"
                                                      SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}"
                                                      Visibility="{x:Bind IsChoice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <NumberBox Grid.Column="1" Width="112" Minimum="{x:Bind Minimum}" Maximum="{x:Bind Maximum}"
                                                       SmallChange="{x:Bind Step}" SpinButtonPlacementMode="Compact"
                                                       Value="{x:Bind Number, Mode=TwoWay}"
                                                       Visibility="{x:Bind IsNumber, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid MinHeight="40" Visibility="{x:Bind ViewModel.ShowLod, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Lift-off distance" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" MinWidth="104" ItemsSource="{x:Bind ViewModel.LodOptions, Mode=OneWay}"
                                          SelectedIndex="{x:Bind ViewModel.RequestedLodIndex, Mode=TwoWay}" />
                            </Grid>

                        </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Spacing="4" Visibility="{x:Bind ViewModel.DeviceCanSet, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverseConverter}}">
                            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.DeviceVerifyText, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.DeviceCurrentText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0"
                                    Visibility="{x:Bind ViewModel.DeviceCanSet, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button Content="Apply to mouse" Style="{StaticResource AccentButtonStyle}" Click="DeviceApply_Click" />
                            <Button Content="Undo" Click="DeviceRevert_Click" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.DeviceApplyText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="ButtonsSection" Visibility="Collapsed">
                <Border Style="{StaticResource PanelCardStyle}">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Spacing="2">
                            <TextBlock Text="Button settings" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Only the buttons this mouse reports are listed. Each value is read from the mouse and written back only when you press Apply."
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ButtonSettings, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:MouseSettingRow">
                                        <Grid MinHeight="40" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="116" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Hint}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                           Visibility="{x:Bind HasHint, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                            <Slider Grid.Column="1" Minimum="{x:Bind Minimum}" Maximum="{x:Bind Maximum}" StepFrequency="{x:Bind Step}"
                                                    Value="{x:Bind Number, Mode=TwoWay}" VerticalAlignment="Center"
                                                    Visibility="{x:Bind IsNumber, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <NumberBox Grid.Column="2" Minimum="{x:Bind Minimum}" Maximum="{x:Bind Maximum}" SmallChange="{x:Bind Step}"
                                                       Value="{x:Bind Number, Mode=TwoWay}" SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch"
                                                       Visibility="{x:Bind IsNumber, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Options, Mode=OneWay}"
                                                      SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}"
                                                      Visibility="{x:Bind IsChoice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Spacing="6" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.ShowButtons, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Content="Apply to mouse" Style="{StaticResource AccentButtonStyle}" Click="DeviceApply_Click" />
                                <Button Content="Undo" Click="DeviceRevert_Click" />
                            </StackPanel>
                            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.DeviceVerifyText, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.ShowButtons, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverseConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.DeviceApplyText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>

            <Grid x:Name="WindowsSection" Visibility="Collapsed" ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Windows pointer settings apply to every mouse on this PC."
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
                    <toolkit:SettingsCard Header="Pointer speed">
                        <Slider Value="{x:Bind ViewModel.Speed, Mode=TwoWay}" Minimum="1" Maximum="20" StepFrequency="1" Width="220" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Enhanced pointer precision">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Precision, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Pointer trails">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Trails, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Scroll lines per notch">
                        <NumberBox Value="{x:Bind ViewModel.WheelLines, Mode=TwoWay}" Minimum="-1" Maximum="100" SpinButtonPlacementMode="Inline" Width="130" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Double-click speed (ms)">
                        <NumberBox Value="{x:Bind ViewModel.DoubleClickMs, Mode=TwoWay}" Minimum="100" Maximum="2000" SpinButtonPlacementMode="Inline" Width="130" />
                    </toolkit:SettingsCard>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                    <toolkit:SettingsCard Header="Primary button is left">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.PrimaryLeft, Mode=TwoWay}" OnContent="Left" OffContent="Right" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Snap pointer to default button">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.SnapDefault, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="ClickLock">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ClickLock, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Re-apply on connect" Description="Re-applies saved Windows settings when the mouse arrives.">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ReapplyOnConnect, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </toolkit:SettingsCard>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Apply Windows settings" Click="WindowsApply_Click" />
                        <Button Content="Reset section" Click="WindowsReset_Click" />
                        <Button Content="Revert changes" Click="WindowsRevert_Click" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.WindowsResultText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid x:Name="TestsSection" Visibility="Collapsed" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Buttons and wheel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.LiveButtonsText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.LiveWheelText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.ModelClickText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Double-click timing" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border MinHeight="64" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8"
                                PointerPressed="ClickTestArea_PointerPressed">
                            <TextBlock Text="Double-click here" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.ClickTestText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Counts per inch" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <NumberBox Value="{x:Bind ViewModel.DpiInches, Mode=TwoWay}" Minimum="0.1" Maximum="100"
                                   SpinButtonPlacementMode="Inline" Header="Distance moved (inches)" Width="200" />
                        <Button Content="Analyze" Click="DpiAnalyze_Click" />
                        <TextBlock Text="{x:Bind ViewModel.DpiResultText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Measured rate" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.LiveHzText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.LiveCountsText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Bottom" />
                            <TextBlock Text="{x:Bind ViewModel.CpuShortText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.TestStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.TestSourceText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.CpuUsageText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.MismatchText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.TestResultText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="IgnoredSection" Visibility="Collapsed" Style="{StaticResource PanelCardStyle}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Ignored devices" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Row="1" Text="No devices were ignored. Every pointing device that reports a brand or vendor software is listed on the Mouse tab."
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.HasIgnoredDevices, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverseConverter}}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.IgnoredDevices, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MouseDeviceRow">
                                <Grid ColumnSpacing="12" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind DisplayName, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Device.ClassReason, Mode=OneWay}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <Button Grid.Column="2" Content="Show anyway" Click="ShowIgnored_Click" Tag="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border x:Name="LogSection" Visibility="Collapsed" Style="{StaticResource PanelCardStyle}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Activity log" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Log.Rows, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="input:MouseLogRow">
                                <StackPanel Spacing="1" Padding="0,4">
                                    <TextBlock Text="{x:Bind Action}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                        <Run Text="{x:Bind Time}" /><Run Text="  " /><Run Text="{x:Bind Device}" /><Run Text="  " /><Run Text="{x:Bind Result}" /><Run Text="  " /><Run Text="{x:Bind Message}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
