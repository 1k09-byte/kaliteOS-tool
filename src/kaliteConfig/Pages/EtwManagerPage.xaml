<Page
    x:Class="kaliteConfig.Pages.EtwManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:kaliteConfig.Pages"
    xmlns:models="using:kaliteConfig.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="ETW Trace Manager" Style="{StaticResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                    <TextBlock Text="Stop background Event Tracing for Windows sessions to reduce I/O jitter and DPC latency." 
                               Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <AutoSuggestBox PlaceholderText="Search traces..." 
                                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    QueryIcon="Find" 
                                    Width="200" 
                                    VerticalAlignment="Center" 
                                    Margin="0,0,8,0"/>
                    <Button Command="{x:Bind ViewModel.OptimizeAllCommand}" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE943;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Text="Optimize All" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.RevertDefaultCommand}" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE777;" FontSize="14"/>
                            <TextBlock Text="System Default" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ClearAllLogsCommand}" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            <TextBlock Text="Clear All Logs" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.RefreshCommand}" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Text="Refresh Sessions" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Data Grid Header -->
        <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" 
                CornerRadius="8,8,0,0" Padding="16,12" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,1,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Trace Name" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="Buffers Written" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="Auto-Logger" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="3" Text="State" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>
        
        <!-- Grouped Trace Categories -->
        <ScrollViewer Grid.Row="2" Padding="0,0,16,0" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.GroupedSessions, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:EtwSessionGroup">
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="{x:Bind Category}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource SystemAccentColorLight2}" Margin="0,0,0,8"/>
                            
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <ItemsRepeater ItemsSource="{x:Bind Sessions, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:EtwSessionModel">
                                            <Grid Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>
                                                
                                                <TextBlock Grid.Column="1" Text="{x:Bind BuffersWritten}" 
                                                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                           
                                                <ToggleSwitch Grid.Column="2" 
                                                              IsOn="{x:Bind IsAutoLoggerEnabled, Mode=TwoWay}"
                                                              Toggled="OnAutoLoggerToggled"
                                                              HorizontalAlignment="Left" 
                                                              VerticalAlignment="Center"
                                                              MinWidth="0"/>
                                                
                                                <ToggleSwitch Grid.Column="3" 
                                                              IsOn="{x:Bind IsRunning, Mode=TwoWay}"
                                                              Toggled="OnSessionToggled"
                                                              HorizontalAlignment="Right" 
                                                              VerticalAlignment="Center"
                                                              MinWidth="0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
        
        <ProgressRing Grid.Row="2" IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" 
                      HorizontalAlignment="Center" VerticalAlignment="Center" Width="40" Height="40"/>
    </Grid>
</Page>
