<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:kaliteConfig.ViewModels"
    xmlns:models="using:kaliteConfig.Models"
    xmlns:converters="using:kaliteConfig.Converters"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <SolidColorBrush x:Key="StartupRowHoverBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
        <SolidColorBrush x:Key="StartupRowPressedBrush" Color="{ThemeResource SubtleFillColorTertiary}" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <Style x:Key="CardListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Card" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Card.Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Card.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="Card.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                            <Setter Target="Card.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="Card.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                            <Setter Target="Card.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="Card.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                            <Setter Target="Card.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Card.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SourcesCardListViewItemStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource CardListViewItemStyle}">
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="TableRowListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1,12,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Page.DataContext>
        <vm:UninstallerViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,16,28,8" Spacing="2">
            <TextBlock Text="Startup" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Everything that starts when Windows signs in or boots, by source, with its command line."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid x:Name="StartupPanel" Grid.Row="1" Padding="28,0,28,20" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Sources" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ListView ItemsSource="{Binding StartupSections}"
                          SelectedIndex="{Binding StartupSectionIndex, Mode=TwoWay}"
                          SelectionMode="Single"
                          ItemContainerStyle="{StaticResource SourcesCardListViewItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:StartupSectionVm">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyTextBlockStyle}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind CountText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock Text="{Binding CurrentStartupSection.Title}"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{Binding CurrentStartupSection.Hint}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="A checkbox switches an entry on or off straight away; the trash button deletes it."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="360" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox Grid.Column="0" PlaceholderText="Search name or command..." QueryIcon="Find"
                                    Text="{Binding StartupSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Grid.Column="1" Content="Hide Microsoft entries" VerticalAlignment="Center"
                              IsChecked="{Binding HideMicrosoftEntries, Mode=TwoWay}"
                              Visibility="{Binding MicrosoftFilterVis}"
                              ToolTipService.ToolTip="Hide Microsoft services and Microsoft scheduled tasks" />
                    <TextBlock Grid.Column="2" Text="{Binding StartupSummaryText}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <CommandBar Grid.Column="3" DefaultLabelPosition="Right" HorizontalAlignment="Right">
                        <AppBarButton Icon="Refresh" Label="Refresh" Command="{Binding LoadStartupCommand}" />
                    </CommandBar>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12,8" Margin="0,0,12,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Start" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding TypeHeaderText}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="Command / Value"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{Binding CurrentStartupEntries}"
                              SelectionMode="None"
                              ItemContainerStyle="{StaticResource TableRowListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:StartupEntry">
                                <Border x:Name="RowSurface" CornerRadius="8" Background="Transparent" Padding="12,8"
                                        PointerEntered="StartupRow_PointerEntered"
                                        PointerExited="StartupRow_PointerExited"
                                        PointerPressed="StartupRow_PointerPressed"
                                        PointerReleased="StartupRow_PointerReleased">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}" OnContent="" OffContent=""
                                                  VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="Checked = automatic start; unchecked = disabled" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               ToolTipService.ToolTip="{x:Bind Id}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind EntryType}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Command}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               IsTextSelectionEnabled="True" VerticalAlignment="Center"
                                               ToolTipService.ToolTip="{x:Bind Command}" />
                                    <Button Grid.Column="4" Click="DeleteStartupEntry_Click" Tag="{x:Bind}"
                                            Width="32" Height="32" Padding="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            AutomationProperties.Name="Delete entry"
                                            ToolTipService.ToolTip="Delete this entry">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="1"
                               Text="Nothing to show - this source has no entries, or the search hides them all."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding EmptyVis}" />

                    <TextBlock Grid.Row="1" Text="{Binding StartupStatusText}"
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Bottom" Margin="0,0,0,8"
                               Visibility="{Binding StartupStatusText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert, FallbackValue=Collapsed}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
