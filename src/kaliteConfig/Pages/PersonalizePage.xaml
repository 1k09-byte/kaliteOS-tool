<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.PersonalizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:kaliteConfig.Converters"
    xmlns:live="using:kaliteConfig.Services.LiveWallpaper"
    xmlns:vm="using:kaliteConfig.ViewModels"
    Background="Transparent"
    NavigationCacheMode="Enabled"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <Page.Resources>
        <converters:ImageFileThumbnailConverter x:Key="ThumbnailConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        <converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />
        <converters:ArgbToBrushConverter x:Key="ArgbToBrushConverter" />
        <converters:IntToFileCountConverter x:Key="IntToFileCountConverter" />
        <converters:ZeroVisibilityConverter x:Key="ZeroVisibilityConverter" />
        <converters:NonZeroVisibilityConverter x:Key="NonZeroToVisibilityConverter" />
        <Style x:Key="PersonalizeCard" TargetType="Border" BasedOn="{StaticResource CardBorder}" />
        <SolidColorBrush x:Key="GridViewItemBorderBrushSelected" Color="Transparent" />
        <SolidColorBrush x:Key="GridViewItemBorderBrushSelectedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="GridViewItemBorderBrushSelectedPressed" Color="Transparent" />
        <Style x:Key="LiveLibraryItemStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="StaticLibraryItemStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="28,8,28,16" Spacing="12">

            <StackPanel Spacing="4">
                <TextBlock Text="Personalize" Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <TextBlock Text="Customize your cursor and choose a desktop wallpaper."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <SelectorBar x:Name="SectionBar" SelectionChanged="SectionBar_SelectionChanged">
                <SelectorBarItem x:Name="WallpaperItem" Text="Wallpaper" Tag="wallpaper" IsSelected="True" />
                <SelectorBarItem x:Name="CursorItem" Text="Cursor" Tag="cursor" />
            </SelectorBar>

            <Button Content="Revert everything to how it was before this app changed it"
                    Click="RevertEverything_Click" />

            <InfoBar IsOpen="{Binding StatusOpen, Mode=TwoWay}"
                     Severity="{Binding StatusSeverity}"
                     Message="{Binding StatusMessage}"
                     IsClosable="True" />
            <InfoBar IsOpen="{Binding IsHighContrast}"
                     Severity="Informational"
                     Title="High contrast is on"
                     Message="Some appearance settings won't visibly apply while a high contrast theme is active." />

            <StackPanel x:Name="WallpaperSection" Spacing="12">
                <Border Style="{StaticResource PersonalizeCard}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Desktop wallpaper" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Monitor" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Monitors}"
                                      SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                                      DisplayMemberPath="Label" />
                            <ComboBox Grid.Column="1" Header="Fit" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Fits}"
                                      SelectedItem="{Binding SelectedFit, Mode=TwoWay}" />
                        </Grid>

                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="8" Height="200" HorizontalAlignment="Stretch">
                            <Image x:Name="PreviewImage" Stretch="UniformToFill"
                                   AutomationProperties.Name="Wallpaper preview" />
                        </Border>
                        <TextBlock Text="Preview is approximate. Tile, Center and Span are shown as an estimate."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Add image..." Click="AddWallpaper_Click" />
                            <Button Content="Apply wallpaper" Command="{Binding ApplyWallpaperCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{Binding SelectedWallpaper, Converter={StaticResource NotNullToBoolConverter}}" />
                            <Button Content="Remove from library" Command="{Binding RemoveSelectedWallpaperCommand}"
                                    IsEnabled="{Binding SelectedWallpaper, Converter={StaticResource NotNullToBoolConverter}}" />
                            <Button Content="Restore wallpaper section" Command="{Binding RevertWallpaperSectionCommand}" />
                        </StackPanel>

                        <Border Style="{StaticResource PersonalizeCard}" Padding="12">
                            <StackPanel Spacing="8">
                                <ToggleSwitch Header="Match Windows colours to the wallpaper"
                                              IsOn="{Binding MatchAccentToWallpaper, Mode=TwoWay}"
                                              OnContent="On" OffContent="Off" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="When applying a wallpaper, its dominant colour also becomes the Windows accent, and the system light/dark setting follows the image brightness." />
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Background="{Binding AccentPreviewArgb, Converter={StaticResource ArgbToBrushConverter}}" />
                                    <TextBlock Text="{Binding AccentPreviewText}" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Content="Apply colours now" Click="PreviewAccent_Click"
                                            IsEnabled="{Binding SelectedWallpaper, Converter={StaticResource NotNullToBoolConverter}}" />
                                    <Button Content="Choose your own accent colour...">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="8">
                                                    <ColorPicker Color="{Binding AccentColor, Mode=TwoWay}"
                                                                 IsAlphaEnabled="False"
                                                                 AutomationProperties.Name="Accent colour" />
                                                    <Button Content="Apply accent colour" Command="{Binding ApplyManualAccentCommand}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Library" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <StackPanel Spacing="8"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding LibraryEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE91B;" FontSize="32"
                                      Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="No wallpapers yet" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Add an image, or bundle some with the app."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <GridView x:Name="LibraryGrid"
                                  ItemsSource="{Binding Library}"
                                  SelectedItem="{Binding SelectedWallpaper, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  ItemContainerStyle="{StaticResource StaticLibraryItemStyle}"
                                  MaxHeight="320"
                                  Visibility="{Binding LibraryEmpty, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                  AutomationProperties.Name="Wallpaper library">
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="180" CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="0">
                                            <Border Height="101" CornerRadius="7,7,0,0"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <Image Stretch="UniformToFill" HorizontalAlignment="Stretch"
                                                       Source="{Binding FullPath, Converter={StaticResource ThumbnailConverter}}"
                                                       AutomationProperties.Name="{Binding OriginalName}" />
                                            </Border>
                                            <TextBlock Text="{Binding OriginalName}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Padding="10,8,10,10" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="CursorSection" Spacing="12" Visibility="Collapsed">
                <Border Style="{StaticResource PersonalizeCard}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Cursor packs" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Choose a pack of custom cursor files. Each .cur or .ani file is matched to a pointer role by its name."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                        <StackPanel Spacing="8" HorizontalAlignment="Center"
                                    Visibility="{Binding CursorPacks.Count, Converter={StaticResource ZeroVisibilityConverter}}">
                            <FontIcon Glyph="&#xE7F4;" FontSize="32"
                                      Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="No cursor packs found" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Import a folder of .cur and .ani files to get started."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <ListView x:Name="CursorPackList"
                                  ItemsSource="{Binding CursorPacks}"
                                  SelectedItem="{Binding SelectedCursorPack, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  MaxHeight="320"
                                  HorizontalContentAlignment="Stretch"
                                  Visibility="{Binding CursorPacks.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"
                                  AutomationProperties.Name="Cursor packs">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding FileCount, Converter={StaticResource IntToFileCountConverter}}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,2"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsBundled, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="BUNDLED" Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Pointer size" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Slider Minimum="{Binding PointerSizeMin}" Maximum="{Binding PointerSizeMax}"
                                    StepFrequency="16" SnapsTo="StepValues" TickFrequency="16"
                                    Value="{Binding PointerSize, Mode=TwoWay}"
                                    AutomationProperties.Name="Pointer size" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{Binding PointerSizeText}" />
                        </StackPanel>
                        <Button Content="Apply pointer size" Command="{Binding ApplyPointerSizeCommand}" HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Apply selected pack" Click="ApplyCursorPack_Click"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{Binding SelectedCursorPack, Converter={StaticResource NotNullToBoolConverter}}" />
                            <Button Content="Import pack from folder..." Click="PickCursorFolder_Click" />
                            <Button Content="Remove selected pack" Command="{Binding RemoveSelectedCursorPackCommand}"
                                    IsEnabled="{Binding SelectedCursorPack, Converter={StaticResource NotNullToBoolConverter}}" />
                            <Button Content="Reset to Windows default" Command="{Binding ResetCursorToDefaultsCommand}" />
                            <Button Content="Restore cursor section" Click="RevertCursor_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="LiveSection" Spacing="12">
                <Border Style="{StaticResource PersonalizeCard}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Live wallpaper" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ToggleSwitch Header="Enable live wallpaper" IsOn="{Binding FeatureEnabled, Mode=TwoWay}"
                                      OnContent="On" OffContent="Off" />
                        <TextBlock Text="Live wallpaper is experimental and stays off until you turn it on."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <ToggleSwitch Header="Resume on launch" IsOn="{Binding ResumeOnLaunch, Mode=TwoWay}"
                                      OnContent="On" OffContent="Off" />
                        <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                                 Message="Live wallpaper stops when the app closes." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PersonalizeCard}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Now playing" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <InfoBar Severity="{Binding StatusSeverity}" Message="{Binding StatusText}"
                                 IsOpen="True" IsClosable="False" />
                        <TextBlock Text="{Binding GateReason}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding GateReason, Converter={StaticResource NullToVisibilityConverter}}" />
                        <ComboBox Header="Targets" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding TargetLabels}"
                                  SelectedIndex="{Binding TargetModeIndex, Mode=TwoWay}" />
                        <ComboBox Header="Wallpaper" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Items}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SameItem, Mode=TwoWay}"
                                  Visibility="{Binding SameOrSpanVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding Assignments}"
                                      Visibility="{Binding PerMonitorVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LiveAssignmentRow">
                                    <Grid ColumnSpacing="12" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind MonitorLabel}" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding DataContext.Items, ElementName=LiveSection}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Monitor" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Monitors}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedMonitorChoice, Mode=TwoWay}" />
                            <Button Grid.Column="1" Content="Set selected on monitor"
                                    Command="{Binding SetSelectedOnMonitorCommand}"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Start" Command="{Binding StartCommand}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Stop" Command="{Binding StopCommand}"
                                    IsEnabled="{Binding PauseEnabled}" />
                            <Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}"
                                    IsEnabled="{Binding PauseEnabled}" />
                            <ProgressRing IsActive="{Binding IsStarting}" Width="20" Height="20"
                                          VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PersonalizeCard}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Live library" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <CommandBar DefaultLabelPosition="Right">
                            <AppBarButton Icon="Add" Label="Video file" Click="LiveAddVideo_Click" />
                            <AppBarButton Icon="NewFolder" Label="HTML folder" Click="LiveAddFolder_Click" />
                            <AppBarButton Icon="Download" Label="Package" Click="LiveAddPackage_Click" />
                            <AppBarButton Icon="Delete" Label="Remove" Command="{Binding RemoveSelectedCommand}" />
                        </CommandBar>
                        <GridView ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                  SelectionMode="Single" IsItemClickEnabled="True" ItemClick="LiveLibrary_ItemClick"
                                  ItemContainerStyle="{StaticResource LiveLibraryItemStyle}"
                                  AllowDrop="True" Drop="LiveLibrary_Drop" DragOver="LiveLibrary_DragOver"
                                  MaxHeight="320" AutomationProperties.Name="Live wallpaper library"
                                  Visibility="{Binding LibraryEmpty, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="live:LiveWallpaperItem">
                                    <Border Width="180" CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Border.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Set on all monitors" Click="LiveSetAll_Click" />
                                                <MenuFlyoutItem Text="Rename" Click="LiveRename_Click" />
                                                <MenuFlyoutItem Text="Remove" Click="LiveRemove_Click" />
                                            </MenuFlyout>
                                        </Border.ContextFlyout>
                                        <StackPanel Spacing="0">
                                            <Border Height="101" CornerRadius="7,7,0,0"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <Image Stretch="UniformToFill" HorizontalAlignment="Stretch"
                                                       Source="{x:Bind Thumb, Mode=OneTime}"
                                                       AutomationProperties.Name="{x:Bind Name}" />
                                            </Border>
                                            <StackPanel Spacing="2" Padding="10,8,10,10">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind KindText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <StackPanel Spacing="8" HorizontalAlignment="Center"
                                    Visibility="{Binding LibraryEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE91B;" FontSize="32"
                                      Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="No live wallpapers yet" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Add a video file, an HTML folder, or a package. You can also drop files here."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PersonalizeCard}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Playback" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox Header="Scaling" HorizontalAlignment="Stretch"
                                  SelectedIndex="{Binding ScaleIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Fill" />
                            <ComboBoxItem Content="Fit" />
                            <ComboBoxItem Content="Stretch" />
                            <ComboBoxItem Content="Center" />
                        </ComboBox>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Volume" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Slider Minimum="0" Maximum="1" StepFrequency="0.01"
                                    Value="{Binding Volume, Mode=TwoWay}"
                                    AutomationProperties.Name="Volume" />
                            <ToggleSwitch Header="Mute" IsOn="{Binding Muted, Mode=TwoWay}"
                                          OnContent="Muted" OffContent="Audible" />
                        </StackPanel>
                        <ComboBox Header="Playback rate" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding RateLabels}"
                                  SelectedIndex="{Binding RateIndex, Mode=TwoWay}" />
                        <ComboBox Header="Frame-rate cap" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding FrameCapLabels}"
                                  SelectedIndex="{Binding FrameCapIndex, Mode=TwoWay}" />
                        <TextBlock Text="The frame-rate cap applies to HTML wallpapers. Video plays at its own rate."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="Smart pause" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Expander.Header>
                    <StackPanel Spacing="8">
                        <ToggleSwitch Header="Pause while a fullscreen app or game is in the foreground (on by default)"
                                      IsOn="{Binding PauseOnFullscreen, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        <ToggleSwitch Header="Pause while on battery power (on by default)"
                                      IsOn="{Binding PauseOnBattery, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        <ToggleSwitch Header="Pause while Energy Saver is active (on by default)"
                                      IsOn="{Binding PauseOnEnergySaver, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        <ToggleSwitch Header="Pause when the desktop is fully covered (off by default)"
                                      IsOn="{Binding PauseWhenCovered, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        <TextBlock Text="Playback also pauses while the session is locked, the display is off, or in a remote session."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Visibility="{Binding HasManifestProps, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Expander.Header>
                        <TextBlock Text="Wallpaper properties" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Props}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LivePropertyRow">
                                <StackPanel Spacing="4" Margin="0,0,0,8">
                                    <TextBlock Text="{x:Bind Def.Label}" Style="{StaticResource BodyTextBlockStyle}" />
                                    <ToggleSwitch IsOn="{x:Bind BoolValue, Mode=TwoWay}" OnContent="On" OffContent="Off"
                                                  Visibility="{x:Bind IsBoolean, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <StackPanel Spacing="4" Visibility="{x:Bind IsNumber, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Slider Minimum="{x:Bind Def.Min}" Maximum="{x:Bind Def.Max}" StepFrequency="{x:Bind Def.Step}"
                                                Value="{x:Bind NumberValue, Mode=TwoWay}" />
                                        <NumberBox Minimum="{x:Bind Def.Min}" Maximum="{x:Bind Def.Max}" SmallChange="{x:Bind Def.Step}"
                                                 Value="{x:Bind NumberValue, Mode=TwoWay}" />
                                    </StackPanel>
                                    <ComboBox ItemsSource="{x:Bind Def.Options}" SelectedItem="{x:Bind TextValue, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Visibility="{x:Bind IsChoice, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Button Content="Choose colour" Visibility="{x:Bind IsColor, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker Color="{x:Bind ColorValue, Mode=TwoWay}" IsAlphaEnabled="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="Playlist" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Expander.Header>
                    <StackPanel Spacing="8">
                        <ToggleSwitch Header="Rotate through the library" IsOn="{Binding PlaylistEnabled, Mode=TwoWay}"
                                      OnContent="On" OffContent="Off" />
                        <ComboBox Header="Interval" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding MinutesLabels}"
                                  SelectedIndex="{Binding PlaylistMinutesIndex, Mode=TwoWay}" />
                        <ToggleSwitch Header="Shuffle" IsOn="{Binding PlaylistShuffle, Mode=TwoWay}"
                                      OnContent="On" OffContent="Off" />
                        <Button Content="Next wallpaper" Command="{Binding NextCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Expander>
            </StackPanel>

            <Border Style="{StaticResource PersonalizeCard}" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Windows theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Switch all of Windows between light and dark."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <ToggleSwitch Header="Apps" IsOn="{Binding AppsUseLightTheme, Mode=TwoWay}"
                                  OnContent="Light" OffContent="Dark" />
                    <ToggleSwitch Header="Windows shell" IsOn="{Binding SystemUsesLightTheme, Mode=TwoWay}"
                                  OnContent="Light" OffContent="Dark" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
