<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.PersonalizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:kaliteConfig.Converters"
    Background="Transparent"
    NavigationCacheMode="Enabled"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <Page.Resources>
        <converters:ImageFileThumbnailConverter x:Key="ThumbnailConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        <converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />
        <converters:ArgbToBrushConverter x:Key="ArgbToBrushConverter" />
        <converters:IntToFileCountConverter x:Key="IntToFileCountConverter" />
        <converters:ZeroVisibilityConverter x:Key="ZeroVisibilityConverter" />
        <converters:NonZeroVisibilityConverter x:Key="NonZeroToVisibilityConverter" />
        <Style x:Key="PersonalizeCard" TargetType="Border" BasedOn="{StaticResource CardBorder}" />
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="28,8,28,16" Spacing="12">

            <StackPanel Spacing="4">
                <TextBlock Text="Personalize" Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <TextBlock Text="Customize your cursor and choose a desktop wallpaper."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <SelectorBar x:Name="SectionBar" SelectionChanged="SectionBar_SelectionChanged">
                <SelectorBarItem x:Name="WallpaperItem" Text="Wallpaper" Tag="wallpaper" IsSelected="True" />
                <SelectorBarItem x:Name="CursorItem" Text="Cursor" Tag="cursor" />
            </SelectorBar>

            <Button Content="Revert everything to how it was before this app changed it"
                    Click="RevertEverything_Click" />

            <InfoBar IsOpen="{Binding StatusOpen, Mode=TwoWay}"
                     Severity="{Binding StatusSeverity}"
                     Message="{Binding StatusMessage}"
                     IsClosable="True" />
            <InfoBar IsOpen="{Binding IsHighContrast}"
                     Severity="Informational"
                     Title="High contrast is on"
                     Message="Some appearance settings won't visibly apply while a high contrast theme is active." />

            <StackPanel x:Name="WallpaperSection" Spacing="12">
                <Border Style="{StaticResource PersonalizeCard}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Desktop wallpaper" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Monitor" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Monitors}"
                                      SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                                      DisplayMemberPath="Label" />
                            <ComboBox Grid.Column="1" Header="Fit" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Fits}"
                                      SelectedItem="{Binding SelectedFit, Mode=TwoWay}" />
                        </Grid>

                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="8" Height="200" HorizontalAlignment="Stretch">
                            <Image x:Name="PreviewImage" Stretch="UniformToFill"
                                   AutomationProperties.Name="Wallpaper preview" />
                        </Border>
                        <TextBlock Text="Preview is approximate. Tile, Center and Span are shown as an estimate."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Add image..." Click="AddWallpaper_Click" />
                            <Button Content="Apply wallpaper" Command="{Binding ApplyWallpaperCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{Binding SelectedWallpaper, Converter={StaticResource NotNullToBoolConverter}}" />
                            <Button Content="Remove from library" Command="{Binding RemoveSelectedWallpaperCommand}"
                                    IsEnabled="{Binding SelectedWallpaper, Converter={StaticResource NotNullToBoolConverter}}" />
                            <Button Content="Restore wallpaper section" Command="{Binding RevertWallpaperSectionCommand}" />
                        </StackPanel>

                        <Border Style="{StaticResource PersonalizeCard}" Padding="12">
                            <StackPanel Spacing="8">
                                <ToggleSwitch Header="Match Windows colours to the wallpaper"
                                              IsOn="{Binding MatchAccentToWallpaper, Mode=TwoWay}"
                                              OnContent="On" OffContent="Off" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="When applying a wallpaper, its dominant colour also becomes the Windows accent, and the system light/dark setting follows the image brightness." />
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Background="{Binding AccentPreviewArgb, Converter={StaticResource ArgbToBrushConverter}}" />
                                    <TextBlock Text="{Binding AccentPreviewText}" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Content="Apply colours now" Click="PreviewAccent_Click"
                                            IsEnabled="{Binding SelectedWallpaper, Converter={StaticResource NotNullToBoolConverter}}" />
                                    <Button Content="Choose your own accent colour...">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="8">
                                                    <ColorPicker Color="{Binding AccentColor, Mode=TwoWay}"
                                                                 IsAlphaEnabled="False"
                                                                 AutomationProperties.Name="Accent colour" />
                                                    <Button Content="Apply accent colour" Command="{Binding ApplyManualAccentCommand}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Library" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <StackPanel Spacing="8"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding LibraryEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE91B;" FontSize="32"
                                      Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="No wallpapers yet" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Add an image, or bundle some with the app."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <GridView x:Name="LibraryGrid"
                                  ItemsSource="{Binding Library}"
                                  SelectedItem="{Binding SelectedWallpaper, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  MaxHeight="320"
                                  Visibility="{Binding LibraryEmpty, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                  AutomationProperties.Name="Wallpaper library">
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4" Width="180">
                                        <Image Width="180" Height="101" Stretch="UniformToFill"
                                               Source="{Binding FullPath, Converter={StaticResource ThumbnailConverter}}"
                                               AutomationProperties.Name="{Binding OriginalName}" />
                                        <TextBlock Text="{Binding OriginalName}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="CursorSection" Spacing="12" Visibility="Collapsed">
                <Border Style="{StaticResource PersonalizeCard}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Cursor packs" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Choose a pack of custom cursor files. Each .cur or .ani file is matched to a pointer role by its name."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                        <StackPanel Spacing="8" HorizontalAlignment="Center"
                                    Visibility="{Binding CursorPacks.Count, Converter={StaticResource ZeroVisibilityConverter}}">
                            <FontIcon Glyph="&#xE7F4;" FontSize="32"
                                      Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="No cursor packs found" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Import a folder of .cur and .ani files to get started."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <ListView x:Name="CursorPackList"
                                  ItemsSource="{Binding CursorPacks}"
                                  SelectedItem="{Binding SelectedCursorPack, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  MaxHeight="320"
                                  HorizontalContentAlignment="Stretch"
                                  Visibility="{Binding CursorPacks.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"
                                  AutomationProperties.Name="Cursor packs">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding FileCount, Converter={StaticResource IntToFileCountConverter}}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,2"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsBundled, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="BUNDLED" Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Pointer size" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Slider Minimum="{Binding PointerSizeMin}" Maximum="{Binding PointerSizeMax}"
                                    StepFrequency="16" SnapsTo="StepValues" TickFrequency="16"
                                    Value="{Binding PointerSize, Mode=TwoWay}"
                                    AutomationProperties.Name="Pointer size" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{Binding PointerSizeText}" />
                        </StackPanel>
                        <Button Content="Apply pointer size" Command="{Binding ApplyPointerSizeCommand}" HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Apply selected pack" Click="ApplyCursorPack_Click"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{Binding SelectedCursorPack, Converter={StaticResource NotNullToBoolConverter}}" />
                            <Button Content="Import pack from folder..." Click="PickCursorFolder_Click" />
                            <Button Content="Remove selected pack" Command="{Binding RemoveSelectedCursorPackCommand}"
                                    IsEnabled="{Binding SelectedCursorPack, Converter={StaticResource NotNullToBoolConverter}}" />
                            <Button Content="Reset to Windows default" Command="{Binding ResetCursorToDefaultsCommand}" />
                            <Button Content="Restore cursor section" Click="RevertCursor_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource PersonalizeCard}" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Windows theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Switch all of Windows between light and dark."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <ToggleSwitch Header="Apps" IsOn="{Binding AppsUseLightTheme, Mode=TwoWay}"
                                  OnContent="Light" OffContent="Dark" />
                    <ToggleSwitch Header="Windows shell" IsOn="{Binding SystemUsesLightTheme, Mode=TwoWay}"
                                  OnContent="Light" OffContent="Dark" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
