<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.PersonalizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:kaliteConfig.Converters"
    Background="Transparent"
    NavigationCacheMode="Enabled"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <Page.Resources>
        <converters:ImageFileThumbnailConverter x:Key="ThumbnailConverter" />
        <Style x:Key="PersonalizeCard" TargetType="Border" BasedOn="{StaticResource CardBorder}" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="28,0,28,24" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="Personalize" Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <TextBlock Text="Customize your cursor and choose a desktop wallpaper."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Button Content="Revert everything to how it was before this app changed it"
                    Click="RevertEverything_Click" />

            <InfoBar IsOpen="{Binding StatusOpen, Mode=TwoWay}"
                     Severity="{Binding StatusSeverity}"
                     Message="{Binding StatusMessage}"
                     IsClosable="True" />
            <InfoBar IsOpen="{Binding IsHighContrast}"
                     Severity="Informational"
                     Title="High contrast is on"
                     Message="Some appearance settings won't visibly apply while a high contrast theme is active." />

            <SelectorBar x:Name="SectionBar" SelectionChanged="SectionBar_SelectionChanged">
                <SelectorBarItem x:Name="WallpaperItem" Text="Wallpaper" Tag="wallpaper" IsSelected="True" />
                <SelectorBarItem x:Name="CursorItem" Text="Cursor" Tag="cursor" />
            </SelectorBar>

            <StackPanel x:Name="WallpaperSection" Spacing="16">
                <Border Style="{StaticResource PersonalizeCard}" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Desktop wallpaper" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Monitor" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Monitors}"
                                      SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                                      DisplayMemberPath="Label" />
                            <ComboBox Grid.Column="1" Header="Fit" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Fits}"
                                      SelectedItem="{Binding SelectedFit, Mode=TwoWay}" />
                        </Grid>

                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="4" Height="240" HorizontalAlignment="Stretch">
                            <Image x:Name="PreviewImage" Stretch="UniformToFill"
                                   AutomationProperties.Name="Wallpaper preview" />
                        </Border>
                        <TextBlock Text="Preview is approximate. Tile, Center and Span are shown as an estimate."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Add image..." Click="AddWallpaper_Click" />
                            <Button Content="Apply wallpaper" Command="{Binding ApplyWallpaperCommand}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Remove from library" Command="{Binding RemoveSelectedWallpaperCommand}" />
                            <Button Content="Restore wallpaper section" Command="{Binding RevertWallpaperSectionCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="CursorSection" Spacing="16" Visibility="Collapsed">
                <Border Style="{StaticResource PersonalizeCard}" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Pointer" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <NumberBox Header="Pointer size" Value="{Binding PointerSize, Mode=TwoWay}"
                                   Minimum="32" Maximum="256" SpinButtonPlacementMode="Inline"
                                   SmallChange="16" LargeChange="32" />

                        <Slider Header="Pointer speed" Value="{Binding PointerSpeed, Mode=TwoWay}"
                                Minimum="1" Maximum="20" StepFrequency="1" TickFrequency="1" />

                        <ToggleSwitch Header="Enhance pointer precision"
                                      IsOn="{Binding EnhancedPrecision, Mode=TwoWay}"
                                      OnContent="On" OffContent="Off" />

                        <NumberBox Header="Pointer trails (0 turns trails off)"
                                   Value="{Binding Trails, Mode=TwoWay}"
                                   Minimum="0" Maximum="12" SpinButtonPlacementMode="Inline" />

                        <NumberBox Header="Lines to scroll per notch"
                                   Value="{Binding WheelLines, Mode=TwoWay}"
                                   Minimum="1" Maximum="100" SpinButtonPlacementMode="Inline" />

                        <NumberBox Header="Text cursor (caret) thickness"
                                   Value="{Binding CaretWidth, Mode=TwoWay}"
                                   Minimum="1" Maximum="20" SpinButtonPlacementMode="Inline" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Apply cursor settings" Click="ApplyCursor_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Reset pointer to Windows default" Command="{Binding ResetCursorToDefaultsCommand}" />
                            <Button Content="Restore cursor section" Click="RevertCursor_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PersonalizeCard}" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Cursor scheme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Choose a folder of .cur and .ani files. Each file is mapped to a standard pointer role by its name."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SchemeFolder}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Choose scheme folder..." Click="PickCursorFolder_Click" />
                            <Button Content="Apply scheme" Click="ApplyScheme_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
