<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.InstallerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:kaliteConfig.Pages"
    xmlns:models="using:kaliteConfig.Models"
    xmlns:animations="using:Microsoft.UI.Xaml.Media.Animation"
    xmlns:dev="using:DevWinUI"
    xmlns:converters="using:kaliteConfig.Converters"
    NavigationCacheMode="Enabled">
    <!-- Entrance transition now lives on the main ContentFrame (see MainWindow.xaml)
         so every page animates the same way; declaring it here too stacked two
         entrances on top of each other. -->

    <Page.Resources>
        <converters:AssetPathToImageSourceConverter x:Key="AssetPathConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>

        <DataTemplate x:Key="InstallerCardTemplate" x:DataType="models:BrowserInstallItem">
            <Button
                x:Name="CardRoot"
                Margin="0,0,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Click="BrowserCard_Click"
                Tag="{x:Bind}"
                Visibility="{x:Bind local:InstallerPage.BoolToVis(IsVisible), Mode=OneWay}">
                <Grid Padding="14" UseLayoutRounding="True">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <!-- Large app icon (no fallback glyph behind images). -->
                        <Grid HorizontalAlignment="Center" Width="48" Height="48">
                            <Image HorizontalAlignment="Center" Width="48" Height="48"
                                Source="{x:Bind ImagePath, Converter={StaticResource AssetPathConverter}}" />
                        </Grid>
                        <!-- Browser name -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextAlignment="Center" />
                        <!-- Status text container: only active states (downloading /
                             installing / failed / done). No static "Install" caption. -->
                        <Grid HorizontalAlignment="Center">
                            <!-- Normal status text -->
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind StatusText, Mode=OneWay}"
                                TextAlignment="Center"
                                Visibility="{x:Bind local:InstallerPage.StatusToActiveVisibility(Status), Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- COMPACT VIEW: one roomy row per app - 32px icon, semibold name,
             status right-aligned. Rows run 56px tall with breathing room so the
             list fills the page instead of rattling around in it. -->
        <DataTemplate x:Key="InstallerCompactTemplate" x:DataType="models:BrowserInstallItem">
            <Button
                    Margin="0,0,0,6"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    Click="BrowserCard_Click"
                    Tag="{x:Bind}"
                    Visibility="{x:Bind local:InstallerPage.BoolToVis(IsVisible), Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="32" Height="32" VerticalAlignment="Center"
                           Source="{x:Bind ImagePath, Converter={StaticResource AssetPathConverter}}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center"
                               FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" FontSize="13" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind StatusText, Mode=OneWay}" />
                </Grid>
            </Button>
        </DataTemplate>

    </Page.Resources>

    <Grid x:Name="RootGrid" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="40,28,40,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Apps" Style="{StaticResource KalitePageTitle}" />
            <!-- Layout switcher for the Install tab. It only affects the app
                 install grid, so it is hidden on the Uninstall tab by
                 MainSelectorBar_SelectionChanged - a control that
                 silently does nothing on the tab you are looking at is worse
                 than no control at all. -->
            <StackPanel x:Name="ViewModePanel" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <RadioButton x:Name="ViewCardBtn" GroupName="AppViewMode" Content="Cards"
                             IsChecked="True" Click="ViewMode_Click"
                             ToolTipService.ToolTip="Big icon tiles" />
                <RadioButton x:Name="ViewCompactBtn" GroupName="AppViewMode" Content="Compact"
                             Click="ViewMode_Click"
                             ToolTipService.ToolTip="Single-line rows, more apps at once" />
            </StackPanel>
        </Grid>

        <SelectorBar x:Name="MainSelectorBar" Grid.Row="1" Margin="36,12,36,8"
                     HorizontalAlignment="Left"
                     SelectionChanged="MainSelectorBar_SelectionChanged">
            <SelectorBarItem x:Name="TabInstall" Text="Install" IsSelected="True" />
            <SelectorBarItem x:Name="TabUninstall" Text="Uninstall" />
        </SelectorBar>

        <Grid x:Name="InstallPanel" Grid.Row="2" Style="{StaticResource KaliteEntranceGrid}">
        <ScrollViewer
            Padding="40,0,40,28"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                MaxWidth="1064"
                Margin="0,8,0,32"
                HorizontalAlignment="Left"
                Spacing="32">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Show installed" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleSwitch IsOn="{x:Bind ViewModel.ShowInstalled, Mode=TwoWay}" VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Reveal installed apps (with uninstall option)." />
                </StackPanel>
                <InfoBar Message="Everything here is already installed - nothing left to install."
                         Severity="Informational" IsOpen="True" IsClosable="False"
                         Visibility="{x:Bind ViewModel.NothingToInstall, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <!-- Web Browsers Section -->
                <StackPanel Spacing="20">
                    <TextBlock Text="Web Browsers" Style="{StaticResource KaliteSectionTitle}" />
                    <ItemsRepeater x:Name="BrowserGrid" ItemsSource="{x:Bind ViewModel.VisibleBrowsers, Mode=OneWay}"
                                   ItemTemplate="{StaticResource InstallerCardTemplate}"
                                   HorizontalAlignment="Left">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="184"
                                             MinItemHeight="192"
                                             MinColumnSpacing="16"
                                             MinRowSpacing="16"
                                             Orientation="Horizontal"
                                             ItemsJustification="Start"
                                             ItemsStretch="None" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <ItemsRepeater x:Name="BrowserList" ItemsSource="{x:Bind ViewModel.VisibleBrowsers, Mode=OneWay}"
                                   ItemTemplate="{StaticResource InstallerCompactTemplate}"
                                   HorizontalAlignment="Stretch" Visibility="Collapsed" />
                </StackPanel>

                <!-- Game Launchers Section -->
                <StackPanel Spacing="20">
                    <TextBlock Text="Game Launchers" Style="{StaticResource KaliteSectionTitle}" />
                    <ItemsRepeater x:Name="LauncherGrid" ItemsSource="{x:Bind ViewModel.VisibleGameLaunchers, Mode=OneWay}"
                                   ItemTemplate="{StaticResource InstallerCardTemplate}"
                                   HorizontalAlignment="Left">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="184"
                                             MinItemHeight="192"
                                             MinColumnSpacing="16"
                                             MinRowSpacing="16"
                                             Orientation="Horizontal"
                                             ItemsJustification="Start"
                                             ItemsStretch="None" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <ItemsRepeater x:Name="LauncherList" ItemsSource="{x:Bind ViewModel.VisibleGameLaunchers, Mode=OneWay}"
                                   ItemTemplate="{StaticResource InstallerCompactTemplate}"
                                   HorizontalAlignment="Stretch" Visibility="Collapsed" />
                </StackPanel>

                <!-- Socials & Communication Section -->
                <StackPanel Spacing="20">
                    <TextBlock Text="Socials &amp; Communication" Style="{StaticResource KaliteSectionTitle}" />
                    <ItemsRepeater x:Name="SocialGrid" ItemsSource="{x:Bind ViewModel.VisibleSocialApps, Mode=OneWay}"
                                   ItemTemplate="{StaticResource InstallerCardTemplate}"
                                   HorizontalAlignment="Left">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="184"
                                             MinItemHeight="192"
                                             MinColumnSpacing="16"
                                             MinRowSpacing="16"
                                             Orientation="Horizontal"
                                             ItemsJustification="Start"
                                             ItemsStretch="None" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <ItemsRepeater x:Name="SocialList" ItemsSource="{x:Bind ViewModel.VisibleSocialApps, Mode=OneWay}"
                                   ItemTemplate="{StaticResource InstallerCompactTemplate}"
                                   HorizontalAlignment="Stretch" Visibility="Collapsed" />
                </StackPanel>

                <!-- Utilities Section -->
                <StackPanel Spacing="20">
                    <TextBlock Text="Utilities" Style="{StaticResource KaliteSectionTitle}" />
                    <ItemsRepeater x:Name="UtilityGrid" ItemsSource="{x:Bind ViewModel.VisibleUtilities, Mode=OneWay}"
                                   ItemTemplate="{StaticResource InstallerCardTemplate}"
                                   HorizontalAlignment="Left">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="184"
                                             MinItemHeight="192"
                                             MinColumnSpacing="16"
                                             MinRowSpacing="16"
                                             Orientation="Horizontal"
                                             ItemsJustification="Start"
                                             ItemsStretch="None" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <ItemsRepeater x:Name="UtilityList" ItemsSource="{x:Bind ViewModel.VisibleUtilities, Mode=OneWay}"
                                   ItemTemplate="{StaticResource InstallerCompactTemplate}"
                                   HorizontalAlignment="Stretch" Visibility="Collapsed" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
        </Grid>
        <!-- Entrance transition: the Uninstall/Remover/Startup panels inside
             animate themselves; the hosted page itself needs no extra effect. -->
        <local:UninstallerPage x:Name="UninstallPanel" Grid.Row="2" Visibility="Collapsed" />
        
        <!-- ContentDialog moved inside the visual tree to resolve XamlRoot / Binding cycle crashes.

             Its GEOMETRY IS FIXED ON PURPOSE (min==max width, fixed-height
             scroll host, reserved-height status rows). A ContentDialog is
             positioned once, when ShowAsync runs; anything that resizes its
             content afterwards - the progress button swapping to its long
             "Downloading... (43.7%)" caption, the status line appearing, an
             error line appearing - re-lays the dialog out around that stale
             position, so it visibly crawls out of the middle of the screen and
             reads as broken for the whole install. A dialog whose size cannot
             change cannot drift, so the size simply never changes here: the
             progress text and the error line got their own permanently
             reserved rows and the button got a fixed width with a short
             "Working..." caption. -->
        <ContentDialog x:Name="BrowserDetailsDialog"
                       Style="{StaticResource DefaultContentDialogStyle}"
                       Title="{x:Null}"
                       PrimaryButtonText=""
                       CloseButtonText="{x:Bind local:InstallerPage.GetCloseButtonText(ViewModel.SelectedBrowser.Status), Mode=OneWay}"
                       Grid.RowSpan="3">
            <ContentDialog.Resources>
                <!-- min == max, so the dialog measures to exactly this width at
                     open and stays there no matter what the content wants. -->
                <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
                <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
            </ContentDialog.Resources>
            <!-- Fixed height: the scroll host is the one element allowed to
                 clip overflow, and because its height is constant the dialog
                 height is constant too.
                 Padding right reserves the scrollbar's lane, so when the
                 vertical bar appears (long extension lists) it slides in beside
                 the content instead of drawing on top of the Install button. -->
            <ScrollViewer Height="420"
                          Padding="0,0,16,0"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Auto">
            <StackPanel Spacing="16">
                <!-- Title Panel -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                     <Image Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{x:Bind ViewModel.SelectedBrowser.ImagePath, Mode=OneWay, Converter={StaticResource AssetPathConverter}}"/>
                     <TextBlock Style="{StaticResource KaliteSectionTitle}" VerticalAlignment="Center" Text="{x:Bind ViewModel.SelectedBrowser.Name, Mode=OneWay}"/>
                </StackPanel>

                <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.SelectedBrowser.Description, Mode=OneWay}"/>

                <!-- Extensions List -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedBrowser.Extensions, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ExtensionItem">
                            <CheckBox
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Status Checkmark (only visible if installed). Height is
                     fixed because this row appears and disappears with the
                     install state, and a row that changes height moves the
                     dialog. The space is simply always reserved. -->
                <StackPanel Orientation="Horizontal" Spacing="8" Height="22" Visibility="{x:Bind local:InstallerPage.IsInstalledToVisibility(ViewModel.SelectedBrowser.Status), Mode=OneWay}">
                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                              Visibility="{x:Bind local:InstallerPage.StatusShowsTickVisibility(ViewModel.SelectedBrowser.Status), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedBrowser.StatusText, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>

                <!-- Live install progress, in its own permanently reserved line.
                     It used to be the button's CheckedContent, where a caption
                     like "Downloading... (43.7%)" made the button - and with it
                     the whole dialog - jump in width the moment the install
                     started. -->
                <TextBlock Height="18"
                           FontSize="12"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ViewModel.InstallStatusText, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.IsInstalling, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Action Button at bottom (aligned right, mimicking dialog button).
                     The Uninstall button was removed at the user's request: it was
                     the only route to UninstallBrowserCommand, so removing it
                     means installed apps are read-only here. Uninstalling still
                     happens on the Uninstall tab. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <dev:ProgressButton x:Name="DialogProgressBtn"
                                        Width="170"
                                        Content="{x:Bind local:InstallerPage.StatusToActionLabel(ViewModel.SelectedBrowser.Status), Mode=OneWay}"
                                        CheckedContent="Working..."
                                        IsChecked="{x:Bind ViewModel.IsInstalling, Mode=OneWay}"
                                        IsIndeterminateProgressRing="false"
                                        ProgressRingVisibility="Collapsed"
                                        IsEnabled="{x:Bind local:InstallerPage.Not(ViewModel.IsInstalling), Mode=OneWay}"
                                        Visibility="{x:Bind local:InstallerPage.StatusToNotInstalledVisibility(ViewModel.SelectedBrowser.Status), Mode=OneWay}"
                                        Click="DialogProgressBtn_Click"/>
                </StackPanel>
                <!-- Install failure line: a dedicated element so reporting an error
                     never replaces Content. The old ShowStatus swapped the whole
                     StackPanel for one TextBlock (and overwrote the bound
                     CloseButtonText), gutting the dialog for every later open. -->
                <TextBlock x:Name="DialogStatusText"
                           Height="40"
                           MaxLines="2"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           FontSize="13"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
