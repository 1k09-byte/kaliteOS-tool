<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.InstallerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:kaliteConfig.Pages"
    xmlns:models="using:kaliteConfig.Models"
    xmlns:animations="using:Microsoft.UI.Xaml.Media.Animation"
    xmlns:dev="using:DevWinUI"
    xmlns:converters="using:kaliteConfig.Converters"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:AssetPathToImageSourceConverter x:Key="AssetPathConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>

        <DataTemplate x:Key="InstallerCompactTemplate" x:DataType="models:BrowserInstallItem">
            <Grid Margin="0,0,0,6" ColumnSpacing="8"
                  Visibility="{x:Bind local:InstallerPage.BoolToVis(IsVisible), Mode=OneWay}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="NarrowRow">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="WideRow">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="720" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="InfoColumn.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="ActionColumn.(Grid.Row)" Value="0" />
                                <Setter Target="ActionColumn.(Grid.Column)" Value="1" />
                                <Setter Target="ActionColumn.Margin" Value="8,0,0,0" />
                                <Setter Target="ActionColumn.VerticalAlignment" Value="Center" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="InfoColumn"
                    Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    CornerRadius="8"
                    Padding="12,8"
                    Click="BrowserCard_Click"
                    Tag="{x:Bind}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="32" Height="32" VerticalAlignment="Center"
                           Source="{x:Bind ImagePath, Converter={StaticResource AssetPathConverter}}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind StatusText, Mode=OneWay}" />
                </Grid>
                </Button>

                <StackPanel x:Name="ActionColumn" Grid.Row="1" Grid.Column="1"
                            Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{x:Bind local:InstallerPage.BusyVisibility(Status), Mode=OneWay}">
                    <ProgressRing x:Name="RowBusy"
                        Width="20"
                        Height="20"
                        IsActive="True"
                        Visibility="{x:Bind local:InstallerPage.BusyVisibility(Status), Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid x:Name="RootGrid" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="28,16,28,0" Text="Apps" Style="{StaticResource TitleTextBlockStyle}" />

        <SelectorBar x:Name="MainSelectorBar" Grid.Row="1" Margin="28,4,28,0"
                     HorizontalAlignment="Left"
                     SelectionChanged="MainSelectorBar_SelectionChanged">
            <SelectorBarItem x:Name="TabInstall" Text="Install" IsSelected="True" />
            <SelectorBarItem x:Name="TabUninstall" Text="Uninstall" />
        </SelectorBar>

        <Grid x:Name="InstallPanel" Grid.Row="2">
            <ScrollViewer Padding="28,4,28,20" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="CategoryGrid" MaxWidth="1400" Margin="0,4,0,16" RowSpacing="8" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                                <ToggleSwitch IsOn="{x:Bind ViewModel.ShowInstalled, Mode=TwoWay}"
                                              OnContent="" OffContent="" MinWidth="0"
                                              ToolTipService.ToolTip="Reveal installed apps (with uninstall option)." />
                                <TextBlock Text="Show installed apps" VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <InfoBar Message="Everything here is already installed - nothing left to install."
                                 Severity="Informational" IsOpen="True" IsClosable="False"
                                 Visibility="{x:Bind ViewModel.NothingToInstall, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <Border x:Name="BrowserCard" Grid.Row="1" Grid.Column="0" VerticalAlignment="Top"
                            Padding="0,0,0,8">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Web Browsers" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ItemsRepeater x:Name="BrowserList" ItemsSource="{x:Bind ViewModel.VisibleBrowsers, Mode=OneWay}"
                                           ItemTemplate="{StaticResource InstallerCompactTemplate}"
                                           HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="LauncherCard" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top"
                            Padding="0,0,0,8">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Game Launchers" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ItemsRepeater x:Name="LauncherList" ItemsSource="{x:Bind ViewModel.VisibleGameLaunchers, Mode=OneWay}"
                                           ItemTemplate="{StaticResource InstallerCompactTemplate}"
                                           HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="SocialCard" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top"
                            Padding="0,0,0,8">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Socials &amp; Communication" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ItemsRepeater x:Name="SocialList" ItemsSource="{x:Bind ViewModel.VisibleSocialApps, Mode=OneWay}"
                                           ItemTemplate="{StaticResource InstallerCompactTemplate}"
                                           HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="UtilityCard" Grid.Row="4" Grid.Column="0" VerticalAlignment="Top"
                            Padding="0,0,0,8">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Utilities" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ItemsRepeater x:Name="UtilityList" ItemsSource="{x:Bind ViewModel.VisibleUtilities, Mode=OneWay}"
                                           ItemTemplate="{StaticResource InstallerCompactTemplate}"
                                           HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                </Grid>
            </ScrollViewer>
        </Grid>
        <local:UninstallerPage x:Name="UninstallPanel" Grid.Row="2" Visibility="Collapsed" />

        <ContentDialog x:Name="BrowserDetailsDialog"
                       Style="{StaticResource DefaultContentDialogStyle}"
                       Title="{x:Null}"
                       PrimaryButtonText=""
                       CloseButtonText="{x:Bind local:InstallerPage.GetCloseButtonText(ViewModel.SelectedBrowser.Status), Mode=OneWay}"
                       Grid.RowSpan="3">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
                <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
            </ContentDialog.Resources>
            <ScrollViewer Height="420"
                          Padding="0,0,16,0"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Auto">
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                     <Image Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{x:Bind ViewModel.SelectedBrowser.ImagePath, Mode=OneWay, Converter={StaticResource AssetPathConverter}}"/>
                     <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" Text="{x:Bind ViewModel.SelectedBrowser.Name, Mode=OneWay}"/>
                </StackPanel>

                <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.SelectedBrowser.Description, Mode=OneWay}"/>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedBrowser.Extensions, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ExtensionItem">
                            <CheckBox
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <StackPanel Orientation="Horizontal" Spacing="8" Height="22" Visibility="{x:Bind local:InstallerPage.IsInstalledToVisibility(ViewModel.SelectedBrowser.Status), Mode=OneWay}">
                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                              Visibility="{x:Bind local:InstallerPage.StatusShowsTickVisibility(ViewModel.SelectedBrowser.Status), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedBrowser.StatusText, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>

                <TextBlock Height="18"
                           FontSize="12"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ViewModel.InstallStatusText, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.IsInstalling, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <dev:ProgressButton x:Name="DialogProgressBtn"
                                        Width="170"
                                        Content="{x:Bind local:InstallerPage.StatusToActionLabel(ViewModel.SelectedBrowser.Status), Mode=OneWay}"
                                        CheckedContent="Working..."
                                        IsChecked="{x:Bind ViewModel.IsInstalling, Mode=OneWay}"
                                        IsIndeterminateProgressRing="false"
                                        ProgressRingVisibility="Collapsed"
                                        IsEnabled="{x:Bind local:InstallerPage.Not(ViewModel.IsInstalling), Mode=OneWay}"
                                        Visibility="{x:Bind local:InstallerPage.StatusToNotInstalledVisibility(ViewModel.SelectedBrowser.Status), Mode=OneWay}"
                                        Click="DialogProgressBtn_Click"/>
                </StackPanel>
                <TextBlock x:Name="DialogStatusText"
                           Height="40"
                           MaxLines="2"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           FontSize="13"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
