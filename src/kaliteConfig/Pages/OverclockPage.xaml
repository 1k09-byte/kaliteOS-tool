<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.OverclockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oc="using:kaliteConfig.GpuOverclock.Views"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <ScrollViewer Padding="36,0,36,24" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Stretch" Spacing="8">
                
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" Margin="0,0,0,12">
                    <Border Width="48" Height="48" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="11">
                        <FontIcon Glyph="&#xE950;" FontSize="22" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GPU Overclock" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="NVIDIA and AMD performance tuning" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Click="RedetectBtn_Click" VerticalAlignment="Center" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Re-detect" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <oc:OverclockSection x:Name="OverclockPanel" />

                <!-- AMD adapters and what their driver says they support. Collapses
                     itself when there is no AMD driver on the machine. -->
                <oc:AmdGpuSection x:Name="AmdPanel" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
