<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.OverclockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oc="using:kaliteConfig.GpuOverclock.Views"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <ScrollViewer Padding="36,8,36,24" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Stretch" Spacing="12">

                <!-- The hub above already names the page, so this tab only carries a
                     one-line summary and the re-detect action. -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Style="{StaticResource GalleryPageCaption}"
                               Text="Live clocks, voltage and fan control for the detected adapter. Nothing is written until you apply it." />
                    <Button Grid.Column="1" Click="RedetectBtn_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Re-detect" />
                        </StackPanel>
                    </Button>
                </Grid>

                <oc:OverclockSection x:Name="OverclockPanel" />

                <oc:AmdGpuSection x:Name="AmdPanel" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
