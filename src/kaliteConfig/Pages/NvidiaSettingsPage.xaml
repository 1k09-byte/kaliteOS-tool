<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.NvidiaSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:kaliteConfig.ViewModels"
    xmlns:models="using:kaliteConfig.Models"
    xmlns:converters="using:kaliteConfig.Converters"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        <Style x:Key="BannerCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="16,0" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="RowSlider" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsThumbToolTipEnabled" Value="False" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,2" />
        </Style>
        <Style x:Key="GroupNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <DataTemplate x:Key="ResolutionTemplate" x:DataType="models:DisplayMode"><TextBlock Text="{x:Bind ResolutionDisplay}" /></DataTemplate>
        <DataTemplate x:Key="RefreshRateTemplate" x:DataType="models:DisplayMode"><TextBlock Text="{x:Bind RefreshRateDisplay}" /></DataTemplate>
        <DataTemplate x:Key="RotationTemplate" x:DataType="x:Object"><TextBlock Text="{Binding Name}" /></DataTemplate>
    </Page.Resources>

    <Page.DataContext><vm:NvidiaSettingsViewModel x:Name="ViewModel" /></Page.DataContext>

    <Grid>
      <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Left" IsOpen="False">
            <AppBarButton Icon="Save" Label="Save profile" Command="{x:Bind Vm.SaveProfileCommand}" />
            <AppBarButton Icon="Undo" Label="Undo" Command="{x:Bind Vm.UndoCommand}" />
            <AppBarButton Icon="Refresh" Label="Refresh" Command="{x:Bind Vm.RefreshCommand}" />
            <AppBarButton Icon="Repair" Label="Revert" Command="{x:Bind Vm.RevertCommand}" />
            <AppBarSeparator />
            <AppBarButton Icon="Accept" Label="Apply" Command="{x:Bind Vm.ApplyCommand}" />
          </CommandBar>
          <StackPanel Grid.Row="1" Padding="28,0,28,12" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <Border Width="44" Height="44" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="10"><FontIcon Glyph="&#xE9A1;" FontSize="20" /></Border>
              <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="NVIDIA Control Panel · Display" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Display, color, scaling and Windows HDR controls." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </StackPanel>
            <ComboBox x:Name="DisplayPicker" Header="Display" MinWidth="360" HorizontalAlignment="Left" ItemsSource="{x:Bind Vm.Displays, Mode=OneWay}" DisplayMemberPath="DisplayLabel" SelectedItem="{x:Bind Vm.SelectedDisplay, Mode=TwoWay}" />
            <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="{x:Bind Vm.StatusSeverity, Mode=OneWay}" Title="{x:Bind Vm.StatusText, Mode=OneWay}" Message="{x:Bind Vm.StatusDetails, Mode=OneWay}" />
            <Border Style="{StaticResource BannerCard}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="2" Visibility="{x:Bind Vm.IsAwaitingConfirmation, Mode=OneWay}">
              <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="24" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="Applied — review the picture" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Vm.CountdownText, Mode=OneWay}" Style="{StaticResource GroupNote}" Margin="0"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Revert now" Command="{x:Bind Vm.RevertNowCommand}"/><Button Content="Keep changes" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.KeepChangesCommand}"/></StackPanel>
              </Grid>
            </Border>
          </StackPanel>
          <ScrollViewer Grid.Row="2" Padding="28,0,28,24" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18" Width="860" HorizontalAlignment="Left">
              <Grid Visibility="{x:Bind Vm.IsBusy, Mode=OneWay}"><Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.8"/><ProgressRing IsActive="True" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
              <Border Style="{StaticResource GroupCard}" Padding="20" Visibility="{x:Bind Vm.HasSelection, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"><StackPanel Spacing="6"><TextBlock Text="No display selected" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock Style="{StaticResource GroupNote}" Margin="0" Text="These controls talk to the graphics driver directly. Attach a display and press Refresh."/></StackPanel></Border>
              <StackPanel Spacing="18" Visibility="{x:Bind Vm.HasSelection, Mode=OneWay}">
                <StackPanel><TextBlock Text="Screen" Style="{StaticResource GroupTitle}"/><TextBlock Style="{StaticResource GroupNote}" Text="Resolution, refresh rate, orientation and desktop layout. These belong to Windows rather than to the graphics driver."/><Border Style="{StaticResource GroupCard}"><StackPanel>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Display resolution" Style="{StaticResource RowLabel}"/><ComboBox Grid.Column="1" MinWidth="220" HorizontalAlignment="Left" ItemsSource="{x:Bind DisplayVm.AvailableResolutions, Mode=OneWay}" SelectedItem="{x:Bind DisplayVm.SelectedResolution, Mode=TwoWay}" ItemTemplate="{StaticResource ResolutionTemplate}"/></Grid>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Refresh rate" Style="{StaticResource RowLabel}"/><ComboBox Grid.Column="1" MinWidth="220" HorizontalAlignment="Left" ItemsSource="{x:Bind DisplayVm.AvailableRefreshRates, Mode=OneWay}" SelectedItem="{x:Bind DisplayVm.SelectedRefreshRate, Mode=TwoWay}" ItemTemplate="{StaticResource RefreshRateTemplate}"/></Grid>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Display scale" Style="{StaticResource RowLabel}"/><ComboBox x:Name="ScaleComboBox" Grid.Column="1" MinWidth="220" HorizontalAlignment="Left" ItemsSource="{x:Bind DisplayVm.AvailableScales, Mode=OneWay}" IsEnabled="{x:Bind DisplayVm.ScaleIsSupported, Mode=OneWay}" SelectionChanged="ScaleComboBox_SelectionChanged"/></Grid>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Orientation" Style="{StaticResource RowLabel}"/><ComboBox Grid.Column="1" MinWidth="220" HorizontalAlignment="Left" ItemsSource="{x:Bind DisplayVm.AvailableRotations, Mode=OneWay}" SelectedItem="{x:Bind DisplayVm.SelectedRotation, Mode=TwoWay}" ItemTemplate="{StaticResource RotationTemplate}"/></Grid>
                </StackPanel></Border><TextBlock Style="{StaticResource GroupNote}" Text="Scale applies immediately; running programs keep their old size until restarted."/></StackPanel>
                <StackPanel><TextBlock Text="Arrangement" Style="{StaticResource GroupTitle}"/><TextBlock Style="{StaticResource GroupNote}" Text="Drag displays to match your physical setup, then apply the layout."/><Border Style="{StaticResource GroupCard}" Padding="16"><StackPanel Spacing="12"><Button Content="Apply layout" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="ApplyArrangement_Click"/><Border x:Name="ArrangementBounds" Background="{ThemeResource LayerFillColorDefaultBrush}" Height="280" CornerRadius="8" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"><Canvas x:Name="ArrangementCanvas"/></Border></StackPanel></Border></StackPanel>
                <StackPanel><TextBlock Text="Color" Style="{StaticResource GroupTitle}"/><TextBlock Style="{StaticResource GroupNote}" Text="Brightness and contrast use the driver; channel gains are sent to the monitor; hue is applied by the driver."/><Border Visibility="{x:Bind Vm.MonitorControlsUnreachable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource GroupCard}" Padding="16,10" Margin="0,0,0,10"><StackPanel Spacing="3"><TextBlock Text="Channel gains unavailable" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock Style="{StaticResource GroupNote}" Margin="0" Text="{x:Bind Vm.ColorNote, Mode=OneWay}"/></StackPanel></Border><Border Style="{StaticResource GroupCard}"><StackPanel>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Brightness" Style="{StaticResource RowLabel}"/><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider Grid.Column="0" Style="{StaticResource RowSlider}" Minimum="0" Maximum="1" StepFrequency="0.01" IsEnabled="{x:Bind Vm.SupportsBrightness, Mode=OneWay}" Value="{x:Bind Vm.Brightness, Mode=TwoWay}"/><TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind Vm.BrightnessText, Mode=OneWay}"/></Grid></Grid>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Contrast" Style="{StaticResource RowLabel}"/><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider Grid.Column="0" Style="{StaticResource RowSlider}" Minimum="0" Maximum="1" StepFrequency="0.01" IsEnabled="{x:Bind Vm.SupportsContrast, Mode=OneWay}" Value="{x:Bind Vm.Contrast, Mode=TwoWay}"/><TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind Vm.ContrastText, Mode=OneWay}"/></Grid></Grid>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Red gain" Style="{StaticResource RowLabel}"/><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider Grid.Column="0" Style="{StaticResource RowSlider}" Minimum="0" Maximum="1" StepFrequency="0.01" IsEnabled="{x:Bind Vm.SupportsColorGain, Mode=OneWay}" Value="{x:Bind Vm.RedGain, Mode=TwoWay}"/><TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind Vm.RedGainText, Mode=OneWay}"/></Grid></Grid>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Green gain" Style="{StaticResource RowLabel}"/><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider Grid.Column="0" Style="{StaticResource RowSlider}" Minimum="0" Maximum="1" StepFrequency="0.01" IsEnabled="{x:Bind Vm.SupportsColorGain, Mode=OneWay}" Value="{x:Bind Vm.GreenGain, Mode=TwoWay}"/><TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind Vm.GreenGainText, Mode=OneWay}"/></Grid></Grid>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Blue gain" Style="{StaticResource RowLabel}"/><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider Grid.Column="0" Style="{StaticResource RowSlider}" Minimum="0" Maximum="1" StepFrequency="0.01" IsEnabled="{x:Bind Vm.SupportsColorGain, Mode=OneWay}" Value="{x:Bind Vm.BlueGain, Mode=TwoWay}"/><TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind Vm.BlueGainText, Mode=OneWay}"/></Grid></Grid>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Hue" Style="{StaticResource RowLabel}"/><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider Grid.Column="0" Style="{StaticResource RowSlider}" Minimum="-180" Maximum="180" StepFrequency="1" IsEnabled="{x:Bind Vm.SupportsHue, Mode=OneWay}" Value="{x:Bind Vm.Hue, Mode=TwoWay}"/><TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind Vm.HueText, Mode=OneWay}"/></Grid></Grid>
                </StackPanel></Border></StackPanel>
                <StackPanel><TextBlock Text="Digital Vibrance" Style="{StaticResource GroupTitle}"/><TextBlock Style="{StaticResource GroupNote}" Text="Driver-side saturation adjustment."/><Border Style="{StaticResource GroupCard}"><Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Digital Vibrance" Style="{StaticResource RowLabel}"/><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider Grid.Column="0" Style="{StaticResource RowSlider}" Minimum="0" Maximum="100" StepFrequency="1" IsEnabled="{x:Bind Vm.SupportsDigitalVibrance, Mode=OneWay}" Value="{x:Bind Vm.DigitalVibrance, Mode=TwoWay}"/><TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind Vm.DigitalVibranceText, Mode=OneWay}"/></Grid></Grid></Border></StackPanel>

                <StackPanel><TextBlock Text="Scaling" Style="{StaticResource GroupTitle}"/><TextBlock Style="{StaticResource GroupNote}" Text="How resolutions that do not match the panel are stretched, and which device does the work."/><Border Style="{StaticResource GroupCard}"><StackPanel>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Scaling mode" Style="{StaticResource RowLabel}"/><ComboBox Grid.Column="1" MinWidth="220" HorizontalAlignment="Left" ItemsSource="{x:Bind Vm.ScalingModeChoices, Mode=OneWay}" SelectedIndex="{x:Bind Vm.ScalingModeIndex, Mode=TwoWay}" IsEnabled="{x:Bind Vm.SupportsScaling, Mode=OneWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
                  <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Perform scaling on" Style="{StaticResource RowLabel}"/><ComboBox Grid.Column="1" MinWidth="220" HorizontalAlignment="Left" ItemsSource="{x:Bind Vm.ScalingLocationLabels, Mode=OneWay}" SelectedIndex="{x:Bind Vm.ScalingLocationIndex, Mode=TwoWay}" IsEnabled="{x:Bind Vm.SupportsScaling, Mode=OneWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
                </StackPanel></Border></StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
    </Grid>
</Page>
