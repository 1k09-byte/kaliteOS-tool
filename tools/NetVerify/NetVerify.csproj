<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Network pure-logic verification harness (SnipVerify pattern).
    Compiles the REAL NetAdapterModels plus NetParsing and checks hand-computed
    expectations. The main app never sees it. Run from tools/NetVerify with dotnet run.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWinUI>false</UseWinUI>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\kaliteConfig.Core\Pure\NetAdapterModels.cs" LinkBase="Core" />
    <Compile Include="..\..\src\kaliteConfig.Core\Pure\NetParsing.cs" LinkBase="Core" />
    <Compile Include="..\..\src\kaliteConfig\Services\Network\NetProcess.cs" LinkBase="Services" />
    <Compile Include="..\..\src\kaliteConfig\Services\Network\NetAdapterService.cs" LinkBase="Services" />
    <Compile Include="..\..\src\kaliteConfig\Services\Network\NetEditService.cs" LinkBase="Services" />
    <Compile Include="..\..\src\kaliteConfig\Services\Network\NetSpeedTest.cs" LinkBase="Services" />
  </ItemGroup>

</Project>
