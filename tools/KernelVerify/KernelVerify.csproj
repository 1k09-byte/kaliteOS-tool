<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kernel tweak verification harness. Console app that compiles the REAL
    Services/WindowsSettingsService.cs (plus its only native dependency,
    Native/PowrProf.cs — no fakes) and checks the pure logic: access-denied
    message truthfulness (admin vs elevated-blocked), tweak lookup, and
    that the elevation probe never throws. Lives under tools/ so the main
    app build never sees it (kaliteConfig.csproj removes tools/**).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWinUI>false</UseWinUI>
  </PropertyGroup>

  <ItemGroup>
    <!-- The REAL service code, same files the app ships. -->
    <Compile Include="..\..\Services\WindowsSettingsService.cs" Link="Services\WindowsSettingsService.cs" />
    <Compile Include="..\..\Native\PowrProf.cs" Link="Native\PowrProf.cs" />
  </ItemGroup>

</Project>
