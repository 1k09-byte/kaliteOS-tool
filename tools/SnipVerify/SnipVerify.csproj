<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Snip gallery pure-logic verification harness (OcVerify/BenchVerify pattern).
    Compiles the REAL SnipGalleryModels plus SnipGalleryQuery and checks
    hand-computed filter / sort / naming expectations. The main app never sees it.
    Run from tools/SnipVerify with dotnet run.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWinUI>false</UseWinUI>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Models\SnipGalleryModels.cs" LinkBase="Models" />
    <Compile Include="..\..\Models\SnipPreviewViewport.cs" LinkBase="Models" />
    <Compile Include="..\..\Services\SnipGalleryQuery.cs" LinkBase="Services" />
    <Compile Include="..\..\Services\SnipGalleryService.cs" LinkBase="Services" />
    <Compile Include="..\..\Services\SnipThumbnailService.cs" LinkBase="Services" />
    <Compile Include="..\..\Services\SnipPreviewService.cs" LinkBase="Services" />
    <Compile Include="..\..\Services\SnipRefreshCadence.cs" LinkBase="Services" />
    <Compile Include="..\..\Services\SnipFolderWatcher.cs" LinkBase="Services" />
    <Compile Include="..\..\Services\SnipRegionLogic.cs" LinkBase="Services" />
    <Compile Include="..\..\Services\SnipWindowSnap.cs" LinkBase="Services" />
    <Compile Include="..\..\Services\SnipStickerService.cs" LinkBase="Services" />
    <Compile Include="..\..\Services\SnipHotkeyService.cs" LinkBase="Services" />
  </ItemGroup>

</Project>