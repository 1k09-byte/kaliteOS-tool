<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 1 stats verification harness (OcVerify pattern). Console app that
    compiles the REAL BenchmarkModels plus BenchmarkStatsService and checks
    hand computed expectations. Main app build never sees it.
    Run from tools/BenchVerify with dotnet run.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWinUI>false</UseWinUI>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Models\BenchmarkModels.cs" LinkBase="Models" />
    <Compile Include="..\..\Services\BenchmarkStatsService.cs" LinkBase="Services" />
    <Compile Include="..\..\Services\BenchmarkPresentMonCsv.cs" LinkBase="Services" />
    <Compile Include="..\..\Services\BenchmarkSensorStats.cs" LinkBase="Services" />
    <Compile Include="..\..\Services\BenchmarkImportService.cs" LinkBase="Services" />
  </ItemGroup>

</Project>
