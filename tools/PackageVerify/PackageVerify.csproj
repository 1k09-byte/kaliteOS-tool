<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Package-manager verification harness. Console app that compiles the REAL
    PackageManager models + WinGet parser + bundle/CSV logic (no fakes) and
    checks the pure parts offline: winget table parsing across captured live
    shapes, bundle JSON round-trip + missing-diff, CSV quoting, version-line
    display rules. An opt-in live mode exercises the real winget.exe
    read-only paths (detect/search/list-updates — never installs).
    Lives under tools/ so the main app build never sees it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWinUI>false</UseWinUI>
  </PropertyGroup>

  <ItemGroup>
    <!-- The REAL package-manager code, same files the app ships. -->
    <Compile Include="..\..\PackageManager\Models\*.cs" LinkBase="PackageManager\Models" />
    <Compile Include="..\..\PackageManager\Services\CliProcess.cs" Link="PackageManager\Services\CliProcess.cs" />
    <Compile Include="..\..\PackageManager\Services\IPackageSource.cs" Link="PackageManager\Services\IPackageSource.cs" />
    <Compile Include="..\..\PackageManager\Services\WinGetPackageSource.cs" Link="PackageManager\Services\WinGetPackageSource.cs" />
    <Compile Include="..\..\PackageManager\Services\PackageBundleService.cs" Link="PackageManager\Services\PackageBundleService.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
