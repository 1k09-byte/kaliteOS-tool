<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Install page data verification (BenchVerify pattern). Compiles the REAL
    InstallerService plus models and ViewModel, then checks the Visible*
    collections the Install tab binds to. Main app build never sees it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWinUI>false</UseWinUI>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Models\BrowserInstallItem.cs" LinkBase="Models" />
    <Compile Include="..\..\Models\ExtensionItem.cs" LinkBase="Models" />
    <Compile Include="..\..\Services\InstallerService.cs" LinkBase="Services" />
    <Compile Include="..\..\Services\IInstallerService.cs" LinkBase="Services" />
    <Compile Include="..\..\Services\ChromiumExtensionInstaller.cs" LinkBase="Services" />
    <Compile Include="..\..\Services\FirefoxExtensionInstaller.cs" LinkBase="Services" />
    <Compile Include="..\..\ViewModels\InstallerViewModel.cs" LinkBase="ViewModels" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
