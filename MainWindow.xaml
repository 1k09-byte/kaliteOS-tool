                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" UseLayoutRounding="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </NavigationView>

            <!-- Shared selection pill at the rail's left edge. Margin-driven moves
                 are glide-animated; positioned from code-behind (UpdateNavPill). -->
            <Border
                x:Name="NavPill"
                Width="4"
                Height="22"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="1.5"
                Opacity="0">
                <Border.Transitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </Border.Transitions>
            </Border>
        </Grid>
    </Grid>
</Window>
