<Window
    x:Class="stellarisKIT.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    Title="kit"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="titleBar" />

        <!-- Store-style shell: fixed 76px rail + shared selection pill overlay.
             The pill glides between items (RepositionThemeTransition); the rail
             slides in on launch (EntranceThemeTransition). -->
        <Grid x:Name="NavShell" Grid.Row="1">
            <Grid.Transitions>
                <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="-40" />
                </TransitionCollection>
            </Grid.Transitions>

        <NavigationView
            x:Name="NavView"
            UseLayoutRounding="True"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="68"
            CompactPaneLength="68"
            IsPaneOpen="True"
            SelectionChanged="NavView_SelectionChanged">
            
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />

                <Style TargetType="NavigationViewItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="NavigationViewItem">
                                <Grid x:Name="LayoutRoot" Background="Transparent" Margin="4,4,4,4" Width="60" Height="58">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Target="IconPresenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <Setter Target="ContentTextBlock.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                    <!-- Gentle hover pulse. No From (starts at current value,
                                                         releases to base on exit) so rapid hover never jumps
                                                         or sticks. -->
                                                    <DoubleAnimation Storyboard.TargetName="IconPresenter" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.06" Duration="0:0:0.15" AutoReverse="True" FillBehavior="Stop" />
                                                    <DoubleAnimation Storyboard.TargetName="IconPresenter" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.06" Duration="0:0:0.15" AutoReverse="True" FillBehavior="Stop" />
                                                </Storyboard>
                                                <VisualState.Setters>
                                                    <Setter Target="BackgroundPill.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                    <Setter Target="IconPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                    <Setter Target="ContentTextBlock.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="BackgroundPill.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                    <Setter Target="IconPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                    <Setter Target="ContentTextBlock.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <!-- Selected icon animation runs from code-behind
                                                 (PlaySelectPop): a VSM storyboard here is cancelled
                                                 the moment the pointer hovers (state leaves
                                                 Selected for PointerOverSelected). -->
                                            <VisualState x:Name="Selected">
                                                <Storyboard>
                                                    <!-- Idle "breathing" on the selected icon. Opacity-only
                                                         (alpha blending never re-rasterizes, stays sharp).
                                                         FillBehavior Stop releases to full opacity the
                                                         moment the item is deselected. -->
                                                    <DoubleAnimation Storyboard.TargetName="IconPresenter" Storyboard.TargetProperty="Opacity" From="1" To="0.65" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" FillBehavior="Stop" />
                                                </Storyboard>
                                                <VisualState.Setters>
                                                    <Setter Target="BackgroundPill.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                    <Setter Target="IconPresenter.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                    <Setter Target="ContentTextBlock.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PointerOverSelected">
                                                <VisualState.Setters>
                                                    <Setter Target="BackgroundPill.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                    <Setter Target="IconPresenter.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                    <Setter Target="ContentTextBlock.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PressedSelected">
                                                <VisualState.Setters>
                                                    <Setter Target="BackgroundPill.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                    <Setter Target="IconPresenter.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                    <Setter Target="ContentTextBlock.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                    <!-- Pill that highlights on hover/select -->
                                    <Border x:Name="BackgroundPill" Background="Transparent" CornerRadius="4" />

                                    <!-- Selection marker: one shared NavPill overlay (bottom of file)
                                         glides between items; no per-item indicator here. -->

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                        <ContentPresenter x:Name="IconPresenter" Content="{TemplateBinding Icon}" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" RenderTransformOrigin="0.5,0.5">
                                        <ContentPresenter.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform />
                                                <RotateTransform />
                                                <TranslateTransform />
                                            </TransformGroup>
                                        </ContentPresenter.RenderTransform>
                                        </ContentPresenter>
                                        <TextBlock x:Name="ContentTextBlock" Text="{TemplateBinding Content}" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center" TextWrapping="NoWrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </NavigationView.Resources>
            
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Apps" Tag="AppsPage" Margin="0" Padding="0">
                    <ToolTipService.ToolTip>
                        <ToolTip Visibility="Collapsed" />
                    </ToolTipService.ToolTip>
                    <NavigationViewItem.Icon>
