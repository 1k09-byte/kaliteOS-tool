                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="WS" Tag="WindowsSettingsPage" Margin="0" Padding="0">
                    <ToolTipService.ToolTip>
                        <ToolTip Visibility="Collapsed" />
                    </ToolTipService.ToolTip>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings" Margin="0" Padding="0">
                    <ToolTipService.ToolTip>
                        <ToolTip Visibility="Collapsed" />
                    </ToolTipService.ToolTip>
