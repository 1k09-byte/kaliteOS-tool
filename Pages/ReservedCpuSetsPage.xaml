<Page
    x:Class="kaliteConfig.Pages.ReservedCpuSetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:kaliteConfig.Pages"
    xmlns:models="using:kaliteConfig.ViewModels">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" 
                     Severity="Error" 
                     Title="Error"
                     Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" 
                     IsClosable="True" />

            <InfoBar IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}" 
                     Severity="Success" 
                     Title="Success"
                     Message="{x:Bind ViewModel.SuccessText, Mode=OneWay}" 
                     IsClosable="True" />
                     
            <InfoBar IsOpen="{x:Bind ViewModel.RequiresPerBootReapply, Mode=OneWay}"
                     Severity="Informational"
                     Title="Reboot note"
                     Message="Your version of Windows requires reserving CPUs to be applied at every startup. Reserving them manually works until you reboot."
                     IsClosable="False" />
                     
            <InfoBar IsOpen="{x:Bind ViewModel.IsNotElevated, Mode=OneWay}"
                     Severity="Warning"
                     Title="Elevation Required"
                     Message="You must run kaliteConfig as Administrator to save reserved CPU sets."
                     IsClosable="False" />
        </StackPanel>

        <!-- The Check All / Uncheck All / Invert bulk commands were removed:
             cores are ticked one by one here. "Apply at Startup" stays (older
             Windows builds drop the kernel reservation on every reboot). -->
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" Margin="-12,0,-12,12" Background="Transparent">
            <CommandBar.SecondaryCommands>
                <AppBarToggleButton Label="Apply at Startup" 
                                    IsChecked="{x:Bind ViewModel.ApplyAtStartup, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.RequiresPerBootReapply, Mode=OneWay}" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <TextBlock Grid.Row="2" Text="Select the system cores you want to isolate from the OS Task Scheduler." Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />

        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Cores}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:CpuCoreItem">
                    <Grid Padding="12,8">
                        <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsReserved, Mode=TwoWay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
