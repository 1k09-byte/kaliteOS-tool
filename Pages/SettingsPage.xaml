<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="stellarisKIT.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:stellarisKIT"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Page.Resources>
        <!-- Consistent settings layout, cloned from WinUI-Gallery Pages/SettingsPage.xaml
             (see docs/GALLERY-REFERENCE.md section 3). -->
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="PageHeader"
            MaxWidth="1064"
            HorizontalAlignment="Left"
            Margin="36,24,36,0"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Settings" />
        <ScrollViewer
            Grid.Row="1"
            Padding="36,0,36,0"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                MaxWidth="1064"
                HorizontalAlignment="Left"
                Spacing="{StaticResource SettingsCardSpacing}">

                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="General" />

                <toolkit:SettingsCard
                    Description="Keep the app running so thread rules apply automatically"
                    Header="Start with Windows">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="startupToggle"
                        OffContent="Off"
                        OnContent="On"
                        Toggled="StartupToggle_Toggled" />
                </toolkit:SettingsCard>

                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Appearance" />

                <toolkit:SettingsCard
                    Description="Select which app theme to display"
                    Header="App theme">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="themeMode"
                        dev:ThemeServiceAttach.ThemeService="{x:Bind local:App.Current.ThemeService}"
                        Width="250"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="themeModeComboBox">
                        <ComboBoxItem Content="Use system setting" Tag="Default" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard
                    Description="Change the appearance of the backdrop material behind your app"
                    Header="Material">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE2B1;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="backdropMode"
                        dev:ThemeServiceAttach.ThemeService="{x:Bind local:App.Current.ThemeService}"
                        Width="250"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="backdropModeComboBox">
                        <ComboBoxItem Content="None" Tag="None" />
                        <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                        <ComboBoxItem Content="Acrylic Thin" Tag="AcrylicThin" />
                        <ComboBoxItem Content="Mica" Tag="Mica" />
                        <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                    </ComboBox>
                </toolkit:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>