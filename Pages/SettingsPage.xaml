<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:kaliteConfig"
    xmlns:pages="using:kaliteConfig.Pages"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Page.Resources>
        <!-- Consistent settings layout, cloned from WinUI-Gallery Pages/SettingsPage.xaml
             (see docs/GALLERY-REFERENCE.md section 3). -->
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="PageHeader"
            HorizontalAlignment="Stretch"
            Margin="36,24,36,0"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Settings" />
        <ScrollViewer
            Grid.Row="1"
            Padding="36,0,36,0"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                HorizontalAlignment="Stretch"
                Spacing="{StaticResource SettingsCardSpacing}">

                <!-- Consumer update banner (hidden unless a newer GitHub release exists).
                     Wired in code-behind only for the CONSUMER flavor - the full
                     flavor leaves Vm null and never checks, so this stays closed. -->
                <InfoBar Title="{x:Bind Vm.BannerTitle, Mode=OneWay}"
                         Message="{x:Bind Vm.Notes, Mode=OneWay}"
                         IsOpen="{x:Bind Vm.IsAvailable, Mode=OneWay}"
                         Severity="Informational"
                         IsClosable="True"
                         Margin="0,0,0,12">
                    <InfoBar.Content>
                        <StackPanel Spacing="8">
                            <ProgressBar Value="{x:Bind pages:SettingsPageBindings.UpdateProgressValue(Vm.DownloadPercent), Mode=OneWay}"
                                         IsIndeterminate="{x:Bind Vm.IsBusy, Mode=OneWay}"
                                         Visibility="{x:Bind Vm.ProgressVisibility, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{x:Bind Vm.PrimaryUpdateActionText, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        IsEnabled="{x:Bind Vm.CanUpdateNow, Mode=OneWay}"
                                        Click="UpdateNow_Click" />
                                <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>

                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="General" />

                <toolkit:SettingsCard
                    Description="Starts minimized to the system tray so thread rules keep applying"
                    Header="Start with Windows">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="startupToggle"
                        OffContent="Off"
                        OnContent="On"
                        Toggled="StartupToggle_Toggled" />
                </toolkit:SettingsCard>

                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Appearance" />

                <toolkit:SettingsCard
                    Description="Select which app theme to display"
                    Header="App theme">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="themeMode"
                        dev:ThemeServiceAttach.ThemeService="{x:Bind local:App.Current.ThemeService}"
                        Width="250"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="themeModeComboBox">
                        <ComboBoxItem Content="Use system setting" Tag="Default" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </toolkit:SettingsCard>


                <toolkit:SettingsCard
                    Description="Change the appearance of the backdrop material behind your app"
                    Header="Material">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE2B1;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="backdropMode"
                        dev:ThemeServiceAttach.ThemeService="{x:Bind local:App.Current.ThemeService}"
                        Width="250"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="backdropModeComboBox">
                        <ComboBoxItem Content="None" Tag="None" />
                        <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                        <ComboBoxItem Content="Acrylic Thin" Tag="AcrylicThin" />
                        <ComboBoxItem Content="Mica" Tag="Mica" />
                        <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                    </ComboBox>
                </toolkit:SettingsCard>

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="About" />

                <toolkit:SettingsCard x:Name="AboutCard" Header="About kaliteConfig" Description="Version - View development team and application links" IsClickEnabled="True" Click="AboutCard_Click">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
            </StackPanel>
        </ScrollViewer>

        <!-- About Dialog Modal -->
        <ContentDialog x:Name="AboutDialog" Title="About kaliteConfig" CloseButtonText="Close">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                <StackPanel Spacing="24" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Development Team" />
                    
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Spacing="8" HorizontalAlignment="Center">
                            <PersonPicture DisplayName="kupo0860" ProfilePicture="ms-appx:///Assets/Devs/dev1.png" Width="64" Height="64" />
                            <TextBlock Text="kupo0860" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Center">
                            <PersonPicture DisplayName="cytrafps" ProfilePicture="ms-appx:///Assets/Devs/dev2.png" Width="64" Height="64" />
                            <TextBlock Text="cytrafps" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="8" HorizontalAlignment="Center">
                            <PersonPicture DisplayName="kal0uf" ProfilePicture="ms-appx:///Assets/Devs/dev3.png" Width="64" Height="64" />
                            <TextBlock Text="kal0uf" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Spacing="8" HorizontalAlignment="Center">
                            <PersonPicture DisplayName="venon.codm" ProfilePicture="ms-appx:///Assets/Devs/dev4.jpg" Width="64" Height="64" />
                            <TextBlock Text="venon.codm" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Application Links" Margin="0,16,0,0" />
                    
                    <StackPanel Spacing="4">
                        <toolkit:SettingsCard Header="Discord" Description="Join the discussion and get support.">
                            <HyperlinkButton Content="Join" NavigateUri="https://discord.gg/faQgV6yayY" />
                        </toolkit:SettingsCard>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

    </Grid>
</Page>