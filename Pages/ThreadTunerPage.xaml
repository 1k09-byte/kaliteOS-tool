<Page
    x:Class="kaliteConfig.Pages.ThreadTunerPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:kaliteConfig.Pages"
    xmlns:models="using:kaliteConfig.Models"
    xmlns:animations="using:Microsoft.UI.Xaml.Media.Animation"
    NavigationCacheMode="Enabled">
    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <EntranceNavigationTransitionInfo />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
        </TransitionCollection>
    </Page.Transitions>

    <Page.Resources>
        <Style x:Key="ProcessCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="ProcessSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- Do not let WinUI paint its full-width square hover/selected layer.
             The row's own rounded Border is the only visual surface. -->
        <Style x:Key="ProcessCardItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="FocusVisualPrimaryThickness" Value="0" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="SelectionBorder" BorderThickness="2" CornerRadius="12" BorderBrush="Transparent">
                            <ContentPresenter Background="Transparent"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Rule Row Template -->
        <DataTemplate x:Key="RuleRowTemplate" x:DataType="models:TunerProfile">
            <Border Margin="12,4" Padding="14,10" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    ToolTipService.ToolTip="{x:Bind Pattern}" DoubleTapped="RuleRow_DoubleTapped">
                <Border.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Edit" Click="RuleEdit_Click" />
                        <MenuFlyoutItem Text="Enable / disable" Click="RuleToggle_Click" />
                        <MenuFlyoutItem Text="Apply now" Click="RuleApplyNow_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Delete" Click="RuleDelete_Click" />
                    </MenuFlyout>
                </Border.ContextFlyout>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Pattern, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ProcessActionsSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ThreadRulesSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Visibility="{x:Bind EnabledPillVis, Mode=OneWay}">
                            <TextBlock Text="Enabled" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </Border>
                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Visibility="{x:Bind DisabledPillVis, Mode=OneWay}">
                            <TextBlock Text="Disabled" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock FontSize="12" Text="{x:Bind LastResult, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Visibility="{x:Bind AppliedResultVis, Mode=OneWay}" />
                        <TextBlock FontSize="12" Text="{x:Bind LastResult, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Visibility="{x:Bind WaitingResultVis, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Process Row Template -->
        <DataTemplate x:Key="ProcessRowTemplate" x:DataType="models:TunerProcessRow">
            <Grid Padding="4,8" ColumnSpacing="12" Background="Transparent" ToolTipService.ToolTip="{x:Bind Name}">
                <Grid.ContextFlyout>
                    <MenuFlyout Opening="ProcessMenu_Opening">
                        <MenuFlyoutItem Text="Terminate" Click="Action_Terminate" />
                        <MenuFlyoutItem Text="Suspend" Click="Action_Suspend" />
                        <MenuFlyoutItem Text="Resume" Click="Action_Resume" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem Text="Priority >">
                            <MenuFlyoutItem Text="High" Click="Action_Priority" Tag="High" />
                            <MenuFlyoutItem Text="Above normal" Click="Action_Priority" Tag="AboveNormal" />
                            <MenuFlyoutItem Text="Normal" Click="Action_Priority" Tag="Normal" />
                            <MenuFlyoutItem Text="Below normal" Click="Action_Priority" Tag="BelowNormal" />
                            <MenuFlyoutItem Text="Idle" Click="Action_Priority" Tag="Idle" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem Text="CPU affinity..." Click="Action_Affinity" />
                        <MenuFlyoutItem Text="Show current settings" Click="Action_ShowSettings" />
                        <MenuFlyoutSubItem Text="Priority boost >">
                            <MenuFlyoutItem Text="Enabled" Click="Action_Boost" Tag="Enabled" />
                            <MenuFlyoutItem Text="Disabled" Click="Action_Boost" Tag="Disabled" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Create rule..." Click="Action_CreateRule" />
                        <MenuFlyoutItem Text="Show details" Click="Action_Details" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Grid Width="20" Height="20">
                        <PathIcon Data="M2,2v20h20V2H2z" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Width="16" Height="16" Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                        <Image Source="{x:Bind AppIcon, Mode=OneWay}" Width="20" Height="20" />
                    </Grid>
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
                
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind CpuPercent, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid" UseLayoutRounding="True" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Action Bar -->
            <RowDefinition Height="Auto" /> <!-- SelectorBar -->
            <RowDefinition Height="*" />    <!-- Main Content Panel -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="28,20,28,0" Style="{StaticResource ProcessCard}" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="Process Control" FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="Make durable process changes, tune priority boost, and automate rules without losing control." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Spacing="2">
                        <TextBlock Text="PERMANENT SETTINGS" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Re-applied automatically" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,14,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="5" Margin="0,0,16,0">
                <SelectorBar CornerRadius="9" x:Name="MainSelectorBar" SelectionChanged="MainSelectorBar_SelectionChanged" VerticalAlignment="Center" Background="Transparent">
                    <SelectorBarItem CornerRadius="8" x:Name="TabProcesses" Text="Processes" Background="Transparent" />
                    <SelectorBarItem CornerRadius="8" x:Name="TabRules" Text="Rules" Background="Transparent" />
                </SelectorBar>
            </Border>
        </Grid>

        <!-- Processes Panel -->
        <Grid x:Name="ProcessesPanel" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="28,0,28,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="GamingModePanel" Grid.Column="0" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Gaming session" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Boost a selected game while keeping every change reversible." FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Border x:Name="OptimizerStatusPanel" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="10,6"
                                        VerticalAlignment="Center" Visibility="{Binding Optimizer.IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        <TextBlock Text="{Binding Optimizer.ActiveGameName}" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="·" Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                                        <TextBlock Text="{Binding Optimizer.ProcessesManaged}" FontSize="11" />
                                        <TextBlock Text="managed" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="SuspendRow" Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="PageGamingStatusText" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="520" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PageSuspendStatusText" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ToolTipService.ToolTip="Keep the app running so rules apply automatically">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Start with Windows" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Text="Apply rules automatically" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                            </StackPanel>
                            <ToggleSwitch CornerRadius="8" x:Name="StartupToggle" VerticalAlignment="Center" Toggled="StartupToggle_Toggled" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button CornerRadius="8" x:Name="PageGamingModeButton" Grid.Column="0" Content="Enable Gaming mode" Style="{StaticResource AccentButtonStyle}" Click="Page_ToggleGamingMode" MinWidth="160" Padding="14,8"
                                ToolTipService.ToolTip="Raises the selected process to Above Normal and applies the safe Gaming Mode profile." />
                        <Button CornerRadius="8" x:Name="PageRestoreButton" Grid.Column="1" Content="Restore changes" Click="Page_RestorePriorities" IsEnabled="False" Padding="14,8"
                                ToolTipService.ToolTip="Revert every priority kaliteConfig changed." />
                        <TextBox CornerRadius="8" x:Name="ProcessesSearchBox" Grid.Column="2" MaxWidth="280" MinWidth="220" HorizontalAlignment="Right" PlaceholderText="Search processes or PID" VerticalAlignment="Center"
                                 Text="{x:Bind ViewModel.RulesFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Column Headers -->
            <Border x:Name="ProcessesHeader" Grid.Row="1" Margin="28,0,28,0" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Process" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="CPU" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="PID" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="Memory" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="5" Text="Threads" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="6" Text="Priority" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="7" Text="State" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="8" Text="Context switches delta" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="9" Text="Cycles delta" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="10" Text="Boost" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               ToolTipService.ToolTip="Priority boost for the whole process. Untick to disable it - the choice is saved and re-applied to this process every time it starts." />
                </Grid>
            </Border>

            <ListView CornerRadius="12" x:Name="ProcessesGrid" Grid.Row="2" Margin="28,6,28,0" ItemsSource="{x:Bind ViewModel.DisplayedProcesses, Mode=OneWay}" SelectionMode="Single" SelectionChanged="ProcessesGrid_SelectionChanged" ShowsScrollingPlaceholders="False"
                      Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="4"
                      ItemContainerStyle="{StaticResource ProcessCardItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TunerProcessRow">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Margin="2,0" Padding="0"
                                PointerEntered="ProcessCard_PointerEntered" PointerExited="ProcessCard_PointerExited">
                        <Grid Padding="4,8" ColumnSpacing="12" Background="Transparent" ToolTipService.ToolTip="{x:Bind Name}" DoubleTapped="Row_DoubleTapped">
                            <Grid.ContextFlyout>
                                <MenuFlyout Opening="ProcessMenu_Opening">
                                    <MenuFlyoutItem Text="Terminate" Click="Action_Terminate" />
                                    <MenuFlyoutItem Text="Suspend" Click="Action_Suspend" />
                                    <MenuFlyoutItem Text="Resume" Click="Action_Resume" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutSubItem Text="Priority   >">
                                        <MenuFlyoutItem Text="Real time" Click="Action_Priority" Tag="Realtime" />
                                        <MenuFlyoutItem Text="High" Click="Action_Priority" Tag="High" />
                                        <MenuFlyoutItem Text="Above normal" Click="Action_Priority" Tag="AboveNormal" />
                                        <MenuFlyoutItem Text="Normal" Click="Action_Priority" Tag="Normal" />
                                        <MenuFlyoutItem Text="Below normal" Click="Action_Priority" Tag="BelowNormal" />
                                        <MenuFlyoutItem Text="Idle" Click="Action_Priority" Tag="Idle" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutItem Text="CPU affinity..." Click="Action_Affinity" />
                                            <MenuFlyoutSubItem Text="Priority boost   >">
                                        <MenuFlyoutItem Text="Enabled" Click="Action_Boost" Tag="Enabled" />
                                        <MenuFlyoutItem Text="Disabled" Click="Action_Boost" Tag="Disabled" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSubItem Text="Efficiency mode   >">
                                        <MenuFlyoutItem Text="Enabled" Click="Action_Eco" Tag="Enabled" />
                                        <MenuFlyoutItem Text="Disabled" Click="Action_Eco" Tag="Disabled" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Create rule..." Click="Action_CreateRule" />
                                    <MenuFlyoutItem Text="Show details" Click="Action_Details" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="24,0,0,0">
                                <Grid Width="16" Height="16">
                                    <PathIcon Data="M2,2v20h20V2H2z" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Width="16" Height="16" Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                                    <Image Source="{x:Bind AppIcon, Mode=OneWay}" Width="16" Height="16" />
                                </Grid>
                                <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"
                                          Visibility="{x:Bind IsProtected, Mode=OneWay}"
                                          ToolTipService.ToolTip="Protected process - Windows does not allow priority/affinity changes." />
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{x:Bind local:ThreadTunerPage.RowNameBrush(IsProtected), Mode=OneWay}" />
                            </StackPanel>

                            <Button Grid.Column="1" Content="Threads" FontSize="12" Padding="10,4" MinWidth="0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Tag="{x:Bind}" Click="RowThreads_Click"
                                    ToolTipService.ToolTip="Open the threads dialog for this process" />

                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind CpuPercent, Mode=OneWay}" />
                            <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind Pid}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind Memory, Mode=OneWay}" />
                            <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind Threads, Mode=OneWay}" />
                            <TextBlock Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind PriorityText, Mode=OneWay}" />
                            <TextBlock Grid.Column="7" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind State, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="8" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind ContextSwitchesDelta, Mode=OneWay}" />
                            <TextBlock Grid.Column="9" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" FontSize="12" Text="{x:Bind CyclesDelta, Mode=OneWay}" />

                            <!-- Per-process Priority boost. Unticking applies to the
                                 live process immediately and is remembered for good. -->
                            <CheckBox CornerRadius="8" Grid.Column="10"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      MinWidth="0"
                                      IsThreeState="False"
                                      Click="RowBoost_Click"
                                      Tag="{x:Bind}"
                                      IsEnabled="{x:Bind local:ThreadTunerPage.Not(IsProtected), Mode=OneWay}"
                                      IsChecked="{x:Bind BoostAllowed, Mode=OneWay}"
                                      ToolTipService.ToolTip="Priority boost (ticked = Windows default). Untick to disable it permanently for this process." />
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid x:Name="ProcessesFooter" Grid.Row="3" Margin="28,12,28,12">
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <TextBlock Text="Updated 2 s" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- RulesPanel -->
        <Grid x:Name="RulesPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Rules toolbar -->
            <Border Grid.Row="0" Margin="28,4,28,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Rules" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox CornerRadius="8" Grid.Column="1" MaxWidth="320" HorizontalAlignment="Left" PlaceholderText="Search rules" VerticalAlignment="Center"
                         Text="{x:Bind ViewModel.RulesFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button CornerRadius="8" Content="Edit" VerticalAlignment="Center" Click="RuleEdit_Click" />
                    <Button CornerRadius="8" Content="Enable / disable" VerticalAlignment="Center" Click="RuleToggle_Click" />
                    <Button CornerRadius="8" Content="Delete" VerticalAlignment="Center" Click="RuleDelete_Click" />
                </StackPanel>
                <Button CornerRadius="8" Grid.Column="3" Content="Add rule" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Click="RuleAdd_Click" />
            </Grid>
            </Border>

            <!-- Rules column headers -->
            <Border Grid.Row="1" Margin="28,0,28,0" Padding="14,8" CornerRadius="8"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Process" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="Process actions" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="Thread rules" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="Last result" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- Rules list -->
            <ListView CornerRadius="12" x:Name="RulesList" Grid.Row="2" Margin="16,0,16,0" ItemsSource="{x:Bind ViewModel.DisplayedProcessProfiles, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                      ItemTemplate="{StaticResource RuleRowTemplate}"
                      SelectionMode="Single" ShowsScrollingPlaceholders="False" />

            <!-- Rules footer -->
            <Grid Grid.Row="3" Margin="12,8,12,12">
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <TextBlock x:Name="RulesCountText" Text="0 rules" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Each action is applied and verified independently" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Double-click to edit" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>
