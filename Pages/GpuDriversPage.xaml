<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.Pages.GpuDriversPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:kaliteConfig.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:kaliteConfig.Models"
    xmlns:dev="using:DevWinUI"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:oc="using:kaliteConfig.GpuOverclock.Views"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <!-- Card container -->
        <Style x:Key="GpuCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <!-- Small icon tile -->
        <Style x:Key="IconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="9" />
        </Style>

        <!-- Status pill -->
        <Style x:Key="PillTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <x:String x:Key="MutedForeground">{ThemeResource TextFillColorSecondaryBrush}</x:String>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="1" Padding="36,0,36,24" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Stretch" Spacing="8">

                <!-- ===================== Header ===================== -->
                <Grid Margin="0,0,0,12" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="11">
                            <FontIcon Glyph="&#xE7F4;" FontSize="22" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Graphics" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.DetectStatusText, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ComboBox
                            x:Name="NotebookToggle"
                            SelectedIndex="{x:Bind ViewModel.NotebookGpuIndex, Mode=TwoWay}"
                            Margin="0,0,0,0" Padding="12,4" VerticalAlignment="Center">
                            <x:String>Desktop GPU</x:String>
                            <x:String>Notebook GPU</x:String>
                        </ComboBox>
                        <ComboBox
                            x:Name="StudioChannelToggle"
                            SelectedIndex="{x:Bind ViewModel.StudioChannelIndex, Mode=TwoWay}"
                            Margin="0,0,0,0" Padding="12,4" VerticalAlignment="Center">
                            <x:String>Game Ready channel</x:String>
                            <x:String>Studio channel</x:String>
                        </ComboBox>
                        <Button Command="{x:Bind ViewModel.DetectGpusCommand}" Click="RedetectBtn_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Re-detect" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ===================== GPU cards ===================== -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.VisibleDrivers, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="1200" MinItemHeight="0"
                                           MinRowSpacing="16" MinColumnSpacing="16"
                                           ItemsJustification="Start" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:GpuDriverItem">
                            <Border Style="{StaticResource GpuCardStyle}">
                                <StackPanel Spacing="16">

                                    <!-- Header: icon, vendor + GPU name, primary pill -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="10"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Padding="12" VerticalAlignment="Center">
                                            <Image Source="{x:Bind local:GpuDriversPage.VendorIcon(Vendor), Mode=OneWay}" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{x:Bind Vendor}" FontSize="14"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind HardwareName}" Style="{StaticResource TitleTextBlockStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border CornerRadius="10" Padding="8,2"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{x:Bind PrimaryVis, Mode=OneWay}">
                                                <TextBlock Text="Primary" Style="{StaticResource PillTextStyle}"
                                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                            <Border CornerRadius="10" Padding="8,2"
                                                    Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                    Visibility="{x:Bind SecondaryVis, Mode=OneWay}">
                                                <TextBlock Text="Secondary" Style="{StaticResource PillTextStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Versions -->
                                    <Grid ColumnSpacing="8" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Driver version" FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind InstalledVersion, Mode=OneWay, TargetNullValue='—'}"
                                                       FontSize="20" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="18" VerticalAlignment="Center" Margin="0,18,0,0"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="Latest version" FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind LatestVersion, Mode=OneWay, TargetNullValue='—'}"
                                                       FontSize="20" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Specs row -->
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE950;" FontSize="20"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind VramText}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" />
                                                <TextBlock Text="VRAM" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE977;" FontSize="20"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind GpuTypeText}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" />
                                                <TextBlock Text="GPU type" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="20"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind DeviceTypeText}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" />
                                                <TextBlock Text="Device type" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Live install feedback: progress bar + status line -->
                                    <StackPanel Spacing="6"
                                                Visibility="{x:Bind local:GpuDriversPage.ProgressVis(Status), Mode=OneWay}">
                                        <ProgressBar Value="{x:Bind DownloadProgress, Mode=OneWay}"
                                                     Maximum="100"
                                                     IsIndeterminate="{x:Bind local:GpuDriversPage.InstallPhaseVis(Status), Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Error line (lookup/install failures) -->
                                    <TextBlock Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind local:GpuDriversPage.ErrorVis(ErrorMessage), Mode=OneWay}" />

                                    <!-- Actions: install only when there's something to install,
                                         otherwise a single Check for updates -->
                                    <Grid>
                                        <Button Tag="{x:Bind}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Content="{x:Bind PrimaryActionText, Mode=OneWay}"
                                                Visibility="{x:Bind local:GpuDriversPage.InstallBtnVis(Status), Mode=OneWay}"
                                                Click="DownloadInstallBtn_Click" />
                                        <Button Tag="{x:Bind}"
                                                HorizontalAlignment="Stretch"
                                                Content="{x:Bind CheckActionText, Mode=OneWay}"
                                                IsEnabled="{x:Bind IsCheckEnabled, Mode=OneWay}"
                                                Visibility="{x:Bind local:GpuDriversPage.CheckBtnVis(Status), Mode=OneWay}"
                                                Click="CheckForUpdatesBtn_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- NVIDIA overclock module (self-handles the unsupported case,
                     e.g. shows "no NVIDIA GPU detected" on AMD/Intel machines) -->
                <oc:OverclockSection x:Name="OverclockPanel" Margin="0,8,0,0" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
