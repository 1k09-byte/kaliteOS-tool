<Project Sdk="Microsoft.NET.Sdk">
  <!-- Structure mirrors the WinUI 3 Gallery standalone project (WinUIGallery.csproj),
       on the latest stack: WASDK 2.4.0 + net10.0 + Windows SDK 22621 projections.
       Package versions verified from gallery sources (@b1730cb / DevWinUI @30a7bbb). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>kaliteConfig</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\kaliteConfig.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- WinUI-Gallery pattern: packaged and unpackaged configurations side by side.
         A post-install toolkit wants unpackaged runs (elevated helpers, no MSIX identity). -->
    <Configurations>Debug;Release</Configurations>
    <Packaged>false</Packaged>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkIncludeVersionInfo>true</WindowsAppSdkIncludeVersionInfo>
    <!-- The gallery ships untrimmed (PublishAot=false, no PublishTrimmed); trimming
         WinUI/XAML apps breaks runtime type resolution. R2R stays on for Release. -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug' or '$(Configuration)' == 'Debug-Unpackaged'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release' or '$(Configuration)' == 'Release-Unpackaged'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
       <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Scratch/vendor drops (e.g. Assets\_temp\node_modules) must never be
         indexed as PRI resources (PRI249 bogus-qualifier warnings) nor
         shipped inside the installer. -->
    <Content Remove="Assets\_temp\**\*" />
    <!-- Dev tools live in-repo but must never join the app build. -->
    <Compile Remove="tools\**\*" />
    <EmbeddedResource Remove="tools\**\*" />
    <None Remove="tools\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DevWinUI" Version="10.4.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--  Consumer flavor: same codebase minus the pro-only areas.
        Build with: dotnet build -p:ConsumerBuild=true
        Publish with: Installer/Build-Consumer.ps1
        Excluded: power-plan settings. -->
  <PropertyGroup Condition="'$(ConsumerBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);CONSUMER</DefineConstants>
    <!-- Distinct exe so consumer output never collides with a running pro build. -->
    <AssemblyName>kaliteConfig-Consumer</AssemblyName>
  </PropertyGroup>

  <ItemGroup Condition="'$(ConsumerBuild)' == 'true'">
    <!-- Pro-only pages (markup + code-behind). -->
    <Page Remove="Pages\PowerPlansPage.xaml" />
    <Compile Remove="Pages\PowerPlansPage.xaml.cs" />
    <!-- Pro-only view models. -->
    <Compile Remove="ViewModels\PowerPlansViewModel.cs" />
    <!-- Pro-only models/services (power-plan engine). -->
    <Compile Remove="Models\PowerPlanModels.cs" />
    <Compile Remove="Services\PowerService.cs" />
  </ItemGroup>

  <!--  Unpackaged publish otherwise ships without the app's own .pri
        (only framework PRIs are publish assets), and the app then dies
        silently at startup (0xC000027B). Top it up after publish. -->
  <Target Name="EnsureAppPriInPublishDir" AfterTargets="Publish">
    <Copy SourceFiles="$(ProjectPriFullPath)" DestinationFolder="$(PublishDir)" Condition="Exists('$(ProjectPriFullPath)') and !Exists('$(PublishDir)$(ProjectPriFileName)')" />
  </Target>

  <!--  The running app locks its own exe, which fails the build with
        MSB3027/MSB3021. Stop any running instance before every build so
        rebuild-while-running just works. Remove this target if you would
        rather stop the app yourself (Shift+F5). -->
  <Target Name="KillRunningAppBeforeBuild" BeforeTargets="BeforeBuild">
    <Exec Command="taskkill /F /IM kaliteConfig.exe 2&gt;nul &amp; taskkill /F /IM kaliteConfig-Consumer.exe 2&gt;nul &amp; exit 0" StandardOutputImportance="low" />
  </Target>

  <!--  App Version and Assembly Info  -->
  <PropertyGroup>
    <Version>0.2.0.2</Version>
    <AssemblyTitle>kaliteConfig</AssemblyTitle>
    <AssemblyProduct>kaliteConfig</AssemblyProduct>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <AssemblyFileVersion>$(Version)</AssemblyFileVersion>
  </PropertyGroup>
</Project>
