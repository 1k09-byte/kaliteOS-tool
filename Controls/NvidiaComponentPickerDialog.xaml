<ContentDialog
    x:Class="kaliteConfig.Controls.NvidiaComponentPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:kaliteConfig.Controls"
    mc:Ignorable="d"
    Title="Choose components"
    PrimaryButtonText="Install selected"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="560">
        <TextBlock Text="NVIDIA packages the display driver with optional extras. Everything unchecked is excluded from the silent install. The base display driver cannot be removed."
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <CheckBox x:Name="CleanInstallCheck"
                  Content="Clean install (remove previous driver settings first)"
                  ToolTipService.ToolTip="Uses the NVIDIA installer's own clean-install flag - the safe way to reset driver state." />

        <ListView x:Name="ComponentsList"
                  SelectionMode="None"
                  MaxHeight="340"
                  IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:NvidiaComponentVm">
                    <Grid Padding="0,4" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                  IsEnabled="{x:Bind IsEnabled}"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Description}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="FootprintText"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Expander Header="Package verification details" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4" Padding="4">
                <TextBlock x:Name="VerFileName" FontSize="12" />
                <TextBlock x:Name="VerSize" FontSize="12" />
                <TextBlock x:Name="VerSha" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock x:Name="VerSig" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Expander>

        <Expander Header="Install log" HorizontalAlignment="Stretch" Visibility="Collapsed" x:Name="LogExpander">
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText"
                           FontSize="11"
                           FontFamily="Consolas"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Expander>

        <ProgressBar x:Name="InstallProgress" Maximum="100" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
