<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.PackageManager.Views.PackageBundlesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:kaliteConfig.PackageManager.ViewModels"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Package Bundles" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind Vm.StatusLine, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Bundles, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:BundleRow">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Bundle.Name}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{x:Bind Summary, Mode=OneWay}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Check missing" Click="CheckMissing_Click" Tag="{x:Bind}" />
                                <Button Content="Install missing" Style="{StaticResource AccentButtonStyle}"
                                        Click="InstallMissing_Click" Tag="{x:Bind}" />
                                <Button Content="Export" Click="ExportBundle_Click" Tag="{x:Bind}" />
                                <Button Content="Delete" Click="DeleteBundle_Click" Tag="{x:Bind}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="New bundle" Style="{StaticResource AccentButtonStyle}" Click="NewBundle_Click" />
            <Button Content="Import bundle file…" Click="ImportBundle_Click" />
        </StackPanel>
    </Grid>
</Page>
