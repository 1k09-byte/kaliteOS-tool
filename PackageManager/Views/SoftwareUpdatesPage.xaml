<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="kaliteConfig.PackageManager.Views.SoftwareUpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:kaliteConfig.PackageManager.ViewModels"
    xmlns:local="using:kaliteConfig.PackageManager.Views"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Software Updates" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind Vm.StatusLine, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox Grid.Column="0" PlaceholderText="Filter updates..." QueryIcon="Find"
                            Text="{x:Bind Vm.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Reload" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind Vm.LoadCommand}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Export CSV" VerticalAlignment="Center"
                    Click="ExportCsv_Click" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Sources" FontWeight="SemiBold" />
                <ItemsRepeater ItemsSource="{x:Bind Vm.SourceChoices, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SourceChoice">
                            <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Select all" Command="{x:Bind Vm.CheckAllSourcesCommand}" />
                    <Button Content="Clear" Command="{x:Bind Vm.UncheckAllSourcesCommand}" />
                </StackPanel>
                <TextBlock Text="View" FontWeight="SemiBold" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ToggleButton Content="List" Tag="0" Click="ViewMode_Click"
                                  IsChecked="{x:Bind Vm.ViewMode.Equals(vm:PackageViewMode.List), Mode=OneWay}" />
                    <ToggleButton Content="Compact" Tag="1" Click="ViewMode_Click"
                                  IsChecked="{x:Bind Vm.ViewMode.Equals(vm:PackageViewMode.Compact), Mode=OneWay}" />
                    <ToggleButton Content="Grid" Tag="2" Click="ViewMode_Click"
                                  IsChecked="{x:Bind Vm.ViewMode.Equals(vm:PackageViewMode.Grid), Mode=OneWay}" />
                </StackPanel>
                <ComboBox SelectedIndex="{x:Bind Vm.SortKeyIndex, Mode=TwoWay}" Header="Order by">
                    <ComboBoxItem Content="Name" />
                    <ComboBoxItem Content="Source" />
                    <ComboBoxItem Content="Version" />
                </ComboBox>
            </StackPanel>

            <Grid Grid.Column="1">
                <local:PackageListView x:Name="ResultsList"
                                       Items="{x:Bind Vm.Filtered, Mode=OneWay}"
                                       ViewMode="{x:Bind Vm.ViewMode, Mode=OneWay}"
                                       ActionLabel="Update"
                                       ActionCommand="{x:Bind Vm.UpdateOneCommand}"
                                       CancelCommand="{x:Bind Vm.CancelActiveOperationCommand}"
                                       InfoRequested="ResultsList_InfoRequested"
                                       SelectionToggled="ResultsList_SelectionToggled" />
                <TextBlock Text="Reload to check every enabled source for updates."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind local:SoftwareUpdatesPage.EmptyVis(Vm.Filtered.Count, Vm.IsBusy), Mode=OneWay}" />
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{x:Bind Vm.CountsLine, Mode=OneWay}" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <Button Content="Select all" Command="{x:Bind Vm.SelectAllCommand}" />
            <Button Content="Clear selection" Command="{x:Bind Vm.ClearSelectionCommand}" />
            <Button Content="Update selection" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind Vm.UpdateSelectedCommand}" />
            <Button Content="Add selection to bundle…" Click="AddToBundle_Click" />
        </StackPanel>
    </Grid>
</Page>
