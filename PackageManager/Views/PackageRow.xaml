<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="kaliteConfig.PackageManager.Views.PackageRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:kaliteConfig.PackageManager.ViewModels"
    xmlns:local="using:kaliteConfig.PackageManager.Views"
    mc:Ignorable="d">

    <!-- One package row in three densities. All bindings are to this
         control's own dependency properties (set by PackageListView in
         ElementPrepared) plus the bound Package — no cross-template
         ElementName tricks, so nothing here can silently stop resolving. -->
    <Grid>
        <!-- ============ List (detailed) ============ -->
        <StackPanel x:Name="ListWrap" Spacing="4">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{x:Bind Package.IsSelected, Mode=TwoWay}"
                          Checked="SelectionBox_Toggled" Unchecked="SelectionBox_Toggled"
                          VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{x:Bind Package.DisplayName, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"
                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Package.Name, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Package.Id, Mode=OneWay}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{x:Bind Package.VersionLine, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Package.SourceLabel, Mode=OneWay}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="{x:Bind ActionLabel, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ActionCommand, Mode=OneWay}" CommandParameter="{x:Bind Package, Mode=OneWay}"
                            Click="ActionButton_Click"
                            Visibility="{x:Bind local:PackageRow.BoolToVis(ShowAction), Mode=OneWay}" />
                    <Button Content="Cancel"
                            Command="{x:Bind CancelCommand, Mode=OneWay}" CommandParameter="{x:Bind Package, Mode=OneWay}"
                            Visibility="{x:Bind local:PackageRow.RunningVis(Package.ActiveOperation.State), Mode=OneWay, FallbackValue=Collapsed}" />
                    <Button Click="InfoButton_Click" ToolTipService.ToolTip="Details"
                            Visibility="{x:Bind local:PackageRow.BoolToVis(ShowInfo), Mode=OneWay}">
                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
            <StackPanel Spacing="2"
                        Visibility="{x:Bind local:PackageRow.RunningVis(Package.ActiveOperation.State), Mode=OneWay, FallbackValue=Collapsed}">
                <ProgressBar Value="{x:Bind Package.ActiveOperation.PercentValue, Mode=OneWay, FallbackValue=0}"
                             Maximum="100"
                             IsIndeterminate="{x:Bind Package.ActiveOperation.IsIndeterminate, Mode=OneWay, FallbackValue=False}" />
                <TextBlock Text="{x:Bind Package.ActiveOperation.Message, Mode=OneWay, FallbackValue=''}"
                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- ============ Compact (single line) ============ -->
        <Grid x:Name="CompactGrid" ColumnSpacing="10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" IsChecked="{x:Bind Package.IsSelected, Mode=TwoWay}"
                      Checked="SelectionBox_Toggled" Unchecked="SelectionBox_Toggled"
                      VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="{x:Bind Package.DisplayName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " />
                <Run Text="{x:Bind Package.VersionLine, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </TextBlock>
            <Button Grid.Column="2" Content="{x:Bind ActionLabel, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ActionCommand, Mode=OneWay}" CommandParameter="{x:Bind Package, Mode=OneWay}"
                    Click="ActionButton_Click"
                    Visibility="{x:Bind local:PackageRow.BoolToVis(ShowAction), Mode=OneWay}" />
            <Button Grid.Column="3" Click="InfoButton_Click" ToolTipService.ToolTip="Details"
                    Visibility="{x:Bind local:PackageRow.BoolToVis(ShowInfo), Mode=OneWay}">
                <FontIcon Glyph="&#xE946;" FontSize="14" />
            </Button>
        </Grid>

        <!-- ============ Grid (card) ============ -->
        <Border x:Name="CardBorder" CornerRadius="10" Padding="14" Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{x:Bind Package.IsSelected, Mode=TwoWay}"
                              Checked="SelectionBox_Toggled" Unchecked="SelectionBox_Toggled"
                              VerticalAlignment="Center" />

                </Grid>
                <TextBlock Text="{x:Bind Package.DisplayName, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"
                           TextWrapping="Wrap" MaxLines="2" />
                <TextBlock Text="{x:Bind Package.Id, Mode=OneWay}" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Package.VersionLine, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Package.SourceLabel, Mode=OneWay}" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="{x:Bind ActionLabel, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ActionCommand, Mode=OneWay}" CommandParameter="{x:Bind Package, Mode=OneWay}"
                            Click="ActionButton_Click"
                            Visibility="{x:Bind local:PackageRow.BoolToVis(ShowAction), Mode=OneWay}" />
                    <Button Click="InfoButton_Click" ToolTipService.ToolTip="Details"
                            Visibility="{x:Bind local:PackageRow.BoolToVis(ShowInfo), Mode=OneWay}">
                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
