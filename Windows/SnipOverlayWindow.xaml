<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="kaliteConfig.Views.SnipOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">
    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded" KeyDown="RootGrid_KeyDown" IsTabStop="True">
        <Grid.Resources>
        <Style x:Key="SnipToolButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="SnipActionButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="SnipGlyph" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style x:Key="SnipSeparator" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        </Grid.Resources>
        <!-- Render the frozen screen and draw interaction here -->
        <canvas:CanvasControl x:Name="DrawCanvas" ClearColor="Transparent"
                              Draw="DrawCanvas_Draw"
                              PointerPressed="DrawCanvas_PointerPressed"
                              PointerMoved="DrawCanvas_PointerMoved"
                              PointerReleased="DrawCanvas_PointerReleased" />
        <Canvas>
            <StackPanel x:Name="ToolbarHost" Visibility="Collapsed" Spacing="0">
                <!-- Main toolbar row: tools | history | output -->
                <Border x:Name="SnipToolbar" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="6">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <!-- Tools group: radio behavior, exactly one active -->
                        <ToggleButton x:Name="BtnToolSelect" Style="{StaticResource SnipToolButton}" Click="BtnTool_Click"
                                      ToolTipService.ToolTip="Select (V)" AutomationProperties.Name="Select tool"
                                      Tag="Select">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xE7A8;"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnToolArrow" Style="{StaticResource SnipToolButton}" Click="BtnTool_Click"
                                      ToolTipService.ToolTip="Arrow (A)" AutomationProperties.Name="Arrow tool" Tag="Arrow">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xE72A;"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnToolLine" Style="{StaticResource SnipToolButton}" Click="BtnTool_Click"
                                      ToolTipService.ToolTip="Line (L)" AutomationProperties.Name="Line tool" Tag="Line">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xE949;"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnToolRect" Style="{StaticResource SnipToolButton}" Click="BtnTool_Click"
                                      ToolTipService.ToolTip="Rectangle (R)" AutomationProperties.Name="Rectangle tool" Tag="Rectangle">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xE739;"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnToolEllipse" Style="{StaticResource SnipToolButton}" Click="BtnTool_Click"
                                      ToolTipService.ToolTip="Ellipse (O)" AutomationProperties.Name="Ellipse tool" Tag="Ellipse">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xEA3A;"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnToolInk" Style="{StaticResource SnipToolButton}" Click="BtnTool_Click"
                                      ToolTipService.ToolTip="Pen (P)" AutomationProperties.Name="Pen tool" Tag="Ink">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xED63;"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnToolHighlight" Style="{StaticResource SnipToolButton}" Click="BtnTool_Click"
                                      ToolTipService.ToolTip="Highlighter (H)" AutomationProperties.Name="Highlighter tool" Tag="Highlight">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xED64;"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnToolText" Style="{StaticResource SnipToolButton}" Click="BtnTool_Click"
                                      ToolTipService.ToolTip="Text (T)" AutomationProperties.Name="Text tool" Tag="Text">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xE8D2;"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnToolNumber" Style="{StaticResource SnipToolButton}" Click="BtnTool_Click"
                                      ToolTipService.ToolTip="Number badge (N)" AutomationProperties.Name="Number badge tool" Tag="Number">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xE8FD;"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnToolBlur" Style="{StaticResource SnipToolButton}" Click="BtnTool_Click"
                                      ToolTipService.ToolTip="Blur / Pixelate (B)" AutomationProperties.Name="Blur tool" Tag="Blur">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xEAEB;"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnToolSpotlight" Style="{StaticResource SnipToolButton}" Click="BtnTool_Click"
                                      ToolTipService.ToolTip="Spotlight (S)" AutomationProperties.Name="Spotlight tool" Tag="Spotlight">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xE793;"/>
                        </ToggleButton>

                        <Border Style="{StaticResource SnipSeparator}"/>

                        <!-- History group -->
                        <Button x:Name="BtnUndo" Style="{StaticResource SnipActionButton}" Click="BtnUndo_Click"
                                ToolTipService.ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xE7A7;"/>
                        </Button>
                        <Button x:Name="BtnRedo" Style="{StaticResource SnipActionButton}" Click="BtnRedo_Click"
                                ToolTipService.ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xE7A6;"/>
                        </Button>

                        <Border Style="{StaticResource SnipSeparator}"/>

                        <!-- Output group -->
                        <Button x:Name="BtnOcr" Style="{StaticResource SnipActionButton}" Click="BtnOcr_Click"
                                ToolTipService.ToolTip="Copy text / OCR" AutomationProperties.Name="Copy text OCR">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xE8FE;"/>
                        </Button>
                        <Button x:Name="BtnPin" Style="{StaticResource SnipActionButton}" Click="BtnPin_Click"
                                ToolTipService.ToolTip="Pin to screen" AutomationProperties.Name="Pin to screen">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xE718;"/>
                        </Button>
                        <Button x:Name="BtnSave" Style="{StaticResource SnipActionButton}" Click="BtnSave_Click"
                                ToolTipService.ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save snip">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xE74E;"/>
                        </Button>
                        <Button x:Name="BtnCopy" Style="{StaticResource SnipActionButton}" Click="BtnCopy_Click"
                                ToolTipService.ToolTip="Copy (Enter)" AutomationProperties.Name="Copy snip">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xE8C8;"/>
                        </Button>

                        <!-- Instant copy toggle: check badge instead of tool highlight -->
                        <ToggleButton x:Name="BtnInstantMode" Style="{StaticResource SnipToolButton}" Click="BtnInstantMode_Click"
                                      ToolTipService.ToolTip="Instant copy: OFF" AutomationProperties.Name="Instant copy toggle">
                            <Grid>
                                <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xE8C8;"/>
                                <Border x:Name="InstantCheckBadge" Width="14" Height="14" CornerRadius="7"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,-4,-4" Visibility="Collapsed">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE73E;" FontSize="8" Foreground="White"/>
                                </Border>
                            </Grid>
                        </ToggleButton>

                        <Border Style="{StaticResource SnipSeparator}"/>

                        <Button x:Name="BtnClose" Style="{StaticResource SnipActionButton}" Click="BtnClose_Click"
                                ToolTipService.ToolTip="Close (Esc)" AutomationProperties.Name="Close snip overlay">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xE711;"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Contextual formatting row: shown only when the active tool needs it -->
                <Border x:Name="FormatRow" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,1,1"
                        CornerRadius="0,0,8,8" Padding="8,6" Margin="0,-2,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Color" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" Spacing="4"/>
                        <Button x:Name="BtnCustomColor" Padding="4" Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Custom color" AutomationProperties.Name="Custom color">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xEF3C;" FontSize="14"/>
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="ColorPickerTool" Color="Red" IsColorChannelTextInputVisible="False"
                                                 IsHexInputVisible="False" IsAlphaEnabled="False"
                                                 ColorChanged="ColorPickerTool_ColorChanged"/>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Border Style="{StaticResource SnipSeparator}"/>

                        <TextBlock Text="Thickness" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Slider x:Name="SliderThickness" Minimum="1" Maximum="20" Value="4" Width="110"
                                VerticalAlignment="Center" ValueChanged="SliderThickness_ValueChanged"
                                ToolTipService.ToolTip="Stroke thickness"/>
                        <Ellipse x:Name="ThicknessPreview" Width="6" Height="6"
                                 Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"/>

                        <Border x:Name="FillSeparator" Style="{StaticResource SnipSeparator}"/>
                        <ToggleButton x:Name="BtnFillToggle" Padding="4" Background="Transparent" BorderThickness="0"
                                      ToolTipService.ToolTip="Fill shape" AutomationProperties.Name="Fill shape"
                                      Checked="BtnFillToggle_Changed" Unchecked="BtnFillToggle_Changed">
                            <FontIcon Style="{StaticResource SnipGlyph}" Glyph="&#xEA3B;" FontSize="14"/>
                        </ToggleButton>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Canvas>
    </Grid>
</Window>
