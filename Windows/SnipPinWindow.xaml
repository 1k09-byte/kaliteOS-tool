<Window
    x:Class="kaliteConfig.Views.SnipPinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Pinned Snip">
    <Grid Background="Transparent" PointerPressed="Grid_PointerPressed" CornerRadius="4">
        <Border BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Image x:Name="PinnedImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button VerticalAlignment="Top" HorizontalAlignment="Right"
                        Margin="4" Width="28" Height="28" Padding="0" Opacity="0.6" Click="BtnClose_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
